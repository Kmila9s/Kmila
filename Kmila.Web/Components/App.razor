    @* Mermaid diagrams — Markdown lessons with ```mermaid fenced blocks get
       rewritten to <pre class="mermaid"> which this script auto-initializes.
       kmilaMermaidRun is exposed so pages that render Markdown after the first
       paint (LessonView, etc.) can re-scan the DOM on navigation. *@
    <script type="module">
        import mermaid from '/_content/Kmila.Shared/lib/mermaid/mermaid.esm.min.mjs';
        // Pull live token values from the document so Mermaid blends with
        // the kmila palette in BOTH light and dark themes. Default Mermaid
        // theme renders pale-yellow boxes that clash with the rest of the
        // app (see audit 2026-06-14, finding A-12).
        const cssVar = (name, fallback) => {
            const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
            return v || fallback;
        };
        const kmilaMermaidConfig = () => {
            const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            return {
                startOnLoad: false,
                securityLevel: 'strict',
                theme: 'base',
                themeVariables: {
                    fontFamily: cssVar('--font-sans', 'system-ui, sans-serif'),
                    background: cssVar('--surface-1', dark ? '#0f172a' : '#ffffff'),
                    primaryColor: cssVar('--surface-2', dark ? '#1e293b' : '#f1f5f9'),
                    primaryTextColor: cssVar('--text-strong', dark ? '#f8fafc' : '#0f172a'),
                    primaryBorderColor: cssVar('--kmila-accent', '#1f57c4'),
                    lineColor: cssVar('--text-muted', dark ? '#94a3b8' : '#64748b'),
                    secondaryColor: cssVar('--surface-3', dark ? '#334155' : '#e2e8f0'),
                    tertiaryColor: cssVar('--surface-2', dark ? '#1e293b' : '#f8fafc'),
                    textColor: cssVar('--text-default', dark ? '#e2e8f0' : '#1e293b'),
                },
            };
        };
        mermaid.initialize(kmilaMermaidConfig());
        // Mermaid replaces pre.mermaid's innerHTML with the rendered SVG on
        // first run, which DESTROYS the original source. Re-running on a
        // theme switch then tries to parse the SVG markup as mermaid syntax
        // and fails — the diagram silently disappears. Stash the source in a
        // data attribute the first time we see each pre so we can restore it
        // before re-rendering. (Backlog #7.)
        //
        // v11.15.0 code-splits diagram grammars into lazy chunks. `mermaid.run`
        // by itself can race the first `import()` for the flowchart chunk on
        // hydration — the pre exists in the DOM but the parser isn't loaded
        // yet, so every diagram falls to the "Syntax error / version 11.15.0"
        // fallback. Awaiting `mermaid.parse(src)` before `run` forces the
        // chunk import to resolve first. Single-flight + pending flag
        // coalesces overlapping calls from the load handler, LessonView's
        // OnAfterRender, and the theme-swap observer during hydration.
        let mermaidRunning = false;
        let mermaidPending = false;
        window.kmilaMermaidRun = async function () {
            if (mermaidRunning) { mermaidPending = true; return; }
            mermaidRunning = true;
            try {
                do {
                    mermaidPending = false;
                    await new Promise(r => requestAnimationFrame(r));
                    const nodes = Array.from(document.querySelectorAll('pre.mermaid:not([data-processed])'));
                    for (const el of nodes) {
                        if (!el.hasAttribute('data-kmila-mermaid-src')) {
                            el.setAttribute('data-kmila-mermaid-src', el.textContent || '');
                        }
                    }
                    for (const el of nodes) {
                        const src = el.getAttribute('data-kmila-mermaid-src') || '';
                        try {
                            await mermaid.parse(src);
                            await mermaid.run({ nodes: [el] });
                        } catch (e) {
                            console.warn('[mermaid]', e, src.slice(0, 80));
                            el.removeAttribute('data-processed');
                        }
                    }
                } while (mermaidPending);
            } finally {
                mermaidRunning = false;
            }
        };
        // Re-theme on Bootstrap theme changes so dark-mode diagrams don't glow.
        new MutationObserver(() => {
            mermaid.initialize(kmilaMermaidConfig());
            document.querySelectorAll('pre.mermaid').forEach(el => {
                var src = el.getAttribute('data-kmila-mermaid-src');
                if (src !== null) el.textContent = src;
                el.removeAttribute('data-processed');
            });
            window.kmilaMermaidRun();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
        window.addEventListener('load', () => window.kmilaMermaidRun());
    </script>
