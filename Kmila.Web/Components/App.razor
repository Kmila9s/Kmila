    @*
        Custom reconnect modal. Blazor Server auto-injects an unstyled fallback
        when the SignalR circuit drops; defining this element ourselves overrides
        it so the disconnection UX matches the rest of the project.

        State classes set by the framework:
          .components-reconnect-show     — actively retrying
          .components-reconnect-failed   — gave up after the retry budget
          .components-reconnect-rejected — server refused the resume (circuit gone)

        The button with id="components-reconnect-button" is wired automatically
        to Blazor.reconnect(); the reload button calls location.reload() inline
        because at that point the circuit is dead and no DI is reachable.
    *@
    <div id="components-reconnect-modal" class="kmila-reconnect" role="dialog" aria-live="assertive" aria-labelledby="kmila-reconnect-title" style="display: none;">
        <div class="kmila-reconnect__backdrop" aria-hidden="true"></div>
        <div class="kmila-reconnect__card" role="document">
            <div class="kmila-reconnect__head">
                <span class="kmila-reconnect__icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M10.706 3.294A12.55 12.55 0 0 0 8 3C5.259 3 2.723 3.882.663 5.379a.485.485 0 0 0-.048.736.518.518 0 0 0 .668.05A11.45 11.45 0 0 1 8 4c.63 0 1.249.05 1.852.148zm-1.39 1.297A11.5 11.5 0 0 0 8 4.5C5.466 4.5 3.156 5.475 1.452 7.087a.5.5 0 1 0 .69.726A10.5 10.5 0 0 1 8 5.5c.36 0 .713.018 1.06.052zM2.852 9.808a9.5 9.5 0 0 1 1.78-1.07l1.057 1.057a8 8 0 0 0-1.43.83.5.5 0 0 1-.6-.8c.06-.045.121-.087.181-.13l-.97-.97a.5.5 0 0 0-.018-.018zm5.234.21A6.5 6.5 0 0 0 8 10c-.99 0-1.94.221-2.79.62l1.018 1.018A5.5 5.5 0 0 1 8 11c.21 0 .416.012.617.034zM4.776 4.069l8.156 8.156a.5.5 0 1 0 .708-.708L4.683 2.56a.5.5 0 0 0-.707.707zM8 13a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/></svg>
                </span>
                <div>
                    <h2 id="kmila-reconnect-title" data-rcn-i18n="title">Connection lost</h2>
                    <p class="kmila-reconnect__subtitle" data-rcn-i18n="subtitle">The link to the server was interrupted.</p>
                </div>
            </div>

            <div class="kmila-reconnect__body">
                <p class="kmila-reconnect__msg kmila-reconnect__msg--show" data-rcn-i18n="msgShow">
                    Trying to reconnect…
                </p>
                <p class="kmila-reconnect__msg kmila-reconnect__msg--failed" data-rcn-i18n="msgFailed">
                    We couldn't reconnect to the server. Reload the page to start a new session — your saved projects are intact.
                </p>
                <p class="kmila-reconnect__msg kmila-reconnect__msg--rejected" data-rcn-i18n="msgRejected">
                    Your session has expired. Reload the page to continue — your saved projects are intact.
                </p>

                <div class="kmila-reconnect__spinner" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>
            </div>

            <div class="kmila-reconnect__actions">
                <button type="button" id="components-reconnect-button" class="kmila-reconnect__btn kmila-reconnect__btn--primary" data-rcn-i18n="btnRetry">Try again</button>
                <button type="button" class="kmila-reconnect__btn kmila-reconnect__btn--ghost" onclick="location.reload()" data-rcn-i18n="btnReload">Reload page</button>
            </div>
        </div>
    </div>

    <script>
        // Reconnect-modal localizer. Server-renders English; this script swaps
        // text to the user's preferred language using the same key the rest of
        // the app persists (`kmila-lang` in localStorage). Ships a baked-in
        // dictionary because at reconnect time the SignalR circuit is dead and
        // Traductor / DbContext are unreachable.
        (function () {
            var STR = {
                en: { title: "Connection lost",                       subtitle: "The link to the server was interrupted.",                msgShow: "Trying to reconnect…",                                                                                       msgFailed: "We couldn't reconnect to the server. Reload the page to start a new session — your saved projects are intact.",                                  msgRejected: "Your session has expired. Reload the page to continue — your saved projects are intact.",                                  btnRetry: "Try again",      btnReload: "Reload page" },
                es: { title: "Conexión perdida",                      subtitle: "El enlace con el servidor se interrumpió.",              msgShow: "Intentando reconectar…",                                                                                     msgFailed: "No fue posible reconectar al servidor. Recarga la página para iniciar una nueva sesión — tus proyectos guardados están intactos.",                msgRejected: "Tu sesión ha expirado. Recarga la página para continuar — tus proyectos guardados están intactos.",                        btnRetry: "Reintentar",     btnReload: "Recargar página" },
                fr: { title: "Connexion perdue",                      subtitle: "Le lien avec le serveur a été interrompu.",              msgShow: "Tentative de reconnexion…",                                                                                  msgFailed: "Impossible de se reconnecter au serveur. Recharge la page pour démarrer une nouvelle session — tes projets enregistrés sont intacts.",            msgRejected: "Ta session a expiré. Recharge la page pour continuer — tes projets enregistrés sont intacts.",                             btnRetry: "Réessayer",      btnReload: "Recharger" },
                de: { title: "Verbindung verloren",                   subtitle: "Die Verbindung zum Server wurde unterbrochen.",          msgShow: "Verbindung wird wiederhergestellt…",                                                                         msgFailed: "Verbindung zum Server konnte nicht wiederhergestellt werden. Lade die Seite neu, um eine neue Sitzung zu starten — deine gespeicherten Projekte bleiben erhalten.", msgRejected: "Deine Sitzung ist abgelaufen. Lade die Seite neu — deine gespeicherten Projekte bleiben erhalten.",                         btnRetry: "Erneut versuchen", btnReload: "Seite neu laden" },
                ch: { title: "连接已断开",                              subtitle: "与服务器的连接被中断。",                                  msgShow: "正在尝试重新连接…",                                                                                          msgFailed: "无法重新连接到服务器。请重新加载页面以开启新会话 — 你已保存的项目不会丢失。",                                                                                                                                                                                                msgRejected: "会话已过期。请重新加载页面以继续 — 你已保存的项目不会丢失。",                                                                btnRetry: "重试",            btnReload: "重新加载页面" },
                jp: { title: "接続が切断されました",                       subtitle: "サーバーとの接続が中断されました。",                       msgShow: "再接続を試みています…",                                                                                       msgFailed: "サーバーへ再接続できませんでした。ページを再読み込みして新しいセッションを開始してください — 保存済みのプロジェクトはそのままです。",                                                                                                                                                                  msgRejected: "セッションの有効期限が切れました。ページを再読み込みしてください — 保存済みのプロジェクトはそのままです。",                                                                                                            btnRetry: "再試行",          btnReload: "ページを再読み込み" },
                ar: { title: "انقطع الاتصال",                            subtitle: "انقطع الرابط مع الخادم.",                                msgShow: "جارٍ محاولة إعادة الاتصال…",                                                                                  msgFailed: "تعذّر إعادة الاتصال بالخادم. أعِد تحميل الصفحة لبدء جلسة جديدة — مشروعاتك المحفوظة سليمة.",                                                                                                                                                                                                  msgRejected: "انتهت صلاحية جلستك. أعِد تحميل الصفحة للمتابعة — مشروعاتك المحفوظة سليمة.",                                                  btnRetry: "إعادة المحاولة",  btnReload: "إعادة تحميل الصفحة" }
            };
            var lang;
            try { lang = localStorage.getItem('kmila-lang') || 'en'; } catch (_) { lang = 'en'; }
            var dict = STR[lang] || STR.en;
            var modal = document.getElementById('components-reconnect-modal');
            if (!modal) return;
            modal.querySelectorAll('[data-rcn-i18n]').forEach(function (el) {
                var k = el.getAttribute('data-rcn-i18n');
                if (dict[k]) el.textContent = dict[k];
            });
            // Match the document's text direction so Arabic flips correctly even
            // when Blazor hasn't applied <html dir> yet.
            if (lang === 'ar') modal.setAttribute('dir', 'rtl');

            // Visibility sync. Some Blazor framework builds toggle the modal
            // both by adding a state class AND by writing `style.display`
            // inline; in that case a class-only CSS rule loses to the inline
            // style and the modal stays hidden on disconnect. Mirroring the
            // state class into style.display ourselves keeps visibility
            // correct regardless of which path the framework takes — and the
            // MutationObserver is cheap because the class attribute only
            // changes a handful of times across a session.
            var STATE_CLASSES = [
                'components-reconnect-show',
                'components-reconnect-failed',
                'components-reconnect-rejected'
            ];
            function syncVisibility() {
                var visible = STATE_CLASSES.some(function (c) {
                    return modal.classList.contains(c);
                });
                modal.style.display = visible ? 'flex' : 'none';
            }
            try {
                new MutationObserver(syncVisibility).observe(modal, {
                    attributes: true,
                    attributeFilter: ['class']
                });
            } catch (_) { /* MutationObserver missing — the class CSS still applies */ }
            syncVisibility();
        })();
    </script>

    <script src="_framework/blazor.web.js"></script>
</body>

