    <!-- Blockly — visual-programming engine for the /concepts exercises.
         Self-hosted so the Web build doesn't need a CDN. Load order matters:
           1. blockly_compressed.js — the core (defines Blockly.inject, FieldDropdown, Blocks, …).
           2. blocks_compressed.js  — standard block library.
           3. msg/en.js             — i18n strings for default labels/tooltips.
           4. concepts-blocks.js    — our custom block types + JS interop bridge.

         Loaded *before* BlazorMonaco on purpose. Monaco's loader.js installs an
         AMD `define()` global and triggers an async `require()` to bootstrap
         its editor modules; if we set `define = undefined` after Monaco has
         loaded (the previous shim approach), that async callback can fire
         inside the shim window and Monaco's lazy module load throws silently,
         leaving `monaco.editor.getEditors()` permanently empty. Loading
         Blockly first — when `define` doesn't exist yet — lets the Blockly
         UMD wrapper take its plain-browser branch (`root.Blockly = factory()`)
         without any interference, and Monaco then owns `define` for the rest
         of the page lifetime. See [[project_blockly_bundling_gotcha]] memory
         entry for the full history; previous "shim" approach is now retired. -->
    <script src="_content/Kmila.Shared/lib/blockly/blockly_compressed.js"></script>
    <script src="_content/Kmila.Shared/lib/blockly/blocks_compressed.js"></script>
    <script src="_content/Kmila.Shared/lib/blockly/en.js"></script>
    <script src="_content/Kmila.Shared/js/concepts-blocks.js"></script>

