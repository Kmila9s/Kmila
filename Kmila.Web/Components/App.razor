    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
    <!-- VHDL language support - must load after Monaco editor -->
    <!-- Doc-data files first, one per language (stubs for non-EN/ES fall back silently) -->
    <script src="_content/Kmila.Shared/js/vhdl-data/vhdl-data.en.js"></script>
    <script src="_content/Kmila.Shared/js/vhdl-data/vhdl-data.es.js"></script>
    <script src="_content/Kmila.Shared/js/vhdl-data/vhdl-data.fr.js"></script>
    <script src="_content/Kmila.Shared/js/vhdl-data/vhdl-data.de.js"></script>
    <script src="_content/Kmila.Shared/js/vhdl-data/vhdl-data.ch.js"></script>
    <script src="_content/Kmila.Shared/js/vhdl-data/vhdl-data.jp.js"></script>
    <script src="_content/Kmila.Shared/js/vhdl-data/vhdl-data.ar.js"></script>
