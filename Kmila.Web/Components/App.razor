    @* Mermaid diagrams — Markdown lessons with ```mermaid fenced blocks get
       rewritten to <pre class="mermaid"> which this script auto-initializes.
       kmilaMermaidRun is exposed so pages that render Markdown after the first
       paint (LessonView, etc.) can re-scan the DOM on navigation. *@
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
        const isDark = () => document.documentElement.getAttribute('data-bs-theme') === 'dark';
        mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: isDark() ? 'dark' : 'default' });
        window.kmilaMermaidRun = function () {
            try { mermaid.run({ querySelector: 'pre.mermaid' }); } catch (e) { console.warn('[mermaid]', e); }
        };
        // Re-theme on Bootstrap theme changes so dark-mode diagrams don't glow.
        new MutationObserver(() => {
            mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: isDark() ? 'dark' : 'default' });
            document.querySelectorAll('pre.mermaid').forEach(el => { el.removeAttribute('data-processed'); });
            window.kmilaMermaidRun();
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
        window.addEventListener('load', () => window.kmilaMermaidRun());
    </script>
