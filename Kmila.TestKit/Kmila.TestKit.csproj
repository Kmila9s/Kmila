<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test kit shared by SimulatorBench, PracticeValidator and the unit tests
       (multi-HDL Phase 0, v3.0.7): reference simulators, Kmila runners
       (in-process and HTTP), stimulus derivation and golden hashes. Never
       referenced by an app head, so it is not listed in the Dockerfiles. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Kmila.Shared/Kmila.Shared.csproj" />
  </ItemGroup>

</Project>
