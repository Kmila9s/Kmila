# Keep the repo-root build context lean. Paths are relative to the repo root
# (the compose/`docker build` context), matching App/Kmila/deploy/.dockerignore.
**/bin/
**/obj/
**/.git/
**/.vs/
**/.vscode/
**/.idea/
**/node_modules/
**/*.user

# Unity / 3D asset trees — not part of the .NET app, very large.
Modelos3D/
KmilaFactorySim/
Simulator/

# Local build outputs
**/publish/
