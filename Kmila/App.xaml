<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Kmila"
             x:Class="Kmila.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Brand-aligned defaults. PageBackgroundColor matches the splash
                 color in Kmila.csproj (MauiSplashScreen Color="#475569") so the
                 splash → WebView handoff is a same-color transition with no
                 flash. This value is what Mac Catalyst paints in the title-bar
                 strip and what every native MAUI surface uses as a fallback
                 before the BlazorWebView body renders. Keep in sync with the
                 kmila-primary token in Kmila.Shared/wwwroot/css/tokens.css. -->
            <Color x:Key="PageBackgroundColor">#475569</Color>
            <Color x:Key="PrimaryTextColor">White</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="BackgroundColor" Value="#334155" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>