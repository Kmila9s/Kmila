<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android35.0;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <!--<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>-->
    <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
    <!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

    <!-- Note for MacCatalyst:
      The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
      When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
      The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
      either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
    <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

    <OutputType>Exe</OutputType>
    <RootNamespace>Kmila</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1587;CS1591;CS1570;CS1573;CS1574;CS1998;CS8602;CS8604;CS8625;CS8892;CS0219;CS0618;CS4014;NETSDK1206</NoWarn>

    <!-- Display name -->
    <ApplicationTitle>Kmila</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>kmila</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!--<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>-->
  </PropertyGroup>

  <!-- Android-specific packaging for Google Play's 16 KB page-size requirement
       (mandatory for new releases targeting API 35+ since Nov 2025). Backwards
       compatible: 16 KB-aligned APKs run unchanged on 4 KB-page devices because
       16 is a multiple of 4 — devices < API 35 just ignore the extra padding.
       minSdk stays at 24, so installable device set is unchanged. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Force the packager to align .so entries on 16 KB ZIP-page boundaries. -->
    <AndroidZipAlignmentPages>16</AndroidZipAlignmentPages>
    <!-- Keep native libs uncompressed inside the APK so the loader can mmap
         them directly from the package. Requires API 23+ (we're at 24). -->
    <AndroidExtractNativeLibs>false</AndroidExtractNativeLibs>
    <!-- 64-bit ABIs only — 16 KB pages don't exist on 32-bit Android, and
         Play no longer requires armeabi-v7a / x86 for new submissions. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon - Kmila branding with dark slate blue -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#475569" ForegroundScale="0.65" />

    <!-- Splash Screen - Kmila branding -->
    <MauiSplashScreen Include="Resources\AppIcon\appiconfg.png" Color="#475569" BaseSize="256,256" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Include Devices from Shared project as raw assets -->
    <MauiAsset Include="..\Kmila.Shared\wwwroot\Devices\**\*.json" LogicalName="Devices\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Translation dictionaries: pulled from Kmila.Shared so the Web build
         and the MAUI bundle read the same file. Same LogicalName pattern as
         Devices/Learn/Practice so MauiProgram.cs's Traductor resolver finds
         them via FileSystem.OpenAppPackageFileAsync("Dictionaries/{lang}.json").
         Without this rule, the bundle ships no dictionaries and every UI
         string renders as its raw key (e.g. "NAV_LEARN" instead of "Learn"). -->
    <MauiAsset Include="..\Kmila.Shared\wwwroot\Dictionaries\**\*.json" LogicalName="Dictionaries\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Learn curriculum: manifest + per-language Markdown bodies. Same
         LogicalName pattern as Dictionaries so FileSystem.OpenAppPackageFileAsync
         can open them using the relative path (Learn/manifest.json, Learn/en/…). -->
    <MauiAsset Include="..\Kmila.Shared\wwwroot\Learn\**\*" LogicalName="Learn\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Practice catalog: manifest + per-exercise vhdl/json/md assets. Same
         LogicalName pattern so PracticeCatalog can open them via
         FileSystem.OpenAppPackageFileAsync ("Practice/manifest.json",
         "Practice/{folder}/solution.vhdl", etc). -->
    <MauiAsset Include="..\Kmila.Shared\wwwroot\Practice\**\*" LogicalName="Practice\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Concepts catalog: execution-models mini-curriculum. Manifest +
         per-language markdown bodies + per-language timeline JSON sidecars.
         Same LogicalName pattern so ConceptCatalog can open them via
         FileSystem.OpenAppPackageFileAsync ("Concepts/manifest.json",
         "Concepts/{lang}/{moduleId}/{lessonId}.md", etc). -->
    <MauiAsset Include="..\Kmila.Shared\wwwroot\Concepts\**\*" LogicalName="Concepts\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Project templates: gallery shown in ProjectsView's "+ New project"
         modal. Each template ships its own template.json + per-language
         file tree (Templates/{id}/{lang}/files/...). Same LogicalName
         pattern so ProjectTemplateService can open them via
         FileSystem.OpenAppPackageFileAsync. -->
    <MauiAsset Include="..\Kmila.Shared\wwwroot\Templates\**\*" LogicalName="Templates\%(RecursiveDir)%(Filename)%(Extension)" />

    <!-- Self-hosted JS libraries (currently: Blockly for /concepts/exercise/*).
         Without this glob the MAUI bundle won't ship blockly.min.js and the
         exercise editor breaks offline. The Web build picks these up
         automatically via the RCL static-web-assets pipeline. -->
    <MauiAsset Include="..\Kmila.Shared\wwwroot\lib\**\*" LogicalName="lib\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazor.Bootstrap" Version="3.4.0" />
    <PackageReference Include="BlazorMonaco" Version="3.3.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.5" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Kmila.Shared/Kmila.Shared.csproj" />
  </ItemGroup>

</Project>
