{
  "tests": [
    {
      "id": "t1",
      "visible": true,
      "descriptions": { "en": "Push four times — full asserts", "es": "Cuatro push — full sube" },
      "durationMicros": 2,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 25, "scale": "NS", "value": "0" }
        ]},
        { "portName": "push", "values": [{ "time": 0, "scale": "NS", "value": "1" }] },
        { "portName": "pop",  "values": [{ "time": 0, "scale": "NS", "value": "0" }] }
      ]
    },
    {
      "id": "t2",
      "visible": false,
      "descriptions": { "en": "Empty after reset", "es": "Vacío tras reset" },
      "durationMicros": 1,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0, "scale": "NS", "value": "1" }
        ]},
        { "portName": "push", "values": [{ "time": 0, "scale": "NS", "value": "0" }] },
        { "portName": "pop",  "values": [{ "time": 0, "scale": "NS", "value": "0" }] }
