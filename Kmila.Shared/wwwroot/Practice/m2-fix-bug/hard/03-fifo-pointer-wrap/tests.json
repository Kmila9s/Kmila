{
  "tests": [
    {
      "id": "t1",
      "visible": true,
      "descriptions": { "en": "Push 4, then push more — full must assert at 4", "es": "Push 4 y seguir empujando — full debe activarse en 4" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 25, "scale": "NS", "value": "0" }
        ]},
        { "portName": "push", "values": [
          { "time": 0,    "scale": "NS", "value": "0" },
          { "time": 50,   "scale": "NS", "value": "1" },
          { "time": 1500, "scale": "NS", "value": "0" }
        ]},
        { "portName": "pop", "values": [{ "time": 0, "scale": "NS", "value": "0" }] }
      ]
    },
    {
      "id": "t2",
      "visible": false,
      "descriptions": { "en": "Empty after reset", "es": "Vacío tras reset" },
      "durationMicros": 2,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 25, "scale": "NS", "value": "0" }
        ]},
        { "portName": "push", "values": [{ "time": 0, "scale": "NS", "value": "0" }] },
        { "portName": "pop",  "values": [{ "time": 0, "scale": "NS", "value": "0" }] }
      ]
    },
    {
      "id": "t3",
      "visible": false,
      "descriptions": { "en": "Push then pop equally — empty again", "es": "Push y pop igual — vuelve a vacío" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 25, "scale": "NS", "value": "0" }
        ]},
        { "portName": "push", "values": [
          { "time": 50,  "scale": "NS", "value": "1" },
          { "time": 130, "scale": "NS", "value": "0" }
        ]},
        { "portName": "pop", "values": [
          { "time": 200, "scale": "NS", "value": "1" },
          { "time": 280, "scale": "NS", "value": "0" }
        ]}
      ]
    },
    {
      "id": "t4",
      "visible": false,
      "descriptions": { "en": "Wrap pointers: push 4, pop 4, push 4 — full again at 4", "es": "Vuelta de punteros: push 4, pop 4, push 4 — full otra vez en 4" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 25, "scale": "NS", "value": "0" }
        ]},
        { "portName": "push", "values": [
          { "time": 50,   "scale": "NS", "value": "1" },
          { "time": 130,  "scale": "NS", "value": "0" },
          { "time": 1000, "scale": "NS", "value": "1" },
          { "time": 1080, "scale": "NS", "value": "0" }
        ]},
        { "portName": "pop", "values": [
          { "time": 500, "scale": "NS", "value": "1" },
          { "time": 580, "scale": "NS", "value": "0" }
        ]}
      ]
    },
    {
      "id": "t5",
      "visible": false,
      "descriptions": { "en": "Reset asserted while pushing", "es": "Reset durante una operación de push" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,    "scale": "NS", "value": "1" },
          { "time": 25,   "scale": "NS", "value": "0" },
          { "time": 800,  "scale": "NS", "value": "1" },
          { "time": 825,  "scale": "NS", "value": "0" }
        ]},
        { "portName": "push", "values": [
          { "time": 50, "scale": "NS", "value": "1" }
        ]},
        { "portName": "pop", "values": [{ "time": 0, "scale": "NS", "value": "0" }] }
      ]
    }
  ]
}
