{
  "tests": [
    {
      "id": "t1",
      "visible": true,
      "descriptions": { "en": "Free-run after reset — sequence diverges from buggy taps", "es": "Ejecución libre tras reset — la secuencia diverge con taps mal puestos" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 25, "scale": "NS", "value": "0" }
        ]}
      ]
    },
    {
      "id": "t2",
      "visible": false,
      "descriptions": { "en": "Held in reset — q stays 00000001", "es": "Reset mantenido — q queda 00000001" },
      "durationMicros": 2,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [{ "time": 0, "scale": "NS", "value": "1" }] }
      ]
    },
    {
      "id": "t3",
      "visible": false,
      "descriptions": { "en": "Reset pulse mid-run resets the seed", "es": "Pulso de reset reinicia la semilla" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,    "scale": "NS", "value": "1" },
          { "time": 25,   "scale": "NS", "value": "0" },
          { "time": 1000, "scale": "NS", "value": "1" },
          { "time": 1025, "scale": "NS", "value": "0" }
        ]}
      ]
    },
    {
      "id": "t4",
      "visible": false,
      "descriptions": { "en": "Long free-run — many distinct states must appear", "es": "Ejecución larga — deben aparecer muchos estados distintos" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 25, "scale": "NS", "value": "0" }
        ]}
      ]
    },
    {
      "id": "t5",
      "visible": false,
      "descriptions": { "en": "Short reset window then free-run", "es": "Ventana corta de reset y luego ejecución libre" },
      "durationMicros": 3,
      "systemClockMhz": 50,
      "inputs": [
        { "portName": "reset", "values": [
          { "time": 0,  "scale": "NS", "value": "1" },
          { "time": 40, "scale": "NS", "value": "0" }
        ]}
      ]
    }
  ]
}
