@*
    MarkdownModal Component

    A beautiful modal component for displaying markdown files with enhanced styling,
    loading states, and error handling. Features a clean card-based design with
    a header showing file information and a scrollable content area.

    Features:
    - Card-based design with header and body sections
    - Loading spinner while content is being fetched
    - Error state handling with alert message
    - Scrollable content area with custom height
    - File name and project context in header
    - Refresh button to reload content
    - Empty state handling

    Usage:
    <MarkdownModal File="@projectFile" />

    Dependencies:
    - ProjectFiles repository (injected)
    - BlazorBootstrap Markdown, Card, Icon, Badge, Button, Spinner, Alert components
*@

<Card Class="markdown-modal-card shadow-sm">
    <CardHeader Class="bg-light">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <Icon Name="IconName.FileEarmarkText" Class="text-primary fs-5" />
                <div>
                    <strong class="fs-6">@(File?.FileName ?? "Markdown Viewer")</strong>
                    @if(File?.Project != null)
                    {
                        <br/>
                        <small class="text-muted">
                            <Icon Name="IconName.Folder2" Class="me-1" />
                            @File.Project.Name
                        </small>
                    }
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if(!_isLoading && !_hasError)
                {
                    <Badge Color="BadgeColor.Success" Pill="true">
                        <Icon Name="IconName.CheckCircle" Class="me-1" />
                        Loaded
                    </Badge>
                }
                <Button Color="ButtonColor.Light"
                        Size="ButtonSize.Small"
                        Outline="true"
                        @onclick="RefreshContentAsync"
                        Disabled="_isLoading"
                        TooltipTitle="Refresh content">
                    <Icon Name="IconName.ArrowClockwise" />
                </Button>
            </div>
        </div>
    </CardHeader>
    <CardBody Class="p-0">
        @if(_isLoading)
        {
            <!-- Loading State -->
            <div class="d-flex flex-column justify-content-center align-items-center py-5">
                <Spinner Type="SpinnerType.Border" Color="SpinnerColor.Primary" Class="mb-3" />
                <span class="text-muted">Loading markdown content...</span>
            </div>
        }
        else if(_hasError)
        {
            <!-- Error State -->
            <div class="p-3">
                <Alert Color="AlertColor.Danger" Dismissible="false">
                    <div class="d-flex align-items-center">
                        <Icon Name="IconName.ExclamationTriangleFill" Class="me-2 fs-5" />
                        <div>
                            <strong>Error loading content</strong>
                            <p class="mb-0 mt-1 small">@_errorMessage</p>
                        </div>
                    </div>
                </Alert>
                <div class="text-center mt-3">
                    <Button Color="ButtonColor.Primary"
                            Size="ButtonSize.Small"
                            @onclick="RefreshContentAsync">
                        <Icon Name="IconName.ArrowClockwise" Class="me-1" />
                        Try Again
                    </Button>
                </div>
            </div>
        }
        else if(string.IsNullOrWhiteSpace(_markdown))
        {
            <!-- Empty State -->
            <div class="d-flex flex-column justify-content-center align-items-center py-5 text-muted">
                <Icon Name="IconName.FileEarmark" Class="fs-1 mb-2 opacity-50" />
                <span>No content available</span>
                <small>This file appears to be empty</small>
            </div>
        }
        else
        {
            <!-- Content Display -->
            <div class="markdown-content-wrapper">
                <Markdown Class="markdown-content p-3">@_markdown</Markdown>
            </div>
        }
    </CardBody>
</Card>

<style>
    .markdown-modal-card {
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .markdown-content-wrapper {
        max-height: 60dvh; /* Viewport-relative for mobile compatibility */
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Small mobile screens */
    @@media (max-width: 576px) {
        .markdown-content-wrapper {
            max-height: 50dvh;
        }
    }

    .markdown-content {
        line-height: 1.7;
    }

    /* Markdown content styling */
    .markdown-content h1,
    .markdown-content h2,
    .markdown-content h3,
    .markdown-content h4,
    .markdown-content h5,
    .markdown-content h6 {
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        font-weight: 600;
        color: var(--bs-dark);
    }

    .markdown-content h1 {
        font-size: 1.75rem;
        border-bottom: 2px solid var(--bs-primary);
        padding-bottom: 0.5rem;
    }

    .markdown-content h2 {
        font-size: 1.5rem;
        border-bottom: 1px solid var(--bs-border-color);
        padding-bottom: 0.3rem;
    }

    .markdown-content h3 {
        font-size: 1.25rem;
    }

    .markdown-content p {
        margin-bottom: 1rem;
    }

    .markdown-content code {
        background-color: rgba(var(--bs-primary-rgb), 0.1);
        padding: 0.2em 0.4em;
        border-radius: 0.25rem;
        font-size: 0.875em;
        color: var(--bs-primary);
    }

    .markdown-content pre {
        background-color: #1e1e1e;
        color: #d4d4d4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1rem 0;
    }

    .markdown-content pre code {
        background-color: transparent;
        padding: 0;
        color: inherit;
        font-size: 0.85rem;
    }

    .markdown-content blockquote {
        border-left: 4px solid var(--bs-primary);
        padding-left: 1rem;
        margin: 1rem 0;
        color: var(--bs-secondary);
        font-style: italic;
    }

    .markdown-content ul,
    .markdown-content ol {
        margin-bottom: 1rem;
        padding-left: 2rem;
    }

    .markdown-content li {
        margin-bottom: 0.5rem;
    }

    .markdown-content table {
        width: 100%;
        margin: 1rem 0;
        border-collapse: collapse;
    }

    .markdown-content th,
    .markdown-content td {
        border: 1px solid var(--bs-border-color);
        padding: 0.5rem 0.75rem;
        text-align: left;
    }

    .markdown-content th {
        background-color: var(--bs-light);
        font-weight: 600;
    }

    .markdown-content tr:nth-child(even) {
        background-color: rgba(var(--bs-light-rgb), 0.5);
    }

    .markdown-content a {
        color: var(--bs-primary);
        text-decoration: none;
    }

    .markdown-content a:hover {
        text-decoration: underline;
    }

    .markdown-content img {
        max-width: 100%;
        height: auto;
        border-radius: 0.5rem;
        margin: 1rem 0;
    }

    .markdown-content hr {
        border: none;
        border-top: 1px solid var(--bs-border-color);
        margin: 1.5rem 0;
    }

    /* Custom scrollbar for the content area */
    .markdown-content-wrapper::-webkit-scrollbar {
        width: 8px;
    }

    .markdown-content-wrapper::-webkit-scrollbar-track {
        background: var(--bs-light);
        border-radius: 4px;
    }

    .markdown-content-wrapper::-webkit-scrollbar-thumb {
        background: var(--bs-secondary);
        border-radius: 4px;
    }

    .markdown-content-wrapper::-webkit-scrollbar-thumb:hover {
        background: var(--bs-primary);
    }
</style>

@code{
    #region Parameters

    /// <summary>
    /// The project file containing the markdown content to display.
    /// When this parameter changes, the component automatically reloads the content.
    /// </summary>
    [Parameter]
    public ProjectFile File { get; set; } = default!;

    #endregion

    #region Private Fields

    /// <summary>
    /// The loaded project file with its content.
    /// </summary>
    private ProjectFile _file = default!;

    /// <summary>
    /// The markdown content string to render.
    /// </summary>
    private string _markdown = string.Empty;

    /// <summary>
    /// Indicates whether content is currently being loaded.
    /// </summary>
    private bool _isLoading = true;

    /// <summary>
    /// Indicates whether an error occurred during content loading.
    /// </summary>
    private bool _hasError = false;

    /// <summary>
    /// The error message to display when loading fails.
    /// </summary>
    private string _errorMessage = string.Empty;

    #endregion

    #region Lifecycle Methods

    /// <summary>
    /// Called when the component parameters are set or changed.
    /// Loads the markdown content from the file asynchronously.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await LoadContentAsync();
    }

    #endregion

    #region Private Methods

    /// <summary>
    /// Loads the markdown content from the specified file.
    /// Handles loading states and error conditions.
    /// </summary>
    private async Task LoadContentAsync()
    {
        if (File == null)
        {
            _isLoading = false;
            _hasError = true;
            _errorMessage = "No file specified";
            return;
        }

        try
        {
            _isLoading = true;
            _hasError = false;
            _errorMessage = string.Empty;
            StateHasChanged();

            _file = await ProjectFiles.ReadFileContentAsync(File, File.Project);
            _markdown = _file?.Content ?? string.Empty;
        }
        catch (Exception ex)
        {
            _hasError = true;
            _errorMessage = $"Failed to load file: {ex.Message}";
            _markdown = string.Empty;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Refreshes the markdown content by reloading from the file.
    /// Called when the user clicks the refresh button.
    /// </summary>
    private async Task RefreshContentAsync()
    {
        await LoadContentAsync();
    }

    #endregion
}