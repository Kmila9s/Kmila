@implements IDisposable
<PageTitle>Simulation Parameters</PageTitle>

<!-- Mobile-friendly Tab Navigation -->
<Tabs @ref="_tabs" EnableFadeEffect="true" NavStyle="NavStyle.Pills" Class="simulation-tabs mb-3" OnShowing="OnTabChangingAsync">
    <!-- Tab 1: FPGA & Resources -->
    <Tab Title="FPGA" Name="fpga-tab" IsActive="true">
        <Content>
            <div class="tab-content-wrapper p-2 p-md-3">
                <!-- FPGA Selector Fallback (when no FPGA is selected in TopBar) -->
                @if(SelectedFPGA?.FPGA == null)
                {
                    <Card Class="mb-3 border-warning">
                        <CardHeader Class="py-2 py-md-3 bg-warning bg-opacity-10">
                            <Icon Name="IconName.ExclamationTriangle" Class="me-2 text-warning" />
                            <strong>Select FPGA Device</strong>
                        </CardHeader>
                        <CardBody Class="p-2 p-md-3">
                            <p class="text-muted small mb-3">
                                No FPGA device is currently selected. Choose a device to view specifications and run simulations.
                            </p>
                            <div class="row g-2">
                                <div class="col-12 col-md-8">
                                    <select class="form-select form-select-sm" @onchange="OnFPGASelected" value="@_selectedFPGAPath">
                                        <option value="">-- Select FPGA Device --</option>
                                        @foreach(var fpga in _availableFPGAs)
                                        {
                                            <option value="@fpga">@System.IO.Path.GetFileNameWithoutExtension(fpga)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-md-4">
                                    <Button Color="ButtonColor.Primary"
                                            Size="ButtonSize.Small"
                                            Outline="true"
                                            Disabled="@(string.IsNullOrEmpty(_selectedFPGAPath))"
                                            @onclick="ApplySelectedFPGAAsync"
                                            Class="w-100">
                                        <Icon Name="IconName.CheckCircle" Class="me-1" />
                                        Apply
                                    </Button>
                                </div>
                            </div>
                        </CardBody>
                    </Card>
                }

                <!-- FPGA Information Section -->
                <Card Class="mb-3">
                    <CardHeader Class="py-2 py-md-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <Icon Name="IconName.Cpu" Class="me-2" />
                                <strong>FPGA Details</strong>
                            </div>
                            @if(SelectedFPGA?.FPGA != null)
                            {
                                <!-- Quick FPGA Change Dropdown -->
                                <Dropdown Color="DropdownColor.Secondary" Size="DropdownSize.Small">
                                    <DropdownToggleButton>
                                        <Icon Name="IconName.ArrowRepeat" Class="me-1" />
                                        Change
                                    </DropdownToggleButton>
                                    <DropdownMenu>
                                        @foreach(var fpga in _availableFPGAs)
                                        {
                                            var fpgaItem = fpga;
                                            <DropdownItem Type="DropdownItemType.Button"
                                                          @onclick="() => QuickChangeFPGAAsync(fpgaItem)"
                                                          Active="@(_selectedFPGAPath == fpgaItem)">
                                                @System.IO.Path.GetFileNameWithoutExtension(fpgaItem)
                                            </DropdownItem>
                                        }
                                    </DropdownMenu>
                                </Dropdown>
                            }
                        </div>
                    </CardHeader>
                    <CardBody Class="p-2 p-md-3">
                        @if(SelectedFPGA?.FPGA != null)
                        {
                            <div class="row g-2 g-md-3">
                                <!-- FPGA Basic Info -->
                                <div class="col-12">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                                        <div>
                                            <h5 class="mb-0 fs-6 fs-md-5">@SelectedFPGA.FPGA.Model</h5>
                                            <small class="text-muted">@SelectedFPGA.FPGA.Family</small>
                                        </div>
                                        <Badge Color="BadgeColor.Primary">@SelectedFPGA.FPGA.Manufacturer</Badge>
                                    </div>
                                </div>

                                <!-- FPGA Resources Grid - 2 columns on mobile, 4 on desktop -->
                                @if(SelectedFPGA.FPGA.Resources != null)
                                {
                                    <div class="col-6 col-md-6 col-lg-3">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.Cpu" Class="me-1 me-md-2" />
                                                <strong class="small">Logic Units</strong>
                                            </div>
                                            <div class="text-muted small text-truncate">
                                                @SelectedFPGA.FPGA.Resources.LogicUnits?.ToString("N0") @SelectedFPGA.FPGA.Resources.LogicUnitsType
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-6 col-lg-3">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.Memory" Class="me-1 me-md-2" />
                                                <strong class="small">Memory</strong>
                                            </div>
                                            <div class="text-muted small text-truncate">
                                                @SelectedFPGA.FPGA.Resources.MemoryTotalKbits?.ToString("N0") Kbits
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-6 col-lg-3">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.ToggleOn" Class="me-1 me-md-2" />
                                                <strong class="small">Flip-Flops</strong>
                                            </div>
                                            <div class="text-muted small text-truncate">
                                                @SelectedFPGA.FPGA.Resources.RegistersFlipFlops?.ToString("N0") FF
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-6 col-lg-3">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.Calculator" Class="me-1 me-md-2" />
                                                <strong class="small">DSP Slices</strong>
                                            </div>
                                            <div class="text-muted small text-truncate">
                                                @SelectedFPGA.FPGA.Resources.DspSlices @SelectedFPGA.FPGA.Resources.DspSliceType
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Clocking Info -->
                                @if(SelectedFPGA.FPGA.Clocking != null)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.Clock" Class="me-1 me-md-2" />
                                                <strong class="small">Max Clock</strong>
                                            </div>
                                            <div class="text-muted small">
                                                @SelectedFPGA.FPGA.Clocking.MaxPllOutputMhz MHz
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.Diagram3" Class="me-1 me-md-2" />
                                                <strong class="small">Clock Res.</strong>
                                            </div>
                                            <div class="text-muted small">
                                                @SelectedFPGA.FPGA.Clocking.PllCount PLL / @SelectedFPGA.FPGA.Clocking.DcmMmcmCount DCM
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- I/O Info -->
                                @if(SelectedFPGA.FPGA.IO != null)
                                {
                                    <div class="col-6 col-md-4">
                                        <div class="border rounded p-2 h-100">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.Plugin" Class="me-1 me-md-2" />
                                                <strong class="small">I/O Pins</strong>
                                            </div>
                                            <div class="text-muted small">
                                                @SelectedFPGA.FPGA.IO.MaxUserIO (@SelectedFPGA.FPGA.IO.IoBanksCount banks)
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Power Info -->
                                @if(SelectedFPGA.FPGA.Power != null)
                                {
                                    <div class="col-6 col-md-12">
                                        <div class="border rounded p-2">
                                            <div class="d-flex align-items-center mb-1">
                                                <Icon Name="IconName.Lightning" Class="me-1 me-md-2" />
                                                <strong class="small">Core Voltage</strong>
                                            </div>
                                            <div class="text-muted small">
                                                @SelectedFPGA.FPGA.Power.CoreVoltageVccintV V (VCCINT)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <Alert Color="AlertColor.Warning">
                                <Icon Name="IconName.ExclamationTriangle" Class="me-2" />
                                No FPGA selected. Please select an FPGA to view its specifications.
                            </Alert>
                        }
                    </CardBody>
                </Card>

                <!-- Resource Usage Analysis -->
                @if(SelectedFPGA?.FPGA != null && Builder.Parser.Entities.Any())
                {
                    <Card Class="mb-3">
                        <CardHeader Class="py-2 py-md-3">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                                <div>
                                    <Icon Name="IconName.Speedometer" Class="me-2" />
                                    <strong>Resource Utilization</strong>
                                </div>
                                @if(_resourcesExceeded)
                                {
                                    <Badge Color="BadgeColor.Danger" Pill="true">
                                        <Icon Name="IconName.ExclamationTriangleFill" Class="me-1" />
                                        Exceeded
                                    </Badge>
                                }
                                else if(_resourcesNearLimit)
                                {
                                    <Badge Color="BadgeColor.Warning" Pill="true">
                                        <Icon Name="IconName.ExclamationTriangle" Class="me-1" />
                                        Near Limit
                                    </Badge>
                                }
                                else
                                {
                                    <Badge Color="BadgeColor.Success" Pill="true">
                                        <Icon Name="IconName.CheckCircle" Class="me-1" />
                                        OK
                                    </Badge>
                                }
                            </div>
                        </CardHeader>
                        <CardBody Class="p-2 p-md-3">
                            @if(_resourcesExceeded)
                            {
                                <Alert Color="AlertColor.Danger" Class="mb-3 small">
                                    <Icon Name="IconName.ExclamationTriangleFill" Class="me-2" />
                                    <strong>Cannot start!</strong> Design exceeds FPGA resources.
                                </Alert>
                            }
                            else if(_resourcesNearLimit)
                            {
                                <Alert Color="AlertColor.Warning" Class="mb-3 small">
                                    <Icon Name="IconName.ExclamationTriangle" Class="me-2" />
                                    <strong>Warning:</strong> Near FPGA limits.
                                </Alert>
                            }

                            <div class="row g-2">
                                <!-- Flip-Flops Progress -->
                                @if(SelectedFPGA.FPGA.Resources?.RegistersFlipFlops != null && SelectedFPGA.FPGA.Resources.RegistersFlipFlops > 0)
                                {
                                    <div class="col-12">
                                        @{
                                            var ffUsed = CalculateTotalFlipFlops();
                                            var ffAvailable = SelectedFPGA.FPGA.Resources.RegistersFlipFlops.Value;
                                            var ffPercent = GetResourcePercentage(ffUsed, ffAvailable);
                                            var ffColor = GetProgressColor(ffPercent);
                                        }
                                        <div class="mb-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-1 gap-1">
                                                <strong class="small">
                                                    <Icon Name="IconName.ToggleOn" Class="me-1" />
                                                    Flip-Flops
                                                </strong>
                                                <span class="font-monospace small">
                                                    <Badge Color="@GetBadgeColorFromProgress(ffColor)" Class="py-0 px-1">
                                                        @ffUsed.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted">/</span>
                                                    <Badge Color="BadgeColor.Secondary" Class="py-0 px-1">
                                                        @ffAvailable.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted ms-1 d-none d-sm-inline">(@ffPercent.ToString("F1")%)</span>
                                                </span>
                                            </div>
                                            <Progress>
                                                <ProgressBar Color="@ffColor" Width="@ffPercent" Type="@(ffPercent >= 80 ? ProgressType.Striped : ProgressType.Default)" />
                                            </Progress>
                                        </div>
                                    </div>
                                }

                                <!-- LUTs Progress -->
                                @if(SelectedFPGA.FPGA.Resources?.LogicUnits != null && SelectedFPGA.FPGA.Resources.LogicUnits > 0)
                                {
                                    <div class="col-12">
                                        @{
                                            var lutUsed = CalculateTotalLUTs();
                                            var lutAvailable = SelectedFPGA.FPGA.Resources.LogicUnits.Value;
                                            var lutPercent = GetResourcePercentage(lutUsed, lutAvailable);
                                            var lutColor = GetProgressColor(lutPercent);
                                        }
                                        <div class="mb-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-1 gap-1">
                                                <strong class="small">
                                                    <Icon Name="IconName.Grid" Class="me-1" />
                                                    @SelectedFPGA.FPGA.Resources.LogicUnitsType
                                                </strong>
                                                <span class="font-monospace small">
                                                    <Badge Color="@GetBadgeColorFromProgress(lutColor)" Class="py-0 px-1">
                                                        @lutUsed.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted">/</span>
                                                    <Badge Color="BadgeColor.Secondary" Class="py-0 px-1">
                                                        @lutAvailable.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted ms-1 d-none d-sm-inline">(@lutPercent.ToString("F1")%)</span>
                                                </span>
                                            </div>
                                            <Progress>
                                                <ProgressBar Color="@lutColor" Width="@lutPercent" Type="@(lutPercent >= 80 ? ProgressType.Striped : ProgressType.Default)" />
                                            </Progress>
                                        </div>
                                    </div>
                                }

                                <!-- DSP Slices Progress -->
                                @if(SelectedFPGA.FPGA.Resources?.DspSlices != null && SelectedFPGA.FPGA.Resources.DspSlices > 0)
                                {
                                    <div class="col-12">
                                        @{
                                            var dspUsed = CalculateTotalDSPSlices();
                                            var dspAvailable = SelectedFPGA.FPGA.Resources.DspSlices.Value;
                                            var dspPercent = GetResourcePercentage(dspUsed, dspAvailable);
                                            var dspColor = GetProgressColor(dspPercent);
                                        }
                                        <div class="mb-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-1 gap-1">
                                                <strong class="small">
                                                    <Icon Name="IconName.Calculator" Class="me-1" />
                                                    DSP Slices
                                                </strong>
                                                <span class="font-monospace small">
                                                    <Badge Color="@GetBadgeColorFromProgress(dspColor)" Class="py-0 px-1">
                                                        @dspUsed.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted">/</span>
                                                    <Badge Color="BadgeColor.Secondary" Class="py-0 px-1">
                                                        @dspAvailable.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted ms-1 d-none d-sm-inline">(@dspPercent.ToString("F1")%)</span>
                                                </span>
                                            </div>
                                            <Progress>
                                                <ProgressBar Color="@dspColor" Width="@dspPercent" Type="@(dspPercent >= 80 ? ProgressType.Striped : ProgressType.Default)" />
                                            </Progress>
                                        </div>
                                    </div>
                                }

                                <!-- BRAM Blocks Progress -->
                                @if(SelectedFPGA.FPGA.Resources?.MemoryBlocks != null && SelectedFPGA.FPGA.Resources.MemoryBlocks > 0)
                                {
                                    <div class="col-12">
                                        @{
                                            var bramUsed = CalculateTotalBRAMBlocks();
                                            var bramAvailable = SelectedFPGA.FPGA.Resources.MemoryBlocks.Value;
                                            var bramPercent = GetResourcePercentage(bramUsed, bramAvailable);
                                            var bramColor = GetProgressColor(bramPercent);
                                        }
                                        <div class="mb-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-1 gap-1">
                                                <strong class="small">
                                                    <Icon Name="IconName.Memory" Class="me-1" />
                                                    BRAM
                                                </strong>
                                                <span class="font-monospace small">
                                                    <Badge Color="@GetBadgeColorFromProgress(bramColor)" Class="py-0 px-1">
                                                        @bramUsed.ToString("F1")
                                                    </Badge>
                                                    <span class="text-muted">/</span>
                                                    <Badge Color="BadgeColor.Secondary" Class="py-0 px-1">
                                                        @bramAvailable.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted ms-1 d-none d-sm-inline">(@bramPercent.ToString("F1")%)</span>
                                                </span>
                                            </div>
                                            <Progress>
                                                <ProgressBar Color="@bramColor" Width="@bramPercent" Type="@(bramPercent >= 80 ? ProgressType.Striped : ProgressType.Default)" />
                                            </Progress>
                                        </div>
                                    </div>
                                }

                                <!-- I/O Pins Progress -->
                                @if(SelectedFPGA.FPGA.IO?.MaxUserIO != null && SelectedFPGA.FPGA.IO.MaxUserIO > 0)
                                {
                                    <div class="col-12">
                                        @{
                                            var ioUsed = CalculateTotalIOPins();
                                            var ioAvailable = SelectedFPGA.FPGA.IO.MaxUserIO.Value;
                                            var ioPercent = GetResourcePercentage(ioUsed, ioAvailable);
                                            var ioColor = GetProgressColor(ioPercent);
                                        }
                                        <div class="mb-2">
                                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-1 gap-1">
                                                <strong class="small">
                                                    <Icon Name="IconName.Plugin" Class="me-1" />
                                                    I/O Pins
                                                </strong>
                                                <span class="font-monospace small">
                                                    <Badge Color="@GetBadgeColorFromProgress(ioColor)" Class="py-0 px-1">
                                                        @ioUsed.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted">/</span>
                                                    <Badge Color="BadgeColor.Secondary" Class="py-0 px-1">
                                                        @ioAvailable.ToString("N0")
                                                    </Badge>
                                                    <span class="text-muted ms-1 d-none d-sm-inline">(@ioPercent.ToString("F1")%)</span>
                                                </span>
                                            </div>
                                            <Progress>
                                                <ProgressBar Color="@ioColor" Width="@ioPercent" Type="@(ioPercent >= 80 ? ProgressType.Striped : ProgressType.Default)" />
                                            </Progress>
                                        </div>
                                    </div>
                                }
                            </div>
                        </CardBody>
                    </Card>
                }
            </div>
        </Content>
    </Tab>

    <!-- Tab 2: Configuration -->
    <Tab Title="Config" Name="config-tab">
        <Content>
            <div class="tab-content-wrapper p-2 p-md-3">
                <!-- Simulation Time Configuration -->
                <Card Class="mb-3">
                    <CardHeader Class="py-2 py-md-3">
                        <Icon Name="IconName.Clock" Class="me-2" />
                        <strong>Time Configuration</strong>
                    </CardHeader>
                    <CardBody Class="p-2 p-md-3">
                        <!-- Time Input with Dropdown -->
                        <div class="input-group input-group-sm input-group-md-lg mb-3">
                            <span class="input-group-text">
                                <Icon Name="IconName.HourglassSplit" />
                            </span>
                            <input type="number"
                                   class="form-control"
                                   aria-label="Simulation time value"
                                   @bind="_time"
                                   min=0
                                   max=1000
                                   disabled=@(_running)
                                   placeholder="Enter time"/>
                            <button class="btn btn-outline-secondary dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    disabled=@_running>
                                <span class="d-none d-sm-inline">Time scale: </span>@_zone
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @foreach(var zone in Enum.GetValues(typeof(TimeScale)))
                                {
                                    <li><a class="dropdown-item" @onclick="() => SetZone((TimeScale)zone)">@Enum.GetName(typeof(TimeScale), zone)</a></li>
                                }
                            </ul>
                        </div>

                        <!-- Enhanced Range Slider -->
                        <EnhancedRangeSlider
                            Label="Simulation Duration"
                            IconName="IconName.HourglassSplit"
                            @bind-Value="_time"
                            Min="0"
                            Max="1000"
                            Step="1"
                            Unit="@_zone.ToString()"
                            Disabled="_running"
                            ShowBadge="true"
                            ShowMinMaxLabels="true"
                            ShowValueIndicator="true"
                            ShowCustomLabels="true"
                            TickMarks="_timeTickMarks"
                            CustomLabels="_customLabels"
                            HelpText="Adjust the simulation time duration"
                            BadgeColorMode="Custom"
                            BadgeIconName="IconName.Speedometer2"
                            BadgeAriaLabel="Current simulation time"
                            CustomColorThresholds="_colorThresholds"
                        />
                    </CardBody>
                </Card>

                <!-- Port Variables Input Section -->
                @if(!_running && Builder.Parser.Entities.Any())
                {
                    <Card Class="mb-3">
                        <CardHeader Class="py-2 py-md-3">
                            <Icon Name="IconName.Plugin" Class="me-2" />
                            <strong>Input Port Variables</strong>
                        </CardHeader>
                        <CardBody Class="p-2 p-md-3">
                            <div class="row g-2 g-md-3">
                                @foreach(var entity in Builder.Parser.Entities)
                                {
                                    @foreach(var variable in entity.Ports.Where(p => p.PortType == PortType.IN))
                                    {
                                        <div class="col-12">
                                            <PortMomentInput
                                                Variable=variable
                                                LimitTime=_time
                                                TimeScale=_zone
                                                IsRunning=_running
                                            />
                                        </div>
                                    }
                                }
                            </div>
                        </CardBody>
                    </Card>
                }

                <!-- Configuration Save/Load Section -->
                <Card Class="mb-3">
                    <CardHeader Class="py-2 py-md-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <Icon Name="IconName.GearFill" Class="me-1" />
                                <strong>Configurations</strong>
                                @if(!string.IsNullOrEmpty(_loadedConfigName))
                                {
                                    <Badge Color="BadgeColor.Info" Class="ms-1">
                                        @_loadedConfigName
                                        @if(_hasUnsavedConfigChanges)
                                        {
                                            <span class="text-warning">*</span>
                                        }
                                    </Badge>
                                }
                            </div>
                            <Button Color="ButtonColor.Secondary"
                                    Size="ButtonSize.ExtraSmall"
                                    Outline="true"
                                    @onclick="() => _showConfigPanel = !_showConfigPanel">
                                <Icon Name="@(_showConfigPanel ? IconName.ChevronUp : IconName.ChevronDown)" />
                            </Button>
                        </div>
                    </CardHeader>
                    @if(_showConfigPanel)
                    {
                        <CardBody Class="p-2 p-md-3">
                            <ConfigurationModal
                                OnConfigurationLoaded="OnConfigurationLoadedAsync"
                                CurrentFPGA="SelectedFPGA?.FPGA"
                                CurrentFPGAPath="@_selectedFPGAPath"
                                CurrentTimeValue="_time"
                                CurrentTimeScale="@_zone.ToString()"
                                CurrentPortMoments="_currentPortMoments"
                            />
                        </CardBody>
                    }
                </Card>
            </div>
        </Content>
    </Tab>

    <!-- Tab 3: Run Simulation -->
    <Tab Title="Run" Name="run-tab">
        <Content>
            <div class="tab-content-wrapper p-2 p-md-3">
                <form @onsubmit="OnFormSubmited">
                    <!-- Control Buttons Card -->
                    <Card Class="mb-3">
                        <CardHeader Class="py-2 py-md-3">
                            <Icon Name="IconName.PlayCircle" Class="me-2" />
                            <strong>Simulation Controls</strong>
                        </CardHeader>
                        <CardBody Class="p-2 p-md-3">
                            <!-- Quick Status Summary -->
                            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 small">
                                <span>
                                    <Icon Name="IconName.Clock" Class="me-1" />
                                    <strong>Duration:</strong> @_time @_zone
                                </span>
                                @if(_resourcesExceeded)
                                {
                                    <Badge Color="BadgeColor.Danger">
                                        <Icon Name="IconName.ExclamationTriangleFill" Class="me-1" />
                                        Resources Exceeded
                                    </Badge>
                                }
                                else if(_resourcesNearLimit)
                                {
                                    <Badge Color="BadgeColor.Warning">
                                        <Icon Name="IconName.ExclamationTriangle" Class="me-1" />
                                        Near Limit
                                    </Badge>
                                }
                                else
                                {
                                    <Badge Color="BadgeColor.Success">
                                        <Icon Name="IconName.CheckCircle" Class="me-1" />
                                        Ready
                                    </Badge>
                                }
                            </div>

                            <!-- Mobile-friendly button layout -->
                            <div class="d-grid gap-2">
                                <!-- Primary Start Button -->
                                <Button
                                    Type="ButtonType.Submit"
                                    Color="@(_resourcesExceeded ? ButtonColor.Danger : ButtonColor.Success)"
                                    Outline="false"
                                    Size="ButtonSize.Large"
                                    Disabled="@(_running || _resourcesExceeded)"
                                    Loading=_running
                                    LoadingText="Running..."
                                    TooltipTitle="@(_resourcesExceeded ? "Cannot start - resources exceeded" : "Start simulation")"
                                    Class="py-3"
                                >
                                    @if(_resourcesExceeded)
                                    {
                                        <Icon Name="IconName.ExclamationTriangleFill" Class="me-2" />
                                        <text>Resources Exceeded</text>
                                    }
                                    else
                                    {
                                        <Icon Name="IconName.PlayFill" Class="me-2" />
                                        <text>Start Simulation</text>
                                    }
                                </Button>

                                <!-- Control buttons shown when running -->
                                @if(_running)
                                {
                                    <div class="btn-group w-100" role="group" aria-label="Simulation controls">
                                        @if(!_paused)
                                        {
                                            <Button
                                                Type="ButtonType.Button"
                                                Color="ButtonColor.Info"
                                                Outline=true
                                                TooltipTitle="Pause simulation"
                                                @onclick='OnPauseSimulation'
                                                Class="flex-fill"
                                            >
                                                <Icon Name=IconName.Pause Class="me-1" />
                                                <span class="d-none d-sm-inline">Pause</span>
                                            </Button>
                                        }
                                        else
                                        {
                                            <Button
                                                Type="ButtonType.Button"
                                                Color="ButtonColor.Success"
                                                Outline=true
                                                TooltipTitle="Continue simulation"
                                                @onclick='OnContinueSimulation'
                                                Class="flex-fill"
                                            >
                                                <Icon Name=IconName.Play Class="me-1" />
                                                <span class="d-none d-sm-inline">Continue</span>
                                            </Button>
                                        }
                                        <Button
                                            Type="ButtonType.Button"
                                            Color="ButtonColor.Warning"
                                            Outline=true
                                            TooltipTitle="Restart simulation"
                                            @onclick='RestartSimulationAsync'
                                            Class="flex-fill"
                                        >
                                            <Icon Name=IconName.ArrowClockwise Class="me-1" />
                                            <span class="d-none d-sm-inline">Restart</span>
                                        </Button>
                                        <Button
                                            Type="ButtonType.Button"
                                            Color="ButtonColor.Danger"
                                            Outline=true
                                            TooltipTitle="Stop simulation"
                                            @onclick='StopSimulationAsync'
                                            Class="flex-fill"
                                        >
                                            <Icon Name=IconName.StopFill Class="me-1" />
                                            <span class="d-none d-sm-inline">Stop</span>
                                        </Button>
                                    </div>
                                }
                            </div>
                        </CardBody>
                    </Card>
                </form>

                <!-- Simulation Progress Section -->
                @if(_running)
                {
                    <Card Class="mb-3 border-primary">
                        <CardHeader Class="py-2 py-md-3 bg-primary bg-opacity-10">
                            <Icon Name="IconName.Activity" Class="me-2" />
                            <strong>Simulation Progress</strong>
                        </CardHeader>
                        <CardBody Class="p-2 p-md-3">
                            <div class="mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold">@(_paused ? "Paused" : "Running")...</span>
                                    <Badge Color="@(_paused ? BadgeColor.Warning : BadgeColor.Success)" Class="fs-6">
                                        @_percent.ToString("F1")%
                                    </Badge>
                                </div>
                                <Progress Class="progress-lg" Style="height: 24px;">
                                    <ProgressBar Type="@(_paused ? ProgressType.Default : ProgressType.Striped)"
                                        Color="@(_paused ? ProgressColor.Warning : ProgressColor.Success)"
                                        Width=_percent
                                        Label=@_label
                                        @ref=_progressBar/>
                                </Progress>
                            </div>
                            @if(_paused)
                            {
                                <Alert Color="AlertColor.Info" Class="mb-0 mt-3 small">
                                    <Icon Name="IconName.InfoCircle" Class="me-2" />
                                    Paused. Tap Continue to resume or Stop to end.
                                </Alert>
                            }
                        </CardBody>
                    </Card>
                }

                <!-- Help text for mobile users -->
                @if(!_running)
                {
                    <Alert Color="AlertColor.Light" Class="small">
                        <Icon Name="IconName.InfoCircle" Class="me-2" />
                        Configure time and inputs in the <strong>Config</strong> tab, then return here to start.
                    </Alert>
                }
            </div>
        </Content>
    </Tab>
</Tabs>

<ConfirmDialog @ref="_confirmDialog" />

@code {
    #region Parameters

    /// <summary>
    /// Event callback invoked when the simulation is started.
    /// Provides the total simulation time as a TimeSpan parameter.
    /// </summary>
    [Parameter]
    public EventCallback<TimeSpan> OnSimulationStarted { get; set; }

    #endregion

    #region Private Fields

    /// <summary>
    /// Reference to the confirm dialog component used for user confirmations.
    /// </summary>
    private ConfirmDialog _confirmDialog = new();

    /// <summary>
    /// Reference to the Tabs component for programmatic control.
    /// </summary>
    private Tabs _tabs = new();

    /// <summary>
    /// The simulation time value (0-1000 units).
    /// </summary>
    private int _time = 0;

    /// <summary>
    /// The current time scale for the simulation (NS, US, MS, S, M, H).
    /// </summary>
    private TimeScale _zone = TimeScale.US;

    /// <summary>
    /// List of available FPGA device file paths.
    /// </summary>
    private List<string> _availableFPGAs = new();

    /// <summary>
    /// Currently selected FPGA file path (for fallback selector).
    /// </summary>
    private string _selectedFPGAPath = string.Empty;

    /// <summary>
    /// Controls visibility of the configuration panel.
    /// </summary>
    private bool _showConfigPanel = false;

    /// <summary>
    /// Current port moment configurations for saving.
    /// </summary>
    private List<PortMomentConfiguration>? _currentPortMoments = null;

    /// <summary>
    /// Name of the currently loaded configuration.
    /// </summary>
    private string _loadedConfigName = string.Empty;

    /// <summary>
    /// Tracks whether there are unsaved changes to the current configuration.
    /// </summary>
    private bool _hasUnsavedConfigChanges = false;

    /// <summary>
    /// Indicates whether the simulation is currently running.
    /// </summary>
    private bool _running = false;

    /// <summary>
    /// Indicates whether the simulation is currently paused.
    /// </summary>
    private bool _paused = false;

    /// <summary>
    /// Indicates whether the simulation has ended.
    /// </summary>
    private bool _simulationEnded = false;

    /// <summary>
    /// Indicates whether the design exceeds the FPGA's available resources.
    /// </summary>
    private bool _resourcesExceeded = false;

    /// <summary>
    /// Indicates whether the design is near the FPGA's resource limits (>80%).
    /// </summary>
    private bool _resourcesNearLimit = false;

    /// <summary>
    /// The current simulation progress percentage (0-100).
    /// </summary>
    private double _percent = 0;

    /// <summary>
    /// The total time for the simulation execution.
    /// </summary>
    private TimeSpan _totalTime;

    /// <summary>
    /// Reference to the progress bar component.
    /// </summary>
    private ProgressBar _progressBar = new();

    /// <summary>
    /// Tick marks for the time range input slider.
    /// </summary>
    private static readonly IEnumerable<TickMark> _timeTickMarks = new List<TickMark>
    {
        new() { Label = "very cold!", Value = "0" },
        new() { Label = "cool", Value = "250" },
        new() { Label = "medium", Value = "500" },
        new() { Label = "getting warm!", Value = "750" },
        new() { Label = "hot!", Value = "1000" }
    };

    /// <summary>
    /// Custom labels for the enhanced range slider.
    /// Displayed below the slider to indicate intensity levels.
    /// </summary>
    private static readonly List<string> _customLabels = new()
    {
        "Minimal",
        "Low",
        "Moderate",
        "High",
        "Maximum"
    };

    /// <summary>
    /// Color thresholds for the enhanced range slider badge.
    /// Maps value thresholds to badge colors for visual feedback.
    /// </summary>
    private static readonly Dictionary<int, BadgeColor> _colorThresholds = new()
    {
        { 0, BadgeColor.Info },
        { 250, BadgeColor.Success },
        { 500, BadgeColor.Warning },
        { 750, BadgeColor.Danger }
    };

    #endregion

    #region Computed Properties

    /// <summary>
    /// Gets the label for the progress bar showing the current percentage.
    /// </summary>
    private string _label => $"{_percent:F1}%";

    #endregion

    #region Lifecycle Methods

    /// <summary>
    /// Invoked when the component is initialized.
    /// Loads available FPGAs, subscribes to simulation events and validates resource usage.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Load available FPGA devices
        _availableFPGAs = await JSONFileReader.GetFPGAsAsync();

        // Set current FPGA path if one is already selected
        if (SelectedFPGA?.Path != null)
        {
            _selectedFPGAPath = SelectedFPGA.Path;
        }

        // Subscribe to events only once during initialization
        Builder.OnSimulationEnded += OnSimulationEnded;
        Builder.OnProgressAdvanced += OnProgressAdvance;
        SelectedFPGA.OnFPGAChange += OnFPGAChanged;
        ValidateResourceUsage();
    }

    /// <summary>
    /// Invoked when component parameters are set.
    /// Only validates resources - event subscriptions are handled in OnInitialized to prevent duplicates.
    /// </summary>
    protected override void OnParametersSet()
    {
        // Only validate resources, do NOT re-subscribe to events here
        // Event subscriptions are handled once in OnInitialized()
        ValidateResourceUsage();
    }

    /// <summary>
    /// Handles FPGA selection changes and revalidates resource usage.
    /// </summary>
    private void OnFPGAChanged()
    {
        // Update local path reference
        if (SelectedFPGA?.Path != null)
        {
            _selectedFPGAPath = SelectedFPGA.Path;
        }
        ValidateResourceUsage();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Disposes the component and unsubscribes from events.
    /// Resets the progress percentage and removes event listeners to prevent memory leaks.
    /// </summary>
    public void Dispose()
    {
        _percent = 0;
        Builder.OnSimulationEnded -= OnSimulationEnded;
        Builder.OnProgressAdvanced -= OnProgressAdvance;
        SelectedFPGA.OnFPGAChange -= OnFPGAChanged;
    }

    #endregion

    #region Event Handlers

    /// <summary>
    /// Handles the form submission to start the simulation.
    /// Validates resource usage before starting.
    /// Converts the time input to the appropriate TimeSpan based on the selected time scale
    /// and invokes the OnSimulationStarted callback.
    /// </summary>
    private async Task OnFormSubmited()
    {
        // Validate resources before starting
        ValidateResourceUsage();

        if (_resourcesExceeded)
        {
            ToastService.Notify(new ToastMessage
            {
                Type = ToastType.Danger,
                Title = "Cannot Start Simulation",
                Message = "The design exceeds the selected FPGA's available resources. Please select a larger FPGA or optimize your design.",
                AutoHide = true,
                HelpText = $"{DateTime.Now}"
            });
            return;
        }

        _running = true;
        _percent = 0;
        StateHasChanged();

        TimeSpan totalTime = _zone switch
        {
            TimeScale.NS => TimeSpan.FromTicks(_time),
            TimeScale.US => TimeSpan.FromMicroseconds(_time),
            TimeScale.MS => TimeSpan.FromMilliseconds(_time),
            TimeScale.S => TimeSpan.FromSeconds(_time),
            TimeScale.M => TimeSpan.FromMinutes(_time),
            TimeScale.H => TimeSpan.FromHours(_time),
            _ => TimeSpan.FromMilliseconds(_time)
        };

        _totalTime = totalTime;
        _simulationEnded = false;
        await OnSimulationStarted.InvokeAsync(totalTime);
    }

    /// <summary>
    /// Handles the pause button click event.
    /// Pauses the simulation timer and updates the UI state.
    /// </summary>
    private void OnPauseSimulation()
    {
        Builder.PauseTimer();
        _paused = true;
        StateHasChanged();
    }

    /// <summary>
    /// Handles the continue button click event.
    /// Resumes the simulation timer from the current tick and updates the UI state.
    /// </summary>
    private void OnContinueSimulation()
    {
        Builder.ContinueTimer();
        _paused = false;
        StateHasChanged();
    }

    /// <summary>
    /// Handles the simulation ended event from the ProgramBuilder.
    /// Updates the UI state and displays a success notification.
    /// </summary>
    /// <param name="ended">Indicates whether the simulation has ended successfully.</param>
    private void OnSimulationEnded(bool ended)
    {
        _running = false;
        _simulationEnded = true;
        ToastService.Notify(Message("Simulation Completed", "The simulation has ended successfully"));
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Handles the progress advance event from the ProgramBuilder.
    /// Updates the progress bar percentage and UI state.
    /// When progress reaches 100%, automatically stops the simulation.
    /// </summary>
    /// <param name="progress">The current progress percentage (0-100).</param>
    private void OnProgressAdvance(double progress)
    {
        if (progress >= 100)
        {
            InvokeAsync(() =>
            {
                _percent = 100;
                _paused = false;
                _running = false;
                _simulationEnded = true;
                Builder.StopTimer();
                StateHasChanged();
            });
        }
        else
        {
            InvokeAsync(() =>
            {
                _percent = progress;
                StateHasChanged();
            });
        }
    }

    #endregion

    #region User Actions

    /// <summary>
    /// Restarts the simulation asynchronously after user confirmation.
    /// Displays a confirmation dialog and resets all variables to their initial state.
    /// </summary>
    private async Task RestartSimulationAsync()
    {
        var options = new ConfirmDialogOptions
        {
            NoButtonColor = ButtonColor.Success,
            AutoFocusYesButton = false,
            YesButtonColor = ButtonColor.Danger,
            YesButtonText = "Restart simulation",
            NoButtonText = "No, go back"
        };

        var confirmation = await _confirmDialog.ShowAsync(
            title: "Restart Simulation",
            message1: "Do you want to restart the simulation from the beginning?",
            message2: "All variables will be reset to their initial values and the simulation will start over.",
            confirmDialogOptions: options);

        if (confirmation)
        {
            Builder.RestartTimer(_totalTime);
            _simulationEnded = false;
            _paused = false;
            _percent = 0;
            StateHasChanged();
            ToastService.Notify(Message("Simulation Restarted", "The simulation has been restarted successfully"));
        }
    }

    /// <summary>
    /// Stops the simulation asynchronously after user confirmation.
    /// Displays a confirmation dialog and halts the simulation, preserving the current state.
    /// </summary>
    private async Task StopSimulationAsync()
    {
        var options = new ConfirmDialogOptions
        {
            NoButtonColor = ButtonColor.Success,
            AutoFocusYesButton = false,
            YesButtonColor = ButtonColor.Danger,
            YesButtonText = "Stop simulation",
            NoButtonText = "No, go back"
        };

        var confirmation = await _confirmDialog.ShowAsync(
            title: "Stop Simulation",
            message1: "Do you want to stop the simulation?",
            message2: "The variables will be displayed with their states at the current tick. You can start a new simulation at any time.",
            confirmDialogOptions: options);

        if (confirmation)
        {
            Builder.StopTimer();
            _percent = 0;
            _paused = false;
            _running = false;
            _simulationEnded = true;
            ToastService.Notify(Message("Simulation Stopped", "The simulation has been stopped successfully"));
            StateHasChanged();
        }
    }

    #endregion

    #region Helper Methods

    /// <summary>
    /// Sets the time scale for the simulation.
    /// Updates the current time zone and refreshes the UI.
    /// </summary>
    /// <param name="zone">The time scale to set (NS, US, MS, S, M, or H).</param>
    private void SetZone(TimeScale zone)
    {
        _zone = zone;
        MarkConfigChanged();
        StateHasChanged();
    }

    /// <summary>
    /// Handles time value changes from the slider/input.
    /// </summary>
    private void OnTimeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            _time = value;
            MarkConfigChanged();
        }
    }

    /// <summary>
    /// Marks the current configuration as having unsaved changes.
    /// </summary>
    private void MarkConfigChanged()
    {
        if (!string.IsNullOrEmpty(_loadedConfigName))
        {
            _hasUnsavedConfigChanges = true;
        }
    }

    /// <summary>
    /// Handles tab change events to prompt for saving unsaved configuration changes.
    /// </summary>
    private async Task OnTabChangingAsync(TabsEventArgs args)
    {
        // Only prompt if there are unsaved changes and moving away from Config tab
        if (_hasUnsavedConfigChanges && args.ActiveTabName == "config-tab")
        {
            var options = new ConfirmDialogOptions
            {
                YesButtonText = "Save Configuration",
                YesButtonColor = ButtonColor.Success,
                NoButtonText = "Discard Changes",
                NoButtonColor = ButtonColor.Secondary
            };

            var confirmation = await _confirmDialog.ShowAsync(
                title: "Unsaved Configuration Changes",
                message1: $"You have unsaved changes to the configuration '{_loadedConfigName}'.",
                message2: "Would you like to save this configuration before switching tabs?",
                confirmDialogOptions: options
            );

            if (confirmation)
            {
                // Save the configuration
                await SaveCurrentConfigurationAsync();
            }
            else
            {
                // Discard changes
                _hasUnsavedConfigChanges = false;
            }
        }
    }

    /// <summary>
    /// Saves the current configuration settings with the loaded name.
    /// </summary>
    private async Task SaveCurrentConfigurationAsync()
    {
        if (string.IsNullOrEmpty(_loadedConfigName))
            return;

        var config = ConfigService.CreateConfiguration(
            _loadedConfigName,
            string.Empty,
            SelectedFPGA?.FPGA,
            _selectedFPGAPath,
            _time,
            _zone.ToString(),
            _currentPortMoments
        );

        var result = await ConfigService.SaveConfigurationAsync(config);
        if (result)
        {
            _hasUnsavedConfigChanges = false;
            ToastService.Notify(new ToastMessage(ToastType.Success, $"Configuration '{_loadedConfigName}' saved"));
        }
        else
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Failed to save: {ConfigService.LastError}"));
        }
    }

    #endregion

    #region FPGA Selection Methods

    /// <summary>
    /// Handles FPGA selection change from the dropdown.
    /// </summary>
    private void OnFPGASelected(ChangeEventArgs e)
    {
        _selectedFPGAPath = e.Value?.ToString() ?? string.Empty;
    }

    /// <summary>
    /// Applies the selected FPGA from the fallback selector.
    /// </summary>
    private async Task ApplySelectedFPGAAsync()
    {
        if (string.IsNullOrEmpty(_selectedFPGAPath))
        {
            ToastService.Notify(new ToastMessage(ToastType.Warning, "Please select an FPGA device first"));
            return;
        }

        try
        {
            var fpga = await JSONFileReader.ReadFPGAJsonFileAsync(_selectedFPGAPath);
            if (fpga != null)
            {
                SelectedFPGA.SetFPGA(fpga, _selectedFPGAPath);
                MarkConfigChanged();
                ToastService.Notify(new ToastMessage(ToastType.Success, $"FPGA '{fpga.Model}' selected"));
                StateHasChanged();
            }
            else
            {
                ToastService.Notify(new ToastMessage(ToastType.Danger, $"Failed to load FPGA: {_selectedFPGAPath}"));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Error applying FPGA: {ex.Message}"));
        }
    }

    /// <summary>
    /// Quick change FPGA from the inline dropdown.
    /// </summary>
    private async Task QuickChangeFPGAAsync(string fpgaPath)
    {
        _selectedFPGAPath = fpgaPath;
        await ApplySelectedFPGAAsync();
    }

    #endregion

    #region Configuration Methods

    /// <summary>
    /// Handles configuration loaded event from ConfigurationModal.
    /// Applies the loaded configuration settings.
    /// </summary>
    private async Task OnConfigurationLoadedAsync(KmilaConfiguration config)
    {
        try
        {
            // Track loaded config name
            _loadedConfigName = config.Name;
            _hasUnsavedConfigChanges = false;

            // Apply time settings
            _time = config.Time?.Value ?? 0;
            if (Enum.TryParse<TimeScale>(config.Time?.Scale, out var scale))
            {
                _zone = scale;
            }

            // Apply FPGA if specified
            if (config.FPGA != null && !string.IsNullOrEmpty(config.FPGA.Model))
            {
                // Try to find matching FPGA by model name or path
                var fpgaModel = config.FPGA.Model;
                var fpgaPath = config.FPGA.Path ?? string.Empty;

                // First try exact path match
                var matchingPath = _availableFPGAs.FirstOrDefault(f => f == fpgaPath);

                // Then try filename match
                if (string.IsNullOrEmpty(matchingPath))
                {
                    var fileName = System.IO.Path.GetFileNameWithoutExtension(fpgaPath);
                    matchingPath = _availableFPGAs.FirstOrDefault(f =>
                        System.IO.Path.GetFileNameWithoutExtension(f).Equals(fileName, StringComparison.OrdinalIgnoreCase));
                }

                // Then try model name match
                if (string.IsNullOrEmpty(matchingPath))
                {
                    matchingPath = _availableFPGAs.FirstOrDefault(f =>
                        System.IO.Path.GetFileNameWithoutExtension(f).Equals(fpgaModel, StringComparison.OrdinalIgnoreCase));
                }

                if (!string.IsNullOrEmpty(matchingPath))
                {
                    _selectedFPGAPath = matchingPath;
                    await ApplySelectedFPGAAsync();
                }
                else
                {
                    ToastService.Notify(new ToastMessage(ToastType.Warning, $"FPGA '{fpgaModel}' not found in available devices"));
                }
            }

            // Apply port moments if present (future implementation)
            _currentPortMoments = config.PortMoments;

            ToastService.Notify(new ToastMessage(ToastType.Success, $"Configuration '{config.Name}' loaded successfully"));
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new ToastMessage(ToastType.Danger, $"Error loading configuration: {ex.Message}"));
        }
    }

    #endregion

    #region Resource Calculation Methods

    /// <summary>
    /// Calculates the total number of flip-flops used across all entities.
    /// </summary>
    /// <returns>Total flip-flop count.</returns>
    private int CalculateTotalFlipFlops()
    {
        return Builder.Parser.Entities
            .Where(e => e.ResourceUsage != null)
            .Sum(e => e.ResourceUsage.FlipFlops);
    }

    /// <summary>
    /// Calculates the total number of LUTs used across all entities.
    /// </summary>
    /// <returns>Total LUT count.</returns>
    private int CalculateTotalLUTs()
    {
        return Builder.Parser.Entities
            .Where(e => e.ResourceUsage != null)
            .Sum(e => e.ResourceUsage.LUTs);
    }

    /// <summary>
    /// Calculates the total number of DSP slices used across all entities.
    /// </summary>
    /// <returns>Total DSP slice count.</returns>
    private int CalculateTotalDSPSlices()
    {
        return Builder.Parser.Entities
            .Where(e => e.ResourceUsage != null)
            .Sum(e => e.ResourceUsage.DSPSlices);
    }

    /// <summary>
    /// Calculates the total number of BRAM blocks used across all entities.
    /// </summary>
    /// <returns>Total BRAM block count (can be fractional).</returns>
    private double CalculateTotalBRAMBlocks()
    {
        return Builder.Parser.Entities
            .Where(e => e.ResourceUsage != null)
            .Sum(e => e.ResourceUsage.BRAMBlocks);
    }

    /// <summary>
    /// Calculates the total number of I/O pins used across all entities.
    /// </summary>
    /// <returns>Total I/O pin count.</returns>
    private int CalculateTotalIOPins()
    {
        return Builder.Parser.Entities
            .Where(e => e.ResourceUsage != null)
            .Sum(e => e.ResourceUsage.IOPins);
    }

    /// <summary>
    /// Calculates the resource usage percentage.
    /// </summary>
    /// <param name="used">The amount of resource used.</param>
    /// <param name="available">The total available resource.</param>
    /// <returns>Percentage of resource utilization (0-100+).</returns>
    private double GetResourcePercentage(double used, double available)
    {
        if (available <= 0) return 0;
        return Math.Min((used / available) * 100, 100);
    }

    /// <summary>
    /// Determines the progress bar color based on resource usage percentage.
    /// - Success (Green): 0-60%
    /// - Info (Blue): 61-79%
    /// - Warning (Yellow): 80-99%
    /// - Danger (Red): 100%+
    /// </summary>
    /// <param name="percentage">Resource usage percentage.</param>
    /// <returns>The appropriate progress bar color.</returns>
    private ProgressColor GetProgressColor(double percentage)
    {
        return percentage switch
        {
            >= 100 => ProgressColor.Danger,
            >= 80 => ProgressColor.Warning,
            >= 60 => ProgressColor.Info,
            _ => ProgressColor.Success
        };
    }

    /// <summary>
    /// Gets the badge color from progress color for consistency.
    /// </summary>
    /// <param name="progressColor">The progress bar color.</param>
    /// <returns>The corresponding badge color.</returns>
    private BadgeColor GetBadgeColorFromProgress(ProgressColor progressColor)
    {
        return progressColor switch
        {
            ProgressColor.Danger => BadgeColor.Danger,
            ProgressColor.Warning => BadgeColor.Warning,
            ProgressColor.Info => BadgeColor.Info,
            ProgressColor.Success => BadgeColor.Success,
            _ => BadgeColor.Primary
        };
    }

    /// <summary>
    /// Validates whether the design fits within the selected FPGA's resource limits.
    /// Updates _resourcesExceeded and _resourcesNearLimit flags.
    /// </summary>
    private void ValidateResourceUsage()
    {
        if (SelectedFPGA?.FPGA?.Resources == null || !Builder.Parser.Entities.Any())
        {
            _resourcesExceeded = false;
            _resourcesNearLimit = false;
            return;
        }

        bool exceeded = false;
        bool nearLimit = false;

        // Check Flip-Flops
        if (SelectedFPGA.FPGA.Resources.RegistersFlipFlops != null)
        {
            var ffPercent = GetResourcePercentage(CalculateTotalFlipFlops(), SelectedFPGA.FPGA.Resources.RegistersFlipFlops.Value);
            if (ffPercent >= 100) exceeded = true;
            else if (ffPercent >= 80) nearLimit = true;
        }

        // Check LUTs
        if (SelectedFPGA.FPGA.Resources.LogicUnits != null)
        {
            var lutPercent = GetResourcePercentage(CalculateTotalLUTs(), SelectedFPGA.FPGA.Resources.LogicUnits.Value);
            if (lutPercent >= 100) exceeded = true;
            else if (lutPercent >= 80) nearLimit = true;
        }

        // Check DSP Slices
        if (SelectedFPGA.FPGA.Resources.DspSlices != null)
        {
            var dspPercent = GetResourcePercentage(CalculateTotalDSPSlices(), SelectedFPGA.FPGA.Resources.DspSlices.Value);
            if (dspPercent >= 100) exceeded = true;
            else if (dspPercent >= 80) nearLimit = true;
        }

        // Check BRAM
        if (SelectedFPGA.FPGA.Resources.MemoryBlocks != null)
        {
            var bramPercent = GetResourcePercentage(CalculateTotalBRAMBlocks(), SelectedFPGA.FPGA.Resources.MemoryBlocks.Value);
            if (bramPercent >= 100) exceeded = true;
            else if (bramPercent >= 80) nearLimit = true;
        }

        // Check I/O Pins
        if (SelectedFPGA.FPGA.IO?.MaxUserIO != null)
        {
            var ioPercent = GetResourcePercentage(CalculateTotalIOPins(), SelectedFPGA.FPGA.IO.MaxUserIO.Value);
            if (ioPercent >= 100) exceeded = true;
            else if (ioPercent >= 80) nearLimit = true;
        }

        _resourcesExceeded = exceeded;
        _resourcesNearLimit = nearLimit && !exceeded;
    }

    #endregion
}