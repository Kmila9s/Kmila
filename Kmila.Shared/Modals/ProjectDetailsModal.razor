@implements IDisposable

<PageTitle>@Traductor.T("PROJECT_DETAILS_TITLE")</PageTitle>
<EditForm class="row" EditContext="_context" OnValidSubmit="CreateProjectAsync">
    <DataAnnotationsValidator />
    <div class="col-sm-12 col-md-6 my-3">
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="InputProjectName" placeholder="@Traductor.T("PROJECT_NAME_PLACEHOLDER")" @bind=_project.Name>
            <label for="InputProjectName">@Traductor.T("PROJECT_NAME_LABEL")</label>
            <ValidationMessage For="@(() => _project.Name)" />
        </div>
    </div>
    <div class="col-sm-12 col-md-6 my-3">
        <div class="form-floating mb-3">
            <input type="text" class="form-control" id="InputProjectDescription" placeholder="@Traductor.T("PROJECT_DESCRIPTION_PLACEHOLDER")" @bind="_project.Description">
            <label for="InputProjectDescription">@Traductor.T("PROJECT_DESCRIPTION_LABEL")</label>
        </div>
    </div>
    <Button
        Outline=true
        TooltipTitle="@Traductor.T("PROJECT_CREATE_TOOLTIP")"
        Color="ButtonColor.Success"
        Type="ButtonType.Submit"
        Disabled="_creatingProject"
        Loading="_creatingProject"
    >
        @Traductor.T("PROJECT_CREATE_BUTTON")
    </Button>
</EditForm>

@code{
    /// <summary>
    /// Gets or sets the event callback for when a project is created.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnProjectCreated { get; set; }
    private Project _project = new();
    private EditContext _context = default!;
    private bool _creatingProject = false;

    /// <summary>
    /// Method invoked when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
        _context = new(_project);
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
    }
    /// <summary>
    /// Method invoked when the component parameters are set.
    /// </summary>
    protected override void OnParametersSet(){
        _project = new();
        _context = new(_project);
    }
    /// <summary>
    /// Creates a new project asynchronously.
    /// </summary>
    private async Task CreateProjectAsync(){
        _creatingProject = true;
        StateHasChanged();
        try{
            if(_context.Validate()){
                string basePath = string.Empty;
                #if WINDOWS || MACCATALYST || ANDROID || IOS
                    basePath = FileSystem.AppDataDirectory;
                #else
                    basePath = Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ApplicationData), "KmilaData");
                #endif
                string fullPath = Path.Join(basePath, "Projects", _project.Name.Trim().Replace(" ", "").Replace('/', '_').Replace('-', '_'));
                _project.BasePath = fullPath;
                var result = await Projects.CreateAsync(_project);
                ToastService.Notify(Message(
                    result ? Traductor.T("PROJECT_CREATED_SUCCESS") : Traductor.T("COMMON_ERROR"),
                    result ? $"{Traductor.T("PROJECT_CREATED_SUCCESS_MSG").Replace("{0}", _project.BasePath)}" : $"{Traductor.T("PROJECT_CREATED_ERROR_MSG").Replace("{0}", Projects.LastError)}",
                    result ? ToastType.Success : ToastType.Danger
                ));
                if(result) await OnProjectCreated.InvokeAsync();
                _project = new();
            }else{
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), Traductor.T("PROJECT_VALIDATION_ERROR"), ToastType.Danger));
            }
        }catch(Exception ex){
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }finally{
            _creatingProject = false;
            StateHasChanged();
        }
    }
}