@*
    ResourceMetricBox Component

    Reusable metric box for displaying a single FPGA resource metric.
    Shows a title with icon, value with badge, and optional child content.

    Usage:
    <ResourceMetricBox Title="Flip-Flops" Icon="IconName.ToggleOn" IconColor="text-primary"
                       Value="128" Unit="FFs" BadgeColor="BadgeColor.Primary" AccuracyLabel="~95%" />
*@

<div class="col-md-6 col-lg-4">
    <div class="border rounded p-3 h-100 resource-box">
        <div class="d-flex align-items-center mb-2">
            <Icon Name="@Icon" Class="@($"me-2 {IconColor}")" />
            <strong>@Title</strong>
            <Badge Color="BadgeColor.Secondary" Class="ms-2" Pill="true">
                <small>@AccuracyLabel</small>
            </Badge>
        </div>
        <div class="d-flex align-items-center">
            <Badge Color="@BadgeColor" Class="font-monospace fs-5">
                @Value
            </Badge>
            <small class="text-muted ms-2">@Unit</small>
        </div>
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IconName Icon { get; set; }
    [Parameter] public string IconColor { get; set; } = "text-primary";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public BadgeColor BadgeColor { get; set; } = BadgeColor.Primary;
    [Parameter] public string AccuracyLabel { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
