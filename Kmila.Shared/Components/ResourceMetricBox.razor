@*
    ResourceMetricBox — tokenized metric card for a single FPGA resource.

    Layout:
      ┌────────────────────────────────────────┐
      │  [icon]  Flip-Flops         ~95%       │
      │                                        │
      │  128   FFs                             │
      │                                        │
      │  [optional child content]              │
      └────────────────────────────────────────┘

    Styling is driven by a semantic "variant" derived from the legacy BadgeColor
    parameter so callers don't need to change. All colors flow through tokens so
    dark mode swaps without extra rules.
*@

<div class="resource-metric resource-metric--@Variant">
    <div class="resource-metric__head">
        <span class="resource-metric__icon">
            <Icon Name="@Icon" />
        </span>
        <div class="resource-metric__label">
            <span class="resource-metric__title">@Title</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(AccuracyLabel))
        {
            <span class="resource-metric__accuracy">@AccuracyLabel</span>
        }
    </div>

    <div class="resource-metric__value">
        <span class="resource-metric__number">@Value</span>
        @if (!string.IsNullOrWhiteSpace(Unit))
        {
            <span class="resource-metric__unit">@Unit</span>
        }
    </div>

    @if (ChildContent != null)
    {
        <div class="resource-metric__extra">@ChildContent</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IconName Icon { get; set; }
    [Parameter] public string IconColor { get; set; } = "text-primary";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public BadgeColor BadgeColor { get; set; } = BadgeColor.Primary;
    [Parameter] public string AccuracyLabel { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Maps the legacy <see cref="BadgeColor"/> param onto our semantic variant
    /// class so existing callers don't break. IconColor is kept but ignored —
    /// variant drives the whole color treatment so everything stays in tokens.
    /// </summary>
    private string Variant => BadgeColor switch
    {
        BadgeColor.Success   => "success",
        BadgeColor.Info      => "info",
        BadgeColor.Warning   => "warning",
        BadgeColor.Danger    => "danger",
        BadgeColor.Secondary => "neutral",
        BadgeColor.Light     => "neutral",
        BadgeColor.Dark      => "neutral",
        _                    => "primary"
    };
}
