<!-- Port Moment Input Component -->
<Card Class="mb-3">
    <CardHeader>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <Icon Name="IconName.Plugin" Class="me-2" />
                <strong>@Variable?.Name</strong>
                <Badge Color="BadgeColor.Info" Class="ms-2">
                    @Enum.GetName(typeof(DATATYPES), Variable?.Type ?? DATATYPES.UNKNOWN)
                </Badge>
            </div>
            @if(!_portMoment.IsClock && !IsRunning)
            {
                <Button
                    Size="ButtonSize.Small"
                    Color="ButtonColor.Success"
                    Outline=true
                    TooltipTitle="Add multiple moments for this port"
                    @onclick='AddInputParams'
                >
                    <Icon Name="IconName.PlusCircle" Class="me-1" />
                    Add Moments
                </Button>
            }
        </div>
    </CardHeader>
    <CardBody>
        <!-- Clock Configuration -->
        <div class="mb-3">
            <div class="form-check form-switch">
                <input
                    class="form-check-input"
                    type="checkbox"
                    role="switch"
                    id="clock-switch-@Variable?.Name"
                    @bind="_portMoment.IsClock"
                    @bind:after="NotifyPortMomentsChanged"
                    disabled="@IsRunning"
                    aria-label="Toggle system clock mode">
                <label class="form-check-label" for="clock-switch-@Variable?.Name">
                    <Icon Name="IconName.Clock" Class="me-1" />
                    System Clock Signal
                </label>
            </div>
            @if(_portMoment.IsClock)
            {
                <Alert Color="AlertColor.Info" Class="mt-2 mb-0">
                    <Icon Name="IconName.InfoCircle" Class="me-2" />
                    This port is configured as a system clock. Value and time inputs are disabled.
                </Alert>
            }
        </div>

        <!-- Value and Time Configuration -->
        <div class="row g-3">
            <!-- Value Input -->
            <div class="col-md-6">
                <label for="value-input-@Variable?.Name" class="form-label">
                    <Icon Name="IconName.InputCursorText" Class="me-1" />
                    Port Value
                </label>
                <input
                    type="text"
                    class="form-control"
                    id="value-input-@Variable?.Name"
                    @bind="_portMoment.Value"
                    @bind:after="NotifyPortMomentsChanged"
                    placeholder="Enter port value (e.g., '1', '0', 'Z')"
                    disabled="@(_portMoment.IsClock || IsRunning)"
                    readonly="@_portMoment.IsClock"
                    aria-label="Port value input"/>
            </div>

            <!-- Time Input -->
            <div class="col-md-6">
                <label for="time-input-@Variable?.Name" class="form-label">
                    <Icon Name="IconName.Clock" Class="me-1" />
                    Time Value
                </label>
                <div class="input-group">
                    <input
                        type="number"
                        class="form-control"
                        id="time-input-@Variable?.Name"
                        @bind="_portMoment.TimeInput"
                        @bind:after="NotifyPortMomentsChanged"
                        min="1"
                        max="@LimitTime"
                        placeholder="Time value"
                        disabled="@(_portMoment.IsClock || IsRunning)"
                        readonly="@_portMoment.IsClock"
                        aria-label="Time value input"/>
                    <button
                        class="btn btn-outline-secondary dropdown-toggle"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        disabled="@(_portMoment.IsClock || IsRunning)">
                        @_portMoment.TimeScale
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach(var zone in _availableTimeScales.Where(p => p <= TimeScale))
                        {
                            <li>
                                <a class="dropdown-item @(_portMoment.TimeScale == zone ? "active" : "")"
                                   @onclick="() => SetZone(zone)">
                                    <Icon Name="IconName.Clock" Class="me-2" />
                                    @Enum.GetName(typeof(TimeScale), zone)
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <div class="form-text">
                    Maximum: @LimitTime @TimeScale
                </div>
            </div>
        </div>
    </CardBody>
</Card>

<!-- Offcanvas for Extra Inputs -->
<Offcanvas @ref="_inputsOffCanvas"
           Size="OffcanvasSize.Large"
           UseStaticBackdrop="true"/>

@code {
    #region Parameters

    /// <summary>
    /// Gets or sets the variable associated with this port moment input.
    /// This represents the VHDL/Verilog port being configured.
    /// </summary>
    [Parameter]
    public Variable? Variable { get; set; } = default!;

    /// <summary>
    /// Gets or sets the maximum time limit for the simulation.
    /// This constrains the time input values that can be entered.
    /// </summary>
    [Parameter]
    public int LimitTime { get; set; }

    /// <summary>
    /// Gets or sets the time scale for the simulation (NS, US, MS, S, M, H).
    /// This determines the available time scale options in the dropdown.
    /// </summary>
    [Parameter]
    public TimeScale TimeScale { get; set; } = TimeScale.US;

    /// <summary>
    /// Gets or sets a value indicating whether the simulation is currently running.
    /// When true, input controls are disabled to prevent modifications during simulation.
    /// </summary>
    [Parameter]
    public bool IsRunning { get; set; } = false;

    /// <summary>
    /// Callback fired whenever port moment data changes (base value, clock toggle, or extra moments).
    /// Provides a PortMomentConfiguration representing all current moments for this port.
    /// </summary>
    [Parameter]
    public EventCallback<PortMomentConfiguration> OnPortMomentsChanged { get; set; }

    /// <summary>
    /// Initial configuration to restore when loading a saved config.
    /// When set, the component restores base moment and extra moments from this data.
    /// </summary>
    [Parameter]
    public PortMomentConfiguration? InitialConfiguration { get; set; }

    #endregion

    #region Private Fields

    /// <summary>
    /// The port moment instance that holds the current input values.
    /// </summary>
    private PortMoment _portMoment = new();

    /// <summary>
    /// Collection of additional port moments for multi-value inputs.
    /// Used when the user wants to set multiple values at different time points.
    /// </summary>
    private List<PortMoment> _portMoments = new();

    /// <summary>
    /// Reference to the offcanvas component for displaying extra input fields.
    /// </summary>
    private Offcanvas _inputsOffCanvas = new();

    /// <summary>
    /// Counter for the number of additional input moments added.
    /// Note: This field is currently assigned but not actively used in the UI.
    /// </summary>
    private int _inputs = 0;

    /// <summary>
    /// Array of all available time scales (NS, US, MS, S, M, H).
    /// </summary>
    private static readonly TimeScale[] _availableTimeScales = Enum.GetValues<TimeScale>();

    #endregion

    /// <summary>
    /// Tracks the last InitialConfiguration applied, to avoid re-applying on every render.
    /// </summary>
    private PortMomentConfiguration? _appliedInitialConfig;

    #region Lifecycle Methods

    protected override void OnParametersSet()
    {
        // Restore from InitialConfiguration when it changes (e.g. config load)
        if (InitialConfiguration != null && InitialConfiguration != _appliedInitialConfig)
        {
            _appliedInitialConfig = InitialConfiguration;
            RestoreFromConfiguration(InitialConfiguration);
        }
    }

    /// <summary>
    /// Restores the base moment and extra moments from a saved PortMomentConfiguration.
    /// </summary>
    private void RestoreFromConfiguration(PortMomentConfiguration config)
    {
        _portMoments.Clear();
        _portMoment.IsClock = false;
        _portMoment.Value = string.Empty;
        _portMoment.TimeInput = 0;

        if (config.Values == null || config.Values.Count == 0)
            return;

        bool baseSet = false;
        foreach (var val in config.Values)
        {
            // Clock marker
            if (val.TimeScale == "CLK" && val.Value == "CLOCK")
            {
                _portMoment.IsClock = true;
                baseSet = true;
                continue;
            }

            if (!baseSet)
            {
                // First non-clock value goes to the base moment
                _portMoment.Value = val.Value ?? string.Empty;
                _portMoment.TimeInput = val.Time;
                if (Enum.TryParse<TimeScale>(val.TimeScale, out var scale))
                {
                    _portMoment.TimeScale = scale;
                }
                baseSet = true;
            }
            else
            {
                // Subsequent values go to extra moments
                var extraMoment = new PortMoment
                {
                    Variable = Variable,
                    Value = val.Value ?? string.Empty,
                    TimeInput = val.Time,
                    IsClock = false
                };
                if (Enum.TryParse<TimeScale>(val.TimeScale, out var extraScale))
                {
                    extraMoment.TimeScale = extraScale;
                }
                _portMoments.Add(extraMoment);
            }
        }
    }

    #endregion

    #region Event Handlers

    /// <summary>
    /// Sets the time scale for the current port moment.
    /// Updates the UI to reflect the selected time scale.
    /// </summary>
    /// <param name="scale">The time scale to apply (NS, US, MS, S, M, or H).</param>
    private async Task SetZone(TimeScale scale)
    {
        _portMoment.TimeScale = scale;
        await NotifyPortMomentsChanged();
        StateHasChanged();
    }

    /// <summary>
    /// Opens the offcanvas panel to add multiple input parameters for this port.
    /// Passes current extra moments and registers a callback to sync changes back.
    /// </summary>
    private async Task AddInputParams()
    {
        var parameters = new Dictionary<string, object>
        {
            { "PortMoment", _portMoment },
            { "Variable", Variable! },
            { "LimitTime", LimitTime },
            { "TimeScale", TimeScale },
            { "InitialExtraMoments", _portMoments },
            { "OnExtraMomentsChanged", EventCallback.Factory.Create<List<PortMoment>>(this, OnExtraMomentsUpdated) }
        };

        await _inputsOffCanvas.ShowAsync<PortMomentExtraInputs>(
            title: $"Additional Moments for {Variable?.Name}",
            parameters: parameters);
    }

    /// <summary>
    /// Called when the offcanvas PortMomentExtraInputs sends back updated moments.
    /// </summary>
    private async Task OnExtraMomentsUpdated(List<PortMoment> updatedMoments)
    {
        _portMoments = updatedMoments;
        await NotifyPortMomentsChanged();
    }

    /// <summary>
    /// Builds the current PortMomentConfiguration and fires the OnPortMomentsChanged callback.
    /// </summary>
    private async Task NotifyPortMomentsChanged()
    {
        var config = GetCurrentConfiguration();
        await OnPortMomentsChanged.InvokeAsync(config);
    }

    /// <summary>
    /// Collects all moments (base + extras) into a PortMomentConfiguration.
    /// </summary>
    private PortMomentConfiguration GetCurrentConfiguration()
    {
        var config = new PortMomentConfiguration
        {
            PortName = Variable?.Name ?? string.Empty,
            Values = new List<PortMomentValue>()
        };

        // If clock, add a clock marker
        if (_portMoment.IsClock)
        {
            config.Values.Add(new PortMomentValue
            {
                Time = 0,
                TimeScale = "CLK",
                Value = "CLOCK"
            });
        }
        else if (!string.IsNullOrEmpty(_portMoment.Value))
        {
            // Add base moment (only if it has meaningful data)
            config.Values.Add(new PortMomentValue
            {
                Time = _portMoment.TimeInput,
                TimeScale = _portMoment.TimeScale.ToString(),
                Value = _portMoment.Value
            });
        }

        // Add extra moments
        foreach (var moment in _portMoments)
        {
            if (!string.IsNullOrEmpty(moment.Value))
            {
                config.Values.Add(new PortMomentValue
                {
                    Time = moment.TimeInput,
                    TimeScale = moment.TimeScale.ToString(),
                    Value = moment.Value
                });
            }
        }

        return config;
    }

    #endregion
}
