@*
    FPGASimpleView Component

    A compact widget that displays essential FPGA device specifications in a grid layout.
    This component automatically updates when the selected FPGA changes via the SelectedFPGA
    singleton service.

    Features:
    - Displays model name, family, and manufacturer
    - Shows resource specifications (Logic Units, Memory, Registers, DSP)
    - Shows clocking specifications (Max Clock, PLLs/DCMs)
    - Shows I/O specifications (Pins, Banks)
    - Shows power specifications (Core Voltage)
    - Auto-refreshes when FPGA selection changes

    Usage:
    <FPGASimpleView />

    Dependencies:
    - SelectedFPGA (injected singleton service)
    - BlazorBootstrap Icon and Badge components
*@
@implements IDisposable

<div class="fpga-info p-2">
    <!-- Header: Model name and Manufacturer badge -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong class="fs-5">@SelectedFPGA.FPGA.Model</strong>
        <Badge Color="BadgeColor.Primary">@SelectedFPGA.FPGA.Manufacturer</Badge>
    </div>
    <small class="text-muted">@SelectedFPGA.FPGA.Family</small>
    <hr class="my-2"/>

    <!-- Specifications Grid -->
    <div class="row g-2 small">
        @* Resource Specifications Section *@
        @if(SelectedFPGA.FPGA.Resources != null){
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.Cpu" /> <strong>@Traductor.T("FPGA_LOGIC")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.Resources.LogicUnits?.ToString("N0") @SelectedFPGA.FPGA.Resources.LogicUnitsType</span>
            </div>
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.Memory" /> <strong>@Traductor.T("FPGA_MEMORY")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.Resources.MemoryTotalKbits?.ToString("N0") Kbits</span>
            </div>
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.ToggleOn" /> <strong>@Traductor.T("FPGA_REGISTERS")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.Resources.RegistersFlipFlops?.ToString("N0") FF</span>
            </div>
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.Calculator" /> <strong>@Traductor.T("FPGA_DSP")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.Resources.DspSlices @SelectedFPGA.FPGA.Resources.DspSliceType</span>
            </div>
        }
        @* Clocking Specifications Section *@
        @if(SelectedFPGA.FPGA.Clocking != null){
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.Clock" /> <strong>@Traductor.T("FPGA_CLOCK")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.Clocking.MaxPllOutputMhz MHz max</span>
            </div>
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.Diagram3" /> <strong>@Traductor.T("FPGA_PLLS")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.Clocking.PllCount PLL / @SelectedFPGA.FPGA.Clocking.DcmMmcmCount DCM</span>
            </div>
        }
        @* I/O Specifications Section *@
        @if(SelectedFPGA.FPGA.IO != null){
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.Plugin" /> <strong>@Traductor.T("FPGA_IO")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.IO.MaxUserIO pins (@SelectedFPGA.FPGA.IO.IoBanksCount banks)</span>
            </div>
        }
        @* Power Specifications Section *@
        @if(SelectedFPGA.FPGA.Power != null){
            <div class="col-12 col-sm-6">
                <Icon Name="IconName.Lightning" /> <strong>@Traductor.T("FPGA_POWER")</strong><br/>
                <span class="text-muted">@SelectedFPGA.FPGA.Power.CoreVoltageVccintV V core</span>
            </div>
        }
    </div>
</div>

@code{
    /// <summary>
    /// Initializes the component and subscribes to FPGA selection changes.
    /// When the FPGA selection changes, the component automatically re-renders
    /// to display the new device specifications.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;
        SelectedFPGA.OnFPGAChange += StateHasChanged;
    }

    /// <summary>
    /// Disposes the component and unsubscribes from FPGA selection changes.
    /// This prevents memory leaks by removing the event handler when the
    /// component is removed from the render tree.
    /// </summary>
    public void Dispose(){
        SelectedFPGA.OnFPGAChange -= StateHasChanged;
    }
}