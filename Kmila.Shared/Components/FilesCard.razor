@*
    FilesCard — project files list.

    Rebuilt without Blazor Bootstrap's Grid/Card so the visual treatment is
    fully token-driven and matches the rest of the app. Each row has a hybrid
    action pattern: the primary action (Open) is inline as a ghost button, the
    rest (Rename, Delete) live in a kebab menu that's a native <details>
    popover — no JS.

    Rename happens inline: the filename text is replaced with an <input>.
    Enter commits, Esc cancels, blur commits too. The repository refuses
    duplicates and rolls back on failure (toast + stays in edit mode).
*@
@implements IDisposable

<div class="files-list">
    <header class="files-list__header">
        <Icon Name="IconName.Folder2Open" />
        <span class="files-list__title">@Traductor.T("FILES_PROJECT_FILES")</span>
        @if (_projectFiles.Any())
        {
            <span class="files-list__count">@_projectFiles.Count</span>
        }
    </header>

    @if (!_projectFiles.Any())
    {
        <div class="files-list__empty">
            <div class="files-list__empty-icon"><Icon Name="IconName.FileEarmarkPlus" /></div>
            <p><strong>@Traductor.T("FILES_NO_FILES")</strong></p>
            <p class="files-list__empty-sub">@Traductor.T("FILES_CREATE_FIRST")</p>
        </div>
    }
    else
    {
        <ul class="files-list__items" role="list">
            @foreach (var file in _projectFiles)
            {
                var info = GetFileInfo(file.FileName);
                var isActive = _selectedFile?.Id == file.Id;
                var isEditing = _editingFile?.Id == file.Id;

                <li class="file-row file-row--@info.Variant @(isActive ? "is-active" : "")">
                    <span class="file-row__indicator" aria-hidden="true"></span>

                    <span class="file-row__icon" aria-hidden="true">
                        <Icon Name="@info.Icon" />
                    </span>

                    @if (isEditing)
                    {
                        <input type="text"
                               class="file-row__rename"
                               @bind="_editingName"
                               @bind:event="oninput"
                               @onkeydown="OnRenameKeyDownAsync"
                               @onblur="() => CommitRenameAsync(file)"
                               placeholder="@Traductor.T("FILES_RENAME_PLACEHOLDER")"
                               aria-label="@Traductor.T("FILES_RENAME")"
                               autofocus />
                    }
                    else
                    {
                        <button type="button"
                                class="file-row__name"
                                @onclick="() => OpenFileAsync(file)"
                                title="@file.FileName">
                            @file.FileName
                        </button>
                    }

                    <span class="file-row__chip">@info.Ext</span>

                    @if (!isEditing)
                    {
                        <button type="button"
                                class="btn btn-ghost btn-sm file-row__open"
                                @onclick="() => OpenFileAsync(file)">
                            <Icon Name="IconName.BoxArrowUpRight" />
                            <span>@Traductor.T("FILES_OPEN")</span>
                        </button>

                        <details class="file-row__menu">
                            <summary class="btn btn-ghost btn-sm file-row__menu-btn"
                                     aria-label="@Traductor.T("FILES_MORE_ACTIONS")"
                                     title="@Traductor.T("FILES_MORE_ACTIONS")">
                                <Icon Name="IconName.ThreeDotsVertical" />
                            </summary>
                            <div class="file-row__menu-panel" role="menu">
                                <button type="button" role="menuitem"
                                        class="file-row__menu-item"
                                        @onclick="() => StartRename(file)">
                                    <Icon Name="IconName.Pencil" />
                                    <span>@Traductor.T("FILES_RENAME")</span>
                                </button>
                                <button type="button" role="menuitem"
                                        class="file-row__menu-item file-row__menu-item--danger"
                                        @onclick="() => RemoveFileAsync(file)">
                                    <Icon Name="IconName.Trash" />
                                    <span>@Traductor.T("FILES_DELETE")</span>
                                </button>
                            </div>
                        </details>
                    }
                </li>
            }
        </ul>
    }
</div>

<ConfirmDialog @ref="_removeFileDialog" />

@code {
    [Parameter] public Project Project { get; set; } = null!;
    [Parameter] public EventCallback<ProjectFile> OnProjectFileClicked { get; set; } = new();
    [Parameter] public EventCallback<ProjectFile> OnProjectFileRemoved { get; set; } = new();

    private List<ProjectFile> _projectFiles { get; set; } = new();
    private ConfirmDialog _removeFileDialog = new();
    private ProjectFile? _selectedFile;
    private ProjectFile? _editingFile;
    private string _editingName = string.Empty;

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        if (Project != null)
        {
            _projectFiles = await ProjectFiles.GetProjectFilesAsync(Project);
            if (_projectFiles.Count > 0)
                _selectedFile = _projectFiles.First();
        }
    }

    /// <summary>
    /// Marks <paramref name="file"/> as the active selection. Safe to call
    /// before this component has been rendered — FilesCard now lives inside
    /// a dock tab that may not be visible on the first pass, so the parent
    /// Editor calls this while our render handle still doesn't exist.
    /// When that happens we just set the field; the component will render
    /// with the correct selection whenever the Files tab is first shown.
    /// </summary>
    public void SetDefaultFile(ProjectFile file)
    {
        _selectedFile = _projectFiles.FirstOrDefault(p => p.Id == file.Id);
        try
        {
            InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
            // Not yet rendered — no handle assigned. The current _selectedFile
            // will be picked up on first render, no action needed.
        }
    }

    public async Task ReloadFiles()
    {
        if (Project != null)
            _projectFiles = await ProjectFiles.GetProjectFilesAsync(Project);
    }

    private async Task OpenFileAsync(ProjectFile file)
    {
        _selectedFile = file;
        await OnProjectFileClicked.InvokeAsync(file);
    }

    /// <summary>
    /// Enters inline-edit mode for <paramref name="file"/>. The kebab menu auto-closes
    /// because moving focus out of the &lt;details&gt; collapses it natively.
    /// </summary>
    private void StartRename(ProjectFile file)
    {
        _editingFile = file;
        _editingName = file.FileName;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs e)
    {
        if (_editingFile == null) return;
        if (e.Key == "Enter")
        {
            await CommitRenameAsync(_editingFile);
        }
        else if (e.Key == "Escape")
        {
            CancelRename();
        }
    }

    private async Task CommitRenameAsync(ProjectFile file)
    {
        if (_editingFile == null) return;

        var newName = _editingName?.Trim() ?? string.Empty;

        // No-op if empty or unchanged — exit edit mode quietly
        if (string.IsNullOrWhiteSpace(newName) ||
            string.Equals(newName, file.FileName, StringComparison.Ordinal))
        {
            CancelRename();
            return;
        }

        file.Project = Project;
        var ok = await ProjectFiles.RenameAsync(file, newName);

        if (ok)
        {
            file.FileName = newName;
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_RENAMED_SUCCESS"), ToastType.Success));
            _editingFile = null;
            _editingName = string.Empty;
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                $"{Traductor.T("FILES_RENAMED_ERROR")}: {ProjectFiles.LastError}", ToastType.Danger));
            // Stay in edit mode so the user can correct and retry
        }
        StateHasChanged();
    }

    private void CancelRename()
    {
        _editingFile = null;
        _editingName = string.Empty;
    }

    private async Task RemoveFileAsync(ProjectFile file)
    {
        var options = new ConfirmDialogOptions
        {
            YesButtonColor = ButtonColor.Danger,
            NoButtonColor = ButtonColor.Secondary,
            AutoFocusYesButton = false,
            YesButtonText = Traductor.T("FILES_DELETE"),
            NoButtonText = Traductor.T("COMMON_GO_BACK")
        };
        var confirmed = await _removeFileDialog.ShowAsync(
            Traductor.T("FILES_REMOVE_TITLE"),
            Traductor.T("FILES_REMOVE_MSG1"),
            Traductor.T("FILES_REMOVE_MSG2"),
            options);

        if (!confirmed)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_NOT_REMOVED"), ToastType.Info));
            return;
        }

        file.Project = Project;
        var ok = await ProjectFiles.RemoveAsync(file);

        if (ok)
        {
            _projectFiles.RemoveAll(f => f.Id == file.Id);
            if (_selectedFile?.Id == file.Id)
                _selectedFile = _projectFiles.FirstOrDefault();
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_REMOVED_SUCCESS"), ToastType.Success));
            await OnProjectFileRemoved.InvokeAsync(file);
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                $"{Traductor.T("FILES_REMOVED_ERROR")}: {ProjectFiles.LastError}", ToastType.Danger));
        }
        StateHasChanged();
    }

    private record FileInfo(IconName Icon, string Variant, string Ext);

    /// <summary>
    /// Maps a file extension to icon + variant + uppercase extension label.
    /// Variant drives the CSS color treatment (tinted icon + chip accent).
    /// </summary>
    private FileInfo GetFileInfo(string fileName)
    {
        if (!fileName.Contains('.'))
            return new FileInfo(IconName.FileEarmark, "other", "");

        var ext = fileName.Substring(fileName.LastIndexOf('.')).ToLowerInvariant();
        var label = ext.TrimStart('.').ToUpperInvariant();

        return ext switch
        {
            ".vhd" or ".vhdl" => new FileInfo(IconName.FileCode,    "vhdl",     label),
            ".md"              => new FileInfo(IconName.FileTypeMd,  "markdown", label),
            ".txt"             => new FileInfo(IconName.FileTypeTxt, "text",     label),
            ".json"            => new FileInfo(IconName.Braces,      "json",     label),
            ".xml"             => new FileInfo(IconName.Code,        "xml",      label),
            _                  => new FileInfo(IconName.FileEarmark, "other",    label),
        };
    }
}
