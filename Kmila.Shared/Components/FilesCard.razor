<!-- Enhanced Project Files Card -->
@implements IDisposable
<Card Class="h-100">
    <CardHeader>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <Icon Name="IconName.Folder" Class="me-2" />
                <strong>@Traductor.T("FILES_PROJECT_FILES")</strong>
            </div>
            @if(_projectFiles.Any())
            {
                <Badge Color="BadgeColor.Primary" Pill="true">
                    @_projectFiles.Count @(_projectFiles.Count == 1 ? Traductor.T("FILES_FILE") : Traductor.T("FILES_FILES"))
                </Badge>
            }
        </div>
    </CardHeader>
    <CardBody>
        @if(!_projectFiles.Any())
        {
            <!-- Empty State -->
            <Alert Color="AlertColor.Info" Class="mb-0 text-center">
                <Icon Name="IconName.InfoCircle" Size="IconSize.x3" Class="d-block mx-auto mb-2" />
                <strong>@Traductor.T("FILES_NO_FILES")</strong>
                <p class="mb-0 small text-muted mt-1">@Traductor.T("FILES_CREATE_FIRST")</p>
            </Alert>
        }
        else
        {
            <!-- File Statistics Bar -->
            <div class="row g-2 mb-3">
                @{
                    var vhdlCount = _projectFiles.Count(f => f.FileName.EndsWith(".vhdl") || f.FileName.EndsWith(".vhd"));
                    var txtCount = _projectFiles.Count(f => f.FileName.EndsWith(".txt"));
                    var mdCount = _projectFiles.Count(f => f.FileName.EndsWith(".md"));
                    var otherCount = _projectFiles.Count - vhdlCount - txtCount - mdCount;
                }

                @if(vhdlCount > 0)
                {
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <Icon Name="IconName.FileCode" Class="text-primary" />
                            <div class="small text-muted">VHDL</div>
                            <strong>@vhdlCount</strong>
                        </div>
                    </div>
                }
                @if(txtCount > 0)
                {
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <Icon Name="IconName.FileTypeTxt" Class="text-info" />
                            <div class="small text-muted">@Traductor.T("FILES_TEXT")</div>
                            <strong>@txtCount</strong>
                        </div>
                    </div>
                }
                @if(mdCount > 0)
                {
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <Icon Name="IconName.FileTypeMd" Class="text-success" />
                            <div class="small text-muted">Markdown</div>
                            <strong>@mdCount</strong>
                        </div>
                    </div>
                }
                @if(otherCount > 0)
                {
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 text-center">
                            <Icon Name="IconName.FileEarmark" Class="text-secondary" />
                            <div class="small text-muted">@Traductor.T("FILES_OTHER")</div>
                            <strong>@otherCount</strong>
                        </div>
                    </div>
                }
            </div>

            <!-- Files Grid -->
            <Grid TItem="ProjectFile"
                AllowFiltering="true"
                AllowPaging="true"
                AllowSorting="true"
                Class="table table-hover table-bordered"
                Data="_projectFiles"
                PageSize="15"
                Responsive="true">

                <GridColumns>
                    <GridColumn TItem="ProjectFile" HeaderText="@Traductor.T("FILES_FILE")" PropertyName="FileName" SortKeySelector="item => item.FileName">
                        <div class="d-flex align-items-center">
                            @{
                                var (iconName, badgeColor, fileExt) = GetFileInfo(context.FileName);
                                var isSelected = _selectedFile?.Id == context.Id;
                            }

                            <Icon Name="@iconName" Class="me-2" Size="IconSize.x5" />

                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center">
                                    <strong class="@(isSelected ? "text-success" : "")">
                                        @context.FileName.Substring(0, context.FileName.LastIndexOf("."))
                                    </strong>
                                    @if(isSelected)
                                    {
                                        <Badge Color="BadgeColor.Success" Class="ms-2">
                                            <Icon Name="IconName.CheckCircleFill" Class="me-1" />
                                            @Traductor.T("FILES_ACTIVE")
                                        </Badge>
                                    }
                                </div>
                                <small class="text-muted">
                                    <Badge Color="@badgeColor" Class="mt-1">
                                        @fileExt.ToUpper()
                                    </Badge>
                                </small>
                            </div>
                        </div>
                    </GridColumn>

                    <GridColumn TItem="ProjectFile" HeaderText="@Traductor.T("FILES_ACTIONS")" Sortable=false Filterable=false>
                        <div class="btn-group" role="group">
                            <Button
                                Size="ButtonSize.Small"
                                Outline=true
                                Color="ButtonColor.Primary"
                                TooltipTitle="@Traductor.T("FILES_OPEN")"
                                Type="ButtonType.Button"
                                @onclick="@(async () => await OpenFileAsync(context))"
                            >
                                <Icon Name="IconName.BoxArrowUpRight" Class="me-1" />
                                @Traductor.T("FILES_OPEN")
                            </Button>
                            <Button
                                Size="ButtonSize.Small"
                                Outline=true
                                Color="ButtonColor.Danger"
                                TooltipTitle="@Traductor.T("FILES_DELETE")"
                                Type="ButtonType.Button"
                                @onclick="@(async () => await RemoveFileAsync(context))"
                            >
                                <Icon Name="IconName.Trash" />
                            </Button>
                        </div>
                    </GridColumn>
                </GridColumns>
            </Grid>
        }
    </CardBody>
</Card>
<ConfirmDialog @ref=_removeFileDialog/>
@code{
    /// <summary>
    /// Gets or sets the project.
    /// </summary>
    [Parameter]
    public Project Project { get; set; } = null!;
    /// <summary>
    /// Gets or sets the event callback for when a project file is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<ProjectFile> OnProjectFileClicked { get; set; } = new();
    /// <summary>
    /// Gets or sets the event callback for when a project file is removed.
    /// </summary>
    [Parameter]
    public EventCallback<ProjectFile> OnProjectFileRemoved { get; set; } = new();
    private List<ProjectFile> _projectFiles { get; set; } = new();
    private ConfirmDialog _removeFileDialog = new();
    private ProjectFile? _selectedFile = null;

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
    }

    /// <summary>
    /// Method invoked when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync(){
        if(Project != null){
            _projectFiles = await ProjectFiles.GetProjectFilesAsync(Project);
            if(_projectFiles.Count > 0){
                _selectedFile = _projectFiles.First();
            }
        }
    }
    /// <summary>
    /// Sets the default file.
    /// </summary>
    /// <param name="file">The file to set as default.</param>
    public void SetDefaultFile(ProjectFile file){
        try{
            _selectedFile = _projectFiles.FirstOrDefault(p => p.Id == file.Id);
        }finally{
            InvokeAsync(StateHasChanged);
        }
        
    }
    /// <summary>
    /// Reloads the files for the project.
    /// </summary>
    public async Task ReloadFiles(){
        if(Project != null){
            _projectFiles = await ProjectFiles.GetProjectFilesAsync(Project);
        }
    }
    /// <summary>
    /// Opens a file in the editor.
    /// </summary>
    /// <param name="file">The file to open.</param>
    private async Task OpenFileAsync(ProjectFile file)
    {
        _selectedFile = file;
        await OnProjectFileClicked.InvokeAsync(file);
    }

    /// <summary>
    /// Removes a file asynchronously.
    /// </summary>
    /// <param name="file">The file to remove.</param>
    private async Task RemoveFileAsync(ProjectFile file){
        ConfirmDialogOptions options = new(){
            YesButtonColor = ButtonColor.Danger,
            NoButtonColor = ButtonColor.Success,
            AutoFocusYesButton = false,
            YesButtonText = Traductor.T("FILES_DELETE"),
            NoButtonText = Traductor.T("COMMON_GO_BACK")
        };
        var confirmation = await _removeFileDialog.ShowAsync(
            Traductor.T("FILES_REMOVE_TITLE"),
            Traductor.T("FILES_REMOVE_MSG1"),
            Traductor.T("FILES_REMOVE_MSG2"),
            options
        );
        if(confirmation){
            await OnProjectFileRemoved.InvokeAsync(file);
        }else{
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_NOT_REMOVED"), ToastType.Info));
        }
    }

    /// <summary>
    /// Gets file information including icon, badge color, and extension.
    /// </summary>
    /// <param name="fileName">The file name to analyze.</param>
    /// <returns>A tuple containing the icon name, badge color, and file extension.</returns>
    private (IconName iconName, BadgeColor badgeColor, string extension) GetFileInfo(string fileName)
    {
        if (!fileName.Contains("."))
        {
            return (IconName.FileEarmark, BadgeColor.Secondary, "");
        }

        var extension = fileName.Substring(fileName.LastIndexOf("."));
        var lowerExt = extension.ToLower();

        if (lowerExt == ".vhdl" || lowerExt == ".vhd")
        {
            return (IconName.FileCode, BadgeColor.Primary, extension);
        }
        else if (lowerExt == ".txt")
        {
            return (IconName.FileTypeTxt, BadgeColor.Info, extension);
        }
        else if (lowerExt == ".md")
        {
            return (IconName.FileTypeMd, BadgeColor.Success, extension);
        }
        else
        {
            return (IconName.FileEarmark, BadgeColor.Secondary, extension);
        }
    }
}