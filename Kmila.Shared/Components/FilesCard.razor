@*
    FilesCard — project files & folders tree.

    Now folder-aware: groups files by DirectoryPath into a collapsible tree, with
    a toolbar exposing "New file" / "New folder", a kebab menu per row (rename,
    move, delete, set entry, details for files; rename/new file/new folder/delete
    for folders), and HTML5 drag-and-drop to move files between folders. The
    repository handles disk + DB persistence — this component only orchestrates.

    Tree is flattened into a single ordered list (DFS) so we don't need a
    recursive sub-component; row indentation is driven by depth alone.
*@
@implements IDisposable

<div class="files-list">
    <header class="files-list__header">
        <Icon Name="IconName.Folder2Open" />
        <span class="files-list__title">@Traductor.T("FILES_PROJECT_FILES")</span>
        @if (_projectFiles.Any())
        {
            <span class="files-list__count">@_projectFiles.Count</span>
        }
        <div class="files-list__toolbar">
            <KmilaTooltip TextKey="FILES_NEW_FILE">
                <button type="button"
                        class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        aria-label="@Traductor.T("FILES_NEW_FILE")"
                        @onclick="() => RequestNewFile(string.Empty)">
                    <Icon Name="IconName.FileEarmarkPlus" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="FILES_NEW_FOLDER">
                <button type="button"
                        class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        aria-label="@Traductor.T("FILES_NEW_FOLDER")"
                        @onclick="() => StartNewFolder(string.Empty)">
                    <Icon Name="IconName.FolderPlus" />
                </button>
            </KmilaTooltip>
        </div>
    </header>

    @if (!_projectFiles.Any() && !_directories.Any() && _newFolderParent == null)
    {
        <div class="files-list__empty">
            <div class="files-list__empty-icon"><Icon Name="IconName.FileEarmarkPlus" /></div>
            <p><strong>@Traductor.T("FILES_NO_FILES")</strong></p>
            <p class="files-list__empty-sub">@Traductor.T("FILES_CREATE_FIRST")</p>
        </div>
    }
    else
    {
        var rows = BuildFlatTree();
        <ul class="files-list__items files-tree" role="tree"
            @ondragover:preventDefault="true"
            @ondrop="() => OnDropOnFolderAsync(string.Empty)"
            @ondrop:preventDefault="true">
            @* Inline new-folder input at root *@
            @if (_newFolderParent == string.Empty)
            {
                <li class="file-row file-row--folder is-editing" style="padding-left: 0">
                    <span class="file-row__icon"><Icon Name="IconName.Folder2" /></span>
                    <input type="text"
                           class="file-row__rename"
                           placeholder="@Traductor.T("FILES_FOLDER_NAME_PROMPT")"
                           @bind="_newFolderName"
                           @bind:event="oninput"
                           @onkeydown="OnNewFolderKeyDownAsync"
                           @onblur="CommitNewFolderAsync"
                           autofocus />
                </li>
            }

            @foreach (var row in rows)
            {
                if (row.IsFolder)
                {
                    var path = row.FolderPath!;
                    var isExpanded = !_collapsedFolders.Contains(path);
                    var isDropTarget = _dragOverFolder == path;
                    var isRenaming = _renamingFolderPath == path;
                    <li class="file-row file-row--folder @(isDropTarget ? "is-drop" : "")"
                        style="padding-left: @(row.Depth * 16)px"
                        @ondragover:preventDefault="true"
                        @ondragover="() => OnFolderDragOver(path)"
                        @ondragleave="() => OnFolderDragLeave(path)"
                        @ondrop="() => OnDropOnFolderAsync(path)"
                        @ondrop:preventDefault="true">
                        <button type="button"
                                class="file-row__chevron"
                                @onclick="() => ToggleFolder(path)"
                                aria-label="@Traductor.T(isExpanded ? "FILES_COLLAPSE" : "FILES_EXPAND")">
                            <Icon Name="@(isExpanded ? IconName.ChevronDown : IconName.ChevronRight)" />
                        </button>
                        <span class="file-row__icon">
                            <Icon Name="@(isExpanded ? IconName.Folder2Open : IconName.Folder2)" />
                        </span>
                        @if (isRenaming)
                        {
                            <input type="text"
                                   class="file-row__rename"
                                   @bind="_renamingFolderName"
                                   @bind:event="oninput"
                                   @onkeydown="OnFolderRenameKeyDownAsync"
                                   @onblur="() => CommitFolderRenameAsync(path)"
                                   autofocus />
                        }
                        else
                        {
                            <button type="button"
                                    class="file-row__name"
                                    @onclick="() => ToggleFolder(path)">
                                @row.FolderName
                            </button>
                        }

                        @if (!isRenaming)
                        {
                            var folderMenuKey = $"folder:{path}";
                            <button type="button"
                                    class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm file-row__menu-btn @(_openMenuKey == folderMenuKey ? "is-open" : "")"
                                    data-kmila-menu-key="@folderMenuKey"
                                    aria-label="@Traductor.T("FILES_MORE_ACTIONS")"
                                    @onclick:stopPropagation="true"
                                    @onclick="async (e) => await ToggleMenuAsync(folderMenuKey, e)">
                                <Icon Name="IconName.ThreeDotsVertical" />
                            </button>
                        }
                    </li>

                    @* Inline new-folder input nested under a folder *@
                    if (_newFolderParent == path)
                    {
                        <li class="file-row file-row--folder is-editing"
                            style="padding-left: @((row.Depth + 1) * 16)px">
                            <span class="file-row__icon"><Icon Name="IconName.Folder2" /></span>
                            <input type="text"
                                   class="file-row__rename"
                                   placeholder="@Traductor.T("FILES_FOLDER_NAME_PROMPT")"
                                   @bind="_newFolderName"
                                   @bind:event="oninput"
                                   @onkeydown="OnNewFolderKeyDownAsync"
                                   @onblur="CommitNewFolderAsync"
                                   autofocus />
                        </li>
                    }
                }
                else
                {
                    var file = row.File!;
                    var info = GetFileInfo(file.FileName);
                    var isActive = _selectedFile?.Id == file.Id;
                    var isEditing = _editingFile?.Id == file.Id;
                    var isEntry = _entryFileName != null && string.Equals(_entryFileName, file.RelativePath, StringComparison.Ordinal);
                    <li class="file-row file-row--@info.Variant @(isActive ? "is-active" : "") @(isEntry ? "is-entry" : "")"
                        style="padding-left: @(row.Depth * 16)px"
                        draggable="true"
                        @ondragstart="() => OnFileDragStartAsync(file.Id)"
                        @ondragend="OnFileDragEndAsync"
                        @onclick="() => OpenFileAsync(file)">
                        <span class="file-row__indicator" aria-hidden="true"></span>

                        <span class="file-row__icon" aria-hidden="true">
                            <Icon Name="@info.Icon" />
                            @if (isEntry)
                            {
                                <span class="file-row__entry-marker"
                                      title="@Traductor.T("FILES_ENTRY_POINT")"
                                      aria-label="@Traductor.T("FILES_ENTRY_POINT")">
                                    <Icon Name="IconName.StarFill" />
                                </span>
                            }
                        </span>

                        @if (isEditing)
                        {
                            <input type="text"
                                   class="file-row__rename"
                                   @bind="_editingName"
                                   @bind:event="oninput"
                                   @onkeydown="OnRenameKeyDownAsync"
                                   @onblur="() => CommitRenameAsync(file)"
                                   placeholder="@Traductor.T("FILES_RENAME_PLACEHOLDER")"
                                   autofocus />
                        }
                        else
                        {
                            <button type="button"
                                    class="file-row__name"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => OpenFileAsync(file)"
                                    title="@file.RelativePath">
                                @file.FileName
                            </button>
                        }

                        <span class="file-row__chip">@info.Ext</span>

                        @if (!isEditing)
                        {
                            <KmilaTooltip TextKey="FILES_OPEN_TIP" Placement="Left">
                                <button type="button"
                                        class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm file-row__open"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenFileAsync(file)">
                                    <Icon Name="IconName.BoxArrowUpRight" />
                                    <span>@Traductor.T("FILES_OPEN")</span>
                                </button>
                            </KmilaTooltip>

                            var fileMenuKey = $"file:{file.Id}";
                            <KmilaTooltip TextKey="FILES_MORE_ACTIONS">
                                <button type="button"
                                        class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm file-row__menu-btn @(_openMenuKey == fileMenuKey ? "is-open" : "")"
                                        data-kmila-menu-key="@fileMenuKey"
                                        aria-label="@Traductor.T("FILES_MORE_ACTIONS")"
                                        @onclick:stopPropagation="true"
                                        @onclick="async (e) => await ToggleMenuAsync(fileMenuKey, e)">
                                    <Icon Name="IconName.ThreeDotsVertical" />
                                </button>
                            </KmilaTooltip>
                        }
                    </li>
                }
            }
        </ul>
    }
</div>

@* Single floating popover for the kebab menu of whichever row is currently
   "open". Rendered at the FilesCard root so it can use position:fixed and
   escape any ancestor with overflow:hidden. The contents switch based on
   _openMenuKey ("folder:..." vs "file:...") and only shows when JS interop
   has resolved a position — so we never paint at (0,0) covering anything. *@
@if (_openMenuKey != null && _menuTop.HasValue)
{
    <div class="file-row__menu-backdrop" @onclick="CloseMenu"></div>
    <div class="file-row__menu-panel"
         role="menu"
         style="@BuildMenuPanelStyle()"
         @onclick:stopPropagation="true">
        @{
            var k = _openMenuKey;
            if (k.StartsWith("folder:"))
            {
                var path = k.Substring("folder:".Length);
                <KmilaTooltip TextKey="FILES_NEW_FILE_IN_FOLDER_TIP" Placement="Left">
                    <button type="button" class="file-row__menu-item"
                            @onclick="() => OnMenuItem(() => RequestNewFile(path))">
                        <Icon Name="IconName.FileEarmarkPlus" />
                        <span>@Traductor.T("FILES_NEW_FILE")</span>
                    </button>
                </KmilaTooltip>
                <KmilaTooltip TextKey="FILES_NEW_SUBFOLDER_TIP" Placement="Left">
                    <button type="button" class="file-row__menu-item"
                            @onclick="() => OnMenuItemSync(() => StartNewFolder(path))">
                        <Icon Name="IconName.FolderPlus" />
                        <span>@Traductor.T("FILES_NEW_FOLDER")</span>
                    </button>
                </KmilaTooltip>
                <KmilaTooltip TextKey="FILES_FOLDER_RENAME_TIP" Placement="Left">
                    <button type="button" class="file-row__menu-item"
                            @onclick="() => OnMenuItemSync(() => StartFolderRename(path))">
                        <Icon Name="IconName.Pencil" />
                        <span>@Traductor.T("FILES_FOLDER_RENAME")</span>
                    </button>
                </KmilaTooltip>
                <KmilaTooltip TextKey="FILES_FOLDER_DELETE_TIP" Placement="Left">
                    <button type="button"
                            class="file-row__menu-item file-row__menu-item--danger"
                            @onclick="() => OnMenuItem(() => RemoveFolderAsync(path))">
                        <Icon Name="IconName.Trash" />
                        <span>@Traductor.T("FILES_DELETE")</span>
                    </button>
                </KmilaTooltip>
            }
            else if (k.StartsWith("file:") && int.TryParse(k.Substring("file:".Length), out var fid))
            {
                var f = _projectFiles.FirstOrDefault(x => x.Id == fid);
                if (f != null)
                {
                    var fIsEntry = _entryFileName != null && string.Equals(_entryFileName, f.RelativePath, StringComparison.Ordinal);
                    <KmilaTooltip TextKey="@(fIsEntry ? "FILES_CLEAR_ENTRY_TIP" : "FILES_SET_AS_ENTRY_TIP")" Placement="Left">
                        <button type="button" role="menuitem"
                                class="file-row__menu-item"
                                @onclick="() => OnMenuItem(() => ToggleEntryPointAsync(f))">
                            <Icon Name="@(fIsEntry ? IconName.StarFill : IconName.Star)" />
                            <span>@Traductor.T(fIsEntry ? "FILES_CLEAR_ENTRY" : "FILES_SET_AS_ENTRY")</span>
                        </button>
                    </KmilaTooltip>
                    <KmilaTooltip TextKey="FILES_RENAME_TIP" Placement="Left">
                        <button type="button" role="menuitem"
                                class="file-row__menu-item"
                                @onclick="() => OnMenuItemSync(() => StartRename(f))">
                            <Icon Name="IconName.Pencil" />
                            <span>@Traductor.T("FILES_RENAME")</span>
                        </button>
                    </KmilaTooltip>
                    <KmilaTooltip TextKey="FILES_DETAILS_TIP" Placement="Left">
                        <button type="button" role="menuitem"
                                class="file-row__menu-item"
                                @onclick="() => OnMenuItem(() => OpenDetailsAsync(f))">
                            <Icon Name="IconName.InfoCircle" />
                            <span>@Traductor.T("FILES_DETAILS")</span>
                        </button>
                    </KmilaTooltip>
                    @foreach (var target in MoveTargetsFor(f))
                    {
                        var capturedPath = target.Path;
                        <button type="button" role="menuitem"
                                class="file-row__menu-item"
                                @onclick="() => OnMenuItem(() => MoveFileAsync(f, capturedPath))">
                            <Icon Name="IconName.ArrowRight" />
                            <span>@Traductor.T("FILES_MOVE_TO"): @target.Label</span>
                        </button>
                    }
                    <KmilaTooltip TextKey="FILES_FILE_DELETE_TIP" Placement="Left">
                        <button type="button" role="menuitem"
                                class="file-row__menu-item file-row__menu-item--danger"
                                @onclick="() => OnMenuItem(() => RemoveFileAsync(f))">
                            <Icon Name="IconName.Trash" />
                            <span>@Traductor.T("FILES_DELETE")</span>
                        </button>
                    </KmilaTooltip>
                }
            }
        }
    </div>
}

<ConfirmDialog @ref="_removeFileDialog" />
<ConfirmDialog @ref="_removeFolderDialog" />

<Modal @ref="_createFileModal" Title="@Traductor.T("CREATE_FILE_TITLE")" />
<Modal @ref="_detailsModal" Title="@Traductor.T("FILES_DETAILS_TITLE")" />

@code {
    [Parameter] public Project Project { get; set; } = null!;
    [Parameter] public EventCallback<ProjectFile> OnProjectFileClicked { get; set; } = new();
    [Parameter] public EventCallback<ProjectFile> OnProjectFileRemoved { get; set; } = new();
    /// <summary>
    /// Raised when the user asks to create a new file (toolbar button or a
    /// folder's "new file" menu), with the target sub-directory ("" = root).
    /// When wired, the parent (Editor) opens the create-file modal from its own
    /// root — FilesCard's inline modal is nested in the dock's stacking/overflow
    /// context and renders as a frozen backdrop with no dialog (#5). Falls back
    /// to the inline modal when no handler is attached (standalone use).
    /// </summary>
    [Parameter] public EventCallback<string> OnNewFileRequested { get; set; }

    /// <summary>Fires when the entry-point marker is set or cleared. Payload is
    /// the new entry file's RelativePath, or null when cleared. Lets the editor
    /// keep the Run-target picker label in sync.</summary>
    [Parameter] public EventCallback<string?> OnEntryPointChanged { get; set; }

    private List<ProjectFile> _projectFiles { get; set; } = new();
    private List<string> _directories { get; set; } = new();
    private ConfirmDialog _removeFileDialog = new();
    private ConfirmDialog _removeFolderDialog = new();
    private Modal _createFileModal = default!;
    private Modal _detailsModal = default!;
    private ProjectFile? _selectedFile;
    private ProjectFile? _editingFile;
    private string _editingName = string.Empty;
    private string? _entryFileName;
    private int _loadedProjectId = -1;

    // Folder UI state — tracked locally because directories aren't a DB entity.
    private HashSet<string> _collapsedFolders = new(StringComparer.OrdinalIgnoreCase);
    private string? _newFolderParent;          // null = no input shown
    private string _newFolderName = string.Empty;
    private string? _renamingFolderPath;
    private string _renamingFolderName = string.Empty;

    // Drag-and-drop
    private int? _draggedFileId;
    private string? _dragOverFolder;

    // Kebab menu — Blazor-controlled to avoid the toggle-event timing issues
    // we hit with <details>: the panel never paints at (0,0) because it's only
    // rendered once JS interop returns the trigger's rect.
    private string? _openMenuKey;
    private double? _menuTop;
    private double? _menuLeft;
    // Inline caps applied to the panel after placement so it scrolls instead
    // of overflowing the viewport when the actual menu is taller/wider than
    // our estimates (lots of move-to-folder items, long folder names, etc.).
    private double? _menuMaxHeight;
    private double? _menuMaxWidth;

    // Modal state
    private string _pendingNewFileDir = string.Empty;
    private ProjectFile? _detailsFile;

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        var currentId = Project?.Id ?? -1;
        if (currentId == _loadedProjectId) return;
        _loadedProjectId = currentId;

        if (Project != null)
        {
            await ReloadAllAsync();
            if (_selectedFile == null && _projectFiles.Count > 0)
                _selectedFile = _projectFiles.First();
            _entryFileName = await DbContext.GetProjectMainFileAsync(Project.Id);
        }
        else
        {
            _projectFiles.Clear();
            _directories.Clear();
            _selectedFile = null;
            _entryFileName = null;
        }
    }

    public async Task ReloadFiles()
    {
        if (Project != null)
            await ReloadAllAsync();
    }

    private async Task ReloadAllAsync()
    {
        if (Project == null) return;
        _projectFiles = await ProjectFiles.GetProjectFilesAsync(Project);
        _directories = await ProjectFiles.GetDirectoriesAsync(Project);
    }

    public void SetDefaultFile(ProjectFile file)
    {
        _selectedFile = _projectFiles.FirstOrDefault(p => p.Id == file.Id);
        try { InvokeAsync(StateHasChanged); }
        catch (InvalidOperationException) { /* not yet rendered */ }
    }

    // ---- Tree rendering ------------------------------------------------------

    private record TreeRow(int Depth, bool IsFolder, string? FolderPath, string? FolderName, ProjectFile? File);

    /// <summary>
    /// Flattens the project's files + observed directories into a depth-first list of
    /// rows for rendering. Folders that appear in <c>_collapsedFolders</c> hide their
    /// descendants, but the folder row itself stays visible with a chevron.
    /// </summary>
    private List<TreeRow> BuildFlatTree()
    {
        var rows = new List<TreeRow>();
        var allDirs = new SortedSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var d in _directories) if (!string.IsNullOrEmpty(d)) allDirs.Add(d);
        foreach (var f in _projectFiles)
        {
            if (string.IsNullOrEmpty(f.DirectoryPath)) continue;
            var parts = f.DirectoryPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
            for (int i = 1; i <= parts.Length; i++)
                allDirs.Add(string.Join('/', parts.Take(i)));
        }

        // Recurse manually using a stack of "render this directory" frames.
        void EmitDirectory(string parent, int depth)
        {
            // Sub-folders directly under `parent`
            var prefix = string.IsNullOrEmpty(parent) ? string.Empty : parent + "/";
            var children = allDirs
                .Where(d => string.IsNullOrEmpty(parent)
                    ? !d.Contains('/')
                    : d.StartsWith(prefix) && !d.Substring(prefix.Length).Contains('/'))
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();
            foreach (var child in children)
            {
                var leaf = string.IsNullOrEmpty(parent) ? child : child.Substring(prefix.Length);
                rows.Add(new TreeRow(depth, true, child, leaf, null));
                if (!_collapsedFolders.Contains(child))
                    EmitDirectory(child, depth + 1);
            }
            // Files in `parent`
            var fileChildren = _projectFiles
                .Where(f => string.Equals(f.DirectoryPath ?? string.Empty, parent ?? string.Empty, StringComparison.OrdinalIgnoreCase))
                .OrderBy(f => f.FileName, StringComparer.OrdinalIgnoreCase)
                .ToList();
            foreach (var f in fileChildren)
                rows.Add(new TreeRow(depth, false, null, null, f));
        }

        EmitDirectory(string.Empty, 0);
        return rows;
    }

    private void ToggleFolder(string path)
    {
        if (!_collapsedFolders.Add(path))
            _collapsedFolders.Remove(path);
    }

    // ---- Folder ops ----------------------------------------------------------

    private void StartNewFolder(string parent)
    {
        _newFolderParent = parent ?? string.Empty;
        _newFolderName = string.Empty;
        // Make sure the parent is expanded so the input is visible
        if (!string.IsNullOrEmpty(parent)) _collapsedFolders.Remove(parent);
    }

    private async Task OnNewFolderKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CommitNewFolderAsync();
        else if (e.Key == "Escape") { _newFolderParent = null; _newFolderName = string.Empty; }
    }

    private async Task CommitNewFolderAsync()
    {
        if (_newFolderParent == null) return;
        var name = (_newFolderName ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(name)) { _newFolderParent = null; return; }
        if (name.Contains('/') || name.Contains('\\'))
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), Traductor.T("FILES_INVALID_FOLDER_NAME"), ToastType.Danger));
            return;
        }
        var path = string.IsNullOrEmpty(_newFolderParent) ? name : $"{_newFolderParent}/{name}";
        var ok = await ProjectFiles.CreateDirectoryAsync(Project, path);
        if (ok)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_FOLDER_CREATED"), ToastType.Success));
            await ReloadAllAsync();
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ProjectFiles.LastError, ToastType.Danger));
        }
        _newFolderParent = null;
        _newFolderName = string.Empty;
        StateHasChanged();
    }

    private void StartFolderRename(string path)
    {
        _renamingFolderPath = path;
        _renamingFolderName = path.Contains('/') ? path.Substring(path.LastIndexOf('/') + 1) : path;
    }

    private async Task OnFolderRenameKeyDownAsync(KeyboardEventArgs e)
    {
        if (_renamingFolderPath == null) return;
        if (e.Key == "Enter") await CommitFolderRenameAsync(_renamingFolderPath);
        else if (e.Key == "Escape") { _renamingFolderPath = null; _renamingFolderName = string.Empty; }
    }

    private async Task CommitFolderRenameAsync(string oldPath)
    {
        if (_renamingFolderPath == null) return;
        var newName = (_renamingFolderName ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(newName) || newName.Contains('/') || newName.Contains('\\'))
        {
            _renamingFolderPath = null;
            return;
        }
        var parent = oldPath.Contains('/') ? oldPath.Substring(0, oldPath.LastIndexOf('/')) : string.Empty;
        var newPath = string.IsNullOrEmpty(parent) ? newName : $"{parent}/{newName}";
        if (string.Equals(oldPath, newPath, StringComparison.Ordinal))
        {
            _renamingFolderPath = null;
            return;
        }
        var ok = await ProjectFiles.RenameDirectoryAsync(Project, oldPath, newPath);
        if (ok)
        {
            await ReloadAllAsync();
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_RENAMED_SUCCESS"), ToastType.Success));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ProjectFiles.LastError, ToastType.Danger));
        }
        _renamingFolderPath = null;
        _renamingFolderName = string.Empty;
        StateHasChanged();
    }

    private async Task RemoveFolderAsync(string path)
    {
        var options = new ConfirmDialogOptions
        {
            YesButtonColor = ButtonColor.Danger,
            NoButtonColor = ButtonColor.Secondary,
            AutoFocusYesButton = false,
            YesButtonText = Traductor.T("FILES_DELETE"),
            NoButtonText = Traductor.T("COMMON_GO_BACK")
        };
        var confirmed = await _removeFolderDialog.ShowAsync(
            Traductor.T("FILES_FOLDER_REMOVE_CONFIRM"),
            path,
            string.Empty,
            options);
        if (!confirmed) return;

        var ok = await ProjectFiles.RemoveDirectoryAsync(Project, path);
        if (ok)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_FOLDER_REMOVED"), ToastType.Success));
            await ReloadAllAsync();
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ProjectFiles.LastError, ToastType.Danger));
        }
        StateHasChanged();
    }

    // ---- File ops ------------------------------------------------------------

    private async Task OpenFileAsync(ProjectFile file)
    {
        _selectedFile = file;
        await OnProjectFileClicked.InvokeAsync(file);
    }

    private void StartRename(ProjectFile file)
    {
        _editingFile = file;
        _editingName = file.FileName;
    }

    private async Task OnRenameKeyDownAsync(KeyboardEventArgs e)
    {
        if (_editingFile == null) return;
        if (e.Key == "Enter") await CommitRenameAsync(_editingFile);
        else if (e.Key == "Escape") CancelRename();
    }

    private async Task CommitRenameAsync(ProjectFile file)
    {
        if (_editingFile == null) return;

        var newName = _editingName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(newName) ||
            string.Equals(newName, file.FileName, StringComparison.Ordinal))
        {
            CancelRename();
            return;
        }

        file.Project = Project;
        var ok = await ProjectFiles.RenameAsync(file, newName);

        if (ok)
        {
            bool wasEntry = string.Equals(_entryFileName, file.RelativePath, StringComparison.Ordinal);
            file.FileName = newName;
            if (wasEntry && Project != null)
            {
                await DbContext.SetProjectMainFileAsync(Project.Id, file.RelativePath);
                _entryFileName = file.RelativePath;
            }
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_RENAMED_SUCCESS"), ToastType.Success));
            _editingFile = null;
            _editingName = string.Empty;
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                $"{Traductor.T("FILES_RENAMED_ERROR")}: {ProjectFiles.LastError}", ToastType.Danger));
        }
        StateHasChanged();
    }

    private void CancelRename()
    {
        _editingFile = null;
        _editingName = string.Empty;
    }

    private async Task ToggleEntryPointAsync(ProjectFile file)
    {
        if (Project == null || file == null) return;
        bool wasEntry = string.Equals(_entryFileName, file.RelativePath, StringComparison.Ordinal);
        try
        {
            if (wasEntry)
            {
                await DbContext.ClearProjectMainFileAsync(Project.Id);
                _entryFileName = null;
                ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                    string.Format(Traductor.T("FILES_ENTRY_CLEARED"), file.FileName), ToastType.Info));
            }
            else
            {
                await DbContext.SetProjectMainFileAsync(Project.Id, file.RelativePath);
                _entryFileName = file.RelativePath;
                ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                    string.Format(Traductor.T("FILES_ENTRY_SET"), file.FileName), ToastType.Success));
            }
            // Let the editor refresh the Run-target picker (which shows the entry
            // point's name) without re-querying on every render.
            await OnEntryPointChanged.InvokeAsync(_entryFileName);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    private async Task RemoveFileAsync(ProjectFile file)
    {
        var options = new ConfirmDialogOptions
        {
            YesButtonColor = ButtonColor.Danger,
            NoButtonColor = ButtonColor.Secondary,
            AutoFocusYesButton = false,
            YesButtonText = Traductor.T("FILES_DELETE"),
            NoButtonText = Traductor.T("COMMON_GO_BACK")
        };
        // Interpolate the file name so kebab-on-wrong-row mistakes are
        // catchable (UX-N-019). FILES_REMOVE_TITLE contains a {0} slot that
        // string.Format fills in here; legacy versions without the slot
        // render unchanged (no exception, just no filename insertion).
        var confirmed = await _removeFileDialog.ShowAsync(
            string.Format(Traductor.T("FILES_REMOVE_TITLE"), file.FileName),
            Traductor.T("FILES_REMOVE_MSG1"),
            Traductor.T("FILES_REMOVE_MSG2"),
            options);

        if (!confirmed)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_NOT_REMOVED"), ToastType.Info));
            return;
        }

        file.Project = Project;
        bool wasEntry = string.Equals(_entryFileName, file.RelativePath, StringComparison.Ordinal);
        var ok = await ProjectFiles.RemoveAsync(file);

        if (ok)
        {
            _projectFiles.RemoveAll(f => f.Id == file.Id);
            if (_selectedFile?.Id == file.Id)
                _selectedFile = _projectFiles.FirstOrDefault();
            if (wasEntry && Project != null)
            {
                await DbContext.ClearProjectMainFileAsync(Project.Id);
                _entryFileName = null;
            }
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_REMOVED_SUCCESS"), ToastType.Success));
            await OnProjectFileRemoved.InvokeAsync(file);
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                $"{Traductor.T("FILES_REMOVED_ERROR")}: {ProjectFiles.LastError}", ToastType.Danger));
        }
        StateHasChanged();
    }

    // ---- Move ----------------------------------------------------------------

    private record MoveTarget(string Path, string Label);

    /// <summary>Folders the file isn't already in, plus project root when applicable.</summary>
    private List<MoveTarget> MoveTargetsFor(ProjectFile file)
    {
        var current = file.DirectoryPath ?? string.Empty;
        var targets = new List<MoveTarget>();
        if (!string.IsNullOrEmpty(current))
            targets.Add(new MoveTarget(string.Empty, Traductor.T("FILES_MOVE_ROOT")));
        foreach (var d in _directories)
            if (!string.Equals(d, current, StringComparison.OrdinalIgnoreCase))
                targets.Add(new MoveTarget(d, d));
        return targets;
    }

    private async Task MoveFileAsync(ProjectFile file, string targetDir)
    {
        file.Project = Project;
        bool wasEntry = string.Equals(_entryFileName, file.RelativePath, StringComparison.Ordinal);
        var ok = await ProjectFiles.MoveAsync(file, targetDir);
        if (ok)
        {
            file.DirectoryPath = ProjectFiles.NormalizeDirectoryPath(targetDir);
            if (wasEntry && Project != null)
            {
                await DbContext.SetProjectMainFileAsync(Project.Id, file.RelativePath);
                _entryFileName = file.RelativePath;
            }
            await ReloadAllAsync();
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("FILES_MOVE_SUCCESS"), ToastType.Success));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                $"{Traductor.T("FILES_MOVE_ERROR")}: {ProjectFiles.LastError}", ToastType.Danger));
        }
        StateHasChanged();
    }

    /// <summary>
    /// Stores the dragged file's id in a JS-side global. Blazor's DragEventArgs
    /// can't carry data via DataTransfer, and relying on a C# field races with
    /// re-renders during the drag (StateHasChanged after dragstart can disrupt
    /// the in-flight drag operation). Bridging through JS keeps the identity
    /// stable until drop reads it back.
    /// </summary>
    private async Task OnFileDragStartAsync(int id)
    {
        _draggedFileId = id;
        try { await JS.InvokeVoidAsync("kmilaSetFileDrag", id); } catch { }
    }

    private async Task OnFileDragEndAsync()
    {
        _draggedFileId = null;
        _dragOverFolder = null;
        try { await JS.InvokeVoidAsync("kmilaClearFileDrag"); } catch { }
    }

    private void OnFolderDragOver(string path)
    {
        if (_dragOverFolder != path) _dragOverFolder = path;
    }

    private void OnFolderDragLeave(string path)
    {
        if (_dragOverFolder == path) _dragOverFolder = null;
    }

    // ---- Kebab menu state machine -------------------------------------------

    /// <summary>
    /// Toggles the popover menu attached to a row. Closes any other open menu,
    /// then asks JS for the trigger's getBoundingClientRect so we can render
    /// the panel anchored under it. The panel only enters the DOM after the
    /// position is known — that's how we avoid the "menu painted at top-left"
    /// failure mode we had with &lt;details&gt;/toggle.
    /// </summary>
    private async Task ToggleMenuAsync(string key, MouseEventArgs e)
    {
        if (_openMenuKey == key)
        {
            CloseMenu();
            return;
        }

        try
        {
            var rect = await JS.InvokeAsync<MenuRect?>("kmilaGetButtonRectByKey", key);
            const double panelWidth = 200;      // matches CSS min-width plus padding
            const double panelHeightEstimate = 240; // ~5 menu items + padding; the CSS cap below
                                                    //  (`max-height: 80vh`) is the safety net for taller menus.
            const double margin = 6;
            const double edgePad = 4;
            double left, top;
            double? maxHeight = null;
            double? maxWidth = null;
            if (rect != null)
            {
                var vw = await JS.InvokeAsync<double>("kmilaViewportWidth");
                var vh = await JS.InvokeAsync<double>("kmilaViewportHeight");

                // Default: right-align panel under the trigger (matches the
                // LTR layout where the kebab sits at the right edge of the row
                // and the menu flows leftward). If that puts the panel's left
                // off-screen — which is what happens in RTL because the kebab
                // sits near the LEFT edge of the row — flip to left-aligning
                // under the trigger so the panel stays adjacent to the button
                // instead of getting clamped to the viewport corner.
                var rightAligned = rect.Right - panelWidth;
                if (rightAligned >= edgePad)
                {
                    left = rightAligned;
                }
                else
                {
                    left = Math.Max(edgePad, rect.Left);
                }
                // Final clamp so the panel never paints past the viewport edge.
                if (left + panelWidth > vw - edgePad) left = Math.Max(edgePad, vw - panelWidth - edgePad);
                if (left < edgePad) left = edgePad;
                // Cap actual width to whatever room is left from `left` to the
                // viewport edge — the static panelWidth estimate misses cases
                // where the rendered menu grows wider (long folder names in
                // "Move to: ..." items).
                maxWidth = Math.Max(120, vw - left - edgePad);

                // Vertical placement: prefer below the button, but flip above
                // when there isn't enough room. Daniel filed this in
                // [[project_file_menu_overflow]] — bottom-row file kebabs
                // were rendering past the viewport bottom with their items
                // unreachable. Match the BlazorBootstrap flip behaviour by
                // hand because the panel is rendered via inline `top/left`.
                double spaceBelow = vh - rect.Bottom;
                double spaceAbove = rect.Top;
                if (spaceBelow >= panelHeightEstimate + margin || spaceBelow >= spaceAbove)
                {
                    top = rect.Bottom + margin;          // below trigger
                    maxHeight = Math.Max(120, vh - top - edgePad);
                }
                else
                {
                    // Flip above. Anchor the panel's bottom just over the
                    // trigger and let max-height/overflow handle long lists.
                    maxHeight = Math.Max(120, spaceAbove - margin - edgePad);
                    top = Math.Max(edgePad, rect.Top - margin - maxHeight.Value);
                }
            }
            else
            {
                // Fallback: anchor near the click point if the lookup failed
                left = Math.Max(edgePad, e.ClientX - panelWidth + 16);
                top = e.ClientY + margin;
            }
            _openMenuKey = key;
            _menuTop = top;
            _menuLeft = left;
            _menuMaxHeight = maxHeight;
            _menuMaxWidth = maxWidth;
        }
        catch
        {
            // Last-resort fallback: anchor at the click coordinates so the
            // menu is at least near the user's pointer instead of (0,0).
            _openMenuKey = key;
            _menuTop = e.ClientY + 6;
            _menuLeft = Math.Max(4, e.ClientX - 180);
        }
        StateHasChanged();
    }

    private void CloseMenu()
    {
        _openMenuKey = null;
        _menuTop = null;
        _menuLeft = null;
        _menuMaxHeight = null;
        _menuMaxWidth = null;
    }

    private string BuildMenuPanelStyle()
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();
        sb.Append("top: ").Append((_menuTop ?? 0).ToString("0.##", ci)).Append("px; ");
        sb.Append("left: ").Append((_menuLeft ?? 0).ToString("0.##", ci)).Append("px;");
        if (_menuMaxHeight.HasValue)
            sb.Append(" max-height: ").Append(_menuMaxHeight.Value.ToString("0.##", ci)).Append("px;");
        if (_menuMaxWidth.HasValue)
            sb.Append(" max-width: ").Append(_menuMaxWidth.Value.ToString("0.##", ci)).Append("px;");
        return sb.ToString();
    }

    /// <summary>Closes the menu, then runs the chosen item's async action.</summary>
    private async Task OnMenuItem(Func<Task> action)
    {
        CloseMenu();
        await action();
    }

    /// <summary>Closes the menu, then runs the chosen item's sync action.</summary>
    private void OnMenuItemSync(Action action)
    {
        CloseMenu();
        action();
    }

    /// <summary>Shape of the rect returned by kmilaGetButtonRectByKey.</summary>
    private class MenuRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Right { get; set; }
        public double Bottom { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private async Task OnDropOnFolderAsync(string folderPath)
    {
        // Prefer the JS-stored id — survives re-renders that may have nulled
        // the C# field. Fall back to the field if JS isn't available.
        int? id = _draggedFileId;
        try
        {
            var jsId = await JS.InvokeAsync<int?>("kmilaGetFileDrag");
            if (jsId.HasValue) id = jsId.Value;
        }
        catch { }

        _draggedFileId = null;
        _dragOverFolder = null;
        try { await JS.InvokeVoidAsync("kmilaClearFileDrag"); } catch { }

        if (id == null) return;
        var file = _projectFiles.FirstOrDefault(f => f.Id == id.Value);
        if (file == null) return;
        if (string.Equals(file.DirectoryPath ?? string.Empty, folderPath ?? string.Empty, StringComparison.OrdinalIgnoreCase))
            return;
        await MoveFileAsync(file, folderPath ?? string.Empty);
    }

    // ---- New file modal ------------------------------------------------------

    private async Task RequestNewFile(string targetDir)
    {
        // Prefer the parent's root-level modal (see OnNewFileRequested) — the
        // inline modal below is trapped by the dock's stacking/overflow context
        // on this platform and never shows (#5).
        if (OnNewFileRequested.HasDelegate)
        {
            if (!string.IsNullOrEmpty(targetDir)) _collapsedFolders.Remove(targetDir);
            await OnNewFileRequested.InvokeAsync(targetDir ?? string.Empty);
            return;
        }

        _pendingNewFileDir = targetDir ?? string.Empty;
        if (!string.IsNullOrEmpty(targetDir)) _collapsedFolders.Remove(targetDir);
        var parameters = new Dictionary<string, object>
        {
            { "Project", Project },
            { "TargetDirectory", _pendingNewFileDir },
            { "OnProjectFileCreated", EventCallback.Factory.Create<Kmila.Shared.Models.ProjectFile>(this, OnFileCreatedAsync) }
        };
        var title = string.IsNullOrEmpty(_pendingNewFileDir)
            ? Traductor.T("FILES_NEW_FILE")
            : $"{Traductor.T("FILES_NEW_FILE")} — {_pendingNewFileDir}";
        await _createFileModal.ShowAsync<CreateFileModal>(title, parameters: parameters);
    }

    private async Task OnFileCreatedAsync(Kmila.Shared.Models.ProjectFile? created)
    {
        await _createFileModal.HideAsync();
        await ReloadAllAsync();
        // Auto-open the file the student just created. Without this, the
        // editor remains on its "No file open" placeholder and the user has
        // no obvious way to reach the file they just made (the Files dock
        // tab is at position 7 of 8, off-screen on phones). Find the file
        // back in the reloaded list (Id is set after CreateAsync) and route
        // it through the same path as a manual click.
        if (created != null)
        {
            var match = _projectFiles.FirstOrDefault(f => f.Id == created.Id)
                       ?? _projectFiles.FirstOrDefault(f =>
                              string.Equals(f.FileName, created.FileName, StringComparison.Ordinal)
                              && string.Equals(f.DirectoryPath ?? "", created.DirectoryPath ?? "", StringComparison.Ordinal));
            if (match != null) await OpenFileAsync(match);
        }
        StateHasChanged();
    }

    // ---- Details modal -------------------------------------------------------

    private async Task OpenDetailsAsync(ProjectFile file)
    {
        file.Project = Project;
        _detailsFile = file;
        var parameters = new Dictionary<string, object>
        {
            { "File", file }
        };
        await _detailsModal.ShowAsync<FileDetailsModal>(Traductor.T("FILES_DETAILS_TITLE"), parameters: parameters);
    }

    // ---- Misc helpers --------------------------------------------------------

    private record FileInfo(IconName Icon, string Variant, string Ext);

    private FileInfo GetFileInfo(string fileName)
    {
        if (!fileName.Contains('.'))
            return new FileInfo(IconName.FileEarmark, "other", "");

        var ext = fileName.Substring(fileName.LastIndexOf('.')).ToLowerInvariant();
        var label = ext.TrimStart('.').ToUpperInvariant();

        return ext switch
        {
            ".vhd" or ".vhdl" => new FileInfo(IconName.FileCode,    "vhdl",     label),
            ".md"              => new FileInfo(IconName.FileTypeMd,  "markdown", label),
            ".txt"             => new FileInfo(IconName.FileTypeTxt, "text",     label),
            ".json"            => new FileInfo(IconName.Braces,      "json",     label),
            ".xml"             => new FileInfo(IconName.Code,        "xml",      label),
            _                  => new FileInfo(IconName.FileEarmark, "other",    label),
        };
    }
}
