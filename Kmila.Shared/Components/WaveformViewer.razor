@*
    WaveformViewer Component

    Displays cycle-accurate digital waveforms using BlazorBootstrap LineChart components
    with stepped line mode. One LineChart per signal, vertically stacked.

    Features:
    - Stepped lines for digital waveform display (square waves)
    - Separate charts per signal with appropriate Y-axis scaling
    - Color coding: green=clock, blue=input, orange=output, purple=vector
    - Zoom in/out with horizontal scroll
    - VCD export button
    - Shared time ruler on bottom chart only
*@

@if (Data != null && Data.Signals.Count > 0)
{
    <Card Class="waveform-viewer-card mb-3">
        <CardHeader Class="py-2 d-flex justify-content-between align-items-center">
            <div>
                <Icon Name="IconName.Activity" Class="me-2" />
                <strong>Waveform Viewer</strong>
                <Badge Color="BadgeColor.Info" Class="ms-2">@Data.Signals.Count signals</Badge>
            </div>
            <div class="d-flex gap-2">
                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" Outline="true"
                        @onclick="ZoomIn" TooltipTitle="Zoom In">
                    <Icon Name="IconName.ZoomIn" />
                </Button>
                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" Outline="true"
                        @onclick="ZoomOut" TooltipTitle="Zoom Out">
                    <Icon Name="IconName.ZoomOut" />
                </Button>
                <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" Outline="true"
                        @onclick="HandleVcdExport" TooltipTitle="Export VCD">
                    <Icon Name="IconName.Download" Class="me-1" />
                    VCD
                </Button>
            </div>
        </CardHeader>
        <CardBody Class="p-2 waveform-scroll-container">
            <div class="waveform-charts-wrapper" style="min-width: @(_zoomWidth)px;">
                @for (int i = 0; i < Data.Signals.Count; i++)
                {
                    var signal = Data.Signals[i];
                    var isLast = i == Data.Signals.Count - 1;
                    var color = GetSignalColor(signal);
                    var idx = i;

                    <div class="waveform-signal-row">
                        <div class="waveform-signal-label">
                            <Badge Color="@GetBadgeColor(signal.PortType)" Class="me-1">@signal.PortType</Badge>
                            <span class="fw-semibold small">@signal.Name</span>
                            @if (signal.BitWidth > 1)
                            {
                                <span class="text-muted small ms-1">[@signal.BitWidth-bit]</span>
                            }
                        </div>
                        <div class="waveform-chart-container">
                            <LineChart @ref="_chartRefs[idx]" />
                        </div>
                    </div>
                }
            </div>
        </CardBody>
    </Card>
}

@code {
    /// <summary>
    /// The waveform data to display.
    /// </summary>
    [Parameter]
    public WaveformData? Data { get; set; }

    /// <summary>
    /// Event callback for VCD export.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnExportVcd { get; set; }

    private LineChart[] _chartRefs = Array.Empty<LineChart>();
    private int _zoomWidth = 800;
    private bool _chartsInitialized = false;
    private WaveformData? _previousData;

    protected override void OnParametersSet()
    {
        if (Data != null && Data.Signals.Count > 0)
        {
            // Resize chart refs array if needed
            if (_chartRefs.Length != Data.Signals.Count)
            {
                _chartRefs = new LineChart[Data.Signals.Count];
            }
        }

        // Reset initialization when data changes
        if (Data != _previousData)
        {
            _chartsInitialized = false;
            _previousData = Data;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartsInitialized && Data != null && Data.Signals.Count > 0)
        {
            // Check all refs are available
            bool allRefsReady = true;
            for (int i = 0; i < _chartRefs.Length; i++)
            {
                if (_chartRefs[i] == null)
                {
                    allRefsReady = false;
                    break;
                }
            }

            if (allRefsReady)
            {
                _chartsInitialized = true;
                await InitializeChartsAsync();
            }
        }
    }

    private async Task InitializeChartsAsync()
    {
        if (Data == null) return;

        for (int i = 0; i < Data.Signals.Count; i++)
        {
            var signal = Data.Signals[i];
            var isLast = i == Data.Signals.Count - 1;
            var color = GetSignalColor(signal);

            var chartData = new ChartData
            {
                Labels = Data.TimeLabels,
                Datasets = new List<IChartDataset>
                {
                    new LineChartDataset
                    {
                        Label = $"{signal.Name} ({signal.PortType})",
                        Data = signal.ChartValues,
                        Stepped = true,
                        Tension = 0,
                        BorderWidth = 2,
                        PointRadius = new List<double> { 0 },
                        BorderColor = color,
                        BackgroundColor = color + "20",
                        Fill = signal.DataType != "std_logic"
                    }
                }
            };

            var options = new LineChartOptions
            {
                Responsive = true,
                MaintainAspectRatio = false
            };

            // Configure scales
            options.Scales = new Scales();

            // Y-axis configuration
            if (signal.DataType == "std_logic")
            {
                // For 1-bit signals: fixed 0-1 range, hide ticks
                options.Scales.Y = new ChartAxes
                {
                    Min = -0.1,
                    Max = 1.1
                };
                options.Scales.Y.Title = new ChartAxesTitle { Display = false };
            }
            else
            {
                // For vectors/integers: auto-scale
                options.Scales.Y = new ChartAxes();
                options.Scales.Y.Title = new ChartAxesTitle
                {
                    Display = true,
                    Text = signal.DataType == "integer" ? "Value" : "Hex"
                };
            }

            // X-axis: only show labels on the last chart
            options.Scales.X = new ChartAxes();
            if (!isLast)
            {
                options.Scales.X.Title = new ChartAxesTitle { Display = false };
            }
            else
            {
                options.Scales.X.Title = new ChartAxesTitle
                {
                    Display = true,
                    Text = "Time"
                };
            }

            // Plugins configuration
            options.Plugins = new LineChartPlugins();

            try
            {
                await _chartRefs[i].InitializeAsync(chartData, options);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[WaveformViewer] Error initializing chart for {signal.Name}: {ex.Message}");
            }
        }
    }

    private static string GetSignalColor(WaveformSignal signal)
    {
        // Clock signals (named clk/clock)
        if (signal.Name.Equals("clk", StringComparison.OrdinalIgnoreCase) ||
            signal.Name.Equals("clock", StringComparison.OrdinalIgnoreCase))
        {
            return "rgb(40, 167, 69)"; // green
        }

        return signal.PortType switch
        {
            "IN" => "rgb(13, 110, 253)", // blue
            "OUT" => "rgb(255, 153, 0)", // orange
            "INOUT" => "rgb(111, 66, 193)", // purple
            _ => signal.DataType != "std_logic"
                ? "rgb(111, 66, 193)" // purple for vectors
                : "rgb(108, 117, 125)" // gray for internal
        };
    }

    private static BadgeColor GetBadgeColor(string portType)
    {
        return portType switch
        {
            "IN" => BadgeColor.Primary,
            "OUT" => BadgeColor.Warning,
            "INOUT" => BadgeColor.Info,
            _ => BadgeColor.Secondary
        };
    }

    private void ZoomIn()
    {
        _zoomWidth = Math.Min(_zoomWidth + 200, 4000);
    }

    private void ZoomOut()
    {
        _zoomWidth = Math.Max(_zoomWidth - 200, 400);
    }

    private async Task HandleVcdExport()
    {
        if (Data?.SourceHistory != null)
        {
            string vcd = Data.SourceHistory.ExportToVcd("simulation", Data.TimescaleNs);
            await OnExportVcd.InvokeAsync(vcd);
        }
    }
}
