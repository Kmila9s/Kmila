@*
    BuildProgressDisplay Component

    Displays build progress information including a progress bar,
    status messages, error details, and a dismiss button.

    Usage:
    <BuildProgressDisplay Building="_building" ShowBuildStatus="_showBuildStatus"
                          BuildProgress="_buildProgress" ... />
*@

@if (Building || ShowBuildStatus)
{
    <div class="build-progress-section mt-3 p-2 border rounded bg-light">
        <!-- Progress Bar -->
        @if (Building)
        {
            <div class="mb-2">
                <Progress Class="mb-1">
                    <ProgressBar Width="@((int)(BuildProgress * 100))"
                                 Color="ProgressColor.Success"
                                 Label="@($"{(BuildProgress * 100):F0}%")" />
                </Progress>
            </div>
        }

        <!-- Status Message -->
        <div class="d-flex align-items-center">
            @if (Building)
            {
                <Icon Name="IconName.GearFill" Class="me-2 text-primary spin-animation" />
            }
            else if (BuildCancelled)
            {
                <Icon Name="IconName.SlashCircle" Class="me-2 text-warning" />
            }
            else if (BuildError)
            {
                <Icon Name="IconName.ExclamationTriangleFill" Class="me-2 text-danger" />
            }
            else if (BuildSuccess)
            {
                <Icon Name="IconName.CheckCircleFill" Class="me-2 text-success" />
            }
            <small class="@(BuildCancelled ? "text-warning" : BuildError ? "text-danger" : BuildSuccess ? "text-success" : "text-muted")">
                @BuildStatusMessage
            </small>
        </div>

        <!-- Error Details -->
        @if (BuildError && !string.IsNullOrEmpty(BuildErrorDetail))
        {
            <Alert Color="AlertColor.Danger" Class="mt-2 mb-0 py-2 px-3">
                <small>@BuildErrorDetail</small>
            </Alert>
        }

        <!-- Hide Status Button -->
        @if (!Building && ShowBuildStatus)
        {
            <div class="text-end mt-2">
                <Button Color="ButtonColor.Light"
                        Size="ButtonSize.ExtraSmall"
                        @onclick="OnHideBuildStatus">
                    <Icon Name="IconName.X" /> @Traductor.T("COMMON_DISMISS")
                </Button>
            </div>
        }
    </div>
}

@implements IDisposable

@code {
    [Parameter] public bool Building { get; set; }
    [Parameter] public bool ShowBuildStatus { get; set; }
    [Parameter] public float BuildProgress { get; set; }
    [Parameter] public bool BuildCancelled { get; set; }
    [Parameter] public bool BuildError { get; set; }
    [Parameter] public bool BuildSuccess { get; set; }
    [Parameter] public string BuildStatusMessage { get; set; } = string.Empty;
    [Parameter] public string? BuildErrorDetail { get; set; }
    [Parameter] public EventCallback OnHideBuildStatus { get; set; }

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
    }
}
