@*
    RunTabContent Component

    Presentation-only sub-component for the Run tab in SimulationParametersModal.
    Displays simulation controls, status, and progress.
    All state and event handlers remain in the parent component.
*@

<div class="tab-content-wrapper p-2 p-md-3">
    <!-- Current Configuration Info -->
    @if(!string.IsNullOrEmpty(LoadedConfigName))
    {
        <Alert Color="AlertColor.Info" Class="mb-3 py-2">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <Icon Name="IconName.GearFill" Class="me-2" />
                    <span class="fw-semibold">Configuration:</span>
                    <span class="ms-1">@LoadedConfigName</span>
                    @if(HasUnsavedChanges)
                    {
                        <Badge Color="BadgeColor.Warning" Class="ms-2">Unsaved</Badge>
                    }
                </div>
                <Button Color="ButtonColor.Info"
                        Size="ButtonSize.ExtraSmall"
                        Outline="true"
                        @onclick="OnSaveConfig"
                        Disabled="@(!HasUnsavedChanges)">
                    <Icon Name="IconName.Save" Class="me-1" />
                    Save
                </Button>
            </div>
        </Alert>
    }

    <form @onsubmit="OnFormSubmitted">
        <!-- Control Buttons Card -->
        <Card Class="mb-3">
            <CardHeader Class="py-2 py-md-3">
                <Icon Name="IconName.PlayCircle" Class="me-2" />
                <strong>Simulation Controls</strong>
            </CardHeader>
            <CardBody Class="p-2 p-md-3">
                <!-- Quick Status Summary -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 small">
                    <span>
                        <Icon Name="IconName.Clock" Class="me-1" />
                        <strong>Duration:</strong> @Time @Zone
                    </span>
                    @if(ResourcesExceeded)
                    {
                        <Badge Color="BadgeColor.Danger">
                            <Icon Name="IconName.ExclamationTriangleFill" Class="me-1" />
                            Resources Exceeded
                        </Badge>
                    }
                    else if(ResourcesNearLimit)
                    {
                        <Badge Color="BadgeColor.Warning">
                            <Icon Name="IconName.ExclamationTriangle" Class="me-1" />
                            Near Limit
                        </Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Success">
                            <Icon Name="IconName.CheckCircle" Class="me-1" />
                            Ready
                        </Badge>
                    }
                </div>

                <!-- Mobile-friendly button layout -->
                <div class="d-grid gap-2">
                    <!-- Primary Start Button -->
                    <Button
                        Type="ButtonType.Submit"
                        Color="@(ResourcesExceeded ? ButtonColor.Danger : ButtonColor.Success)"
                        Outline="false"
                        Size="ButtonSize.Large"
                        Disabled="@(Running || ResourcesExceeded)"
                        Loading="Running"
                        LoadingText="Running..."
                        TooltipTitle="@(ResourcesExceeded ? "Cannot start - resources exceeded" : "Start simulation")"
                        Class="py-3"
                    >
                        @if(ResourcesExceeded)
                        {
                            <Icon Name="IconName.ExclamationTriangleFill" Class="me-2" />
                            <text>Resources Exceeded</text>
                        }
                        else
                        {
                            <Icon Name="IconName.PlayFill" Class="me-2" />
                            <text>Start Simulation</text>
                        }
                    </Button>

                    <!-- Control buttons shown when running -->
                    @if(Running)
                    {
                        <div class="btn-group w-100" role="group" aria-label="Simulation controls">
                            @if(!Paused)
                            {
                                <Button
                                    Type="ButtonType.Button"
                                    Color="ButtonColor.Info"
                                    Outline="true"
                                    TooltipTitle="Pause simulation"
                                    @onclick="OnPause"
                                    Class="flex-fill"
                                >
                                    <Icon Name="IconName.Pause" Class="me-1" />
                                    <span class="d-none d-sm-inline">Pause</span>
                                </Button>
                            }
                            else
                            {
                                <Button
                                    Type="ButtonType.Button"
                                    Color="ButtonColor.Success"
                                    Outline="true"
                                    TooltipTitle="Continue simulation"
                                    @onclick="OnContinue"
                                    Class="flex-fill"
                                >
                                    <Icon Name="IconName.Play" Class="me-1" />
                                    <span class="d-none d-sm-inline">Continue</span>
                                </Button>
                            }
                            <Button
                                Type="ButtonType.Button"
                                Color="ButtonColor.Warning"
                                Outline="true"
                                TooltipTitle="Restart simulation"
                                @onclick="OnRestart"
                                Class="flex-fill"
                            >
                                <Icon Name="IconName.ArrowClockwise" Class="me-1" />
                                <span class="d-none d-sm-inline">Restart</span>
                            </Button>
                            <Button
                                Type="ButtonType.Button"
                                Color="ButtonColor.Danger"
                                Outline="true"
                                TooltipTitle="Stop simulation"
                                @onclick="OnStop"
                                Class="flex-fill"
                            >
                                <Icon Name="IconName.StopFill" Class="me-1" />
                                <span class="d-none d-sm-inline">Stop</span>
                            </Button>
                        </div>
                    }
                </div>
            </CardBody>
        </Card>
    </form>

    <!-- Simulation Progress Section -->
    @if(Running)
    {
        <Card Class="mb-3 border-primary">
            <CardHeader Class="py-2 py-md-3 bg-primary bg-opacity-10">
                <Icon Name="IconName.Activity" Class="me-2" />
                <strong>Simulation Progress</strong>
            </CardHeader>
            <CardBody Class="p-2 p-md-3">
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold">@(Paused ? "Paused" : "Running")...</span>
                        <Badge Color="@(Paused ? BadgeColor.Warning : BadgeColor.Success)" Class="fs-6">
                            @Percent.ToString("F1")%
                        </Badge>
                    </div>
                    <Progress Class="progress-lg" Style="height: 24px;">
                        <ProgressBar @ref="_progressBar"
                            Type="@(Paused ? ProgressType.Default : ProgressType.Striped)"
                            Color="@(Paused ? ProgressColor.Warning : ProgressColor.Success)"
                            Width="Percent"
                            Label="@($"{Percent:F1}%")" />
                    </Progress>
                </div>
                @if(Paused)
                {
                    <Alert Color="AlertColor.Info" Class="mb-0 mt-3 small">
                        <Icon Name="IconName.InfoCircle" Class="me-2" />
                        Paused. Tap Continue to resume or Stop to end.
                    </Alert>
                }
            </CardBody>
        </Card>
    }

    <!-- Completion message or help text -->
    @if(!Running && SimulationEnded)
    {
        <Alert Color="AlertColor.Success" Class="small">
            <Icon Name="IconName.CheckCircleFill" Class="me-2" />
            Simulation completed. <strong>Close this dialog</strong> to view the waveform.
        </Alert>
    }
    else if(!Running)
    {
        <Alert Color="AlertColor.Light" Class="small">
            <Icon Name="IconName.InfoCircle" Class="me-2" />
            Configure time and inputs in the <strong>Config</strong> tab, then return here to start.
        </Alert>
    }
</div>

@code {
    [Parameter] public int Time { get; set; }
    [Parameter] public TimeScale Zone { get; set; }
    [Parameter] public bool Running { get; set; }
    [Parameter] public bool Paused { get; set; }
    [Parameter] public bool ResourcesExceeded { get; set; }
    [Parameter] public bool ResourcesNearLimit { get; set; }
    [Parameter] public double Percent { get; set; }
    [Parameter] public string LoadedConfigName { get; set; } = string.Empty;
    [Parameter] public bool HasUnsavedChanges { get; set; }
    [Parameter] public EventCallback OnFormSubmitted { get; set; }
    [Parameter] public EventCallback OnPause { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }
    [Parameter] public EventCallback OnRestart { get; set; }
    [Parameter] public EventCallback OnStop { get; set; }
    [Parameter] public EventCallback OnSaveConfig { get; set; }
    [Parameter] public bool SimulationEnded { get; set; }

    private ProgressBar _progressBar = new();
}
