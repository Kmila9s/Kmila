@*
    KmilaToastHost — glass-styled toast stack for KmilaToastService.

    Mounted once in MainLayout.razor (replacing BlazorBootstrap's <Toasts>).
    Subscribes to KmilaToastService.OnChange and renders the current stack
    fixed at top-center. Auto-dismiss is handled service-side; clicking the
    close button calls Dismiss(id) which cancels the dismiss task.

    Accessibility:
    - The host is `aria-live="polite"` so screen readers announce each new
      toast's body without interrupting the user.
    - Each toast is `role="alert"`; the close button carries the localised
      COMMON_CLOSE label.

    Styling: see `.kmila-toast-host` + `.kmila-toast` in pages.css.
*@
@implements IDisposable
@inject KmilaToastService Toasts

<div class="kmila-toast-host" aria-live="polite" aria-atomic="false">
    @foreach (var item in _items)
    {
        <div class="kmila-toast kmila-toast--@LevelClass(item.Level)" role="alert" @key="item.Id">
            <svg class="kmila-toast__icon" viewBox="0 0 24 24" aria-hidden="true"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                @switch (item.Level)
                {
                    case KmilaToastLevel.Success:
                        <polyline points="20 6 9 17 4 12" />
                        break;
                    case KmilaToastLevel.Danger:
                        <circle cx="12" cy="12" r="10" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                        break;
                    case KmilaToastLevel.Warning:
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                        break;
                    default:
                        <circle cx="12" cy="12" r="10" />
                        <line x1="12" y1="16" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12.01" y2="8" />
                        break;
                }
            </svg>

            <div class="kmila-toast__text">
                @if (!string.IsNullOrEmpty(item.Title))
                {
                    <div class="kmila-toast__title">@item.Title</div>
                }
                <div class="kmila-toast__body">@item.Body</div>
            </div>

            <button class="kmila-toast__close" type="button"
                    aria-label="@Traductor.T("COMMON_CLOSE")"
                    @onclick="() => Toasts.Dismiss(item.Id)">
                <svg viewBox="0 0 24 24" aria-hidden="true"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    private IReadOnlyList<KmilaToastItem> _items = Array.Empty<KmilaToastItem>();

    protected override void OnInitialized()
    {
        Toasts.OnChange += OnToastsChanged;
        _items = Toasts.Snapshot();
    }

    private void OnToastsChanged()
    {
        _items = Toasts.Snapshot();
        InvokeAsync(StateHasChanged);
    }

    private static string LevelClass(KmilaToastLevel level) => level switch
    {
        KmilaToastLevel.Success => "success",
        KmilaToastLevel.Danger => "danger",
        KmilaToastLevel.Warning => "warning",
        _ => "info",
    };

    public void Dispose()
    {
        Toasts.OnChange -= OnToastsChanged;
    }
}
