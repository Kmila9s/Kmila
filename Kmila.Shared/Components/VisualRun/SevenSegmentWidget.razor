@namespace Kmila.Shared.Components.VisualRun
@using Kmila.Shared.Services.VisualRun

@*
    7-segment display widget (single digit).

    Two operating modes via the `mode` config key:
      • "raw"  (default) — 7 individual segment pins (a..g) + optional `dp`
                            for the decimal point. The student wires each
                            segment to a port, exactly like driving a
                            physical 7447/4511 BCD-to-7-segment IC output.
      • "hex"            — 4-bit `value` pin, widget decodes 0..F to the
                            canonical 7-seg pattern internally.
      • "dec"            — 4-bit `value` pin, displays 0..9 and blanks any
                            value > 9 (cleaner BCD demo, matches what a
                            real decoder IC does on out-of-range inputs).

    Segment geometry uses absolutely-positioned divs inside a fixed 70×120
    housing. Each segment has the .kviz-7seg__seg base class + a unique
    .kviz-7seg__seg--{a..g,dp} positioning class.
*@

<div class="kviz-widget kviz-7seg @(EditMode ? "kviz-7seg--edit" : "") @(Selected ? "kviz-widget--selected" : "")"
     style="--kviz-7seg-color:@ColorVar; left:@(Comp.Position.X)px; top:@(Comp.Position.Y)px;"
     data-component-id="@Comp.Id"
     @onpointerdown="HandlePointerDown">
    <div class="kviz-7seg__housing">
        <div class="kviz-7seg__seg kviz-7seg__seg--a  @(SegOn('a') ? "kviz-7seg__seg--on" : "")"></div>
        <div class="kviz-7seg__seg kviz-7seg__seg--b  @(SegOn('b') ? "kviz-7seg__seg--on" : "")"></div>
        <div class="kviz-7seg__seg kviz-7seg__seg--c  @(SegOn('c') ? "kviz-7seg__seg--on" : "")"></div>
        <div class="kviz-7seg__seg kviz-7seg__seg--d  @(SegOn('d') ? "kviz-7seg__seg--on" : "")"></div>
        <div class="kviz-7seg__seg kviz-7seg__seg--e  @(SegOn('e') ? "kviz-7seg__seg--on" : "")"></div>
        <div class="kviz-7seg__seg kviz-7seg__seg--f  @(SegOn('f') ? "kviz-7seg__seg--on" : "")"></div>
        <div class="kviz-7seg__seg kviz-7seg__seg--g  @(SegOn('g') ? "kviz-7seg__seg--on" : "")"></div>
        <div class="kviz-7seg__seg kviz-7seg__seg--dp @(SegOn('p') ? "kviz-7seg__seg--on" : "")"></div>
    </div>
    @if (Mode != "raw")
    {
        <div class="kviz-7seg__readout">@DisplayChar</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public KvizComponent Comp { get; set; } = default!;
    [Parameter] public VisualRunCoordinator? Coordinator { get; set; }
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.PointerEventArgs> OnPointerDownExternal { get; set; }

    // FrameVersion bumps once per coordinator tick — forces re-render so
    // we re-evaluate SegOn() against the latest port values.
    [CascadingParameter(Name = "FrameVersion")] public int FrameVersion { get; set; }

    private string Mode => Comp.Config.GetString("mode", "raw");

    private string ColorVar => Comp.Config.GetString("color", "red") switch
    {
        "green" => "#22c55e",
        "blue" => "#3b82f6",
        "yellow" => "#facc15",
        "white" => "#f8fafc",
        _ => "#ef4444",
    };

    // Canonical segment patterns for 0..F. Each bit set means the
    // corresponding segment is ON. Bit ordering: g f e d c b a (low→high).
    // E.g. '0' = abcdef on, g off → 0b0111111 = 0x3F.
    private static readonly int[] HexPatterns = new[]
    {
        0x3F, // 0
        0x06, // 1
        0x5B, // 2
        0x4F, // 3
        0x66, // 4
        0x6D, // 5
        0x7D, // 6
        0x07, // 7
        0x7F, // 8
        0x6F, // 9
        0x77, // A
        0x7C, // b
        0x39, // C
        0x5E, // d
        0x79, // E
        0x71, // F
    };

    private bool SegOn(char which)
    {
        if (Coordinator == null) return false;
        if (Mode == "raw")
        {
            // Wire-each-segment mode. Pin name = segment letter ('p' = dp).
            // Slice-aware so each segment can pick a specific bit of a
            // wider OUT port (e.g. `seg[3]` picks bit 3 of an 8-bit bus).
            string pin = which == 'p' ? "dp" : which.ToString();
            if (!Comp.Bindings.TryGetValue(pin, out var port) || string.IsNullOrEmpty(port))
                return false;
            var v = Coordinator.LatestSlicedValue(port);
            return !string.IsNullOrEmpty(v) && v[^1] == '1';
        }
        // Decoded modes: read the `value` port + look up the pattern.
        int decoded = DecodedNibble();
        if (decoded < 0) return false; // blanks all segments on out-of-range dec
        int patternIdx = decoded & 0xF;
        int bit = which switch
        {
            'a' => 1 << 0,
            'b' => 1 << 1,
            'c' => 1 << 2,
            'd' => 1 << 3,
            'e' => 1 << 4,
            'f' => 1 << 5,
            'g' => 1 << 6,
            'p' => 0, // dp not driven by hex decode; user wires it explicitly
            _ => 0,
        };
        // In decoded mode the dp pin is still wired as raw if present.
        if (which == 'p')
        {
            if (!Comp.Bindings.TryGetValue("dp", out var dpPort) || string.IsNullOrEmpty(dpPort))
                return false;
            var dpv = Coordinator.LatestSlicedValue(dpPort);
            return !string.IsNullOrEmpty(dpv) && dpv[^1] == '1';
        }
        return (HexPatterns[patternIdx] & bit) != 0;
    }

    // Read the `value` pin in decoded mode. Returns 0..15 on success,
    // -1 to mean "out of range / unwired / blank the display". Slice-aware
    // so `value[7:4]` picks the upper nibble of a wider bus.
    private int DecodedNibble()
    {
        if (Coordinator == null) return -1;
        if (!Comp.Bindings.TryGetValue("value", out var port) || string.IsNullOrEmpty(port))
            return -1;
        var raw = Coordinator.LatestSlicedValue(port);
        if (string.IsNullOrEmpty(raw)) return -1;
        // The port could be std_logic_vector of any width — clamp to the
        // last 4 chars (LSB) since that's the canonical 7-seg input.
        string nibbleStr = raw.Length >= 4 ? raw[^4..] : raw.PadLeft(4, '0');
        int n = 0;
        for (int i = 0; i < 4; i++)
        {
            n <<= 1;
            if (nibbleStr[i] == '1') n |= 1;
            else if (nibbleStr[i] != '0') return -1; // U/X/Z → blank
        }
        if (Mode == "dec" && n > 9) return -1;
        return n;
    }

    private string DisplayChar
    {
        get
        {
            int n = DecodedNibble();
            if (n < 0) return "-";
            return Mode == "dec"
                ? n.ToString()
                : n < 10 ? n.ToString() : ((char)('A' + (n - 10))).ToString();
        }
    }

    private async Task HandlePointerDown(Microsoft.AspNetCore.Components.Web.PointerEventArgs e)
    {
        if (OnPointerDownExternal.HasDelegate)
            await OnPointerDownExternal.InvokeAsync(e);
    }
}
