            <span class="kmila-slot-toolbar-divider" aria-hidden="true"></span>

            @* Group 2 — design edits on the currently-open canvas. Wire keeps
               its label because it's the discoverable path to bind pins;
               Delete goes icon-only since it's a per-selection ephemeral
               action and would repeat the same label + Trash idiom used
               everywhere else in the app. *@
            <KmilaTooltip TextKey="VISUAL_WIRE_TIP" Placement="Bottom">
                <button class="kmila-btn" data-testid="visual-wire" @onclick="OpenWiring" disabled="@(_entity == null)">
                    <Icon Name="IconName.Link45Deg" />
                    <span>@Traductor.T("VISUAL_WIRE")</span>
