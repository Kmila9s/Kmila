@namespace Kmila.Shared.Components.VisualRun
@implements IDisposable
@using Kmila.Shared.Models
@using Kmila.Shared.Repositories
@using Kmila.Shared.Services.VisualRun
@using Kmila.Shared.Modals
@using Parser.Models
@using Interpreter.Services
@inject Projects ProjectsRepo
@inject ProjectFiles ProjectFilesRepo
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@inject Kmila.Shared.Services.SimulationParameters Sim
@inject Kmila.Shared.Services.VisualRun.VisualRunRegistry Registry

@*
    VisualPanel — the reusable canvas surface. Used in two places:
      • `Pages/Visual.razor` route `/visual/{ProjectId}` (EmbeddedMode=false)
      • Editor.razor's view-tabs strip (Code · Blocks · Replay · Visual) where
        it lives inline as the 4th view (EmbeddedMode=true). The Editor
        surrounds it with its own breadcrumb + tab strip, so the panel's
        own header is hidden to avoid the title bar duplication.

    State is fully self-contained: the panel parses the project's entity on
    OnParametersSetAsync and owns its own VisualRunCoordinator. When the
    Editor mounts a VisualPanel inline, the panel re-parses (cheap), which
    means the Visual surface is always coherent with the on-disk project,
    even after a Code-tab Build that touched the VHDL.
*@

<section class="visual-page @(EmbeddedMode ? "visual-page--embedded" : "") @(_isFullscreen ? "is-fullscreen" : "")">
    @if (!EmbeddedMode)
    {
        <header class="visual-page__header">
            <KmilaTooltip TextKey="VISUAL_BACK">
                <button class="kmila-btn-icon" @onclick="GoBack"
                        aria-label="@Traductor.T("VISUAL_BACK")">←</button>
            </KmilaTooltip>
            <div class="visual-page__title">
                <span class="visual-page__project">@(_project?.Name ?? "")</span>
                <span class="visual-page__entity">@(_entity?.Name ?? Traductor.T("VISUAL_NO_ENTITY"))</span>
            </div>
            <div class="visual-page__toolbar">
                @RenderToolbar()
            </div>
        </header>
    }
    else
    {
        <div class="visual-page__toolbar visual-page__toolbar--embedded">
            @RenderToolbar()
        </div>
    }

    @* Phase 2 run controls — speed slider + custom delay + Pause/Continue +
       scrub slider + tick breakpoints. Visible only while running or paused. *@
    @if (_coord != null && (_coord.IsRunning || _coord.IsPaused))
    {
        <div class="visual-page__runbar">
            <div class="visual-page__runbar-row">
                <label class="visual-page__runbar-cell">
                    <small>@Traductor.T("VISUAL_SPEED")</small>
                    <input type="range" min="0" max="@VisualSpeedScale.SliderMax" step="1"
                           class="visual-page__speed-slider"
                           value="@_speedPos"
                           @oninput="OnSpeedSliderInput" />
                    <span class="visual-page__speed-label">@SpeedLabel</span>
                </label>
                <label class="visual-page__runbar-cell">
                    <small>@Traductor.T("VISUAL_MS_PER_TICK")</small>
                    <input type="number" min="0" max="@VisualSpeedScale.SlowestMs" step="1"
                           class="kmila-input visual-page__delay-input"
                           placeholder="@Traductor.T("VISUAL_DELAY_AUTO")"
                           value="@(_customDelayMs?.ToString() ?? "")"
                           @onchange="OnCustomDelayChange" />
                </label>
                <KmilaTooltip TextKey="@(_coord.IsPaused ? "VISUAL_CONTINUE_TIP" : "VISUAL_PAUSE_TIP")">
                    <button class="kmila-btn visual-page__pause-btn"
                            data-testid="visual-pause-continue"
                            @onclick="TogglePause">
                        <Icon Name="@(_coord.IsPaused ? IconName.PlayFill : IconName.PauseFill)" />
                        <span>@Traductor.T(_coord.IsPaused ? "VISUAL_CONTINUE" : "VISUAL_PAUSE")</span>
                    </button>
                </KmilaTooltip>
                <span class="visual-page__tick-readout">
                    @Traductor.T("VISUAL_TICK") <code>@_coord.CurrentTick</code>
                    @if (_lastBreakHitTick is { } hitTick)
                    {
                        <span class="visual-page__bp-hit"> · @Traductor.T("VISUAL_BREAKPOINT") @hitTick</span>
                    }
                </span>
            </div>

            @{
                var hasFrames = _coord.Frames.Count > 0;
                var canScrub = _coord.IsPaused && hasFrames;
            }
            <div class="visual-page__runbar-row visual-page__runbar-row--scrub @(canScrub ? "" : "visual-page__runbar-row--disabled")">
                <label class="visual-page__runbar-cell visual-page__runbar-cell--grow">
                    <small>@Traductor.T("VISUAL_SCRUB")</small>
                    <input type="range"
                           min="@_coord.Frames.OldestTick"
                           max="@_coord.Frames.NewestTick"
                           step="1"
                           class="visual-page__scrub-slider"
                           value="@_scrubTick"
                           disabled="@(!canScrub)"
                           @oninput="OnScrubInput" />
                    <span class="visual-page__scrub-readout">
                        @if (canScrub) { @($"{Traductor.T("VISUAL_TICK")} {_scrubTick} / [{_coord.Frames.OldestTick}..{_coord.Frames.NewestTick}]") }
                        else { <em>@Traductor.T("VISUAL_SCRUB_HINT")</em> }
                    </span>
                </label>
            </div>

            <div class="visual-page__runbar-row visual-page__runbar-row--bp">
                <label class="visual-page__runbar-cell">
                    <small>@Traductor.T("VISUAL_PAUSE_AT_TICK")</small>
                    <input type="number" min="0" step="1"
                           class="kmila-input visual-page__bp-input"
                           value="@_bpInput"
                           @onchange="OnBpInputChange" />
                </label>
                <KmilaTooltip TextKey="VISUAL_BP_ADD_TIP">
                    <button class="kmila-btn" data-testid="visual-bp-add" @onclick="AddBreakpoint">@Traductor.T("VISUAL_BP_ADD")</button>
                </KmilaTooltip>
                @if (_coord.TickBreakpoints.Count > 0)
                {
                    <div class="visual-page__bp-list">
                        @foreach (var bp in _coord.TickBreakpoints.OrderBy(t => t))
                        {
                            var b = bp;
                            <KmilaTooltip TextKey="VISUAL_BP_REMOVE_TITLE">
                                <button class="visual-page__bp-chip"
                                        @onclick="() => RemoveBreakpoint(b)">
                                    @b ×
                                </button>
                            </KmilaTooltip>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (_loadError is not null)
    {
        <div class="visual-page__error">@_loadError</div>
    }

    <div class="visual-page__workspace">
        @* Widget palette — left rail; replaces the toolbar add-buttons.
           Disabled while a run is in flight so the user can't add widgets
           mid-trace (matches the old per-button disabled guard). HTML5 DnD
           is wired through OnDragStart/OnDragEnd: the dragged widget type
           lives in _paletteDraggedType until the canvas drop fires. *@
        <WidgetPalette OnSelected="OnPaletteSelected"
                       OnDragStart="OnPaletteDragStart"
                       OnDragEnd="OnPaletteDragEnd"
                       Disabled="@(_coord?.IsRunning == true)" />

        <div class="visual-page__canvas-stack">
          @* Everything inside this wrap is transformed together by the
             kmilaAttachPanZoom handle attached to the stack root. Canvas,
             wire overlay, and floating props all live in the same
             transformed coordinate space so they scroll + zoom in sync. *@
          <div class="visual-page__canvas-wrap"
               style="width:@(_doc.Canvas.Width)px; height:@(_doc.Canvas.Height)px;">
            <VisualCanvas Doc="@_doc"
                          Coordinator="@_coord"
                          EditMode="@(_coord?.IsRunning != true)"
                          FrameVersion="@_frameVersion"
                          EmptyHint="@EmptyHintText"
                          OnLayoutChanged="MarkDirty"
                          SelectedId="@_selectedId"
                          SelectedIdChanged="@OnSelectedIdChanged"
                          IsSwitchOnLookup="@IsSwitchOn"
                          OnSwitchToggle="@OnSwitchToggle"
                          MultiSwitchStatesLookup="@MultiSwitchStates"
                          OnMultiSwitchToggle="@OnMultiSwitchToggle"
                          OnDrop="@OnCanvasDrop" />

            @* Phase 3 wire-visualization overlay. SVG sits on top of the
               canvas with pointer-events: none so it never steals clicks
               from widgets. Inner SVG content is built in code-behind as a
               MarkupString because Razor's parser treats lowercase <text>
               as a reserved escape construct, which collides with SVG's
               <text> element. Lines go from each placed widget's anchor to
               a port-name label hanging off the right canvas edge. *@
            @if (_showWires && _doc.Components.Count > 0)
            {
                <svg class="visual-page__wires"
                     width="@_doc.Canvas.Width" height="@_doc.Canvas.Height"
                     viewBox="0 0 @_doc.Canvas.Width @_doc.Canvas.Height"
                     preserveAspectRatio="none">
                    @((MarkupString)BuildWireOverlaySvg())
                </svg>
            }

            @* Floating props card — anchored to the selected widget so
               settings appear next to the piece the user is touching
               (matches R3-8 "like Schematic"). Sits inside canvas-stack
               so it scrolls with the canvas and stays attached during
               drag. Position is computed from sel.Position + a per-type
               width, flipping to the widget's left when the widget is
               close enough to the right edge that the card would clip. *@
            @if (_selectedId is not null && Selected is { } sel)
            {
                var anchor = PropsAnchor(sel);
                <aside class="visual-page__props"
                       style="left:@(anchor.Left)px; top:@(anchor.Top)px;">
                    <div class="visual-page__props-header">
                        <span class="visual-page__props-icon" aria-hidden="true">
                            <Icon Name="@PropsIconFor(sel.Type)" />
                        </span>
                        <h6 class="visual-page__props-title">@Traductor.T(PropsTitleKeyFor(sel.Type))</h6>
                        @{
                            var dir = KvizWidgetCatalog.DirectionOf(sel.Type);
                            var pinCounts = KvizWidgetCatalog.PinCountsByDir(sel);
                            bool mixed = dir is null && pinCounts.InCount > 0 && pinCounts.OutCount > 0;
                        }
                        @if (dir is WidgetDirection wdir)
                        {
                            <span class="visual-page__props-dir visual-page__props-dir--@(wdir == WidgetDirection.Input ? "in" : "out")"
                                  title="@Traductor.T(wdir == WidgetDirection.Input ? "VISUAL_WIDGET_DIRECTION_INPUT_HINT" : "VISUAL_WIDGET_DIRECTION_OUTPUT_HINT")">
                                @Traductor.T(wdir == WidgetDirection.Input ? "VISUAL_WIDGET_DIRECTION_INPUT" : "VISUAL_WIDGET_DIRECTION_OUTPUT")
                            </span>
                        }
                        else if (mixed)
                        {
                            <span class="visual-page__props-dir visual-page__props-dir--in"
                                  title="@Traductor.T("VISUAL_WIDGET_DIRECTION_INPUT_HINT")">
                                @string.Format(Traductor.T("VISUAL_WIDGET_DIRECTION_INPUT_N"), pinCounts.InCount)
                            </span>
                            <span class="visual-page__props-dir visual-page__props-dir--out"
                                  title="@Traductor.T("VISUAL_WIDGET_DIRECTION_OUTPUT_HINT")">
                                @string.Format(Traductor.T("VISUAL_WIDGET_DIRECTION_OUTPUT_N"), pinCounts.OutCount)
                            </span>
                        }
                        @* In-place delete for the selected widget (2026-07-19).
                           A trash icon also lives in the top toolbar, but on
                           mobile the toolbar horizontally-scrolls and the icon
                           frequently ends up off-screen — placing a second
                           entry point next to the props card keeps removal
                           discoverable without hunting. Reuses RemoveSelected
                           (same undo push, same run-guard). *@
                        <KmilaTooltip TextKey="VISUAL_DELETE">
                            <button type="button"
                                    class="visual-page__props-delete"
                                    data-testid="visual-props-delete"
                                    @onclick="RemoveSelected"
                                    disabled="@(_coord?.IsRunning == true)"
                                    aria-label="@Traductor.T("VISUAL_DELETE")">
                                <Icon Name="IconName.Trash" />
                            </button>
                        </KmilaTooltip>
                        <button type="button"
                                class="visual-page__props-close"
                                aria-label="@Traductor.T("COMMON_CLOSE")"
                                @onclick="() => _selectedId = null">×</button>
                    </div>
                    @if (sel.Type == "led")
                    {
                        <label>@Traductor.T("VISUAL_PROP_COLOR")
                            <select class="kmila-input"
                                    value="@LedColor(sel)"
                                    @onchange="@(e => OnLedColorChange(sel, e))">
                                <option value="red">@Traductor.T("VISUAL_MATRIX_COLOR_RED")</option>
                                <option value="green">@Traductor.T("VISUAL_MATRIX_COLOR_GREEN")</option>
                                <option value="blue">@Traductor.T("VISUAL_MATRIX_COLOR_BLUE")</option>
                                <option value="yellow">@Traductor.T("VISUAL_MATRIX_COLOR_YELLOW")</option>
                                <option value="white">@Traductor.T("VISUAL_MATRIX_COLOR_WHITE")</option>
                            </select>
                        </label>
                    }
                    else if (sel.Type == "button")
                    {
                        <label>@Traductor.T("VISUAL_PROP_LABEL")
                            <input class="kmila-input"
                                   value="@ButtonLabel(sel)"
                                   @onchange="@(e => OnButtonLabelChange(sel, e))" />
                        </label>
                        @* Contact-bounce simulation is an expert realism option —
                           hidden unless Advanced mode is on so beginners get a
                           clean (debounced) button by default. *@
                        @if (_advancedMode)
                        {
                            <label class="visual-page__props-checkbox">
                                <input type="checkbox"
                                       checked="@ButtonBounce(sel)"
                                       @onchange="@(e => OnButtonBounceChange(sel, e))" />
                                <span>@Traductor.T("VISUAL_PROP_BOUNCE")</span>
                            </label>
                            <small class="kmila-muted">@Traductor.T("VISUAL_PROP_BOUNCE_HINT")</small>
                        }
                    }
                    else if (sel.Type == "switch")
                    {
                        <label>@Traductor.T("VISUAL_PROP_LABEL")
                            <input class="kmila-input"
                                   value="@SwitchLabel(sel)"
                                   @onchange="@(e => OnSwitchLabelChange(sel, e))" />
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_DEFAULT_STATE")
                            <select class="kmila-input"
                                    value="@SwitchDefault(sel)"
                                    @onchange="@(e => OnSwitchDefaultChange(sel, e))">
                                <option value="0">@Traductor.T("VISUAL_DEFAULT_STATE_OFF")</option>
                                <option value="1">@Traductor.T("VISUAL_DEFAULT_STATE_ON")</option>
                            </select>
                        </label>
                    }
                    else if (sel.Type == "stepper")
                    {
                        <label>@Traductor.T("VISUAL_PROP_STEPS_PER_REV")
                            <input class="kmila-input" type="number" min="4" max="4096" step="1"
                                   value="@StepperStepsPerRev(sel)"
                                   @onchange="@(e => OnStepperStepsChange(sel, e))" />
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_DIRECTION")
                            <select class="kmila-input"
                                    value="@StepperDirection(sel)"
                                    @onchange="@(e => OnStepperDirectionChange(sel, e))">
                                <option value="auto">@Traductor.T("VISUAL_DIRECTION_AUTO")</option>
                                <option value="cw">@Traductor.T("VISUAL_DIRECTION_CW")</option>
                                <option value="ccw">@Traductor.T("VISUAL_DIRECTION_CCW")</option>
                            </select>
                        </label>
                    }
                    else if (sel.Type == "seven-seg")
                    {
                        @* The decoded "Expert" modes (hex/dec) are only offered in
                           Advanced mode; beginners wire the raw a..g segments. The
                           select still shows for a legacy widget already on an
                           expert mode so it can be switched back to raw. *@
                        @if (_advancedMode || SevenSegMode(sel) != "raw")
                        {
                            <label>@Traductor.T("VISUAL_PROP_MODE")
                                <select class="kmila-input"
                                        value="@SevenSegMode(sel)"
                                        @onchange="@(e => OnSevenSegModeChange(sel, e))">
                                    <option value="raw">@Traductor.T("VISUAL_SEVEN_SEG_MODE_RAW")</option>
                                    <option value="hex">@Traductor.T("VISUAL_SEVEN_SEG_MODE_HEX")</option>
                                    <option value="dec">@Traductor.T("VISUAL_SEVEN_SEG_MODE_DEC")</option>
                                </select>
                            </label>
                        }
                        @if (SevenSegMode(sel) == "raw")
                        {
                            <label>@Traductor.T("VISUAL_PROP_POLARITY")
                                <select class="kmila-input"
                                        value="@SevenSegPolarity(sel)"
                                        @onchange="@(e => OnSevenSegPolarityChange(sel, e))">
                                    <option value="cathode">@Traductor.T("VISUAL_SEVEN_SEG_POLARITY_CATHODE")</option>
                                    <option value="anode">@Traductor.T("VISUAL_SEVEN_SEG_POLARITY_ANODE")</option>
                                </select>
                            </label>
                        }
                        <label>@Traductor.T("VISUAL_PROP_COLOR")
                            <select class="kmila-input"
                                    value="@LedColor(sel)"
                                    @onchange="@(e => OnLedColorChange(sel, e))">
                                <option value="red">@Traductor.T("VISUAL_MATRIX_COLOR_RED")</option>
                                <option value="green">@Traductor.T("VISUAL_MATRIX_COLOR_GREEN")</option>
                                <option value="blue">@Traductor.T("VISUAL_MATRIX_COLOR_BLUE")</option>
                                <option value="yellow">@Traductor.T("VISUAL_MATRIX_COLOR_YELLOW")</option>
                                <option value="white">@Traductor.T("VISUAL_MATRIX_COLOR_WHITE")</option>
                            </select>
                        </label>
                    }
                    else if (sel.Type == "seven-seg-bank")
                    {
                        <label>@Traductor.T("VISUAL_PROP_DIGITS")
                            <input class="kmila-input" type="number" min="2" max="8"
                                   value="@SevenSegBankDigits(sel)"
                                   @onchange="@(e => OnSevenSegBankDigitsChange(sel, e))" />
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_MODE")
                            <select class="kmila-input"
                                    value="@SevenSegBankMode(sel)"
                                    @onchange="@(e => OnSevenSegBankModeChange(sel, e))">
                                <option value="raw">@Traductor.T("VISUAL_SEVEN_SEG_MODE_RAW")</option>
                                @if (_advancedMode || SevenSegBankMode(sel) == "hex")
                                {
                                    <option value="hex">@Traductor.T("VISUAL_SEVEN_SEG_MODE_HEX")</option>
                                }
                                @if (_advancedMode || SevenSegBankMode(sel) == "dec")
                                {
                                    <option value="dec">@Traductor.T("VISUAL_SEVEN_SEG_MODE_DEC")</option>
                                }
                                <option value="mux">@Traductor.T("VISUAL_SEVEN_SEG_MODE_MUX")</option>
                            </select>
                        </label>
                        @if (SevenSegBankMode(sel) == "mux")
                        {
                            <label>@Traductor.T("VISUAL_PROP_WIRING")
                                <select class="kmila-input"
                                        value="@SevenSegBankWiring(sel)"
                                        @onchange="@(e => OnSevenSegBankWiringChange(sel, e))">
                                    <option value="packed">@Traductor.T("VISUAL_SEVEN_SEG_WIRING_PACKED")</option>
                                    <option value="explicit">@Traductor.T("VISUAL_SEVEN_SEG_WIRING_EXPLICIT")</option>
                                </select>
                            </label>
                            <label>@Traductor.T("VISUAL_PROP_SELECT_LEVEL")
                                <select class="kmila-input"
                                        value="@(SevenSegBankSelectActiveLow(sel) ? "low" : "high")"
                                        @onchange="@(e => OnSevenSegBankSelectLevelChange(sel, e))">
                                    <option value="low">@Traductor.T("VISUAL_SEVEN_SEG_SELECT_ACTIVE_LOW")</option>
                                    <option value="high">@Traductor.T("VISUAL_SEVEN_SEG_SELECT_ACTIVE_HIGH")</option>
                                </select>
                            </label>
                            <label class="kmila-check">
                                <input type="checkbox"
                                       checked="@SevenSegBankPersistence(sel)"
                                       @onchange="@(e => OnSevenSegBankPersistenceChange(sel, e))" />
                                @Traductor.T("VISUAL_PROP_PERSISTENCE")
                            </label>
                        }
                        @if (SevenSegBankMode(sel) == "raw" || SevenSegBankMode(sel) == "mux")
                        {
                            <label>@Traductor.T("VISUAL_PROP_POLARITY")
                                <select class="kmila-input"
                                        value="@SevenSegBankPolarity(sel)"
                                        @onchange="@(e => OnSevenSegBankPolarityChange(sel, e))">
                                    <option value="cathode">@Traductor.T("VISUAL_SEVEN_SEG_POLARITY_CATHODE")</option>
                                    <option value="anode">@Traductor.T("VISUAL_SEVEN_SEG_POLARITY_ANODE")</option>
                                </select>
                            </label>
                        }
                        <label>@Traductor.T("VISUAL_PROP_COLOR")
                            <select class="kmila-input"
                                    value="@LedColor(sel)"
                                    @onchange="@(e => OnLedColorChange(sel, e))">
                                <option value="red">@Traductor.T("VISUAL_MATRIX_COLOR_RED")</option>
                                <option value="green">@Traductor.T("VISUAL_MATRIX_COLOR_GREEN")</option>
                                <option value="blue">@Traductor.T("VISUAL_MATRIX_COLOR_BLUE")</option>
                                <option value="yellow">@Traductor.T("VISUAL_MATRIX_COLOR_YELLOW")</option>
                                <option value="white">@Traductor.T("VISUAL_MATRIX_COLOR_WHITE")</option>
                            </select>
                        </label>
                    }
                    else if (sel.Type == "led-array")
                    {
                        <label>@Traductor.T("VISUAL_PROP_LENGTH")
                            <input class="kmila-input" type="number" min="1" max="64"
                                   value="@LedArrayLength(sel)"
                                   @onchange="@(e => OnLedArrayLengthChange(sel, e))" />
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_COLOR")
                            <select class="kmila-input"
                                    value="@LedColor(sel)"
                                    @onchange="@(e => OnLedColorChange(sel, e))">
                                <option value="red">@Traductor.T("VISUAL_MATRIX_COLOR_RED")</option>
                                <option value="green">@Traductor.T("VISUAL_MATRIX_COLOR_GREEN")</option>
                                <option value="blue">@Traductor.T("VISUAL_MATRIX_COLOR_BLUE")</option>
                                <option value="yellow">@Traductor.T("VISUAL_MATRIX_COLOR_YELLOW")</option>
                                <option value="white">@Traductor.T("VISUAL_MATRIX_COLOR_WHITE")</option>
                            </select>
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_ORIENTATION")
                            <select class="kmila-input"
                                    value="@LedArrayOrientation(sel)"
                                    @onchange="@(e => OnLedArrayOrientationChange(sel, e))">
                                <option value="h">@Traductor.T("VISUAL_ORIENT_H")</option>
                                <option value="v">@Traductor.T("VISUAL_ORIENT_V")</option>
                            </select>
                        </label>
                    }
                    else if (sel.Type == "lcd-hd44780")
                    {
                        <label>@Traductor.T("VISUAL_PROP_MODE")
                            <select class="kmila-input"
                                    value="@LcdMode(sel)"
                                    @onchange="@(e => OnLcdModeChange(sel, e))">
                                @* HD44780 controller (4/8-bit) + raw glass (no
                                   controller) are the real pin-level paths, always
                                   shown. Assisted `text` stays behind Advanced mode. *@
                                <option value="raw-4bit">@Traductor.T("VISUAL_LCD_MODE_RAW_4BIT")</option>
                                <option value="raw-8bit">@Traductor.T("VISUAL_LCD_MODE_RAW_8BIT")</option>
                                <option value="raw-panel">@Traductor.T("VISUAL_LCD_MODE_RAW_PANEL")</option>
                                @if (_advancedMode || LcdMode(sel) == "text")
                                {
                                    <option value="text">@Traductor.T("VISUAL_LCD_MODE_TEXT")</option>
                                }
                            </select>
                        </label>
                        @if (LcdMode(sel) == "raw-panel")
                        {
                            <label>@Traductor.T("VISUAL_LCD_GLASS_ROWS")
                                <input class="kmila-input" type="number" min="1" max="16" step="1"
                                       value="@LcdGlassRows(sel)"
                                       @onchange="@(e => OnLcdGlassRowsChange(sel, e))" />
                            </label>
                            <label>@Traductor.T("VISUAL_LCD_GLASS_COLS")
                                <input class="kmila-input" type="number" min="1" max="40" step="1"
                                       value="@LcdGlassCols(sel)"
                                       @onchange="@(e => OnLcdGlassColsChange(sel, e))" />
                            </label>
                        }
                        else
                        {
                            <label>@Traductor.T("VISUAL_LCD_ROWS")
                                <select class="kmila-input"
                                        value="@LcdRows(sel)"
                                        @onchange="@(e => OnLcdRowsChange(sel, e))">
                                    <option value="2">2</option>
                                    <option value="4">4</option>
                                </select>
                            </label>
                            <label>@Traductor.T("VISUAL_LCD_COLS")
                                <select class="kmila-input"
                                        value="@LcdCols(sel)"
                                        @onchange="@(e => OnLcdColsChange(sel, e))">
                                    <option value="16">16</option>
                                    <option value="20">20</option>
                                </select>
                            </label>
                        }
                    }
                    else if (sel.Type == "dot-matrix")
                    {
                        <label>@Traductor.T("VISUAL_DOTMATRIX_ROWS")
                            <input class="kmila-input" type="number" min="1" max="16" step="1"
                                   value="@DotMatrixRows(sel)"
                                   @onchange="@(e => OnDotMatrixRowsChange(sel, e))" />
                        </label>
                        <label>@Traductor.T("VISUAL_DOTMATRIX_COLS")
                            <input class="kmila-input" type="number" min="1" max="16" step="1"
                                   value="@DotMatrixCols(sel)"
                                   @onchange="@(e => OnDotMatrixColsChange(sel, e))" />
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_COLOR")
                            <select class="kmila-input"
                                    value="@DotMatrixColor(sel)"
                                    @onchange="@(e => OnDotMatrixColorChange(sel, e))">
                                <option value="red">@Traductor.T("VISUAL_MATRIX_COLOR_RED")</option>
                                <option value="green">@Traductor.T("VISUAL_MATRIX_COLOR_GREEN")</option>
                                <option value="blue">@Traductor.T("VISUAL_MATRIX_COLOR_BLUE")</option>
                                <option value="white">@Traductor.T("VISUAL_MATRIX_COLOR_WHITE")</option>
                            </select>
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_BRIGHTNESS")
                            <input class="kmila-input" type="range" min="0" max="100" step="1"
                                   value="@DotMatrixBrightness(sel)"
                                   @onchange="@(e => OnDotMatrixBrightnessChange(sel, e))" />
                        </label>
                    }
                    else if (sel.Type == "keypad-matrix")
                    {
                        @* Decoded (key+pressed) is the Expert binding; beginners
                           implement the row/col scan themselves (raw-scan). *@
                        @if (_advancedMode || KeypadMode(sel) != "raw-scan")
                        {
                            <label>@Traductor.T("VISUAL_PROP_MODE")
                                <select class="kmila-input"
                                        value="@KeypadMode(sel)"
                                        @onchange="@(e => OnKeypadModeChange(sel, e))">
                                    <option value="decoded">@Traductor.T("VISUAL_KEYPAD_MODE_DECODED")</option>
                                    <option value="raw-scan">@Traductor.T("VISUAL_KEYPAD_MODE_RAW")</option>
                                </select>
                            </label>
                        }
                        <label>@Traductor.T("VISUAL_KEYPAD_ROWS")
                            <input class="kmila-input" type="number" min="3" max="4" step="1"
                                   value="@KeypadRows(sel)"
                                   @onchange="@(e => OnKeypadRowsChange(sel, e))" />
                        </label>
                        <label>@Traductor.T("VISUAL_KEYPAD_COLS")
                            <input class="kmila-input" type="number" min="3" max="4" step="1"
                                   value="@KeypadCols(sel)"
                                   @onchange="@(e => OnKeypadColsChange(sel, e))" />
                        </label>
                    }
                    else if (sel.Type == "buzzer-piezo")
                    {
                        @* freq_hz+enable is the Expert binding; beginners drive the
                           raw PWM `signal` pin and build the divider themselves. *@
                        @if (_advancedMode || BuzzerMode(sel) != "signal")
                        {
                            <label>@Traductor.T("VISUAL_PROP_MODE")
                                <select class="kmila-input"
                                        value="@BuzzerMode(sel)"
                                        @onchange="@(e => OnBuzzerModeChange(sel, e))">
                                    <option value="freq">@Traductor.T("VISUAL_BUZZER_MODE_FREQ")</option>
                                    <option value="signal">@Traductor.T("VISUAL_BUZZER_MODE_SIGNAL")</option>
                                </select>
                            </label>
                        }
                        <small class="kmila-muted">@Traductor.T("VISUAL_BUZZER_UNLOCK_HINT")</small>
                    }
                    else if (sel.Type == "matrix-3x3-rgb")
                    {
                        @* Planes (3×9-bit) is the Expert binding; beginners drive the
                           27 raw per-cell colour anodes. *@
                        @if (_advancedMode || RgbMatrixMode(sel) != "raw")
                        {
                            <label>@Traductor.T("VISUAL_PROP_MODE")
                                <select class="kmila-input"
                                        value="@RgbMatrixMode(sel)"
                                        @onchange="@(e => OnRgbMatrixModeChange(sel, e))">
                                    <option value="planes">@Traductor.T("VISUAL_RGB_MATRIX_MODE_PLANES")</option>
                                    <option value="raw">@Traductor.T("VISUAL_RGB_MATRIX_MODE_RAW")</option>
                                </select>
                            </label>
                        }
                        <label>@Traductor.T("VISUAL_PROP_BRIGHTNESS")
                            <input class="kmila-input" type="range" min="0" max="100" step="1"
                                   value="@RgbMatrixBrightness(sel)"
                                   @onchange="@(e => OnRgbMatrixBrightnessChange(sel, e))" />
                        </label>
                    }
                    else if (sel.Type == "matrix-3x3")
                    {
                        @* 9-bit value is the Expert binding; beginners drive the raw
                           per-cell anode/cathode pins. *@
                        @if (_advancedMode || LedMatrixMode(sel) != "raw")
                        {
                            <label>@Traductor.T("VISUAL_PROP_MODE")
                                <select class="kmila-input"
                                        value="@LedMatrixMode(sel)"
                                        @onchange="@(e => OnLedMatrixModeChange(sel, e))">
                                    <option value="value">@Traductor.T("VISUAL_MATRIX_MODE_VALUE")</option>
                                    <option value="raw">@Traductor.T("VISUAL_MATRIX_MODE_RAW")</option>
                                </select>
                            </label>
                        }
                        <label>@Traductor.T("VISUAL_PROP_COLOR")
                            <select class="kmila-input"
                                    value="@LedColor(sel)"
                                    @onchange="@(e => OnLedColorChange(sel, e))">
                                <option value="red">@Traductor.T("VISUAL_MATRIX_COLOR_RED")</option>
                                <option value="green">@Traductor.T("VISUAL_MATRIX_COLOR_GREEN")</option>
                                <option value="blue">@Traductor.T("VISUAL_MATRIX_COLOR_BLUE")</option>
                                <option value="white">@Traductor.T("VISUAL_MATRIX_COLOR_WHITE")</option>
                            </select>
                        </label>
                        <label>@Traductor.T("VISUAL_PROP_BRIGHTNESS")
                            <input class="kmila-input" type="range" min="0" max="100" step="1"
                                   value="@LedMatrixBrightness(sel)"
                                   @onchange="@(e => OnLedMatrixBrightnessChange(sel, e))" />
                        </label>
                    }
                    else if (sel.Type == "multi-switch")
                    {
                        @* `vector` collapses the bank to one std_logic_vector port —
                           the Expert binding. Beginners wire one raw pin per switch
                           (per-bit). *@
                        @if (_advancedMode || MultiSwitchMode(sel) != "per-bit")
                        {
                            <label>@Traductor.T("VISUAL_PROP_MODE")
                                <select class="kmila-input"
                                        value="@MultiSwitchMode(sel)"
                                        @onchange="@(e => OnMultiSwitchModeChange(sel, e))">
                                    <option value="per-bit">@Traductor.T("VISUAL_MULTI_SWITCH_MODE_PER_BIT")</option>
                                    <option value="vector">@Traductor.T("VISUAL_MULTI_SWITCH_MODE_VECTOR")</option>
                                </select>
                            </label>
                        }
                        <label>@Traductor.T("VISUAL_PROP_COUNT")
                            <input class="kmila-input" type="number" min="2" max="8" step="1"
                                   value="@MultiSwitchCount(sel)"
                                   @onchange="@(e => OnMultiSwitchCountChange(sel, e))" />
                        </label>
                        @if (_advancedMode)
                        {
                            <label class="visual-page__props-checkbox">
                                <input type="checkbox"
                                       checked="@MultiSwitchBounce(sel)"
                                       @onchange="@(e => OnMultiSwitchBounceChange(sel, e))" />
                                <span>@Traductor.T("VISUAL_PROP_BOUNCE")</span>
                            </label>
                            <small class="kmila-muted">@Traductor.T("VISUAL_PROP_BOUNCE_HINT")</small>
                        }
                    }
                    <h6 class="visual-page__props-section">@Traductor.T("VISUAL_PIN_TO_PORT")</h6>
                    <div class="visual-page__props-binding">
                        @foreach (var b in sel.Bindings)
                        {
                            var wired = !string.IsNullOrEmpty(b.Value);
                            <div class="visual-page__props-binding-row">
                                <code>@b.Key</code>
                                <span class="visual-page__props-binding-arrow" aria-hidden="true">→</span>
                                <span class="visual-page__props-binding-port @(wired ? null : "visual-page__props-binding-port--unwired")">
                                    @(wired ? b.Value : Traductor.T("VISUAL_UNWIRED"))
                                </span>
                            </div>
                        }
                        @if (sel.Bindings.Count == 0)
                        {
                            <div class="visual-page__props-binding-empty">@Traductor.T("VISUAL_NO_BINDINGS")</div>
                        }
                    </div>
                </aside>
            }
          </div> @* /visual-page__canvas-wrap *@

          @* §6 Item 4 (2026-07-05) — locator popover. Floats over the
             canvas-stack (position: absolute; top-right) so it doesn't
             steal layout from the toolbar. Lists every widget in the
             doc; per-row Focus button snaps pan-zoom to its position. *@
          @if (_showLocator && _doc.Components.Count > 0)
          {
              <aside class="visual-page__locator" data-testid="visual-locator-panel">
                  <div class="visual-page__locator-header">
                      <h6>@Traductor.T("VISUAL_LOCATOR")</h6>
                      <button type="button" class="visual-page__locator-close"
                              @onclick="() => _showLocator = false"
                              aria-label="@Traductor.T("COMMON_CLOSE")">×</button>
                  </div>
                  <ul class="visual-page__locator-list">
                      @foreach (var comp in _doc.Components)
                      {
                          var localC = comp;
                          <li>
                              <button type="button"
                                      data-testid="@($"visual-locator-focus-{localC.Id}")"
                                      class="visual-page__locator-item @(_selectedId == localC.Id ? "is-active" : "")"
                                      @onclick="() => FocusWidget(localC)">
                                  <span class="visual-page__locator-item-label">@LocatorLabelFor(localC)</span>
                              </button>
                          </li>
                      }
                  </ul>
              </aside>
          }
        </div> @* /visual-page__canvas-stack *@
    </div>
</section>

<VisualWiringModal IsOpen="_wiringOpen"
                   Title="@Traductor.T("VISUAL_WIRING_TITLE")"
                   Doc="_doc"
                   Entity="_entity"
                   OnClose="CloseWiring"
                   OnChanged="MarkDirty" />

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    // When true, the panel is mounted inline inside the Editor's view-tabs
    // strip. The header (back-button + title) is suppressed so the toolbar
    // sits flush against the editor's own breadcrumb + tab row.
    [Parameter] public bool EmbeddedMode { get; set; }

    // Editor.razor keeps the VisualPanel mounted (display:none) when the user
    // switches to Code/Blocks/Replay — otherwise the coord's Task.Run loop
    // would keep ticking against a hidden subtree. Editor drives this
    // parameter from _editorCardTab == Visual; on the standalone /visual/{id}
    // route it stays true. Transitions are handled in OnParametersSetAsync:
    // true→false auto-pauses the coord, false→true auto-resumes it (only when
    // WE paused it — a user Pause via the toolbar sets no flag, so auto-resume
    // never overrules the user's intent).
    [Parameter] public bool IsActiveTab { get; set; } = true;
    private bool _lastIsActiveTab = true;
    private bool _autoPausedByTabHide;

    private int _projectId = -1;
    private Project? _project;
    private List<ProjectFile> _files = new();
    private ProjectFile? _designFile;
    private ProjectFile? _kvizFile;
    private Entity? _entity;
    private KvizDoc _doc = new();
    private VisualRunCoordinator? _coord;
    private string? _selectedId;
    private bool _wiringOpen;
    private bool _dirty;
    private int _frameVersion;
    private string? _loadError;
    private System.Threading.Timer? _repaintTimer;

    // R3-6 sub-task A — undo/redo history over the whole KvizDoc.
    // Snapshots are JSON produced by KvizSerializer.Serialize. Every
    // mutation funnels through MarkDirty(), which pushes the previous
    // baseline to _undo and re-baselines _lastSnapshot. Load and Save
    // set _savedSnapshot so _dirty can be computed as
    // (_lastSnapshot != _savedSnapshot) — including "you undid past
    // the save and came back to a clean state."
    private readonly LinkedList<string> _undo = new();
    private readonly LinkedList<string> _redo = new();
    private string _lastSnapshot = "";
    private string _savedSnapshot = "";
    private const int UndoCap = 50;

    // Playback pacing. The continuous slider drives `_customDelayMs` (the real
    // per-tick delay in ms; 0 = Free) as the single source of truth; `_speedPos`
    // is its slider position. The legacy `_speedIndex`/`VisualSpeed` enum is kept
    // only to map old `.kviz` DefaultSpeed strings on load.
    private VisualSpeed _speedIndex = VisualSpeed.Normal;
    private int? _customDelayMs = VisualSpeed.Normal.TickDelayMs();
    private int _speedPos = VisualSpeedScale.SliderFromDelay(VisualSpeed.Normal.TickDelayMs());
    private int _settingsRingBuffer;
    private ulong _scrubTick;
    private string _bpInput = string.Empty;
    private ulong? _lastBreakHitTick;

    // Phase 3 (2026-06-26): "Show wires" toolbar toggle overlays an SVG that
    // draws straight lines from each placed widget's anchor to the port-name
    // label hanging off the canvas edge. Default off — the canvas stays
    // clean for first-open; users opt in when they want to read the
    // pin-to-port routing at a glance.
    private bool _showWires;

    private string SpeedLabel => VisualSpeedScale.DelayLabel(_customDelayMs, Traductor.T("VISUAL_SPEED_FREE"));

    private const string KvizExt = ".kviz";

    private KvizComponent? Selected =>
        _selectedId is null ? null : _doc.Components.FirstOrDefault(c => c.Id == _selectedId);

    // Header icon for the floating props card — mirrors WidgetPalette's
    // per-widget IconName mapping so a user sees the same glyph on the
    // palette chip and on the selected widget's popover.
    private static IconName PropsIconFor(string type) => type switch
    {
        "led"       => IconName.Lightbulb,
        "button"    => IconName.CircleFill,
        "switch"    => IconName.ToggleOn,
        "led-array" => IconName.Grid,
        "stepper"   => IconName.ArrowRepeat,
        "seven-seg" => IconName.Display,
        "seven-seg-bank" => IconName.Display,
        "multi-switch" => IconName.Sliders,
        "matrix-3x3" => IconName.Grid3X3Gap,
        "matrix-3x3-rgb" => IconName.Grid3X3GapFill,
        "buzzer-piezo" => IconName.VolumeUpFill,
        "keypad-matrix" => IconName.Grid,
        "lcd-hd44780" => IconName.Display,
        "dot-matrix" => IconName.Grid3X3Gap,
        _           => IconName.Gear,
    };

    // Dictionary key for the header title — reuses the palette label
    // strings so "Button", "LED", … stay in sync across the palette chip
    // and the props card. Falls back to the raw type slug for unknowns.
    private static string PropsTitleKeyFor(string type) => type switch
    {
        "led"       => "VISUAL_PALETTE_LED",
        "button"    => "VISUAL_PALETTE_BUTTON",
        "switch"    => "VISUAL_PALETTE_SWITCH",
        "led-array" => "VISUAL_PALETTE_LED_ARRAY",
        "stepper"   => "VISUAL_PALETTE_STEPPER",
        "seven-seg" => "VISUAL_PALETTE_SEVEN_SEG",
        "seven-seg-bank" => "VISUAL_PALETTE_SEVEN_SEG_BANK",
        "multi-switch" => "VISUAL_PALETTE_MULTI_SWITCH",
        "matrix-3x3" => "VISUAL_PALETTE_LED_MATRIX",
        "matrix-3x3-rgb" => "VISUAL_PALETTE_RGB_MATRIX",
        "buzzer-piezo" => "VISUAL_PALETTE_BUZZER",
        "keypad-matrix" => "VISUAL_PALETTE_KEYPAD",
        "lcd-hd44780" => "VISUAL_PALETTE_LCD",
        "dot-matrix" => "VISUAL_PALETTE_DOT_MATRIX",
        _           => type,
    };

    // Anchor the floating props card next to the selected widget. Prefers
    // widget-right; flips to widget-left when the card would fall off the
    // canvas right edge. Y clamps between top gap and (canvas.Height -
    // estimated card height) so the card never renders past the canvas box.
    // Card width matches the CSS: 240 px on phones, 260 px elsewhere — use
    // 240 as the smaller of the two so anchor decisions err on "keep it in".
    private (double Left, double Top) PropsAnchor(KvizComponent sel)
    {
        const double CardWidth = 288;   // matches .visual-page__props width in pages.css
        const double CardHeight = 320;  // conservative estimate; scroll handles overflow
        const double Gap = 12;
        double widgetW = sel.Type switch
        {
            "led"        => 64,
            "button"     => 80,
            "switch"     => 80,
            "seven-seg"  => 80,
            "seven-seg-bank" => Math.Clamp(sel.Config.GetInt("digits", 4), 2, 8) * 70 + 16,
            "stepper"    => 130,
            "led-array"  => Math.Max(60, sel.Config.GetInt("length", 4) * 20 + 20),
            "multi-switch" => Math.Clamp(sel.Config.GetInt("count", 4), 2, 8) * 32 + 16,
            "matrix-3x3" => 108,
            "matrix-3x3-rgb" => 108,
            "buzzer-piezo" => 130,
            "keypad-matrix" => Math.Clamp(sel.Config.GetInt("cols", 4), 3, 4) * 42 + 12,
            "lcd-hd44780" => LcdMode(sel) == "raw-panel"
                ? Math.Clamp(sel.Config.GetInt("glassCols", 5), 1, 40) * 10 + 20
                : Math.Clamp(sel.Config.GetInt("cols", 16), 16, 20) * 14 + 20,
            "dot-matrix" => Math.Clamp(sel.Config.GetInt("cols", 8), 1, 16) * 12 + 16,
            _            => 90,
        };
        double x = sel.Position.X + widgetW + Gap;
        if (x + CardWidth > _doc.Canvas.Width)
        {
            x = Math.Max(Gap, sel.Position.X - CardWidth - Gap);
        }
        x = Math.Clamp(x, Gap, Math.Max(Gap, _doc.Canvas.Width - CardWidth - Gap));

        double y = sel.Position.Y;
        y = Math.Clamp(y, Gap, Math.Max(Gap, _doc.Canvas.Height - CardHeight - Gap));
        return (x, y);
    }

    private string EmptyHintText =>
        _entity == null
            ? Traductor.T("VISUAL_EMPTY_NO_ENTITY")
            : Traductor.T("VISUAL_EMPTY_DEFAULT");

    // The toolbar is rendered in two places (header bar standalone / inline
    // strip embedded), so extract it as a RenderFragment to avoid drift.
    private RenderFragment RenderToolbar() => __builder =>
    {
        <text>
            @* Group 1 — primary action. Run/Stop stands alone as the CTA. *@
            @if (_coord?.IsRunning == true)
            {
                <KmilaTooltip TextKey="VISUAL_STOP_TIP" Placement="Bottom">
                    <button class="kmila-btn kmila-btn--danger" data-testid="visual-stop" @onclick="StopRun">
                        <Icon Name="IconName.StopFill" />
                        <span>@Traductor.T("VISUAL_STOP")</span>
