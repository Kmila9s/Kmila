    private readonly Dictionary<string, bool> _switchStates = new();

    private bool IsSwitchOn(KvizComponent c)
    {
        if (_switchStates.TryGetValue(c.Id, out var v)) return v;
        return c.Config.GetString("defaultState", "0") == "1";
    }

    private async Task OnSwitchToggle((KvizComponent comp, bool value) ev)
    {
        _switchStates[ev.comp.Id] = ev.value;
        if (_coord != null && ev.comp.Bindings.TryGetValue("out", out var port) && !string.IsNullOrEmpty(port))
        {
            _coord.Inputs.Set(port, ev.value ? "1" : "0");
        }
        await InvokeAsync(StateHasChanged);
    }

    private static string SwitchLabel(KvizComponent c) => c.Config.GetString("label", "SW");
    private static string SwitchDefault(KvizComponent c) => c.Config.GetString("defaultState", "0");

    private void OnSwitchLabelChange(KvizComponent c, ChangeEventArgs e)
        => SetCfg(c, "label", e.Value?.ToString() ?? "SW");

    private void OnSwitchDefaultChange(KvizComponent c, ChangeEventArgs e)
    {
        var v = (e.Value?.ToString() ?? "0") == "1" ? "1" : "0";
        SetCfg(c, "defaultState", v);
        _switchStates.Remove(c.Id);
    }

