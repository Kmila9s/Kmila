    private static string SevenSegMode(KvizComponent c) => c.Config.GetString("mode", "raw");

    private void OnSevenSegModeChange(KvizComponent c, ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (v != "raw" && v != "hex" && v != "dec") v = "raw";
        // Mode change invalidates the previous pin set — drop bindings that
        // don't apply to the new mode so the user isn't left with orphaned
        // wires. Raw uses a..g+dp; decoded uses value+dp.
        var keep = v == "raw"
            ? new HashSet<string> { "a", "b", "c", "d", "e", "f", "g", "dp" }
            : new HashSet<string> { "value", "dp" };
        var dropped = c.Bindings.Keys.Where(k => !keep.Contains(k)).ToList();
        foreach (var k in dropped) c.Bindings.Remove(k);
        SetCfg(c, "mode", v);
    }

