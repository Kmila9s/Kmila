    // Multi-switch — per-lever states owned here so they survive Run/Stop
    // cycles (same rationale as _switchStates). Array length matches the
    // component's configured count; a mid-simulation count change reshapes
    // the array via OnMultiSwitchCountChange.
    private readonly Dictionary<string, bool[]> _multiSwitchStates = new();

    private bool[] MultiSwitchStates(KvizComponent c)
    {
        var n = Math.Clamp(c.Config.GetInt("count", 4), 2, 8);
        if (_multiSwitchStates.TryGetValue(c.Id, out var arr))
        {
            if (arr.Length == n) return arr;
            // Resize preserving the leading bits — count went up (append
            // false) or down (truncate).
            var resized = new bool[n];
            Array.Copy(arr, resized, Math.Min(arr.Length, n));
            _multiSwitchStates[c.Id] = resized;
            return resized;
        }
        var fresh = new bool[n];
        _multiSwitchStates[c.Id] = fresh;
        return fresh;
    }

    private async Task OnMultiSwitchToggle((KvizComponent comp, int index, bool value) ev)
    {
        var arr = MultiSwitchStates(ev.comp);
        if (ev.index < 0 || ev.index >= arr.Length) return;
        arr[ev.index] = ev.value;
        PushMultiSwitchToCoordinator(ev.comp, arr);
        await InvokeAsync(StateHasChanged);
    }

    // Emit the current per-lever state through the coordinator. Handles
    // both variants: per-bit publishes one bit per bound "out{i}" pin;
    // vector assembles an MSB-first bit string on "value". When bounce
    // is enabled and vector-mode has a wired port, the coordinator's
    // FIFO chatter overlay wobbles the value briefly on each change
    // (raw per-bit callers stay chatter-free — see the plan invariant).
    private void PushMultiSwitchToCoordinator(KvizComponent c, bool[] states)
    {
        if (_coord == null) return;
        var bounce = c.Config.GetBool("bounce", false);
        var mode = c.Config.GetString("mode", "per-bit");
        if (mode == "vector")
        {
            if (!c.Bindings.TryGetValue("value", out var port) || string.IsNullOrEmpty(port)) return;
            var chars = new char[states.Length];
            for (int i = 0; i < states.Length; i++)
                chars[states.Length - 1 - i] = states[i] ? '1' : '0';
            var bits = new string(chars);
            _coord.WriteInput(port, bits);
            // Bounce needs a raw port name — sliced vector bindings skip
            // bounce (deferred, same rationale as ButtonWidget).
            bool sliced = port.IndexOf('[') >= 0;
            if (bounce && !sliced)
            {
                // 6-tick alternation between prior and new bit strings —
                // reuse the existing EnqueueBounce FIFO by simulating a
                // "flap" on the whole vector.
                var flap = InvertBits(bits);
                _coord.EnqueueBounce(port, new[] { flap, bits, flap, bits, flap, bits });
            }
        }
        else
        {
            for (int i = 0; i < states.Length; i++)
            {
                if (!c.Bindings.TryGetValue($"out{i}", out var port) || string.IsNullOrEmpty(port)) continue;
                var bit = states[i] ? "1" : "0";
                _coord.WriteInput(port, bit);
                // Raw per-bit variant intentionally never debounces — the
                // handoff invariant is that students see chatter unless
                // they opt in explicitly via the assisted vector mode.
            }
        }
    }

    private static string InvertBits(string bits)
    {
        var chars = new char[bits.Length];
        for (int i = 0; i < bits.Length; i++)
            chars[i] = bits[i] == '1' ? '0' : '1';
        return new string(chars);
    }

