                        aria-label="@Traductor.T("VISUAL_DELETE")">
                    <Icon Name="IconName.Trash" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="VISUAL_UNDO_TOOLTIP">
                <button class="kmila-btn-icon" data-testid="visual-undo"
