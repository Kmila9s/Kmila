    // Single mutation-commit hook. Every mutation site funnels through
    // here (many still say `_dirty = true` inline — route them via
    // MarkDirty() so snapshot capture stays uniform). The previous
    // baseline is pushed onto the undo stack, then _lastSnapshot is
    // re-baselined against the current post-mutation doc. Redo is
    // invalidated by any new user action.
    private void MarkDirty()
    {
        RecomputeCanvasBounds();
        _undo.AddLast(_lastSnapshot);
        while (_undo.Count > UndoCap) _undo.RemoveFirst();
        _lastSnapshot = KvizSerializer.Serialize(_doc);
        _redo.Clear();
        _dirty = (_lastSnapshot != _savedSnapshot);
    }

    // Widgets are absolutely positioned inside .visual-page__canvas-wrap,
    // which is inline-styled to Canvas.Width × Canvas.Height. Auto-fit
    // model: the canvas is sized to the widget bounding box + padding,
    // rounded up to a CanvasGrowStep boundary so pixel-scale drag doesn't
    // re-fire size changes. Grows when a widget moves past the edge;
    // shrinks when the outermost widget moves inward or is deleted
    // (with a 2-step hysteresis to avoid oscillation). Minimum floor
    // stays at 1200×800 so the empty canvas still feels roomy.
    private const int WidgetOverflowPad = 240;
    private const int CanvasGrowStep    = 400;
    private const int MinCanvasW        = 1200;
    private const int MinCanvasH        = 800;

    private void RecomputeCanvasBounds()
    {
        double maxX = 0, maxY = 0;
        foreach (var c in _doc.Components)
        {
            if (c.Position.X > maxX) maxX = c.Position.X;
            if (c.Position.Y > maxY) maxY = c.Position.Y;
        }
        int neededW = Math.Max((int)Math.Ceiling(maxX) + WidgetOverflowPad, MinCanvasW);
        int neededH = Math.Max((int)Math.Ceiling(maxY) + WidgetOverflowPad, MinCanvasH);
        int targetW = ((neededW / CanvasGrowStep) + 1) * CanvasGrowStep;
        int targetH = ((neededH / CanvasGrowStep) + 1) * CanvasGrowStep;

        bool changed = false;
        // Grow immediately when a widget passes the edge.
        if (targetW > _doc.Canvas.Width)
        {
            _doc.Canvas.Width = targetW;
            changed = true;
        }
        // Shrink only when the gap exceeds 2 * step so tiny drags don't
        // ping-pong the canvas size on every mutation.
        else if (_doc.Canvas.Width - targetW >= 2 * CanvasGrowStep)
        {
            _doc.Canvas.Width = targetW;
            changed = true;
        }

        if (targetH > _doc.Canvas.Height)
        {
            _doc.Canvas.Height = targetH;
            changed = true;
        }
        else if (_doc.Canvas.Height - targetH >= 2 * CanvasGrowStep)
        {
            _doc.Canvas.Height = targetH;
            changed = true;
        }

        if (changed) _pendingPanZoomInvalidate = true;
    }

    private void UndoOnce()
    {
        if (_undo.Count == 0) return;
        _redo.AddLast(_lastSnapshot);
        var prev = _undo.Last!.Value;
        _undo.RemoveLast();
        var restored = KvizSerializer.Deserialize(prev);
        if (restored != null) _doc = restored;
        _lastSnapshot = prev;
        _dirty = (_lastSnapshot != _savedSnapshot);
        // Widget IDs may not exist in the restored doc — safer to
        // drop selection than to reference a stale id.
        _selectedId = null;
        StateHasChanged();
    }

    private void RedoOnce()
    {
        if (_redo.Count == 0) return;
        _undo.AddLast(_lastSnapshot);
        while (_undo.Count > UndoCap) _undo.RemoveFirst();
        var next = _redo.Last!.Value;
        _redo.RemoveLast();
        var restored = KvizSerializer.Deserialize(next);
        if (restored != null) _doc = restored;
        _lastSnapshot = next;
        _dirty = (_lastSnapshot != _savedSnapshot);
        _selectedId = null;
        StateHasChanged();
    }

    // R3-6 sub-task B — revert every in-memory change back to the
    // last-saved snapshot. Not destructive: the discarded state is
    // pushed to the undo stack first so the user can regret the
    // revert with Ctrl/Cmd+Z. Idempotent when already clean.
    private void ClearChanges()
    {
        if (_lastSnapshot == _savedSnapshot) return;
        _undo.AddLast(_lastSnapshot);
        while (_undo.Count > UndoCap) _undo.RemoveFirst();
        var restored = KvizSerializer.Deserialize(_savedSnapshot);
        if (restored != null) _doc = restored;
        _lastSnapshot = _savedSnapshot;
        _redo.Clear();
        _dirty = false;
        _selectedId = null;
        ToastService.Notify(Message(
            Traductor.T("COMMON_MESSAGE"),
            Traductor.T("VISUAL_CLEAR_CHANGES_TOAST"),
            ToastType.Info));
        StateHasChanged();
    }

    private void OnSelectedIdChanged(string? id)
    {
        var isNew = id is not null && id != _selectedId;
        _selectedId = id;
        if (isNew) _pendingPropsScroll = id;
    }

    // Deferred until OnAfterRenderAsync so the props card's DOM exists when
    // the JS reads its rect — Razor renders the card in the same pass that
    // sets _selectedId, but Blazor commits the render before this hook runs.
    private string? _pendingPropsScroll;

    // Pan/zoom + fullscreen state. Pan-zoom is a JS-managed transform on
    // .kviz-canvas driven by the shared kmilaAttachPanZoom library (same
    // one Schematic + Waveform use). Attach happens on the first render
    // pass; detach happens on Dispose. When fullscreen toggles the panel
    // pins to the viewport via CSS, but the pan-zoom handle survives —
    // no reattach needed because the root element identity stays the same.
    private int _panZoomId = -1;
    private bool _panZoomAttached;
    private bool _isFullscreen;
    // Set by MarkDirty() when the canvas dims changed (widget dragged past
    // the previous extent). Consumed on the next render pass to nudge the
    // pan-zoom lib to re-measure its cached bounds so the fresh inline
    // width/height on .visual-page__canvas-wrap is honoured.
    private bool _pendingPanZoomInvalidate;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Per-user source of truth for Advanced mode. localStorage is
            // read here (not in OnInitializedAsync) because JS interop isn't
            // available during prerender. Falls back to the SQLite seed when
            // the key was never written in this browser.
            try
            {
                var ls = await JS.InvokeAsync<string?>("localStorage.getItem", "kmila-advanced-mode");
                if (!string.IsNullOrEmpty(ls))
                {
                    var adv = string.Equals(ls, "true", StringComparison.OrdinalIgnoreCase);
                    if (adv != _advancedMode)
                    {
                        _advancedMode = adv;
                        StateHasChanged();
                    }
                }
            }
            catch { /* JS not ready — keep the SQLite seed */ }
        }

        if (!_panZoomAttached)
        {
            try
            {
                _panZoomId = await JS.InvokeAsync<int>("kmilaAttachPanZoom",
                    ".visual-page__canvas-stack",
                    new
                    {
                        targetSelector = ".visual-page__canvas-wrap",
                        minScale = 0.25,
                        maxScale = 4.0,
                        fitOnAttach = false,
                        // Widgets own their own drag; keep pan-zoom off them.
                        skipTargetSelectors = new[] { ".kviz-widget" },
                        // Plain mouse wheel pans (Ctrl+wheel still zooms).
                        panOnWheel = true,
                        // Smaller clamp than the default 80 px — widgets
                        // near the far edge of an auto-grown canvas need
                        // to stay reachable on phone-sized viewports.
                        minVisible = 24,
                    });
                _panZoomAttached = _panZoomId > 0;
            }
            catch { /* JS not ready during prerender / SSR — retry next pass */ }
        }

        if (_pendingPanZoomInvalidate && _panZoomId > 0)
        {
            _pendingPanZoomInvalidate = false;
            try { await JS.InvokeVoidAsync("kmilaPanZoomInvalidateBounds", _panZoomId); }
            catch { /* JS not ready — the ResizeObserver on the wrap picks up the growth anyway */ }
        }

        if (_pendingPropsScroll is not null)
        {
            var id = _pendingPropsScroll;
            _pendingPropsScroll = null;
            try
            {
                await JS.InvokeVoidAsync("kmilaVisualEnsurePropsVisible", id);
            }
            catch { /* JS not ready during prerender / SSR paths */ }
        }
    }

    private async Task ZoomBy(double factor)
    {
        if (_panZoomId <= 0) return;
        try { await JS.InvokeVoidAsync("kmilaPanZoomZoom", _panZoomId, factor); }
        catch { }
    }

    private async Task ResetZoom()
    {
        if (_panZoomId <= 0) return;
        try { await JS.InvokeVoidAsync("kmilaPanZoomReset", _panZoomId); }
        catch { }
    }

    private async Task ToggleFullscreen()
    {
        _isFullscreen = !_isFullscreen;
        StateHasChanged();
        // The transform on the canvas anchors to the pre-fullscreen root
        // rect; once the parent snaps to viewport size, clamp/fit needs to
        // rerun so the content doesn't leave gaps or slip off-viewport.
        if (_panZoomId > 0)
        {
            try
            {
                await Task.Yield();  // let the class flip commit first
                await JS.InvokeVoidAsync("kmilaPanZoomReset", _panZoomId);
            }
            catch { }
        }
    }

    private async Task SaveAsync()
    {
        if (_project == null) return;
        if (string.IsNullOrEmpty(_doc.DesignFile))
            _doc.DesignFile = _designFile?.FileName ?? "";

        string json = KvizSerializer.Serialize(_doc);
        string desiredName = (_designFile?.FileName?.Split('.').FirstOrDefault() ?? "design") + KvizExt;

        if (_kvizFile == null)
        {
            var newFile = new ProjectFile
            {
                FileName = desiredName,
                DirectoryPath = string.Empty,
                Content = json,
                ProjectId = _project.Id,
                Project = _project,
            };
            await ProjectFilesRepo.CreateAsync(newFile);
            var refreshed = await ProjectFilesRepo.GetProjectFilesAsync(_project);
            _kvizFile = refreshed.FirstOrDefault(f => IsKviz(f) && f.FileName == desiredName);
        }
        else
        {
            _kvizFile.Content = json;
            _kvizFile.Project = _project;
            await ProjectFilesRepo.UpdateAsync(_kvizFile);
        }
        // Re-baseline: what's now on disk matches _lastSnapshot. Keep
        // undo/redo intact — undoing past a save is a legitimate flow.
        _savedSnapshot = _lastSnapshot;
        _dirty = false;
    }

    private static string NewId(string prefix) =>
        $"{prefix}-{Guid.NewGuid().ToString("N").Substring(0, 6)}";

    private void GoBack() => Nav.NavigateTo($"/editor/{_projectId}");

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
        StopRepaintTicker();
        _coord?.Dispose();
        if (_panZoomId > 0)
        {
            try { _ = JS.InvokeVoidAsync("kmilaDetachPanZoom", _panZoomId).AsTask(); }
            catch { }
            _panZoomId = -1;
            _panZoomAttached = false;
        }
    }
}
