                        aria-label="@Traductor.T(_showWires ? "VISUAL_HIDE_WIRES" : "VISUAL_SHOW_WIRES")">
                    <Icon Name="@(_showWires ? IconName.EyeSlash : IconName.Eye)" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="WAVEFORM_ZOOM_OUT">
                <button class="kmila-btn-icon" data-testid="visual-zoom-out"
                        @onclick="() => ZoomBy(0.8)"
                        aria-label="@Traductor.T("WAVEFORM_ZOOM_OUT")">
                    <Icon Name="IconName.ZoomOut" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="WAVEFORM_ZOOM_RESET">
                <button class="kmila-btn-icon" data-testid="visual-zoom-reset"
                        @onclick="ResetZoom"
                        aria-label="@Traductor.T("WAVEFORM_ZOOM_RESET")">
