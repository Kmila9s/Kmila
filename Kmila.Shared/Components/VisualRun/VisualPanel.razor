    private async Task FocusWidget(KvizComponent c)
    {
        if (_panZoomId <= 0) return;
        // Widget bounding-box in canvas coords is approximate — we only
        // know Position; use a generic 220×140 rect (largest common
        // widget footprint) so the focus animation always lands with the
        // widget comfortably inside the viewport.
        const int approxW = 220;
        const int approxH = 140;
        try
        {
            await JS.InvokeVoidAsync("kmilaPanZoomFocus", _panZoomId,
                c.Position.X, c.Position.Y, approxW, approxH,
                new { padding = 60 });
        }
        catch { }
        _selectedId = c.Id;
