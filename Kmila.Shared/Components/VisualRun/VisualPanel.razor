    // §6 Item 1 (2026-07-05) — canvas recording state machine. Idle →
    // Recording → Stopping → Idle. A 500 ms Timer polls the JS status
    // so the elapsed chip stays in sync without triggering render on
    // every rAF. Auto-stops on 2-min hard cap (fired from JS side).
    private enum RecState { Idle, Recording, Stopping }
    private RecState _recState = RecState.Idle;
    private int _recSessionId = -1;
    private int _recElapsedMs;
    private int _recCapMs = 120_000;
    private System.Threading.Timer? _recPoll;

    private async Task StartRecording(bool withRunbar = false)
    {
        if (_recState != RecState.Idle) return;
        try
        {
            var fname = BuildCanvasFilename("webm");
            if (withRunbar) fname = fname.Replace(".webm", "-split.webm");
            var result = await JS.InvokeAsync<System.Text.Json.JsonElement>(
                "kmilaCanvasRecordStart",
                ".kviz-canvas",
                new { fps = 20, hardCapSeconds = 120,
                      filename = fname,
                      withRunbar = withRunbar, runbarHeight = 80 });
            if (result.TryGetProperty("ok", out var ok) && ok.GetBoolean()
                && result.TryGetProperty("sessionId", out var idEl))
            {
                _recSessionId = idEl.GetInt32();
                _recState = RecState.Recording;
                _recElapsedMs = 0;
                _recPoll?.Dispose();
                _recPoll = new System.Threading.Timer(async _ => await PollRecordStatus(),
                    null, 500, 500);
                StateHasChanged();
            }
        }
        catch { /* JS not ready — no-op; user can retry */ }
    }

    private async Task StopRecording()
    {
        if (_recState != RecState.Recording) return;
        _recState = RecState.Stopping;
        StateHasChanged();
        try { await JS.InvokeAsync<System.Text.Json.JsonElement>("kmilaCanvasRecordStop", _recSessionId); }
        catch { }
        finally
        {
            _recPoll?.Dispose();
            _recPoll = null;
            _recState = RecState.Idle;
            _recSessionId = -1;
            _recElapsedMs = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollRecordStatus()
    {
        if (_recState != RecState.Recording) return;
        try
        {
            var s = await JS.InvokeAsync<System.Text.Json.JsonElement>("kmilaCanvasRecordStatus", _recSessionId);
            if (s.TryGetProperty("elapsedMs", out var em)) _recElapsedMs = em.GetInt32();
            if (s.TryGetProperty("capMs", out var cm)) _recCapMs = cm.GetInt32();
            if (s.TryGetProperty("state", out var st) && st.GetString() == "idle")
            {
                // JS-side hard-cap force-stopped us — resync UI.
                _recPoll?.Dispose();
                _recPoll = null;
                _recState = RecState.Idle;
                _recSessionId = -1;
                _recElapsedMs = 0;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private static string FormatElapsed(int elapsedMs, int capMs)
    {
        int es = elapsedMs / 1000, cs = capMs / 1000;
        return $"{es / 60:D2}:{es % 60:D2} / {cs / 60:D2}:{cs % 60:D2}";
    }

    // Advanced mode (2026-10-06). When false (default), the property pane hides
    // the per-widget "Expert (…)" bindings and newly-added widgets stay on their
    // raw/basic surface, so beginners only ever wire real device pins. Runtime
    // interpretation is unaffected — a .kviz that already carries an expert
    // `mode` still renders. Source of truth is the per-user localStorage copy
    // (reconciled in OnAfterRenderAsync); SQLite is native parity / the
    // pre-render seed. See AppSettings.KEY_ADVANCED_MODE.
    private bool _advancedMode;

    protected override async Task OnInitializedAsync()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
        try
        {
            var raw = await DbContext.GetSettingAsync(AppSettings.KEY_VISUAL_RING_BUFFER);
            if (int.TryParse(raw, out var rb) && rb >= 256 && rb <= 16384)
                _settingsRingBuffer = rb;
        }
        catch { }
        try
        {
            // SQLite seed (prerender-safe). localStorage wins once JS is live
            // (OnAfterRenderAsync) so the flag stays per-user on the shared web host.
            var adv = await DbContext.GetSettingAsync(AppSettings.KEY_ADVANCED_MODE);
            _advancedMode = string.Equals(adv, "true", StringComparison.OrdinalIgnoreCase);
        }
        catch { }
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnParametersSetAsync()
    {
        // Auto pause/resume on tab-switch. Handled BEFORE the project-id check
        // because a tab flip on the same project fires OnParametersSetAsync
        // without pid change; we must still react. When WE paused it we set
        // _autoPausedByTabHide; a user-initiated Pause via the toolbar leaves
        // that flag false so the auto-resume path below skips it.
        if (IsActiveTab != _lastIsActiveTab)
        {
            _lastIsActiveTab = IsActiveTab;
            if (!IsActiveTab)
            {
                if (_coord != null && _coord.IsRunning && !_coord.IsPaused)
                {
                    _coord.Pause();
                    _autoPausedByTabHide = true;
                    // Hidden tab keeps the AudioContext alive, so silence the
                    // buzzers now instead of droning in the background.
                    try { await JS.InvokeVoidAsync("kmilaAudio.stopAll"); } catch { }
                }
            }
            else if (_autoPausedByTabHide)
            {
                _coord?.Resume();
                _autoPausedByTabHide = false;
            }
        }

        if (!int.TryParse(ProjectId, out var pid)) return;
        if (pid == _projectId) return;

        // Project changed. Kill any coord bound to the previous project's
        // Entity — otherwise the loop keeps ticking against a stale object
        // and pollutes Sim.RunningProjectId with the wrong id. StopRun
        // handles cancellation + join; Sim/Registry cleanup happens in the
        // OnStopped callback wired in StartRun.
        if (_coord != null) await StopRun();
        _autoPausedByTabHide = false;

        _projectId = pid;
        await LoadProjectAsync();
    }

    private void OnSpeedSliderInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var pos)) pos = _speedPos;
        _speedPos = Math.Clamp(pos, 0, VisualSpeedScale.SliderMax);
        _customDelayMs = VisualSpeedScale.DelayFromSlider(_speedPos); // 0 = Free
        ApplySpeedToCoordAndDoc();
    }

    private void OnCustomDelayChange(ChangeEventArgs e)
    {
        var s = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(s))
        {
            // Blank = fastest (Free), matching the slider's far-right end.
            _customDelayMs = 0;
        }
        else if (int.TryParse(s, out var d) && d >= 0 && d <= VisualSpeedScale.SlowestMs)
        {
            _customDelayMs = d;
        }
        // Keep the slider position in sync with the exact value the user typed.
        _speedPos = VisualSpeedScale.SliderFromDelay(_customDelayMs ?? 0);
        ApplySpeedToCoordAndDoc();
    }

    // Push the current playback speed to the live coordinator and record it on
    // the doc so it persists on the next Save. Recomputes the dirty flag
    // WITHOUT touching the undo stack — a speed change is a lightweight setting,
    // not a canvas edit, so it shouldn't flood undo history on every drag step.
    private void ApplySpeedToCoordAndDoc()
    {
        if (_coord != null) _coord.CustomTickDelayMs = _customDelayMs;
        _doc.Settings.DefaultTickDelayMs = _customDelayMs;
        _lastSnapshot = KvizSerializer.Serialize(_doc);
        _dirty = (_lastSnapshot != _savedSnapshot);
    }

    // Seed the slider/box from the loaded doc's persisted speed. Prefers the
    // numeric DefaultTickDelayMs; falls back to the legacy DefaultSpeed enum
    // name for older sidecars; defaults to Normal. Read-only — does not mutate
    // the doc, so loading an old file that lacks the key stays non-dirty.
    private void ApplySpeedFromSettings()
    {
        int delay;
        if (_doc.Settings.DefaultTickDelayMs is { } d)
            delay = Math.Clamp(d, 0, VisualSpeedScale.SlowestMs);
        else if (Enum.TryParse<VisualSpeed>(_doc.Settings.DefaultSpeed, out var legacy))
            delay = legacy.TickDelayMs();
        else
            delay = VisualSpeed.Normal.TickDelayMs();
        _customDelayMs = delay;
        _speedPos = VisualSpeedScale.SliderFromDelay(delay);
    }

    private void TogglePause()
    {
        if (_coord == null) return;
        if (_coord.IsPaused)
        {
            _coord.Resume();
            _lastBreakHitTick = null;
        }
        else
        {
            _coord.Pause();
            _scrubTick = _coord.Frames.NewestTick;
        }
    }

    private void OnScrubInput(ChangeEventArgs e)
    {
        if (_coord == null || !_coord.IsPaused) return;
        if (!ulong.TryParse(e.Value?.ToString(), out var t)) return;
        _scrubTick = t;
        var frame = _coord.Frames.Nearest(t);
        if (frame is { } f)
        {
            ApplyScrubFrame(f);
            _frameVersion++;
        }
    }

    private void ApplyScrubFrame(VisualFrame f)
    {
        if (_coord == null || _entity == null) return;
        foreach (var p in _entity.Ports)
        {
            if (f.PortValues.TryGetValue(p.Name, out var v))
            {
                try { p.Value = v; } catch { }
            }
        }
    }

    private void OnBpInputChange(ChangeEventArgs e)
    {
        _bpInput = e.Value?.ToString() ?? string.Empty;
    }

    private void AddBreakpoint()
    {
        if (_coord == null) return;
        if (!ulong.TryParse(_bpInput, out var t)) return;
        _coord.TickBreakpoints.Add(t);
        _bpInput = string.Empty;
    }

    private void RemoveBreakpoint(ulong t)
    {
        _coord?.TickBreakpoints.Remove(t);
    }

    private async Task LoadProjectAsync()
    {
        _loadError = null;
        try
        {
            _project = await ProjectsRepo.GetByAsync(_projectId);
            if (_project == null)
            {
                _loadError = Traductor.T("VISUAL_NOT_FOUND");
                return;
            }
            var allFiles = await ProjectFilesRepo.GetProjectFilesAsync(_project);
            _files = allFiles.Where(f => !IsKviz(f)).ToList();
            _kvizFile = allFiles.FirstOrDefault(IsKviz);

            _designFile = _files.FirstOrDefault(f =>
                f.FileName.EndsWith(".vhd", StringComparison.OrdinalIgnoreCase) ||
                f.FileName.EndsWith(".vhdl", StringComparison.OrdinalIgnoreCase));

            if (_kvizFile != null)
            {
                var content = (await ProjectFilesRepo.ReadFileContentAsync(_kvizFile, _project)).Content;
                _doc = KvizSerializer.Deserialize(content ?? "") ?? FreshDoc();
                // Baseline against what's on disk before sanitize touches
                // the doc — that way if Sanitize prunes stale bindings, the
                // resulting in-memory state is legitimately dirty and the
                // user is prompted to save the cleanup.
                _savedSnapshot = KvizSerializer.Serialize(_doc);
                // Drop bindings whose pin key no longer matches the widget's
                // declared pin set (mode changes, hand-edits, stale saves).
                // R3-5 data-integrity gate — the wiring modal already
                // enforces direction on write, but historical saves may
                // still carry mis-directed keys.
                KvizWidgetCatalog.Sanitize(_doc);
                _lastSnapshot = KvizSerializer.Serialize(_doc);
            }
            else
            {
                _doc = FreshDoc();
                _lastSnapshot = _savedSnapshot = KvizSerializer.Serialize(_doc);
            }
            ApplySpeedFromSettings();
            _undo.Clear();
            _redo.Clear();

            await ParseEntityAsync();
            _dirty = (_lastSnapshot != _savedSnapshot);
        }
        catch (Exception ex)
        {
            _loadError = string.Format(Traductor.T("VISUAL_LOAD_FAILED"), ex.Message);
        }
    }

    private KvizDoc FreshDoc() => new()
    {
        Version = 1,
        DesignFile = _designFile?.FileName ?? "",
        Canvas = new KvizCanvas { Width = 1200, Height = 800, Background = "grid" },
        Components = new(),
        Settings = new KvizSettings { RingBufferTicks = 2000, DefaultSpeed = "Normal" },
    };

    private static bool IsKviz(ProjectFile f) =>
        f.FileName.EndsWith(KvizExt, StringComparison.OrdinalIgnoreCase);

    private async Task ParseEntityAsync()
    {
        await Task.CompletedTask;
        if (_project == null || _designFile == null) return;
        try
        {
            string filePath = System.IO.Path.Combine(_project.BasePath,
                _designFile.DirectoryPath ?? string.Empty,
                _designFile.FileName);

            Interpreter.Services.EntityRegistry.Instance.Clear();
            Interpreter.Services.PackageRegistry.Instance.Clear();
            Interpreter.Services.FunctionRegistry.Instance.Clear();

            foreach (var f in _files)
            {
                if (!f.FileName.EndsWith(".vhd", StringComparison.OrdinalIgnoreCase) &&
                    !f.FileName.EndsWith(".vhdl", StringComparison.OrdinalIgnoreCase)) continue;
                try
                {
                    string p = System.IO.Path.Combine(_project.BasePath, f.DirectoryPath ?? "", f.FileName);
                    Interpreter.Services.EntityRegistry.Instance.ScanFile(p);
                }
                catch { }
            }

            var parser = new Debugger.Repositories.Parser(filePath);
            parser.ParseFile();
            _entity = parser.Entities.FirstOrDefault(e => e.Architecture != null);
            if (_entity == null)
            {
                _loadError = Traductor.T("VISUAL_NO_ENTITY_FOUND");
                return;
            }

            // Multi-component designs: inline the instantiated components into a
            // flat single-entity source so the live Visual runtime actually
            // executes the sub-components (otherwise a structural top like a
            // full adder whose logic lives entirely in its half-adder instances
            // would drive nothing and every widget would stay dark). Mirrors the
            // waveform/bounded-sim path in ProgramBuilder. ElaborateOrNull
            // returns null when the top has no component instance, so single-file
            // designs are untouched. The flattened source goes to a TEMP file so
            // the project tree stays clean.
            try
            {
                var flat = Interpreter.Services.SourceElaborator.ElaborateOrNull(
                    _project.BasePath, _entity.Name);
                if (!string.IsNullOrEmpty(flat))
                {
                    var tmp = System.IO.Path.Combine(System.IO.Path.GetTempPath(),
                        $"kmila_visual_{_entity.Name}_{Guid.NewGuid():N}.vhd");
                    await System.IO.File.WriteAllTextAsync(tmp, flat);
                    var flatParser = new Debugger.Repositories.Parser(tmp);
                    flatParser.ParseFile();
                    var flatEntity = flatParser.Entities.FirstOrDefault(e =>
                            string.Equals(e.Name, _entity.Name, StringComparison.OrdinalIgnoreCase)
                            && e.Architecture != null)
                        ?? flatParser.Entities.FirstOrDefault(e => e.Architecture != null);
                    if (flatEntity != null) _entity = flatEntity;
                    try { System.IO.File.Delete(tmp); } catch { }
                }
            }
            catch { /* fall back to the raw (un-inlined) top entity */ }
        }
        catch (Exception ex)
        {
            _loadError = string.Format(Traductor.T("VISUAL_PARSE_FAILED"), ex.Message);
            _entity = null;
        }
    }

    // Phase 3: wire-overlay toggle. Persisted in .kviz? Not yet — the
    // toggle is per-session so the user can flip it for inspection without
    // mutating the saved canvas. Could promote to KvizSettings later.
    private void ToggleWires() => _showWires = !_showWires;

    // Phase 3 wire-route geometry. Each wired widget pin contributes one
    // straight line from the widget's anchor to a port-name chip pinned to
    // the right edge of the canvas. Stacked vertically when multiple wires
    // would share the same Y so they don't overlap.
    private readonly record struct WireRoute(double X1, double Y1, double X2, double Y2, string Port);

    // Build the SVG inner content as a string so we can render it via
    // MarkupString — Razor reserves the lowercase <text> tag for its own
    // escape-from-C# mechanism and refuses to emit an SVG <text> element
    // directly. Outputs are HTML-escaped + culture-invariant.
    private string BuildWireOverlaySvg()
    {
        var sb = new System.Text.StringBuilder(512);
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        foreach (var w in ComputeWireRoutes())
        {
            sb.Append("<line x1=\"").Append(w.X1.ToString(inv))
              .Append("\" y1=\"").Append(w.Y1.ToString(inv))
              .Append("\" x2=\"").Append(w.X2.ToString(inv))
              .Append("\" y2=\"").Append(w.Y2.ToString(inv))
              .Append("\" class=\"visual-page__wire-line\" />");
            double chipW = Math.Max(48, w.Port.Length * 8 + 12);
            sb.Append("<rect x=\"").Append((w.X2 - 4).ToString(inv))
              .Append("\" y=\"").Append((w.Y2 - 10).ToString(inv))
              .Append("\" width=\"").Append(chipW.ToString(inv))
              .Append("\" height=\"20\" rx=\"4\" class=\"visual-page__wire-chip\" />");
            sb.Append("<text x=\"").Append((w.X2 + 4).ToString(inv))
              .Append("\" y=\"").Append((w.Y2 + 4).ToString(inv))
              .Append("\" class=\"visual-page__wire-label\">")
              .Append(System.Net.WebUtility.HtmlEncode(w.Port))
              .Append("</text>");
        }
        return sb.ToString();
    }

    private IEnumerable<WireRoute> ComputeWireRoutes()
    {
        if (_doc.Components.Count == 0) yield break;
        // Right-edge X for port labels — leave a margin so chips don't
        // overflow the workspace card on a 1200-px canvas.
        double edgeX = _doc.Canvas.Width - 110;
        // Approximate per-widget anchor offsets. The widgets vary in size
        // but a constant pad is good enough for an at-a-glance overlay;
        // exact pin geometry would need each widget to report its anchor.
        const double anchorPadX = 60;
        const double anchorPadY = 50;

        // Stack-aware Y: track used Y values so two widgets near the same
        // height get their port chips on different rows.
        var usedY = new List<double>();
        foreach (var c in _doc.Components.OrderBy(c => c.Position.Y))
        {
            if (c.Bindings.Count == 0) continue;
            double cx = c.Position.X + anchorPadX;
            double cy = c.Position.Y + anchorPadY;
            foreach (var (_, port) in c.Bindings)
            {
                if (string.IsNullOrEmpty(port)) continue;
                double targetY = cy;
                // Push down until at least 26 px away from any existing chip.
                while (usedY.Any(y => Math.Abs(y - targetY) < 26))
                {
                    targetY += 26;
                }
                usedY.Add(targetY);
                yield return new WireRoute(cx, cy, edgeX, targetY, port);
            }
        }
    }

    private async Task StartRun()
    {
        if (_entity == null) return;
        // Unlock the audio context on this Run click — the buzzer widget
        // needs a user-gestured resume() before iOS Safari + Android
        // WebView will actually play. Idempotent + safe on browsers
        // without WebAudio.
        try { await JS.InvokeVoidAsync("kmilaAudio.unlock"); }
        catch { /* JS not ready during prerender / no-audio browser */ }
        await ParseEntityAsync();
        if (_entity == null) return;
        _coord?.Dispose();
        var userDrivenPorts = _doc.Components
            .Where(c => c.Type == "switch" || c.Type == "button")
            .Where(c => c.Bindings.TryGetValue("out", out var p) && !string.IsNullOrEmpty(p))
            .Select(c => c.Bindings["out"])
            .ToList();
        int ringTicks = Math.Max(_doc.Settings.RingBufferTicks, _settingsRingBuffer);
        if (ringTicks <= 0) ringTicks = 2000;
        _coord = new VisualRunCoordinator(_entity, ringTicks, userDrivenPorts, Traductor);
        _coord.Speed = _speedIndex;
        _coord.CustomTickDelayMs = _customDelayMs;
        var coordForCallbacks = _coord;
        var pidForCallbacks = _projectId;
        _coord.OnFrame += _ => RequestRepaint();
        _coord.OnError += msg => { _loadError = msg; InvokeAsync(StateHasChanged); };
        _coord.OnStopped += () =>
        {
            // Capture pid + coord in the closure: if the user hopped to a new
            // project and started a fresh visual sim before this old coord's
            // loop task got around to raising OnStopped, we must NOT clear the
            // NEW project's Sim.RunningProjectId. Registry.Unregister keys off
            // (pid, coord) too so a fresh Start's registration survives.
            Registry.Unregister(pidForCallbacks, coordForCallbacks);
            if (Sim.RunningMode == Kmila.Shared.Services.SimMode.Visual
                && Sim.RunningProjectId == pidForCallbacks)
            {
                Sim.EndRun();
            }
            if (pidForCallbacks == _projectId) _autoPausedByTabHide = false;
            InvokeAsync(StateHasChanged);
        };
        _coord.OnBreakpointHit += t =>
        {
            _lastBreakHitTick = t;
            _scrubTick = t;
            InvokeAsync(StateHasChanged);
        };
        await _coord.StartAsync();
        Registry.Register(_projectId, _coord);
        Sim.BeginRun(_projectId, Kmila.Shared.Services.SimMode.Visual);
        SeedSwitchInputs();
        StartRepaintTicker();
        StateHasChanged();
    }

    private void SeedSwitchInputs()
    {
        if (_coord == null) return;
        foreach (var c in _doc.Components.Where(c => c.Type == "switch"))
        {
            if (!c.Bindings.TryGetValue("out", out var port) || string.IsNullOrEmpty(port)) continue;
            var on = IsSwitchOn(c);
            _coord.WriteInput(port, on ? "1" : "0");
        }
        foreach (var c in _doc.Components.Where(c => c.Type == "multi-switch"))
        {
            var arr = MultiSwitchStates(c);
            PushMultiSwitchToCoordinator(c, arr);
        }
    }

    private async Task StopRun()
    {
        var coord = _coord;
        if (coord == null) return;
        coord.Stop();
        // Silence any buzzer immediately — the sim has halted, so no more
        // frames will arrive to switch tones off on their own.
        try { await JS.InvokeVoidAsync("kmilaAudio.stopAll"); } catch { }
        StopRepaintTicker();
        try
        {
            await Task.WhenAny(coord.WaitForStopAsync(), Task.Delay(2000));
        }
        catch { }
        StateHasChanged();
    }

    private volatile int _pendingFrame;

    private void RequestRepaint()
    {
        System.Threading.Interlocked.Increment(ref _pendingFrame);
    }

    private void StartRepaintTicker()
    {
        StopRepaintTicker();
        _repaintTimer = new System.Threading.Timer(_ =>
        {
            if (System.Threading.Interlocked.Exchange(ref _pendingFrame, 0) == 0) return;
            _ = InvokeAsync(() =>
            {
                _frameVersion++;
                StateHasChanged();
            });
        }, null, 33, 33);
    }

    private void StopRepaintTicker()
    {
        _repaintTimer?.Dispose();
        _repaintTimer = null;
    }

    private void OpenWiring() { _wiringOpen = true; }
    private Task CloseWiring() { _wiringOpen = false; return Task.CompletedTask; }

    /// <summary>
    /// Dispatcher for the new <see cref="WidgetPalette"/>. Routes the chip's
    /// widget-type identifier to the existing AddXxx spawn methods so the
    /// palette can replace the toolbar's 6 inline add-buttons without
    /// duplicating any positioning / config defaults.
    /// </summary>
    private void OnPaletteSelected(string widgetType) => SpawnByType(widgetType);

    private void SpawnByType(string widgetType)
    {
        switch (widgetType)
        {
            case "led":       AddLed();      break;
            case "button":    AddButton();   break;
            case "switch":    AddSwitch();   break;
            case "led-array": AddLedArray(); break;
            case "stepper":   AddStepper();  break;
            case "seven-seg": AddSevenSeg(); break;
            case "seven-seg-bank": AddSevenSegBank(); break;
            case "multi-switch": AddMultiSwitch(); break;
            case "matrix-3x3": AddLedMatrix(); break;
            case "matrix-3x3-rgb": AddRgbMatrix(); break;
            case "buzzer-piezo": AddBuzzer(); break;
            case "keypad-matrix": AddKeypad(); break;
            case "lcd-hd44780": AddLcd(); break;
            case "dot-matrix": AddDotMatrix(); break;
        }
    }

    /// <summary>
    /// Stashes the widget type when an HTML5 drag from the palette starts so
    /// the subsequent canvas drop knows what to spawn. Blazor's DataTransfer
    /// doesn't expose SetData/GetData (only Files/Items/Types), hence the
    /// component-local field instead of going through the standard
    /// <c>event.dataTransfer.setData()</c> path.
    /// </summary>
    private string? _paletteDraggedType;

    private void OnPaletteDragStart(string widgetType)
    {
        if (_coord?.IsRunning == true) return;   // mirror the chip's Disabled gate
        _paletteDraggedType = widgetType;
    }

    private void OnPaletteDragEnd()
    {
        // Always clear, even when the drop fired — defensive against the
        // dragend firing AFTER drop on some browsers; the field is null on
        // both paths so subsequent drops on stale state aren't possible.
        _paletteDraggedType = null;
    }

    private void OnCanvasDrop(Microsoft.AspNetCore.Components.Web.DragEventArgs e)
    {
        if (_paletteDraggedType is null) return;
        var type = _paletteDraggedType;
        _paletteDraggedType = null;

        // Spawn via the same path the chip-click takes, then patch the new
        // widget's position to the drop point. The AddXxx methods always
        // append to _doc.Components, so the last entry is the one we just
        // added.
        SpawnByType(type);
        var spawned = _doc.Components.LastOrDefault();
        if (spawned != null)
        {
            spawned.Position.X = Math.Max(0, (int)e.OffsetX);
            spawned.Position.Y = Math.Max(0, (int)e.OffsetY);
            MarkDirty();
        }
    }

