                    <Icon Name="IconName.ArrowClockwise" />
                </button>
            </KmilaTooltip>

            <span class="kmila-slot-toolbar-divider" aria-hidden="true"></span>

            @* Group 3 — persistence. Save carries the dirty-state text so the
               user sees "Save*" / "Saved" without having to hover. *@
            <KmilaTooltip TextKey="VISUAL_SAVE_TIP" Placement="Bottom">
                <button class="kmila-btn @(_dirty ? "is-dirty" : "")" data-testid="visual-save" @onclick="SaveAsync" disabled="@(!_dirty)">
                    <Icon Name="@(_dirty ? IconName.Save : IconName.Check2)" />
                    <span>@(_dirty ? Traductor.T("VISUAL_SAVE_DIRTY") : Traductor.T("VISUAL_SAVED"))</span>
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="VISUAL_CLEAR_CHANGES_TOOLTIP">
                <button class="kmila-btn kmila-btn--ghost" data-testid="visual-clear-changes"
                        @onclick="ClearChanges"
                        disabled="@(!_dirty || _coord?.IsRunning == true)">
                    <Icon Name="IconName.ArrowClockwise" />
                    @Traductor.T("VISUAL_CLEAR_CHANGES")
                </button>
            </KmilaTooltip>

            <span class="kmila-slot-toolbar-divider kmila-slot-toolbar-divider--pusher" aria-hidden="true"></span>

            @* Group 4 — view controls (right cluster). All icon-only, all
               carry `data-tip` so hover shows a styled bubble that survives
               the app's varied host chromes (title tooltips render poorly on
               MAUI WebView and are invisible on touch). Native `title` +
               `aria-label` stay for keyboard/screen-reader users. Secondary
               actions (Fit, Locator, Export, Record) live inside a "More"
               dropdown so this cluster stays legible on narrow viewports. *@
            <KmilaTooltip TextKey="@(_showWires ? "VISUAL_HIDE_WIRES" : "VISUAL_SHOW_WIRES")">
                <button class="kmila-btn-icon @(_showWires ? "is-active" : "")"
                        data-testid="visual-toggle-wires"
