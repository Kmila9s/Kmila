    // Audit F-E-03 (2026-07-11): canvas exports used to write bare
    // `kmila-canvas.<ext>` — no project or timestamp — so a second export
    // silently overwrote the first in the downloads folder. This helper
    // builds `kmila-canvas-<projectSlug>-<yyyyMMdd-HHmmss>.<ext>` with the
    // project slug omitted when unavailable.
    private string BuildCanvasFilename(string ext)
    {
        var slug = (_project?.Name ?? string.Empty)
            .ToLowerInvariant()
            .Replace(' ', '-');
        slug = System.Text.RegularExpressions.Regex.Replace(slug, @"[^a-z0-9\-]", string.Empty);
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        return string.IsNullOrEmpty(slug)
            ? $"kmila-canvas-{stamp}.{ext}"
            : $"kmila-canvas-{slug}-{stamp}.{ext}";
    }

