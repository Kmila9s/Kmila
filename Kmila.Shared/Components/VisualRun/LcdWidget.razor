@namespace Kmila.Shared.Components.VisualRun
@using Kmila.Shared.Services.VisualRun
@using System.Text

@*
    HD44780 character LCD widget (FW-3). Supports the four common
    HD44780 sizes shipped with real dev kits: 16×2, 16×4, 20×2, 20×4.

    Three modes:
      • "text" (default, assisted) — one `line{N}` port per row,
        `std_logic_vector((cols*8)-1 downto 0)` carrying ASCII bytes
        MSB-first. Widget slices each row into byte-wide characters
        and renders them into the DDRAM buffer directly. Optional
        `backlight : std_logic` toggles the display glow.
      • "raw-4bit" / "raw-8bit" — full HD44780 command bus (RS, RW,
        E, DB[4|0]..DB7). Widget implements a subset of the HD44780
        command decoder:
          * Clear display              (0x01)
          * Function set (4/8-bit)     (0x2? / 0x3?)
          * Display on/off control     (0x08..0x0F)
          * Entry mode set             (0x04..0x07)
          * Set DDRAM address          (0x80..0xFF)
          * Data write (RS=1)          — pokes the byte into DDRAM
        RW=1 reads are ignored (busy flag pinned to 0). Latches on
        E rising edge — the canonical HD44780 timing.

    Rendering (v1): each character cell renders the ASCII glyph in
    a monospace LCD-tinted font. True 5×8 pixel-font rendering is
    a follow-up (see project_visual_runtime_mode / plan §deferred).
*@

<div class="kviz-widget kviz-lcd kviz-lcd--@Mode @(Backlight ? "kviz-lcd--on" : "kviz-lcd--off") @(EditMode ? "kviz-lcd--edit" : "") @(Selected ? "kviz-widget--selected" : "")"
     style="left:@(Comp.Position.X)px; top:@(Comp.Position.Y)px;"
     data-component-id="@Comp.Id"
     data-mode="@Mode"
     data-rows="@Rows"
     data-cols="@Cols"
     data-text="@FlattenedText"
     @onpointerdown="HandlePointerDown">
    <div class="kviz-lcd__screen" style="grid-template-columns: repeat(@Cols, 14px);">
        @{
            var text = CurrentText();
        }
        @for (int r = 0; r < Rows; r++)
        {
            for (int c = 0; c < Cols; c++)
            {
                int idx = r * Cols + c;
                char ch = idx < text.Length ? text[idx] : ' ';
                <div class="kviz-lcd__cell">@RenderChar(ch)</div>
            }
        }
    </div>
    <div class="kviz-lcd__port">@PortLabel</div>
</div>

@code {
    [Parameter, EditorRequired] public KvizComponent Comp { get; set; } = default!;
    [Parameter] public VisualRunCoordinator? Coordinator { get; set; }
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.PointerEventArgs> OnPointerDownExternal { get; set; }

    [CascadingParameter(Name = "FrameVersion")] public int FrameVersion { get; set; }

    // DDRAM for raw mode. Sized to rows*cols after each mode change.
    private char[] _ddram = new char[16 * 2];
    private int _ddramCursor;
    private int _lastLcdRows = 2, _lastLcdCols = 16;
    private string _lastMode = "text";
    private char _prevE = '0';

    private int Rows => Math.Clamp(Comp.Config.GetInt("rows", 2), 2, 4);
    private int Cols => Math.Clamp(Comp.Config.GetInt("cols", 16), 16, 20);

    private string Mode
    {
        get
        {
            var m = Comp.Config.GetString("mode", "text");
            return m == "raw-4bit" || m == "raw-8bit" ? m : "text";
        }
    }

    private bool Backlight
    {
        get
        {
            if (Coordinator == null) return true;
            if (!Comp.Bindings.TryGetValue("backlight", out var p) || string.IsNullOrEmpty(p))
                return true;  // unwired backlight → glow on so beginners see chars
            var v = Coordinator.LatestSlicedValue(p);
            return string.IsNullOrEmpty(v) || v[^1] == '1';
        }
    }

    private void EnsureDdramShape()
    {
        int total = Rows * Cols;
        if (_ddram.Length != total || _lastLcdRows != Rows || _lastLcdCols != Cols || _lastMode != Mode)
        {
            _ddram = new char[total];
            for (int i = 0; i < total; i++) _ddram[i] = ' ';
            _ddramCursor = 0;
            _lastLcdRows = Rows;
            _lastLcdCols = Cols;
            _lastMode = Mode;
        }
    }

    // Text mode: read each line{r} vector, slice into byte-wide ASCII
    // chars (MSB = leftmost char), assemble a flat string of Rows*Cols.
    // Missing bindings / short vectors fill with spaces.
    private string CurrentText()
    {
        EnsureDdramShape();
        if (Mode != "text")
        {
            RawDecodeIfNeeded();
            return new string(_ddram);
        }
        if (Coordinator == null) return new string(' ', Rows * Cols);
        var sb = new StringBuilder(Rows * Cols);
        for (int r = 0; r < Rows; r++)
        {
            string line = new string(' ', Cols);
            if (Comp.Bindings.TryGetValue($"line{r}", out var port) && !string.IsNullOrEmpty(port))
            {
                var raw = Coordinator.LatestSlicedValue(port);
                if (!string.IsNullOrEmpty(raw))
                {
                    // Pad / truncate to cols*8 bits then decode byte-wise.
                    int need = Cols * 8;
                    if (raw.Length > need) raw = raw[..need];
                    else if (raw.Length < need) raw = raw.PadLeft(need, '0');
                    var chars = new char[Cols];
                    for (int c = 0; c < Cols; c++)
                    {
                        int hi = c * 8;
                        int b = 0;
                        for (int i = 0; i < 8; i++)
                        {
                            b <<= 1;
                            if (raw[hi + i] == '1') b |= 1;
                        }
                        chars[c] = (char)(b & 0x7F);
                        // Clamp non-printables to space so garbage doesn't
                        // render as odd control glyphs.
                        if (chars[c] < ' ' || chars[c] > '~') chars[c] = ' ';
                    }
                    line = new string(chars);
                }
            }
            sb.Append(line);
        }
        return sb.ToString();
    }

    // Raw modes: latch on E rising edge, dispatch based on RS.
    // Minimal HD44780 subset covering the demo cases; adequate for
    // beginner init sequences and DDRAM writes.
    private void RawDecodeIfNeeded()
    {
        if (Coordinator == null) return;
        if (Mode == "text") return;
        char e = ReadBit("E");
        // Latch on rising edge only.
        if (e != '1' || _prevE == '1') { _prevE = e; return; }
        _prevE = e;

        char rs = ReadBit("RS");
        char rw = ReadBit("RW");
        if (rw == '1') return; // ignore reads

        byte data = 0;
        if (Mode == "raw-8bit")
        {
            for (int i = 7; i >= 0; i--)
                data = (byte)((data << 1) | (ReadBit($"DB{i}") == '1' ? 1 : 0));
        }
        else
        {
            // 4-bit: DB4..DB7 carry the nibble on each latch — high
            // nibble first per the HD44780 spec. We conflate two
            // latches into a byte via `_rawHighNibble` / `_rawExpectLow`.
            byte nib = 0;
            for (int i = 7; i >= 4; i--)
                nib = (byte)((nib << 1) | (ReadBit($"DB{i}") == '1' ? 1 : 0));
            if (!_rawExpectLow)
            {
                _rawHighNibble = nib;
                _rawExpectLow = true;
                return;
            }
            data = (byte)((_rawHighNibble << 4) | (nib & 0x0F));
            _rawExpectLow = false;
        }

        if (rs == '1')
        {
            WriteDdram((char)(data & 0x7F));
        }
        else
        {
            DecodeCommand(data);
        }
    }

    private byte _rawHighNibble;
    private bool _rawExpectLow;

    private void WriteDdram(char ch)
    {
        if (_ddramCursor < 0 || _ddramCursor >= _ddram.Length) _ddramCursor = 0;
        _ddram[_ddramCursor] = (ch < ' ' || ch > '~') ? ' ' : ch;
        _ddramCursor = (_ddramCursor + 1) % _ddram.Length;
    }

    private void DecodeCommand(byte cmd)
    {
        // Highest-set bit wins per HD44780 command table.
        if ((cmd & 0x80) != 0)
        {
            // Set DDRAM address. Real HD44780 splits address by row —
            // row 0 = 0x00, row 1 = 0x40, row 2 = row0+cols, row 3 =
            // row1+cols. Map back to a flat cursor.
            int addr = cmd & 0x7F;
            _ddramCursor = MapDdramAddrToFlat(addr);
        }
        else if ((cmd & 0x40) != 0)
        {
            // Set CGRAM address — unsupported for now, ignored.
        }
        else if ((cmd & 0x20) != 0)
        {
            // Function set — ignored; mode is already fixed by config.
        }
        else if ((cmd & 0x10) != 0)
        {
            // Cursor / display shift — ignored (v1).
        }
        else if ((cmd & 0x08) != 0)
        {
            // Display on/off control — ignored (backlight config carries this in the UI).
        }
        else if ((cmd & 0x04) != 0)
        {
            // Entry mode set — ignored (v1 always auto-increments).
        }
        else if (cmd == 0x02 || cmd == 0x03)
        {
            _ddramCursor = 0;
        }
        else if (cmd == 0x01)
        {
            for (int i = 0; i < _ddram.Length; i++) _ddram[i] = ' ';
            _ddramCursor = 0;
        }
    }

    private int MapDdramAddrToFlat(int addr)
    {
        // Real 2-row HD44780: row 0 starts at 0x00, row 1 at 0x40.
        // 4-row layouts: row 0 = 0x00, row 1 = 0x40, row 2 = 0x00 + cols,
        // row 3 = 0x40 + cols. Reconstruct which row + col the addr sits
        // on so the widget's flat DDRAM stays contiguous.
        int row, col;
        if (addr < 0x40)
        {
            if (addr < Cols) { row = 0; col = addr; }
            else            { row = 2; col = addr - Cols; }
        }
        else
        {
            int a = addr - 0x40;
            if (a < Cols) { row = 1; col = a; }
            else          { row = 3; col = a - Cols; }
        }
        row = Math.Min(row, Rows - 1);
        col = Math.Min(col, Cols - 1);
        return row * Cols + col;
    }

    private char ReadBit(string pinName)
    {
        if (Coordinator == null) return '0';
        if (!Comp.Bindings.TryGetValue(pinName, out var port) || string.IsNullOrEmpty(port))
            return '0';
        var v = Coordinator.LatestSlicedValue(port);
        return string.IsNullOrEmpty(v) ? '0' : v[^1];
    }

    private RenderFragment RenderChar(char ch) => __builder =>
    {
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", "kviz-lcd__char");
        __builder.AddContent(2, ch == ' ' ? " " : ch.ToString());
        __builder.CloseElement();
    };

    private string FlattenedText => CurrentText();

    private string PortLabel
    {
        get
        {
            if (Mode == "text")
            {
                var wired = 0;
                for (int r = 0; r < Rows; r++)
                    if (Comp.Bindings.TryGetValue($"line{r}", out var p) && !string.IsNullOrEmpty(p)) wired++;
                return $"{wired}/{Rows} lines";
            }
            var w = 0;
            foreach (var b in Comp.Bindings.Values)
                if (!string.IsNullOrEmpty(b)) w++;
            int total = Mode == "raw-8bit" ? 11 : 7; // RS+RW+E + 8|4 data
            return $"{w}/{total} wired";
        }
    }

    private async Task HandlePointerDown(Microsoft.AspNetCore.Components.Web.PointerEventArgs e)
    {
        if (OnPointerDownExternal.HasDelegate)
            await OnPointerDownExternal.InvokeAsync(e);
    }
}
