@*
    ProfileMenu — consolidated TopBar dropdown.

    Replaces what used to be four separate <details> elements in the TopBar
    (account pill, FPGA picker, language picker, theme switcher). The single
    avatar/icon trigger keeps the bar uncluttered as we add more features
    (notifications, autosave toggle, etc.) — they all land here.

    Layout when open:

      ┌──────────────────────────────────────┐
      │ [avatar] Daniel · daniel.ulrich      │   ← identity head
      │   Sign out / Settings                │
      ├──────────────────────────────────────┤
      │ FPGA: Cyclone IV E (▾)               │   ← nested <details>
      │   [search · chips · scrollable list] │
      ├──────────────────────────────────────┤
      │ Language  EN ES FR DE CH JP AR       │   ← inline grid of 7 codes
      ├──────────────────────────────────────┤
      │ Theme     ☀ Light · ☾ Dark · ◐ Auto  │   ← 3 buttons row
      └──────────────────────────────────────┘

    Outer popover is a Blazor-controlled <details> with @key forcing remount
    on close so nested <details> reset cleanly. Click-outside to close is
    delegated to native <details>'s own click-elsewhere behavior, with an
    Esc-to-close listener wired through index.html (already present).
*@
@implements IDisposable
@inject SidebarState SidebarState
@inject GitHubAuth GitHubAuth
@inject IServiceProvider SP

<details class="kmila-profile-menu">
    <summary class="kmila-profile-menu__summary"
             aria-label="@Traductor.T(GitHubAuth.IsLoggedIn ? "TOPBAR_ACCOUNT_OPEN" : "TOPBAR_PROFILE_MENU")"
             title="@Traductor.T("TOPBAR_PROFILE_MENU")">
        @if (GitHubAuth.IsLoggedIn && GitHubAuth.Account != null && !string.IsNullOrEmpty(GitHubAuth.Account.AvatarUrl))
        {
            <img src="@GitHubAuth.Account.AvatarUrl"
                 alt=""
                 class="kmila-profile-menu__avatar"
                 width="28" height="28" />
        }
        else
        {
            @* Placeholder avatar — generic person silhouette when no GitHub
               session. Picking a colored circle would lock us into a brand
               that the rest of the app doesn't have, so a neutral icon is
               the safer default. *@
            <span class="kmila-profile-menu__avatar kmila-profile-menu__avatar--placeholder"
                  aria-hidden="true">
                <Icon Name="IconName.PersonFill" />
            </span>
        }
        <Icon Name="IconName.ChevronDown" Class="kmila-profile-menu__chevron" />
    </summary>

    <div class="kmila-profile-menu__panel" role="dialog"
         aria-label="@Traductor.T("TOPBAR_PROFILE_MENU")">

        @* ── Identity head ────────────────────────────────────────── *@
        @if (GitHubAuth.IsLoggedIn && GitHubAuth.Account != null)
        {
            <div class="kmila-profile-menu__head">
                @if (!string.IsNullOrEmpty(GitHubAuth.Account.AvatarUrl))
                {
                    <img src="@GitHubAuth.Account.AvatarUrl" alt=""
                         class="kmila-profile-menu__avatar kmila-profile-menu__avatar--large"
                         width="44" height="44" />
                }
                <div class="kmila-profile-menu__head-text">
                    <strong>@(GitHubAuth.Account.Name ?? GitHubAuth.Account.Login)</strong>
                    <small>@GitHubAuth.Account.Login</small>
                </div>
            </div>
        }
        else
        {
            <div class="kmila-profile-menu__head kmila-profile-menu__head--guest">
                <span class="kmila-profile-menu__avatar kmila-profile-menu__avatar--large kmila-profile-menu__avatar--placeholder">
                    <Icon Name="IconName.PersonFill" />
                </span>
                <div class="kmila-profile-menu__head-text">
                    <strong>@Traductor.T("TOPBAR_GUEST_TITLE")</strong>
                    <small>@Traductor.T("TOPBAR_SIGN_IN_HINT")</small>
                </div>
            </div>
        }

        @* ── FPGA picker — nested popover with search ─────────────── *@
        <section class="kmila-profile-menu__section">
            <header class="kmila-profile-menu__section-head">
                <Icon Name="IconName.CpuFill" />
                <span>@Traductor.T("RUNBAR_FPGA_LABEL")</span>
            </header>
            <details class="kmila-fpga-picker kmila-fpga-picker--inline">
                <summary class="kmila-fpga-picker__summary"
                         aria-label="@Traductor.T("TOPBAR_SELECT_FPGA")">
                    <span class="kmila-fpga-picker__text">
                        @if (_fpga is not null && !string.IsNullOrEmpty(_fpga.Model))
                        {
                            <span class="kmila-fpga-picker__model">@_fpga.Model</span>
                            <span class="kmila-fpga-picker__family">@_fpga.Family</span>
                        }
                        else
                        {
                            <span class="kmila-fpga-picker__placeholder">@Traductor.T("TOPBAR_SELECT_FPGA")</span>
                        }
                    </span>
                    <Icon Name="IconName.ChevronDown" Class="kmila-fpga-picker__chevron" />
                </summary>

                <div class="kmila-fpga-picker__panel kmila-fpga-picker__panel--inline" role="dialog">
                    <div class="kmila-fpga-picker__search">
                        <Icon Name="IconName.Search" />
                        <input type="text"
                               class="form-control"
                               placeholder="@Traductor.T("TOPBAR_SELECT_FPGA")"
                               @bind="_filter"
                               @bind:event="oninput" />
                    </div>

                    @if (_manufacturers.Count > 1)
                    {
                        <div class="kmila-fpga-picker__filters" role="tablist">
                            <button type="button" role="tab"
                                    class="kmila-btn-tab kmila-btn-tab--accent kmila-btn-tab--sm kmila-fpga-picker__chip @(string.IsNullOrEmpty(_manufacturerFilter) ? "is-active" : "")"
                                    @onclick="() => _manufacturerFilter = string.Empty">
                                @Traductor.T("TOPBAR_FPGA_ALL")
                            </button>
                            @foreach (var m in _manufacturers)
                            {
                                <button type="button" role="tab"
                                        class="kmila-btn-tab kmila-btn-tab--accent kmila-btn-tab--sm kmila-fpga-picker__chip @(m == _manufacturerFilter ? "is-active" : "")"
                                        @onclick="() => _manufacturerFilter = m">
                                    @m
                                </button>
                            }
                        </div>
                    }

                    <div class="kmila-fpga-picker__list" role="listbox">
                        @foreach (var path in FilteredFPGAs())
                        {
                            var name = System.IO.Path.GetFileNameWithoutExtension(path);
                            var meta = _fpgaMeta.TryGetValue(path, out var md) ? md : (null, null);
                            var isSelected = string.Equals(_selectedFPGA, path, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    role="option"
                                    aria-selected="@isSelected"
                                    class="kmila-fpga-picker__option @(isSelected ? "is-selected" : "")"
                                    @onclick="() => OnFPGAPicked(path)">
                                <Icon Name="IconName.CpuFill" />
                                <span class="kmila-fpga-picker__option-main">
                                    <span>@name</span>
                                    @if (!string.IsNullOrEmpty(meta.Item2))
                                    {
                                        <span class="kmila-fpga-picker__option-meta">@meta.Item2</span>
                                    }
                                </span>
                                @if (isSelected)
                                {
                                    <Icon Name="IconName.CheckLg" Class="kmila-fpga-picker__check" />
                                }
                            </button>
                        }
                        @if (!FilteredFPGAs().Any())
                        {
                            <div class="kmila-fpga-picker__empty">—</div>
                        }
                    </div>
                </div>
            </details>
        </section>

        @* ── Language — flat 7-button grid ────────────────────────── *@
        <section class="kmila-profile-menu__section">
            <header class="kmila-profile-menu__section-head">
                <Icon Name="IconName.Translate" />
                <span>@Traductor.T("A11Y_LANGUAGE")</span>
            </header>
            <div class="kmila-profile-menu__lang-grid" role="group">
                @foreach (var lang in _languages)
                {
                    var isActive = lang.Code == Traductor.Lang;
                    <button type="button"
                            class="kmila-btn-tab kmila-btn-tab--accent kmila-btn-tab--sm kmila-profile-menu__lang-chip @(isActive ? "is-active" : "")"
                            @onclick="() => SetLanguageAsync(lang.Code)"
                            title="@lang.NativeName">
                        <span class="kmila-profile-menu__lang-code">@lang.Code.ToUpperInvariant()</span>
                        <span class="kmila-profile-menu__lang-native">@lang.NativeName</span>
                    </button>
                }
            </div>
        </section>

        @* ── Theme — 3 inline buttons ─────────────────────────────── *@
        <section class="kmila-profile-menu__section">
            <header class="kmila-profile-menu__section-head">
                <Icon Name="@CurrentThemeIcon" />
                <span>@Traductor.T("SETTINGS_THEME")</span>
            </header>
            <div class="kmila-profile-menu__theme-row" role="group">
                <KmilaTooltip TextKey="THEME_LIGHT_TIP">
                    <button type="button"
                            class="kmila-btn-tab kmila-btn-tab--accent kmila-btn-tab--sm kmila-profile-menu__theme-btn @(_theme == "light" ? "is-active" : "")"
                            @onclick='() => SetThemeAsync("light")'>
                        <Icon Name="IconName.SunFill" />
                        <span>@Traductor.T("THEME_LIGHT")</span>
                    </button>
                </KmilaTooltip>
                <KmilaTooltip TextKey="THEME_DARK_TIP">
                    <button type="button"
                            class="kmila-btn-tab kmila-btn-tab--accent kmila-btn-tab--sm kmila-profile-menu__theme-btn @(_theme == "dark" ? "is-active" : "")"
                            @onclick='() => SetThemeAsync("dark")'>
                        <Icon Name="IconName.MoonStarsFill" />
                        <span>@Traductor.T("THEME_DARK")</span>
                    </button>
                </KmilaTooltip>
                <KmilaTooltip TextKey="THEME_AUTO_TIP">
                    <button type="button"
                            class="kmila-btn-tab kmila-btn-tab--accent kmila-btn-tab--sm kmila-profile-menu__theme-btn @(_theme == "auto" ? "is-active" : "")"
                            @onclick='() => SetThemeAsync("auto")'>
                        <Icon Name="IconName.CircleHalf" />
                        <span>@Traductor.T("THEME_AUTO")</span>
                    </button>
                </KmilaTooltip>
            </div>
        </section>

        @* ── Account actions ──────────────────────────────────────── *@
        <section class="kmila-profile-menu__section kmila-profile-menu__section--actions">
            <KmilaTooltip TextKey="TOPBAR_ACCOUNT_SETTINGS_TIP">
                <button type="button"
                        class="kmila-btn kmila-btn--primary kmila-btn--sm kmila-profile-menu__action"
                        @onclick="OpenSettingsAsync">
                    <Icon Name="IconName.Gear" />
                    <span>@Traductor.T("TOPBAR_ACCOUNT_SETTINGS")</span>
                </button>
            </KmilaTooltip>
            @if (GitHubAuth.IsLoggedIn)
            {
                <KmilaTooltip TextKey="TOPBAR_SIGN_OUT_TIP">
                    <button type="button"
                            class="kmila-btn kmila-btn--danger kmila-btn--sm kmila-profile-menu__action kmila-profile-menu__action--danger"
                            @onclick="SignOutAsync">
                        <Icon Name="IconName.BoxArrowRight" />
                        <span>@Traductor.T("TOPBAR_SIGN_OUT")</span>
                    </button>
                </KmilaTooltip>
            }
            else if (_demo?.AllowGitHubLogin ?? true)
            {
                <KmilaTooltip TextKey="TOPBAR_SIGN_IN_GITHUB_TIP">
                    <button type="button"
                            class="kmila-btn kmila-btn--accent kmila-btn--sm kmila-profile-menu__action kmila-profile-menu__action--primary"
                            @onclick="OpenLoginAsync">
                        <Icon Name="IconName.Github" />
                        <span>@Traductor.T("TOPBAR_SIGN_IN_GITHUB")</span>
                    </button>
                </KmilaTooltip>
            }
        </section>
    </div>
</details>

@* GitHub login modal — kept OUTSIDE the <details> so the user-agent rule
   that hides non-<summary> children of a closed <details> doesn't reach
   the modal's host node and break it once the dropdown collapses. *@
<Modal @ref="_loginModal" Title="@Traductor.T("TOPBAR_SIGN_IN_GITHUB")" Size="ModalSize.Small" />

@code {
    // ---- FPGA state (lifted verbatim from the old TopBar FPGA picker) ----
    private string _selectedFPGA = string.Empty;
    private FPGA? _fpga = new();
    private List<string> _fpgas = new();
    private string _filter = "";
    private string _manufacturerFilter = string.Empty;
    private readonly Dictionary<string, (string?, string?)> _fpgaMeta = new();
    private List<string> _manufacturers = new();

    // ---- Language ----
    private record LangOption(string Code, string NativeName);
    private static readonly LangOption[] _languages = new[]
    {
        new LangOption("en", "English"),
        new LangOption("es", "Español"),
        new LangOption("fr", "Français"),
        new LangOption("de", "Deutsch"),
        new LangOption("ch", "中文"),
        new LangOption("jp", "日本語"),
        new LangOption("ar", "عربي")
    };

    // ---- Theme ----
    private string _theme = "auto";
    private IconName CurrentThemeIcon => _theme switch
    {
        "dark"  => IconName.MoonStarsFill,
        "light" => IconName.SunFill,
        _       => IconName.CircleHalf
    };

    private Modal _loginModal = new();

    // Optional demo-capability gate. Null on the MAUI/Server heads (unregistered);
    // only the WASM demo registers it. Resolved via IServiceProvider so an
    // unregistered service returns null instead of throwing at injection.
    private IDemoCapabilities? _demo => SP.GetService(typeof(IDemoCapabilities)) as IDemoCapabilities;

    protected override async Task OnInitializedAsync()
    {
        Traductor.StaticOnLangChanged += OnLangChanged;
        GitHubAuth.OnChange += OnAuthChanged;
        _ = GitHubAuth.RestoreAsync();

        // FPGA preload — same as the old TopBar
        _fpgas = await JSONFileReader.GetFPGAsAsync();
        foreach (var p in _fpgas)
        {
            try
            {
                var m = await JSONFileReader.ReadFPGAJsonFileAsync(p);
                _fpgaMeta[p] = (m?.Manufacturer, m?.Family);
            }
            catch { _fpgaMeta[p] = (null, null); }
        }
        _manufacturers = _fpgaMeta.Values
            .Select(v => v.Item1)
            .Where(m => !string.IsNullOrEmpty(m))
            .Cast<string>()
            .Distinct()
            .OrderBy(m => m)
            .ToList();

        // Theme preload — the boot script in index.html / App.razor reads
        // localStorage.kmila-theme on first paint to avoid a flash. If we only
        // hydrate from SQLite here, the picker can disagree with the actual
        // applied theme (e.g. after `pm clear` wipes app storage but Settings
        // still holds the prior value). Prefer localStorage as the source of
        // truth so the highlighted pill always matches what the user sees.
        string? stored = null;
        try
        {
            stored = await JS.InvokeAsync<string?>("localStorage.getItem", "kmila-theme");
        }
        catch
        {
            // JS interop can fail during prerender — fall through to SQLite.
        }
        if (string.IsNullOrEmpty(stored))
        {
            stored = await DbContext.GetSettingAsync(AppSettings.KEY_THEME);
        }
        if (!string.IsNullOrEmpty(stored)) _theme = stored;

        // Restore the currently selected FPGA so the inline summary shows the
        // same chip the old TopBar version did. Without this, the panel reads
        // "Select FPGA…" even when SelectedFPGA already has a board picked.
        var current = SelectedFPGA?.FPGA;
        if (current != null && !string.IsNullOrEmpty(current.Model))
        {
            _fpga = current;
            // Find the path that produced this FPGA so the option highlight
            // still works. Fall back gracefully when the path isn't tracked.
            foreach (var (path, meta) in _fpgaMeta)
            {
                if (string.Equals(meta.Item2, current.Family, StringComparison.OrdinalIgnoreCase))
                {
                    _selectedFPGA = path;
                    break;
                }
            }
        }
        else
        {
            // SelectedFPGA is an in-memory singleton with no persistence of
            // its own — on a cold app start it begins empty. Restore from
            // SQLite (AppSettings.KEY_FPGA_PATH) so the user doesn't have to
            // re-pick a board every launch (a real Run-pipeline blocker).
            try
            {
                var savedPath = await DbContext.GetSettingAsync(AppSettings.KEY_FPGA_PATH);
                if (!string.IsNullOrWhiteSpace(savedPath) && _fpgas.Contains(savedPath))
                {
                    var restored = await JSONFileReader.ReadFPGAJsonFileAsync(savedPath);
                    if (restored is not null)
                    {
                        _fpga = restored;
                        _selectedFPGA = savedPath;
                        SelectedFPGA.SetFPGA(restored, savedPath);
                    }
                }
            }
            catch
            {
                // Persistence is best-effort; a bad saved path just falls
                // back to the empty "Select FPGA…" state.
            }
        }
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);
    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private IEnumerable<string> FilteredFPGAs()
    {
        IEnumerable<string> list = _fpgas;
        if (!string.IsNullOrEmpty(_manufacturerFilter))
        {
            list = list.Where(p =>
                _fpgaMeta.TryGetValue(p, out var meta) &&
                string.Equals(meta.Item1, _manufacturerFilter, StringComparison.OrdinalIgnoreCase));
        }
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            list = list.Where(p =>
                System.IO.Path.GetFileNameWithoutExtension(p)
                    .Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                (_fpgaMeta.TryGetValue(p, out var meta) &&
                    ((meta.Item2 ?? "").Contains(_filter, StringComparison.OrdinalIgnoreCase))));
        }
        return list;
    }

    private async Task OnFPGAPicked(string path)
    {
        _selectedFPGA = path;
        _fpga = await JSONFileReader.ReadFPGAJsonFileAsync(path);
        if (_fpga is not null) SelectedFPGA.SetFPGA(_fpga, path);
        // Persist so the picked board survives a cold app restart — the
        // SelectedFPGA singleton has no persistence layer of its own.
        try { await DbContext.SetSettingAsync(AppSettings.KEY_FPGA_PATH, path); }
        catch { /* best-effort; user can re-pick if SQLite write fails */ }
        _filter = "";
        StateHasChanged();
    }

    private async Task SetLanguageAsync(string code)
    {
        await DbContext.SetSettingAsync(AppSettings.KEY_LANGUAGE, code);
        try { await JS.InvokeVoidAsync("kmilaSetDocsLang", code); }
        catch { /* helper missing — non-fatal */ }
    }

    private async Task SetThemeAsync(string theme)
    {
        _theme = theme;
        await JS.InvokeVoidAsync("localStorage.setItem", "kmila-theme", theme);
        var effective = await JS.InvokeAsync<string>("kmilaResolveTheme", theme);
        await JS.InvokeVoidAsync(
            "document.documentElement.setAttribute", "data-bs-theme", effective);
        await DbContext.SetSettingAsync(AppSettings.KEY_THEME, theme);
        var monaco = effective == "dark" ? "vs-dark" : "vs";
        await BlazorMonaco.Editor.Global.SetTheme(JS, monaco);
        StateHasChanged();
    }

    private async Task OpenLoginAsync()
    {
        await CloseRootMenuAsync();
        var parameters = new Dictionary<string, object>
        {
            { "OnSuccess", EventCallback.Factory.Create(this, OnLoginSucceededAsync) },
            { "OnCancel",  EventCallback.Factory.Create(this, () => _loginModal.HideAsync()) }
        };
        await _loginModal.ShowAsync<GitHubLoginModal>(
            Traductor.T("TOPBAR_SIGN_IN_GITHUB"), null, parameters);
    }

    private async Task OnLoginSucceededAsync() => await _loginModal.HideAsync();

    private async Task SignOutAsync()
    {
        await CloseRootMenuAsync();
        await GitHubAuth.SignOutAsync();
    }

    private async Task OpenSettingsAsync()
    {
        await CloseRootMenuAsync();
        NavigationManager.NavigateTo("/settings");
    }

    /// <summary>
    /// Closes the outer profile <details> via JS so it doesn't sit visible
    /// behind a follow-up modal/navigation. We don't expose the open state to
    /// Blazor — it's a cosmetic concern owned by the browser side.
    /// </summary>
    private async Task CloseRootMenuAsync()
    {
        try { await JS.InvokeVoidAsync("eval", "document.querySelectorAll('details.kmila-profile-menu').forEach(d => d.open = false)"); }
        catch { }
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLangChanged;
        GitHubAuth.OnChange -= OnAuthChanged;
    }
}
