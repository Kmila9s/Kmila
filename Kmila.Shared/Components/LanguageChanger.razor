@*
    LanguageChanger — custom <details> popover. Matches the FPGA picker style.

    • Pill trigger shows a globe icon + the current language *code* in uppercase
      (so the trigger stays narrow even for long native names like "日本語").
    • Popover panel lists all 7 languages with native name + code badge,
      check mark next to the current one.
    • RTL-aware (Arabic language flips the popover alignment via [dir=rtl]).

    Reactive flow unchanged:
    DbContext.SetSettingAsync(KEY_LANGUAGE) → StaticOnValueChanged →
    Traductor reloads → StaticOnLangChanged → MainLayout re-renders.
*@
@implements IDisposable

<details class="kmila-lang-picker">
    <summary class="kmila-lang-picker__summary" aria-label="@Traductor.T("A11Y_LANGUAGE")">
        <Icon Name="IconName.Translate" />
        <span class="kmila-lang-picker__code">@CurrentCode</span>
        <Icon Name="IconName.ChevronDown" Class="kmila-lang-picker__chevron" />
    </summary>

    <div class="kmila-lang-picker__panel" role="menu">
        @foreach (var lang in _languages)
        {
            var isActive = lang.Code == Traductor.Lang;
            <button type="button"
                    role="menuitem"
                    class="kmila-lang-picker__option @(isActive ? "is-selected" : "")"
                    @onclick="() => SetLanguageAsync(lang.Code)">
                <span class="kmila-lang-picker__badge">@lang.Code.ToUpperInvariant()</span>
                <span class="kmila-lang-picker__name">@lang.NativeName</span>
                @if (isActive)
                {
                    <Icon Name="IconName.CheckLg" Class="kmila-lang-picker__check" />
                }
            </button>
        }
    </div>
</details>

@code {
    private record LangOption(string Code, string NativeName);

    private static readonly LangOption[] _languages = new[]
    {
        new LangOption("en", "English"),
        new LangOption("es", "Español"),
        new LangOption("fr", "Français"),
        new LangOption("de", "Deutsch"),
        new LangOption("ch", "中文"),
        new LangOption("jp", "日本語"),
        new LangOption("ar", "عربي")
    };

    private string CurrentCode => Traductor.Lang?.ToUpperInvariant() ?? "EN";

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLangChanged;
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private async Task SetLanguageAsync(string code)
    {
        // Blazor side: reactive Traductor reload + UI re-render via the DB event chain.
        await DbContext.SetSettingAsync(AppSettings.KEY_LANGUAGE, code);
        // JS side: update the VHDL doc-language pointer so Monaco hover/completion
        // picks up the new translations immediately — providers re-invoke on every
        // user action, so no Monaco re-register is needed.
        try { await JS.InvokeVoidAsync("kmilaSetDocsLang", code); }
        catch { /* helper is in the inline <head> script — should always exist */ }
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLangChanged;
    }
}
