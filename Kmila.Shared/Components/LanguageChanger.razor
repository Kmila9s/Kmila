@*
    LanguageChanger Component

    A dropdown component for selecting the application's display language.
    Uses Blazor Bootstrap Dropdown with a translate icon for a clean, mobile-friendly UI.

    Reactive Architecture:
    - When the user selects a language, only DbContext.SetSettingAsync is called
    - ApplicationDbContext fires StaticOnValueChanged event after saving
    - Traductor service catches the event and reloads translations automatically
    - MainLayout catches Traductor.StaticOnLangChanged and refreshes the UI

    This reactive pattern ensures instant, smooth language switching without
    the component needing to directly interact with the Traductor service.

    Supported Languages:
    - English (en) - Default
    - Spanish (es)
    - French (fr)
    - German (de)
    - Chinese (ch)
    - Japanese (jp)
    - Arabic (ar) - RTL support

    Dependencies:
    - ApplicationDbContext (injected via _Imports.razor as DbContext)
    - AppSettings.KEY_LANGUAGE - The storage key for language setting
*@
<div class="mx-3">
    <Dropdown Color="DropdownColor.Info">
        <DropdownToggleButton>
            <Icon Name="IconName.Translate" />
            @_selectedLanguage
        </DropdownToggleButton>
        <DropdownMenu>
            @foreach(var key in _languages.Keys){
                <DropdownItem @onclick="async () => await SetNewLanguage(key)" Type="DropdownItemType.Button">@key</DropdownItem>
            }
        </DropdownMenu>
    </Dropdown>
</div>

@code{
    /// <summary>
    /// Available languages with their display names as keys and language codes as values.
    /// </summary>
    private static Dictionary<string, string> _languages = new(){
        { "English", "en"},
        { "Español", "es"},
        { "Français", "fr"},
        { "Deutsch", "de"},
        { "中文", "ch"},
        { "日本語", "jp"},
        { "عربي", "ar"}
    };

    /// <summary>
    /// The currently selected language display name shown in the dropdown button.
    /// </summary>
    private string _selectedLanguage = "English";

    /// <summary>
    /// Sets a new language by saving it to the database.
    /// The reactive event chain handles the rest:
    /// DbContext.SetSettingAsync -> StaticOnValueChanged -> Traductor reloads -> UI refreshes
    /// </summary>
    /// <param name="key">The display name of the language (e.g., "English", "Español").</param>
    private async Task SetNewLanguage(string key){
        _selectedLanguage = key;
        await DbContext.SetSettingAsync(AppSettings.KEY_LANGUAGE, _languages[key]);
    }
}
