@*
    FlowDiagramViewer — control-flow visualization of the parsed VHDL design.

    Complements the gate-level SchematicViewer with a higher-level "how the
    code runs" view: each entity/architecture appears as a flowchart whose
    nodes are processes, concurrent assignments, and the if/case/loop
    structures inside processes. Edges are control-flow (sequential within a
    process; parallel "fan-out" from architecture root to processes).

    Source of data: <c>Builder.Design.Entities</c>, populated by the build
    pipeline. We render after each build (and when the parent component
    notifies us via Refresh()). The output is a Mermaid <c>flowchart TB</c>
    string injected as <pre class="mermaid"> — the page-level mermaid@11
    instance (loaded from CDN in App.razor / index.html for lessons) picks
    it up via window.kmilaMermaidRun.

    Why Mermaid and not custom SVG: the schematic already does ad-hoc SVG
    layout for gate-level detail. For a teaching-flow view, Mermaid's
    auto-layout is good enough and ships zero extra code on our side. If the
    Mermaid CDN is blocked, we fall back to the raw source so the student at
    least sees the structure as text.
*@
@implements IDisposable
@inject ProgramBuilder Builder
@inject IJSRuntime JS

<div class="flow-diagram @(_isFullscreen ? "is-fullscreen" : "")">
    @if (string.IsNullOrEmpty(_mermaidSource))
    {
        <div class="flow-diagram__empty">
            <Icon Name="IconName.Diagram2" />
            <p>@Traductor.T("FLOW_EMPTY")</p>
        </div>
    }
    else
    {
        <header class="flow-diagram__head">
            <span>
                <Icon Name="IconName.Diagram2" />
                @Traductor.T("FLOW_TITLE")
            </span>
            @if (_entityCount > 0)
            {
                <span class="flow-diagram__count">@_entityCount</span>
            }
            <KmilaTooltip TextKey="FLOW_EXPORT_SVG">
                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        @onclick="ExportSvgAsync">
                    <Icon Name="IconName.Download" />
                    <span>SVG</span>
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="FLOW_EXPORT_PNG">
                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        @onclick="ExportPngAsync">
                    <Icon Name="IconName.FileEarmarkImage" />
                    <span>PNG</span>
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="FLOW_EXPORT_UML">
                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        @onclick="ExportUmlAsync">
                    <Icon Name="IconName.FileEarmarkCode" />
                    <span>UML</span>
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="WAVEFORM_ZOOM_IN">
                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        @onclick="() => Zoom(1.25)" aria-label="@Traductor.T("WAVEFORM_ZOOM_IN")">
                    <Icon Name="IconName.ZoomIn" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="WAVEFORM_ZOOM_OUT">
                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        @onclick="() => Zoom(0.8)" aria-label="@Traductor.T("WAVEFORM_ZOOM_OUT")">
                    <Icon Name="IconName.ZoomOut" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="FLOW_ZOOM_FIT">
                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                        @onclick="FitAsync" aria-label="@Traductor.T("FLOW_ZOOM_FIT")">
                    <Icon Name="IconName.AspectRatioFill" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="WAVEFORM_ZOOM_RESET">
                <button type="button" class="kmila-btn-icon kmila-btn-icon--ghost kmila-btn-icon--primary kmila-btn-icon--sm"
                        @onclick="ResetZoomAsync" aria-label="@Traductor.T("WAVEFORM_ZOOM_RESET")">
                    <Icon Name="IconName.ArrowCounterclockwise" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="@(_isFullscreen ? "SCHEMATIC_FULLSCREEN_EXIT" : "SCHEMATIC_FULLSCREEN_ENTER")">
                <button type="button"
                        class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm @(_isFullscreen ? "is-active" : "")"
                        data-kmila-fullscreen-toggle
                        @onclick="ToggleFullscreen"
                        aria-label="@Traductor.T(_isFullscreen ? "SCHEMATIC_FULLSCREEN_EXIT" : "SCHEMATIC_FULLSCREEN_ENTER")">
                    <Icon Name="@(_isFullscreen ? IconName.FullscreenExit : IconName.ArrowsFullscreen)" />
                </button>
            </KmilaTooltip>
            <KmilaTooltip TextKey="FLOW_REFRESH">
                <button type="button" class="kmila-btn-icon kmila-btn-icon--ghost kmila-btn-icon--primary kmila-btn-icon--sm"
                        @onclick="OnRefreshClicked"
                        aria-label="@Traductor.T("FLOW_REFRESH")">
                    <Icon Name="IconName.ArrowClockwise" />
                </button>
            </KmilaTooltip>
        </header>
        <div class="flow-diagram__body">
            @* mermaid auto-detects pre.mermaid and replaces with SVG. The
               key= forces a fresh DOM node when the source changes so we
               never end up showing a stale, already-processed diagram. *@
            <pre class="mermaid" @key="_renderKey">@_mermaidSource</pre>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Forces a re-render with a fresh source string. Editor calls this after
    /// each Build so the diagram reflects the most recently parsed design.
    /// </summary>
    public async Task RefreshAsync()
    {
        _mermaidSource = BuildMermaidSource();
        _renderKey = Guid.NewGuid();
        StateHasChanged();
        await KickMermaidAsync();
    }

    private string _mermaidSource = string.Empty;
    private int _entityCount;
    private Guid _renderKey = Guid.NewGuid();
    private bool _isFullscreen;

    private void ToggleFullscreen()
    {
        _isFullscreen = !_isFullscreen;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLangChanged;
        // Populate from whatever is already in the Builder. The Editor only
        // calls RefreshAsync from RunBuildAsync's finally — but if the user
        // navigates to the Flow tab AFTER a successful build (the common
        // case: build, look at entities, then click Flow), this component
        // mounts FRESH with an empty source and falls into the empty state.
        // Reading the Builder on init keeps the diagram in sync for that
        // navigation path.
        _mermaidSource = BuildMermaidSource();
    }

    /// <summary>
    /// First render after mount we need to kick mermaid so the inline pre.mermaid
    /// gets converted to SVG. Subsequent renders that change _mermaidSource
    /// already kick it from RefreshAsync.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(_mermaidSource))
            await KickMermaidAsync();
        // Only (re)attach when the diagram actually changed (new _renderKey) or
        // we don't have a live handle yet. Blazor re-renders this component after
        // EVERY event handler — including each toolbar zoom click — and a blind
        // re-attach here runs fitOnAttach, which would snap the view back to the
        // fitted scale and wipe out the zoom/pan the user just applied (the
        // "zoom buttons don't work" bug). A genuine new render bumps _renderKey,
        // so a fresh diagram still re-fits.
        if (_panZoomId <= 0 || _attachedKey != _renderKey)
        {
            await AttachPanZoomAsync();
            if (_panZoomId > 0) _attachedKey = _renderKey;
        }
    }

    private int _panZoomId = -1;
    private Guid _attachedKey = Guid.Empty;

    /// <summary>
    /// Hands the rendered mermaid SVG to <c>kmilaAttachPanZoom</c> so trackpad
    /// pinch and 2-finger touch gestures zoom the diagram itself instead of
    /// the entire WebView page. Re-runs after every render: mermaid replaces
    /// the inner element on theme/source changes, so the previous handle
    /// becomes stale. Safe to call before mermaid has finished — the JS
    /// helper returns -1 when no target SVG is present yet.
    /// </summary>
    private bool _attaching;

    private async Task AttachPanZoomAsync()
    {
        if (string.IsNullOrEmpty(_mermaidSource) || _attaching) return;
        _attaching = true;
        try
        {
            if (_panZoomId > 0)
            {
                try { await JS.InvokeVoidAsync("kmilaDetachPanZoom", _panZoomId); } catch { }
                _panZoomId = -1;
            }
            // Mermaid converts <pre> → <svg> asynchronously (and lazy-loads its
            // flowchart grammar chunk on first use), so the SVG usually isn't in
            // the DOM yet when OnAfterRender fires. kmilaAttachFlowPanZoom kicks
            // the render if needed, waits for the <svg>, then binds — so both
            // gestures AND the zoom toolbar (which need a valid _panZoomId)
            // reliably attach once the diagram finishes rendering, no matter how
            // long the first lazy-chunk load takes. Returns -1 if it never
            // renders.
            _panZoomId = await JS.InvokeAsync<int>("kmilaAttachFlowPanZoom",
                ".flow-diagram__body",
                new { targetSelector = "svg", minScale = 0.2, maxScale = 6, fitOnAttach = true });
        }
        catch
        {
            // Prerender or missing helper — zoom simply unavailable until the
            // next render / next toolbar click re-tries via EnsurePanZoomAsync.
        }
        finally { _attaching = false; }
    }

    /// <summary>
    /// Guarantees a live pan-zoom handle before a toolbar action. The initial
    /// attach in OnAfterRender can lose the race against the async Mermaid
    /// render; since the user only clicks a zoom button once they can SEE the
    /// diagram, re-attaching on demand (waiting out any in-flight attach first)
    /// makes the toolbar work regardless of render timing.
    /// </summary>
    private async Task<bool> EnsurePanZoomAsync()
    {
        if (_panZoomId > 0) return true;
        // Attach directly (not via AttachPanZoomAsync) so a still-running
        // mount-time attach — e.g. one polling for a slow first render — can't
        // block us through the _attaching guard. The user only clicks a toolbar
        // button once the diagram is on screen, so the <svg> exists and
        // kmilaAttachFlowPanZoom binds immediately.
        try
        {
            var id = await JS.InvokeAsync<int>("kmilaAttachFlowPanZoom",
                ".flow-diagram__body",
                new { targetSelector = "svg", minScale = 0.2, maxScale = 6, fitOnAttach = true });
            if (id > 0) _panZoomId = id;
        }
        catch { }
        return _panZoomId > 0;
    }

    /// <summary>Toolbar zoom in/out — multiplies the current scale.</summary>
    private async Task Zoom(double factor)
    {
        if (!await EnsurePanZoomAsync()) return;
        try { await JS.InvokeVoidAsync("kmilaPanZoomZoom", _panZoomId, factor); } catch { }
    }

    /// <summary>Toolbar reset — back to 1× at the origin.</summary>
    private async Task ResetZoomAsync()
    {
        if (!await EnsurePanZoomAsync()) return;
        try { await JS.InvokeVoidAsync("kmilaPanZoomReset", _panZoomId); } catch { }
    }

    /// <summary>Toolbar fit — reframe the whole diagram inside the viewport.</summary>
    private async Task FitAsync()
    {
        if (!await EnsurePanZoomAsync()) return;
        try { await JS.InvokeVoidAsync("kmilaPanZoomFit", _panZoomId); } catch { }
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLangChanged;
        if (_panZoomId > 0)
        {
            // Fire-and-forget — Dispose can't await, and the JS-side teardown
            // is synchronous from its own perspective (handle map cleanup).
            try { _ = JS.InvokeVoidAsync("kmilaDetachPanZoom", _panZoomId); } catch { }
            _panZoomId = -1;
        }
    }

    /// <summary>Manual refresh button — reads whatever the Builder has now.</summary>
    private async Task OnRefreshClicked() => await RefreshAsync();

    /// <summary>
    /// Serializes the mermaid-rendered SVG on the JS side, then writes the
    /// payload through <see cref="IFileExportService"/>. On MAUI that lands
    /// the file in ~/Documents/Kmila/SVG/ (visible in Finder / Files.app);
    /// on Web the platform implementation falls back to an anchor download.
    /// Previous versions called <c>kmilaDownloadFlowDiagram</c> directly,
    /// which only worked in real browsers — iOS / macCatalyst WebViews drop
    /// the anchor click and the user never saw the file.
    /// </summary>
    private async Task ExportSvgAsync()
    {
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var fileName = $"kmila-flow-{stamp}.svg";
        try
        {
            var svg = await JS.InvokeAsync<string>("kmilaSerializeFlowSvg", ".flow-diagram__body");
            if (IsFlowExportFailure(svg, out var failKey))
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    Traductor.T(failKey), ToastType.Danger));
                return;
            }
            var result = await Export.SaveTextAsync(ExportCategory.Svg, fileName, "image/svg+xml", svg);
            NotifyExportResult(result);
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    private async Task ExportPngAsync()
    {
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var fileName = $"kmila-flow-{stamp}.png";
        try
        {
            var base64 = await JS.InvokeAsync<string>("kmilaSerializeFlowPng", ".flow-diagram__body");
            if (IsFlowExportFailure(base64, out var failKey))
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    Traductor.T(failKey), ToastType.Danger));
                return;
            }
            var bytes = Convert.FromBase64String(base64);
            var result = await Export.SaveBytesAsync(ExportCategory.Png, fileName, "image/png", bytes);
            NotifyExportResult(result);
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>
    /// Interprets the payload returned by <c>kmilaSerializeFlowSvg</c> /
    /// <c>kmilaSerializeFlowPng</c>. Those return a real SVG string / PNG
    /// base64 on success, or an <c>ERR:&lt;reason&gt;</c> sentinel (never a
    /// valid payload, which never starts with "ERR:") when the diagram could
    /// not be rendered. Maps the reason to the right toast key so the user
    /// sees "couldn't render" rather than the old catch-all "not ready".
    /// </summary>
    private static bool IsFlowExportFailure(string? payload, out string messageKey)
    {
        if (string.IsNullOrEmpty(payload))
        {
            messageKey = "FLOW_MERMAID_NOT_READY";
            return true;
        }
        if (payload.StartsWith("ERR:", StringComparison.Ordinal))
        {
            messageKey = payload switch
            {
                "ERR:render-failed" => "FLOW_RENDER_FAILED",
                "ERR:too-large"     => "FLOW_PNG_TOO_LARGE",
                "ERR:png-failed"    => "FLOW_PNG_FAILED",
                _                   => "FLOW_MERMAID_NOT_READY",
            };
            return true;
        }
        messageKey = string.Empty;
        return false;
    }

    /// <summary>
    /// Re-walks the parsed AST through <see cref="PlantUmlFlowEmitter"/> and
    /// writes the resulting <c>.puml</c> payload. Unlike SVG/PNG this path
    /// doesn't depend on Mermaid having rendered — the emitter reads the
    /// Builder directly, so it works even if the on-screen diagram isn't
    /// ready yet (CDN blocked, theme switch mid-flight, etc.).
    /// </summary>
    private async Task ExportUmlAsync()
    {
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var fileName = $"kmila-flow-{stamp}.puml";
        try
        {
            var uml = PlantUmlFlowEmitter.Emit(Builder?.Design?.Entities);
            if (string.IsNullOrEmpty(uml))
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    Traductor.T("FLOW_EXPORT_NO_ENTITIES"), ToastType.Danger));
                return;
            }
            var result = await Export.SaveTextAsync(ExportCategory.Uml, fileName, "text/plain", uml);
            NotifyExportResult(result);
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    private void NotifyExportResult(FileExportResult result)
    {
        if (result.Saved)
        {
            var msg = result.Path != null
                ? Traductor.T("COMMON_SAVED_TO_FMT", result.Path)
                : Traductor.T("FLOW_EXPORT_OK");
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), msg, ToastType.Success));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                result.Error ?? Traductor.T("COMMON_EXPORT_FAILED"), ToastType.Danger));
        }
    }

    /// <summary>
    /// Re-runs the page-level mermaid@11 instance to convert pre.mermaid into
    /// SVG. Idempotent and safe to call when mermaid hasn't loaded yet (the
    /// JS shim swallows the error so the raw source stays visible as fallback).
    /// </summary>
    private async Task KickMermaidAsync()
    {
        try
        {
            // Two ticks: first to flush this render, second so the
            // <pre.mermaid> is in the DOM before we ask mermaid to scan it.
            await Task.Yield();
            await JS.InvokeVoidAsync("kmilaMermaidRun");
        }
        catch { /* CDN blocked or mermaid not yet loaded — pre.mermaid stays as text */ }
    }

    /// <summary>
    /// Walks <c>Builder.Design.Entities</c> and emits a Mermaid flowchart.
    /// Each entity gets its own subgraph; inside an arch we render a node for
    /// every concurrent task, drilling into Process tasks to show their
    /// if/case/loop structure. Falls back to the task type name when we don't
    /// recognize a shape — that keeps the view alive even when the AST grows.
    /// </summary>
    private string BuildMermaidSource()
    {
        var parser = Builder?.Design;
        var entities = parser?.Entities;
        if (entities == null || entities.Count == 0)
        {
            _entityCount = 0;
            return string.Empty;
        }
        _entityCount = entities.Count;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("flowchart TB");
        // Soft styling — the page theme observer in App.razor switches mermaid
        // theme on dark mode, but a couple of explicit class colors give the
        // categories of node a stable visual identity within either theme.
        sb.AppendLine("  classDef arch fill:#dbeafe,stroke:#3b82f6,color:#1e3a8a;");
        sb.AppendLine("  classDef proc fill:#fef3c7,stroke:#d97706,color:#78350f;");
        sb.AppendLine("  classDef cond fill:#fae8ff,stroke:#a855f7,color:#581c87;");
        sb.AppendLine("  classDef loop fill:#dcfce7,stroke:#16a34a,color:#14532d;");
        sb.AppendLine("  classDef stmt fill:#f1f5f9,stroke:#64748b,color:#0f172a;");

        var ctr = new IdCounter();
        foreach (var entity in entities)
        {
            try { EmitEntity(sb, entity, ctr); }
            catch (Exception ex)
            {
                // Defensive: don't let one malformed AST node poison the whole
                // diagram. Drop a marker node and keep going.
                var id = ctr.Next("err");
                sb.AppendLine($"  {id}[\"{Esc($"⚠ {Traductor.T("FLOW_RENDER_ERROR")}: {ex.Message}")}\"]:::cond");
            }
        }
        return sb.ToString();
    }

    private void EmitEntity(System.Text.StringBuilder sb, dynamic entity, IdCounter ctr)
    {
        string entityName = entity.Name as string ?? "(entity)";
        var arch = entity.Architecture;
        string archName = arch?.Name as string ?? "(arch)";

        var entityId = ctr.Next("e");
        // VHDL keywords (entity / architecture) stay verbatim — they're
        // language tokens that show up identically in any locale's textbook.
        sb.AppendLine($"  subgraph {entityId}[\"{Esc($"entity {entityName}")}\"]");
        sb.AppendLine($"    direction TB");

        var archId = ctr.Next("a");
        sb.AppendLine($"    {archId}[\"{Esc($"architecture {archName}")}\"]:::arch");

        if (arch?.Tasks is System.Collections.IEnumerable archTasks)
        {
            int idx = 0;
            foreach (var task in archTasks)
            {
                idx++;
                EmitArchTask(sb, archId, task, idx, ctr);
            }
        }
        sb.AppendLine("  end");
    }

    /// <summary>Emit a single concurrent task under the architecture.</summary>
    private void EmitArchTask(System.Text.StringBuilder sb, string parentId, object task, int idx, IdCounter ctr)
    {
        if (task == null) return;
        var typeName = task.GetType().Name;

        // Process — branch into its sequential body.
        if (typeName == "Process")
        {
            var procId = ctr.Next("p");
            string label = $"{Traductor.T("FLOW_PROCESS")} #{idx}";
            try
            {
                var sens = (task as dynamic).SensitiveList as System.Collections.IEnumerable;
                if (sens != null)
                {
                    var names = new List<string>();
                    foreach (var v in sens)
                    {
                        var n = (v as dynamic)?.Name as string;
                        if (!string.IsNullOrEmpty(n)) names.Add(n);
                    }
                    if (names.Count > 0)
                        label += $"\\n{Traductor.T("FLOW_SENSITIVE_TO")}: {string.Join(", ", names)}";
                }
            }
            catch { }
            sb.AppendLine($"    {procId}[\"{Esc(label)}\"]:::proc");
            sb.AppendLine($"    {parentId} --> {procId}");

            try
            {
                var tasks = (task as dynamic).Tasks as System.Collections.IEnumerable;
                if (tasks != null)
                {
                    string prevId = procId;
                    int subIdx = 0;
                    foreach (var sub in tasks)
                    {
                        subIdx++;
                        prevId = EmitSequential(sb, prevId, sub, subIdx, ctr);
                    }
                }
            }
            catch { }
            return;
        }

        // Concurrent operation — surface the actual VHDL line so the box
        // reads as the assignment instead of the generic class name.
        // Prefer Operation.RawData when present, then fall back to
        // assignment-target + assignment-source for ConditionalAssignment /
        // SelectedAssignment shapes.
        var stmtId = ctr.Next("c");
        sb.AppendLine($"    {stmtId}[\"{Esc(DescribeConcurrent(task, typeName))}\"]:::stmt");
        sb.AppendLine($"    {parentId} --> {stmtId}");
    }

    /// <summary>
    /// Best-effort label for a concurrent task: returns the VHDL-flavoured
    /// expression where we know the shape, or <paramref name="typeName"/>
    /// otherwise. Reflection-only so we don't have to take typed
    /// dependencies on the Interpreter's repository classes.
    /// </summary>
    private string DescribeConcurrent(object task, string typeName)
    {
        // Plain assignment: Operation has RawData like "y <= a and b".
        var raw = TryGetString(task, "RawData");
        if (!string.IsNullOrWhiteSpace(raw)) return Truncate(raw!.Trim());

        // ConditionalAssignment: TargetName <= v1 when c1 else v2 ...
        if (typeName == "ConditionalAssignment")
        {
            var target = TryGetString(task, "TargetName") ?? "?";
            var parts = new List<string>();
            try
            {
                var brs = task.GetType().GetProperty("Branches")?.GetValue(task) as System.Collections.IEnumerable;
                if (brs != null)
                {
                    foreach (var br in brs)
                    {
                        var v = TryGetString(br, "ValueExpression") ?? "?";
                        var c = TryGetString(br, "ConditionExpression");
                        parts.Add(string.IsNullOrEmpty(c) ? v : $"{v} when {c}");
                    }
                }
            }
            catch { }
            return Truncate($"{target} <= " + (parts.Count > 0 ? string.Join(" else ", parts) : "(?)"));
        }

        // SelectedAssignment: with selector <selector> select target <= ...
        if (typeName == "SelectedAssignment")
        {
            var target   = TryGetString(task, "TargetName") ?? "?";
            var selector = TryGetString(task, "SelectorExpression") ?? "?";
            var n        = 0;
            try
            {
                var brs = task.GetType().GetProperty("Branches")?.GetValue(task) as System.Collections.IEnumerable;
                if (brs != null) foreach (var _ in brs) n++;
            }
            catch { }
            return Truncate($"with {selector} select {target} <= … ({n} branches)");
        }

        return typeName;
    }

    /// <summary>
    /// Emits a sequential statement under <paramref name="prevId"/> and returns
    /// the id of the LAST node emitted so the caller can chain the next one.
    /// Knows the common control-flow shapes (if/case/loops); unknown task
    /// types render as a generic statement box.
    /// </summary>
    private string EmitSequential(System.Text.StringBuilder sb, string prevId, object task, int idx, IdCounter ctr,
        string? inLabel = null, bool inDotted = false)
    {
        if (task == null) return prevId;
        var typeName = task.GetType().Name;

        if (typeName == "IfStructure")
        {
            // Decision-tree layout: one diamond per condition, chained through
            // the "no" edge so the diagram mirrors VHDL if/elsif priority
            // (conditions are tried top-to-bottom). No redundant "then/elsif/
            // else" label boxes — the branch outcome lives on the edge, and the
            // body statements follow directly. The VHDL keywords (if/elsif) we
            // keep verbatim in the diamond; sí/no label the outgoing edges.
            string IF = Traductor.T("FLOW_IF"), ELSIF = Traductor.T("FLOW_ELSIF"),
                   ENDIF = Traductor.T("FLOW_END_IF"),
                   YES = Traductor.T("FLOW_YES"), NO = Traductor.T("FLOW_NO");

            string endId = ctr.Next("ifend");
            sb.AppendLine($"    {endId}([\"{Esc(ENDIF)}\"]):::stmt");

            var branches = new List<object>();
            try
            {
                var brs = (task as dynamic).Branches as System.Collections.IEnumerable;
                if (brs != null) foreach (var br in brs) if (br != null) branches.Add(br);
            }
            catch { }

            // Degenerate: no parseable branches — pass straight through so the
            // chain doesn't dead-end.
            if (branches.Count == 0)
            {
                sb.AppendLine(Edge(prevId, endId, inLabel, inDotted));
                return endId;
            }

            string? currentFrom = prevId;   // source for the next condition / branch
            bool fromIsDiamond = false;     // true once we've emitted a diamond
            bool sawElse = false;
            bool first = true;

            foreach (var br in branches)
            {
                bool isElse = false;
                try { isElse = (bool)((dynamic)br).IsElse; } catch { }
                var body = ((dynamic)br).Tasks as System.Collections.IEnumerable;

                if (isElse)
                {
                    // else body hangs off the previous diamond's "no" edge.
                    sawElse = true;
                    EmitBranchBody(sb, currentFrom!, body, endId,
                        fromIsDiamond ? NO : (first ? inLabel : null),
                        dotted: first && inDotted, ctr);
                    currentFrom = null;
                    break; // else is terminal
                }

                string? condRaw = null;
                try { condRaw = TryGetString(((dynamic)br).Condition, "RawData"); } catch { }
                string keyword = first ? IF : ELSIF;
                string diaLabel = string.IsNullOrWhiteSpace(condRaw)
                    ? keyword
                    : $"{keyword} {Truncate(condRaw!.Trim(), 48)}";
                string diaId = ctr.Next("if");
                sb.AppendLine($"    {diaId}{{{{\"{Esc(diaLabel)}\"}}}}:::cond");

                // Incoming edge: the caller's label for the very first diamond,
                // otherwise the previous diamond's "no" path.
                if (first)
                    sb.AppendLine(Edge(prevId, diaId, inLabel, inDotted));
                else
                    sb.AppendLine(Edge(currentFrom!, diaId, NO, false));

                // "yes" edge → this branch's body → merge node.
                EmitBranchBody(sb, diaId, body, endId, YES, dotted: false, ctr);

                currentFrom = diaId;
                fromIsDiamond = true;
                first = false;
            }

            // No else? The last diamond's "no" outcome is the implicit skip —
            // draw it (dotted) so the diamond shows both outcomes.
            if (!sawElse && currentFrom != null && fromIsDiamond)
                sb.AppendLine(Edge(currentFrom, endId, NO, dotted: true));

            return endId;
        }

        if (typeName == "CaseStructure")
        {
            string CASE = Traductor.T("FLOW_CASE"),
                   ENDCASE = Traductor.T("FLOW_END_CASE"),
                   OTHERS_PATH = Traductor.T("FLOW_OTHERS_PATH");

            var diamondId = ctr.Next("case");
            var sel = CaseSelectorLabel(task);
            string caseLabel = string.IsNullOrWhiteSpace(sel) || sel == "?"
                ? CASE
                : $"{CASE} {Truncate(sel, 48)}";
            sb.AppendLine($"    {diamondId}{{{{\"{Esc(caseLabel)}\"}}}}:::cond");
            sb.AppendLine(Edge(prevId, diamondId, inLabel, inDotted));
            string endId = ctr.Next("caseend");
            sb.AppendLine($"    {endId}([\"{Esc(ENDCASE)}\"]):::stmt");

            var branches = new List<object>();
            try
            {
                var brs = (task as dynamic).Branches as System.Collections.IEnumerable;
                if (brs == null) try { brs = (task as dynamic).Cases as System.Collections.IEnumerable; } catch { }
                if (brs != null) foreach (var ce in brs) if (ce != null) branches.Add(ce);
            }
            catch { }

            bool hasOthers = false;
            int c = 0;
            foreach (var ce in branches)
            {
                c++;
                bool isOthers = false;
                try { isOthers = (bool)((dynamic)ce).IsOthers; } catch { }
                if (isOthers) hasOthers = true;
                // Edge carries the real choice values ("01" | "10", others, …);
                // the body statements follow directly — no redundant when box.
                string whenLabel = CaseWhenLabel(ce, c);
                var body = ((dynamic)ce).Tasks as System.Collections.IEnumerable;
                EmitBranchBody(sb, diamondId, body, endId, whenLabel, dotted: false, ctr);
            }

            // No explicit `when others`? Expose the implicit fall-through so the
            // diamond doesn't read as exhaustive.
            if (!hasOthers)
                sb.AppendLine(Edge(diamondId, endId, OTHERS_PATH, dotted: true));

            return endId;
        }

        if (typeName.EndsWith("LoopStructure") || typeName == "GenerateBlock")
        {
            var loopId = ctr.Next("lp");
            var label = typeName switch
            {
                "ForLoopStructure"    => Traductor.T("FLOW_FOR_LOOP"),
                "WhileLoopStructure"  => Traductor.T("FLOW_WHILE_LOOP"),
                "SimpleLoopStructure" => Traductor.T("FLOW_LOOP"),
                "GenerateBlock"       => Traductor.T("FLOW_GENERATE"),
                _                     => typeName
            };
            sb.AppendLine($"    {loopId}[/\"{Esc(label)}\"/]:::loop");
            sb.AppendLine(Edge(prevId, loopId, inLabel, inDotted));
            try
            {
                var tasks = (task as dynamic).Tasks as System.Collections.IEnumerable;
                if (tasks != null)
                {
                    string innerLast = loopId;
                    int j = 0;
                    foreach (var t in tasks)
                    {
                        j++;
                        innerLast = EmitSequential(sb, innerLast, t, j, ctr);
                    }
                    // Loop arrow back to header for the iteration vibe.
                    sb.AppendLine($"    {innerLast} -.-> {loopId}");
                }
            }
            catch { }
            return loopId;
        }

        // Catch-all — prefer the actual VHDL line (Operation.RawData). For
        // anything else we fall back to type name plus any obvious label
        // property so the reader at least knows what step it is.
        var stmtId = ctr.Next("s");
        var stmtLabel = DescribeConcurrent(task, typeName);
        sb.AppendLine($"    {stmtId}[\"{Esc(stmtLabel)}\"]:::stmt");
        sb.AppendLine(Edge(prevId, stmtId, inLabel, inDotted));
        return stmtId;
    }

    /// <summary>
    /// Reflection-only string-property reader. Returns null on missing /
    /// non-string / exception. Lets the rendering walk shapes from the
    /// Interpreter module without taking a typed dependency.
    /// </summary>
    private static string? TryGetString(object obj, string name)
    {
        if (obj == null) return null;
        try
        {
            var p = obj.GetType().GetProperty(name,
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            return p?.GetValue(obj) as string;
        }
        catch { return null; }
    }

    /// <summary>Reflection-only property reader (any type). Null on miss.</summary>
    private static object? TryGetProp(object? obj, string name)
    {
        if (obj == null) return null;
        try
        {
            return obj.GetType().GetProperty(name,
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)?.GetValue(obj);
        }
        catch { return null; }
    }

    /// <summary>
    /// Emits one Mermaid edge <c>from --> to</c>, optionally labeled and/or
    /// dotted. The label is wrapped in double-quotes so spaces / underscores /
    /// escaped glyphs parse as one token instead of breaking the <c>|…|</c>
    /// delimiter. Keeps all edge construction (plain, labeled, implicit-skip)
    /// in one place.
    /// </summary>
    private static string Edge(string from, string to, string? label, bool dotted)
    {
        var arrow = dotted ? "-.->" : "-->";
        return string.IsNullOrEmpty(label)
            ? $"    {from} {arrow} {to}"
            : $"    {from} {arrow}|\"{Esc(label)}\"| {to}";
    }

    /// <summary>
    /// Chains a branch body (if/elsif/else arm, or case when arm) off
    /// <paramref name="from"/> into the shared merge node <paramref name="endId"/>.
    /// The FIRST incoming edge carries <paramref name="firstLabel"/> (sí/no/the
    /// when-choice) so there's no redundant label box. An empty body collapses
    /// to a single labeled edge straight to the merge node.
    /// </summary>
    private void EmitBranchBody(System.Text.StringBuilder sb, string from,
        System.Collections.IEnumerable? body, string endId, string? firstLabel, bool dotted, IdCounter ctr)
    {
        var items = new List<object>();
        if (body != null) foreach (var t in body) if (t != null) items.Add(t);

        if (items.Count == 0)
        {
            sb.AppendLine(Edge(from, endId, firstLabel, dotted));
            return;
        }

        string last = from;
        for (int j = 0; j < items.Count; j++)
        {
            last = j == 0
                ? EmitSequential(sb, from, items[j], j + 1, ctr, firstLabel, dotted)
                : EmitSequential(sb, last, items[j], j + 1, ctr);
        }
        sb.AppendLine(Edge(last, endId, null, false));
    }

    /// <summary>
    /// Builds the case selector label from the real AST shape:
    /// <c>CaseStructure.SelectorName</c> (falling back to the resolved
    /// <c>Selector.Name</c>), with the slice appended for a sliced selector
    /// like <c>case op(3 downto 0) is</c>. Returns "?" when nothing readable.
    /// </summary>
    private static string CaseSelectorLabel(object task)
    {
        var sel = TryGetString(task, "SelectorName");
        if (string.IsNullOrWhiteSpace(sel))
        {
            var selVar = TryGetProp(task, "Selector");
            sel = selVar != null ? TryGetString(selVar, "Name") : null;
        }
        if (string.IsNullOrWhiteSpace(sel)) return "?";
        sel = sel!.Trim();
        try
        {
            if (TryGetProp(task, "HasSelectorSlice") is bool has && has
                && TryGetProp(task, "SelectorSliceHigh") is int h && h >= 0
                && TryGetProp(task, "SelectorSliceLow") is int l && l >= 0)
            {
                sel = $"{sel}({h} downto {l})";
            }
        }
        catch { }
        return sel;
    }

    /// <summary>
    /// Builds a <c>when</c> arm label from the real AST shape: "others" for the
    /// catch-all (<c>IsOthers</c>), otherwise the branch's <c>Choices</c> joined
    /// with " | " (e.g. <c>"01" | "10"</c>). Falls back to <c>when #n</c> only
    /// when no choices are readable.
    /// </summary>
    private string CaseWhenLabel(object branch, int index)
    {
        try
        {
            if (TryGetProp(branch, "IsOthers") is bool b && b)
                return Traductor.T("FLOW_OTHERS_PATH");
            if (TryGetProp(branch, "Choices") is System.Collections.IEnumerable ch)
            {
                var parts = new List<string>();
                foreach (var c in ch)
                {
                    var s = c?.ToString();
                    if (!string.IsNullOrWhiteSpace(s)) parts.Add(s!.Trim());
                }
                if (parts.Count > 0) return string.Join(" | ", parts);
            }
        }
        catch { }
        return $"{Traductor.T("FLOW_WHEN")} #{index}";
    }

    /// <summary>
    /// Mermaid handles long node labels poorly (auto-layout breaks at extreme
    /// widths). Trim raw VHDL lines past <paramref name="max"/> chars and
    /// append an ellipsis so the diagram stays readable.
    /// </summary>
    private static string Truncate(string s, int max = 64)
    {
        if (string.IsNullOrEmpty(s)) return s;
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", " ").Trim();
        return s.Length <= max ? s : s.Substring(0, max - 1) + "…";
    }

    /// <summary>
    /// Escapes a label for safe interpolation into Mermaid source while
    /// preserving the original VHDL glyphs in the rendered SVG. Every call site
    /// wraps the result in a double-quoted Mermaid label ("..."), which protects
    /// the shape delimiters ([], {}, (), {{}}) and most special characters.
    ///
    /// Mermaid renders with htmlLabels:FALSE (so labels are native SVG &lt;text&gt;
    /// and survive the PNG/SVG export sanitiser, which strips &lt;foreignObject&gt;).
    /// In that mode two earlier approaches fail:
    ///   • Unicode lookalikes (`‹`, `❨`, …) mangle VHDL (<c>q0 ‹= '0'</c>).
    ///   • The HTML-entity sentinel form (<c>#lt;</c>, <c>#40;</c>, <c>#quot;</c>)
    ///     is NOT HTML-decoded for SVG text; worse, the <c>#\w+;</c> pattern
    ///     triggers Mermaid's encodeEntities roundtrip, which double-escapes the
    ///     '&amp;' in a neighbouring <c>&amp;quot;</c> — so quotes export as the
    ///     literal text <c>&amp;quot;</c>.
    /// So emit the characters RAW: inside a quoted label Mermaid renders (), [],
    /// {}, |, &lt; and &gt; faithfully as native SVG text. Only two need escaping,
    /// and only via '&amp;' entities (never '#' sentinels, which would re-trigger
    /// the roundtrip): '&amp;' → &amp;amp; (a raw '&amp;' can swallow following
    /// text as a stray entity) and '"' → &amp;quot; (a raw '"' would close the
    /// quoted label). Both then render as real glyphs. Verified in-browser against
    /// the bundled Mermaid build across VHDL assignments, concatenation and
    /// std_logic_vector literals.
    /// </summary>
    private static string Esc(string s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        // Trim the original trailing ';' first (before the entities below add
        // their own), so a VHDL statement terminator doesn't clutter the label.
        s = s.Replace("\r", "").Replace("\n", " ").TrimEnd(';');
        // Order matters: escape '&' before introducing '&quot;' so the latter's
        // ampersand is not re-escaped into '&amp;quot;'.
        return s
            .Replace("&", "&amp;")
            .Replace("\"", "&quot;");
    }

    /// <summary>Mutable counter used to generate unique node ids per render pass.</summary>
    private class IdCounter
    {
        private int _i;
        public string Next(string prefix) => $"{prefix}{++_i}";
    }
}
