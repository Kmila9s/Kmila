@*
    EditorDock — the bottom dock on the Editor page.

    Renders a horizontal tab strip over five slots (Entities · Ports ·
    Waveforms · Files · Output). Active tab and collapsed state live in the
    scoped <see cref="EditorDockState"/> service so other components (e.g. a
    future Run button) can focus a tab programmatically.

    Persistence (Chunk 2): the user's last-selected tab and collapsed flag
    are mirrored to localStorage and restored on first render. Opening a
    project in a fresh browser lands on Entities.

    Each tab can carry an indicator — a count pill (Entities, Files) or a
    ready dot (Waveforms has data, Output has new lines).
*@
@implements IDisposable
@inject EditorDockState DockState

<section class="kmila-dock @(DockState.IsCollapsed ? "kmila-dock--collapsed" : "")"
         role="tablist"
         aria-label="@Traductor.T("EDITOR_DOCK_ARIA")"
         style="@(DockState.IsCollapsed
             ? "--kmila-dock-height: auto; height: auto; min-height: 0;"
             : $"--kmila-dock-height: {DockState.Height}px;")">

    @* Drag handle — pointer-events on the grabber change the dock height live;
       DockState persists to localStorage via the EditorDock's OnAfterRender. *@
    <div class="kmila-dock__grabber"
         role="separator"
         aria-orientation="horizontal"
         aria-label="@Traductor.T("DOCK_RESIZE_ARIA")"
         @onpointerdown="OnGrabberDown"></div>

    <nav class="kmila-dock__tabs">
        @foreach (var tab in _tabs)
        {
            var isActive = DockState.Active == tab.Id;
            <button type="button"
                    role="tab"
                    aria-selected="@isActive"
                    aria-controls="@($"dock-panel-{tab.Id}")"
                    id="@($"dock-tab-{tab.Id}")"
                    class="kmila-btn-tab kmila-btn-tab--accent kmila-dock__tab @(isActive ? "is-active" : "")"
                    @onclick="() => OnTabClickAsync(tab.Id)">
                <Icon Name="@tab.Icon" />
                <span class="kmila-dock__tab-label">@Traductor.T(tab.LabelKey)</span>
                @{ var count = CountFor(tab.Id); var ready = ReadyFor(tab.Id); }
                @if (count > 0)
                {
                    <span class="kmila-dock__count"
                          title="@string.Format(Traductor.T("EDITOR_DOCK_COUNT_TOOLTIP"), count, Traductor.T(tab.LabelKey))">@count</span>
                }
                else if (ready)
                {
                    <span class="kmila-dock__dot" aria-hidden="true"></span>
                }
            </button>
        }
    </nav>

    @* Collapse toggle lives outside .kmila-dock__tabs so it stays reachable
       even when 8 tabs overflow the strip horizontally on phones. CSS pins
       it absolutely to the top-right of .kmila-dock. *@
    <button type="button"
            class="kmila-dock__collapse"
            @onclick="ToggleCollapsedAsync"
            aria-expanded="@(!DockState.IsCollapsed)"
            aria-controls="dock-panel"
            aria-label="@Traductor.T(DockState.IsCollapsed ? "DOCK_EXPAND" : "DOCK_COLLAPSE")"
            title="@Traductor.T(DockState.IsCollapsed ? "DOCK_EXPAND" : "DOCK_COLLAPSE")">
        <Icon Name="@(DockState.IsCollapsed ? IconName.ChevronUp : IconName.ChevronDown)" />
    </button>

    <div class="kmila-dock__panel kmila-dock__panel--@DockState.Active.ToString().ToLowerInvariant()"
         id="dock-panel"
         role="tabpanel"
         aria-labelledby="@($"dock-tab-{DockState.Active}")"
         hidden="@DockState.IsCollapsed">
        @switch (DockState.Active)
        {
            case EditorTab.Entities:
                @if (EntitiesContent != null) { @EntitiesContent }
                else { @RenderEmpty(IconName.Diagram3, "EDITOR_EMPTY_ENTITIES") }
                break;
            case EditorTab.Schematic:
                @if (SchematicContent != null) { @SchematicContent }
                else { @RenderEmpty(IconName.Diagram3, "EDITOR_EMPTY_SCHEMATIC") }
                break;
            case EditorTab.Flow:
                @if (FlowContent != null) { @FlowContent }
                else { @RenderEmpty(IconName.Diagram2, "EDITOR_EMPTY_FLOW") }
                break;
            case EditorTab.Ports:
                @if (PortsContent != null) { @PortsContent }
                else { @RenderEmpty(IconName.Plugin, "EDITOR_EMPTY_PORTS") }
                break;
            case EditorTab.Waveforms:
                @if (WaveformsContent != null) { @WaveformsContent }
                else { @RenderEmpty(IconName.GraphUp, "EDITOR_EMPTY_WAVEFORMS") }
                break;
            case EditorTab.Runs:
                @if (RunsContent != null) { @RunsContent }
                else { @RenderEmpty(IconName.ClockHistory, "EDITOR_EMPTY_RUNS") }
                break;
            case EditorTab.Replay:
                // Replay was promoted to a sibling tab of the editor card.
                // Falling through with an empty render — if localStorage
                // hydrates this value, the user clicks any visible tab and
                // the layout resolves itself.
                @RenderEmpty(IconName.PlayCircle, "EDITOR_REPLAY_MOVED")
                break;
            case EditorTab.Files:
                @if (FilesContent != null) { @FilesContent }
                else { @RenderEmpty(IconName.Folder2Open, "EDITOR_EMPTY_FILES") }
                break;
            case EditorTab.Output:
                @if (OutputContent != null) { @OutputContent }
                else { @RenderEmpty(IconName.TerminalFill, "EDITOR_EMPTY_OUTPUT") }
                break;
        }
    </div>
</section>

@code {
    [Parameter] public RenderFragment? EntitiesContent { get; set; }
    [Parameter] public RenderFragment? SchematicContent { get; set; }
    [Parameter] public RenderFragment? FlowContent { get; set; }
    [Parameter] public RenderFragment? PortsContent { get; set; }
    [Parameter] public RenderFragment? WaveformsContent { get; set; }
    [Parameter] public RenderFragment? RunsContent { get; set; }
    // ReplayContent deliberately removed — see editor-workbench__view-tabs
    // in Editor.razor for the Step Replay surface's new home.
    [Parameter] public RenderFragment? FilesContent { get; set; }
    [Parameter] public RenderFragment? OutputContent { get; set; }

    /// <summary>Count shown as a pill next to the tab label (e.g. entity count).</summary>
    [Parameter] public int EntitiesCount { get; set; }
    [Parameter] public int FilesCount { get; set; }
    [Parameter] public int RunsCount { get; set; }

    /// <summary>Ready indicator (small dot) shown when count isn't useful but the tab has data.</summary>
    [Parameter] public bool WaveformsReady { get; set; }
    [Parameter] public bool OutputReady { get; set; }

    private record TabDef(EditorTab Id, IconName Icon, string LabelKey);

    private static readonly TabDef[] _tabs = new[]
    {
        new TabDef(EditorTab.Entities,  IconName.Diagram3Fill,     "EDITOR_ENTITIES"),
        new TabDef(EditorTab.Schematic, IconName.Diagram3,     "EDITOR_SCHEMATIC"),
        new TabDef(EditorTab.Flow,      IconName.Diagram2,         "EDITOR_FLOW"),
        new TabDef(EditorTab.Ports,     IconName.Plugin,           "EDITOR_TAB_PORTS"),
        new TabDef(EditorTab.Waveforms, IconName.GraphUp,          "EDITOR_WAVEFORMS"),
        new TabDef(EditorTab.Runs,      IconName.ClockHistory,     "EDITOR_TAB_RUNS"),
        // EditorTab.Replay deliberately omitted (2026-05-19, follow-up 3):
        // Step Replay was promoted to a sibling tab of the Monaco editor in
        // the editor card itself. Enum value stays for back-compat with any
        // hydrated localStorage values; the case branch below falls through
        // to the entities default.
        new TabDef(EditorTab.Files,     IconName.Folder2Open,      "EDITOR_FILES"),
        new TabDef(EditorTab.Output,    IconName.TerminalFill,     "EDITOR_TAB_OUTPUT")
    };

    private const string TAB_KEY       = "kmila-dock-tab";
    private const string COLLAPSED_KEY = "kmila-dock-collapsed";
    private const string HEIGHT_KEY    = "kmila-dock-height";
    private bool _hydrated;

    // Reused across drag sessions — the previous implementation called
    // DotNetObjectReference.Create on every pointerdown without disposing,
    // leaking the component instance into JS-side roots after each drag.
    private Microsoft.JSInterop.DotNetObjectReference<EditorDock>? _selfRef;

    /// <summary>
    /// Mouse/pointer drag start on the grabber. Subsequent moves write the
    /// new height into <see cref="EditorDockState"/> via a JS helper; on
    /// release we persist the final value.
    /// </summary>
    private async Task OnGrabberDown(Microsoft.AspNetCore.Components.Web.PointerEventArgs e)
    {
        try
        {
            _selfRef ??= Microsoft.JSInterop.DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("kmilaDockDragStart", _selfRef, e.ClientY);
        }
        catch { /* JS missing — no-op */ }
    }

    /// <summary>Called from JS during drag with the current delta (px).</summary>
    [Microsoft.JSInterop.JSInvokable]
    public Task OnGrabberMove(int newHeight)
    {
        DockState.SetHeight(newHeight);
        return Task.CompletedTask;
    }

    /// <summary>Called from JS on pointer-up — persists the final height.</summary>
    [Microsoft.JSInterop.JSInvokable]
    public async Task OnGrabberUp()
    {
        await PersistAsync();
    }

    protected override void OnInitialized()
    {
        DockState.OnChange += OnStateChanged;
        Traductor.StaticOnLangChanged += OnStateChanged;
    }

    /// <summary>
    /// After the first render we have JS available, so we can read the last
    /// tab + collapse state from localStorage and rehydrate the service.
    /// Subsequent state changes write back to localStorage.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hydrated) return;
        _hydrated = true;

        try
        {
            var tabStr      = await JS.InvokeAsync<string?>("localStorage.getItem", TAB_KEY);
            var collapsedStr = await JS.InvokeAsync<string?>("localStorage.getItem", COLLAPSED_KEY);
            var heightStr    = await JS.InvokeAsync<string?>("localStorage.getItem", HEIGHT_KEY);

            EditorTab? tab = Enum.TryParse<EditorTab>(tabStr, out var parsed) ? parsed : null;
            var collapsed = string.Equals(collapsedStr, "true", StringComparison.OrdinalIgnoreCase);
            int? height = int.TryParse(heightStr, out var h) ? h : null;

            if (tab.HasValue || collapsed || height.HasValue)
            {
                DockState.HydrateFromStorage(tab, collapsed, height);
                StateHasChanged();
            }
        }
        catch
        {
            // localStorage may be blocked (private mode, sandboxed iframe) —
            // fall back to the in-memory default silently.
        }

        // SQLite default overrides localStorage. Outside the localStorage
        // try-catch so a JS-blocked WebView (which throws on getItem) still
        // applies the user's persisted preference. Fires SetActive (not
        // Hydrate) so the accent indicator and dock body re-render to the
        // pref tab. Used by automation harnesses to drive the editor onto
        // a specific view via SQLite-seed without simulating dock-tab taps.
        try
        {
            var savedDefault = await DbContext.GetSettingAsync(AppSettings.KEY_DEFAULT_DOCK_TAB);
            if (!string.IsNullOrWhiteSpace(savedDefault) &&
                Enum.TryParse<EditorTab>(savedDefault, ignoreCase: true, out var pref))
            {
                DockState.SetActive(pref);
                await PersistAsync();
                StateHasChanged();
            }
        }
        catch { /* DB unavailable — fall back to in-memory default */ }
    }

    private async Task PersistAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", TAB_KEY, DockState.Active.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", COLLAPSED_KEY, DockState.IsCollapsed ? "true" : "false");
            await JS.InvokeVoidAsync("localStorage.setItem", HEIGHT_KEY, DockState.Height.ToString());
        }
        catch { /* see OnAfterRenderAsync */ }
    }

    private async Task ToggleCollapsedAsync()
    {
        DockState.ToggleCollapsed();
        await PersistAsync();
    }

    // On phones the dock defaults to a peek state with the panel hidden, so
    // a plain SetActive looks broken — the user taps a tab and nothing visible
    // changes. Auto-snap to half on the first tap and toggle back to peek when
    // the active tab is tapped again, so the dock behaves like a bottom sheet.
    private async Task OnTabClickAsync(EditorTab id)
    {
        var wasActive = DockState.Active == id && !DockState.IsCollapsed;
        DockState.SetActive(id);
        try
        {
            await JS.InvokeVoidAsync("kmilaDockToggleForTab", wasActive);
        }
        catch { /* JS missing — no-op */ }
    }

    private void OnStateChanged()
    {
        // Persist lazily on any state change — fire-and-forget is fine here,
        // the write is idempotent and tiny.
        _ = PersistAsync();
        InvokeAsync(StateHasChanged);
    }

    private int CountFor(EditorTab t) => t switch
    {
        EditorTab.Entities => EntitiesCount,
        EditorTab.Files    => FilesCount,
        EditorTab.Runs     => RunsCount,
        _                  => 0
    };

    private bool ReadyFor(EditorTab t) => t switch
    {
        EditorTab.Waveforms => WaveformsReady,
        EditorTab.Output    => OutputReady,
        _                   => false
    };

    public void Dispose()
    {
        DockState.OnChange -= OnStateChanged;
        Traductor.StaticOnLangChanged -= OnStateChanged;
        _selfRef?.Dispose();
        _selfRef = null;
    }

    private RenderFragment RenderEmpty(IconName icon, string key) => @<div class="kmila-dock__empty">
        <div class="kmila-dock__empty-icon"><Icon Name="@icon" /></div>
        <p>@Traductor.T(key)</p>
    </div>;
}
