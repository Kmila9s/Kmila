@*
    ExecutionPlayer — the Concepts track's keystone widget.

    Renders a read-only Monaco editor + a tape transport + a live signal
    table, driven by a pre-recorded execution timeline (ExecutionTimelineDoc).
    The component is fully self-contained: pass it a Doc and a Lang, and it
    handles playback, line highlights via JS interop, and value-change pulses.

    Why pre-recorded: see Documentacion/ROADMAP_concurrent_execution_module.md.
    Phase 1 hardcodes the timelines so each step carries a teaching note and
    we sidestep instrumenting the live simulator.
*@

@implements IDisposable

<div class="kmila-exec-player" @onkeydown="OnKeyDown" tabindex="0">
    <div class="kmila-exec-player__code">
        <div class="kmila-exec-monaco">
            <StandaloneCodeEditor @ref="_monaco"
                                  ConstructionOptions="EditorOptions"
                                  OnDidInit="OnMonacoInitAsync" />
        </div>

        <div class="kmila-exec-tape" role="group" aria-label="@Traductor.T("CONCEPTS_PLAYER_TAPE_LABEL")">
            <div class="kmila-exec-tape__progress">
                <span>@(_runner.CurrentIndex + 1) / @TotalSteps</span>
                <div class="kmila-exec-tape__progress-track">
                    <div class="kmila-exec-tape__progress-fill" style="width: @ProgressPct%"></div>
                </div>
                <span>@StepLabel</span>
            </div>

            <button type="button" class="kmila-btn-icon"
                    title="@Traductor.T("CONCEPTS_PLAYER_RESTART")"
                    aria-label="@Traductor.T("CONCEPTS_PLAYER_RESTART")"
                    @onclick="OnRestart">
                <Icon Name="IconName.ArrowCounterclockwise" />
            </button>
            <button type="button" class="kmila-btn-icon"
                    title="@Traductor.T("CONCEPTS_PLAYER_STEP_BACK")"
                    aria-label="@Traductor.T("CONCEPTS_PLAYER_STEP_BACK")"
                    disabled="@(_runner.CurrentIndex == 0)"
                    @onclick="OnStepBack">
                <Icon Name="IconName.SkipStart" />
            </button>
            @if (_runner.IsPlaying)
            {
                <button type="button" class="kmila-btn-icon kmila-btn-icon--accent"
                        title="@Traductor.T("CONCEPTS_PLAYER_PAUSE")"
                        aria-label="@Traductor.T("CONCEPTS_PLAYER_PAUSE")"
                        @onclick="OnPause">
                    <Icon Name="IconName.PauseFill" />
                </button>
            }
            else
            {
                <button type="button" class="kmila-btn-icon kmila-btn-icon--accent"
                        title="@Traductor.T("CONCEPTS_PLAYER_PLAY")"
                        aria-label="@Traductor.T("CONCEPTS_PLAYER_PLAY")"
                        @onclick="OnPlay">
                    <Icon Name="IconName.PlayFill" />
                </button>
            }
            <button type="button" class="kmila-btn-icon"
                    title="@Traductor.T("CONCEPTS_PLAYER_STEP_FORWARD")"
                    aria-label="@Traductor.T("CONCEPTS_PLAYER_STEP_FORWARD")"
                    disabled="@_runner.IsAtEnd"
                    @onclick="OnStepForward">
                <Icon Name="IconName.SkipEnd" />
            </button>

            <label class="kmila-exec-tape__speed">
                @Traductor.T("CONCEPTS_PLAYER_SPEED")
                <select value="@_speedKey" @onchange="OnSpeedChanged">
                    <option value="0.5">0.5×</option>
                    <option value="1">1×</option>
                    <option value="2">2×</option>
                </select>
            </label>
        </div>
    </div>

    <div class="kmila-exec-player__side">
        <div class="kmila-exec-signals" aria-label="@Traductor.T("CONCEPTS_PLAYER_SIGNALS")">
            <div class="kmila-exec-signals__header">@Traductor.T("CONCEPTS_PLAYER_SIGNALS")</div>
            <table class="kmila-exec-signals__table">
                <tbody>
                    @foreach (var name in OrderedSignalNames())
                    {
                        var value = _runner.CurrentStep.Signals.TryGetValue(name, out var v) ? v : "—";
                        var changed = HasChanged(name, value);
                        <tr>
                            <th scope="row">@name</th>
                            <td>
                                <span class="kmila-exec-signals__value @(changed ? "kmila-exec-signals__value--changed" : "")">
                                    @value
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="kmila-exec-player__note" role="status" aria-live="polite">
            @if (!string.IsNullOrEmpty(_currentNote))
            {
                @_currentNote
            }
            else
            {
                <span class="kmila-exec-player__note-empty">@Traductor.T("CONCEPTS_PLAYER_NOTE_EMPTY")</span>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Timeline to play. Swapping documents resets the runner.</summary>
    [Parameter, EditorRequired] public ExecutionTimelineDoc Doc { get; set; } = new();

    /// <summary>Current UI language — drives which <c>note</c> string we render.</summary>
    [Parameter] public string Lang { get; set; } = "en";

    /// <summary>Fired once when autoplay reaches the last step.</summary>
    [Parameter] public EventCallback OnPlaybackComplete { get; set; }

    private readonly TimelineRunner _runner = new();
    private StandaloneCodeEditor? _monaco;
    private bool _monacoReady;
    private ExecutionTimelineDoc? _lastLoaded;
    private string _speedKey = "1";
    private Dictionary<string, string> _previousSignals = new();
    private string _currentNote = string.Empty;

    private int TotalSteps => Math.Max(_runner.Document.Steps.Count, 1);
    private int ProgressPct =>
        _runner.Document.Steps.Count <= 1
            ? 100
            : (int)Math.Round(100.0 * (_runner.CurrentIndex) / (_runner.Document.Steps.Count - 1));

    private string StepLabel =>
        _runner.Document.Steps.Count == 0
            ? string.Empty
            : $"t = {_runner.CurrentStep.T}";

    protected override void OnInitialized()
    {
        _runner.OnTick += OnRunnerTick;
        _runner.OnComplete += OnRunnerComplete;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reseed when the parent swaps to a different timeline document. We
        // compare by reference because the catalog caches deserialised docs,
        // so the same doc => same object identity.
        if (!ReferenceEquals(Doc, _lastLoaded))
        {
            _lastLoaded = Doc;
            _previousSignals = new();
            _runner.Load(Doc ?? new ExecutionTimelineDoc());

            if (_monacoReady && _monaco != null)
            {
                try
                {
                    await _monaco.SetValue(_runner.Document.Code);
                }
                catch { /* tolerated; first render path is via EditorOptions.Value */ }
                await PushHighlightsAsync();
            }
            UpdateCurrentNote();
        }
    }

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor) =>
        new()
        {
            AutomaticLayout = true,
            Language = string.IsNullOrEmpty(Doc?.Language) ? "vhdl" : Doc.Language,
            Value = Doc?.Code ?? string.Empty,
            ReadOnly = true,
            FontSize = 14,
            ScrollBeyondLastLine = false,
            Minimap = new EditorMinimapOptions { Enabled = false },
        };

    private async Task OnMonacoInitAsync()
    {
        _monacoReady = true;
        try
        {
            var bsTheme = await JS.InvokeAsync<string?>(
                "document.documentElement.getAttribute", "data-bs-theme");
            await BlazorMonaco.Editor.Global.SetTheme(JS, bsTheme == "dark" ? "vs-dark" : "vs");
        }
        catch { /* prerender / WebView boot — fine */ }

        // Seed the buffer in case OnParametersSetAsync ran before Monaco was
        // ready — EditorOptions.Value handles the first paint but a parent
        // can swap Doc before OnDidInit fires.
        if (_monaco != null && !string.IsNullOrEmpty(_runner.Document.Code))
        {
            try { await _monaco.SetValue(_runner.Document.Code); } catch { }
        }
        await PushHighlightsAsync();
        UpdateCurrentNote();
        StateHasChanged();
    }

    private void OnRunnerTick()
    {
        UpdateCurrentNote();
        InvokeAsync(async () =>
        {
            await PushHighlightsAsync();
            StateHasChanged();
        });
    }

    private void OnRunnerComplete()
    {
        if (OnPlaybackComplete.HasDelegate)
        {
            InvokeAsync(() => OnPlaybackComplete.InvokeAsync());
        }
    }

    private async Task PushHighlightsAsync()
    {
        if (!_monacoReady) return;
        try
        {
            var lines = _runner.CurrentStep.HighlightLines ?? new List<int>();
            await JS.InvokeVoidAsync("kmilaExecHighlightLines", lines);
        }
        catch
        {
            // JS not available during prerender — the next tick will succeed.
        }
    }

    private void UpdateCurrentNote()
    {
        var notes = _runner.CurrentStep.Note;
        _currentNote = ConceptCatalog.Localize(notes, Lang, string.Empty);
    }

    private void OnPlay()
    {
        // Snapshot signals as "previous" so the next tick's pulse highlights
        // only the values that change *from this moment*.
        SnapshotSignals();
        _runner.Play();
    }

    private void OnPause() => _runner.Pause();

    private void OnRestart()
    {
        SnapshotSignals();
        _runner.Restart();
    }

    private void OnStepForward()
    {
        SnapshotSignals();
        _runner.StepForward();
    }

    private void OnStepBack()
    {
        SnapshotSignals();
        _runner.StepBack();
    }

    private void OnSpeedChanged(ChangeEventArgs e)
    {
        _speedKey = e.Value?.ToString() ?? "1";
        if (double.TryParse(_speedKey, System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var x))
        {
            _runner.Speed = x;
        }
    }

    private void SnapshotSignals()
    {
        _previousSignals = new Dictionary<string, string>(_runner.CurrentStep.Signals);
    }

    /// <summary>
    /// True when the signal's value differs from the snapshot taken at the
    /// previous step boundary. Drives the value-pulse animation; doubles as
    /// "what changed this step" for students scanning the table.
    /// </summary>
    private bool HasChanged(string name, string value)
    {
        if (!_previousSignals.TryGetValue(name, out var prev)) return false;
        return !string.Equals(prev, value, StringComparison.Ordinal);
    }

    /// <summary>
    /// Renders signals in the order specified by <c>signalOrder</c> on the
    /// document, falling back to first-step insertion order when not set.
    /// </summary>
    private IEnumerable<string> OrderedSignalNames()
    {
        if (_runner.Document.SignalOrder.Count > 0)
            return _runner.Document.SignalOrder;
        if (_runner.Document.Steps.Count > 0)
            return _runner.Document.Steps[0].Signals.Keys;
        return Enumerable.Empty<string>();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        // Keyboard shortcuts are best-effort: when Monaco has focus it eats
        // these keys. They work when the wrapping <div> has focus, e.g. after
        // clicking on the signal table or note.
        switch (e.Key)
        {
            case " ":
            case "Spacebar":
                if (_runner.IsPlaying) OnPause(); else OnPlay();
                break;
            case "ArrowRight":
                OnStepForward();
                break;
            case "ArrowLeft":
                OnStepBack();
                break;
            case "r":
            case "R":
                OnRestart();
                break;
        }
    }

    public void Dispose()
    {
        _runner.OnTick -= OnRunnerTick;
        _runner.OnComplete -= OnRunnerComplete;
        _runner.Pause();
    }
}
