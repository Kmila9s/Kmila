@*
    FPGATabContent Component

    Presentation-only sub-component for the FPGA tab in SimulationParametersModal.
    Displays FPGA selection, device details, and resource utilization analysis.
    All state and event handlers remain in the parent component.
*@

<div class="tab-content-wrapper p-2 p-md-3">
    <!-- FPGA Selector Fallback (when no FPGA is selected in TopBar) -->
    @if(FPGADevice == null)
    {
        <Card Class="mb-3 border-warning">
            <CardHeader Class="py-2 py-md-3 bg-warning bg-opacity-10">
                <Icon Name="IconName.ExclamationTriangle" Class="me-2 text-warning" />
                <strong>Select FPGA Device</strong>
            </CardHeader>
            <CardBody Class="p-2 p-md-3">
                <p class="text-muted small mb-3">
                    No FPGA device is currently selected. Choose a device to view specifications and run simulations.
                </p>
                <div class="row g-2">
                    <div class="col-12 col-md-8">
                        <select class="form-select form-select-sm" @onchange="OnFPGASelected" value="@SelectedFPGAPath">
                            <option value="">-- Select FPGA Device --</option>
                            @foreach(var fpga in AvailableFPGAs)
                            {
                                <option value="@fpga">@System.IO.Path.GetFileNameWithoutExtension(fpga)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <Button Color="ButtonColor.Primary"
                                Size="ButtonSize.Small"
                                Outline="true"
                                Disabled="@(string.IsNullOrEmpty(SelectedFPGAPath))"
                                @onclick="OnApplyFPGA"
                                Class="w-100">
                            <Icon Name="IconName.CheckCircle" Class="me-1" />
                            Apply
                        </Button>
                    </div>
                </div>
            </CardBody>
        </Card>
    }

    <!-- FPGA Information Section -->
    <Card Class="mb-3">
        <CardHeader Class="py-2 py-md-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <Icon Name="IconName.Cpu" Class="me-2" />
                    <strong>FPGA Details</strong>
                </div>
                @if(FPGADevice != null)
                {
                    <!-- Quick FPGA Change Dropdown -->
                    <Dropdown Color="DropdownColor.Secondary" Size="DropdownSize.Small">
                        <DropdownToggleButton>
                            <Icon Name="IconName.ArrowRepeat" Class="me-1" />
                            Change
                        </DropdownToggleButton>
                        <DropdownMenu>
                            @foreach(var fpga in AvailableFPGAs)
                            {
                                var fpgaItem = fpga;
                                <DropdownItem Type="DropdownItemType.Button"
                                              @onclick="() => OnQuickChangeFPGA.InvokeAsync(fpgaItem)"
                                              Active="@(SelectedFPGAPath == fpgaItem)">
                                    @System.IO.Path.GetFileNameWithoutExtension(fpgaItem)
                                </DropdownItem>
                            }
                        </DropdownMenu>
                    </Dropdown>
                }
            </div>
        </CardHeader>
        <CardBody Class="p-2 p-md-3">
            @if(FPGADevice != null)
            {
                <div class="row g-2 g-md-3">
                    <!-- FPGA Basic Info -->
                    <div class="col-12">
                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                            <div>
                                <h5 class="mb-0 fs-6 fs-md-5">@FPGADevice.Model</h5>
                                <small class="text-muted">@FPGADevice.Family</small>
                            </div>
                            <Badge Color="BadgeColor.Primary">@FPGADevice.Manufacturer</Badge>
                        </div>
                    </div>

                    <!-- FPGA Resources Grid - 2 columns on mobile, 4 on desktop -->
                    @if(FPGADevice.Resources != null)
                    {
                        <div class="col-6 col-md-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.Cpu" Class="me-1 me-md-2" />
                                    <strong class="small">Logic Units</strong>
                                </div>
                                <div class="text-muted small text-truncate">
                                    @FPGADevice.Resources.LogicUnits?.ToString("N0") @FPGADevice.Resources.LogicUnitsType
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.Memory" Class="me-1 me-md-2" />
                                    <strong class="small">Memory</strong>
                                </div>
                                <div class="text-muted small text-truncate">
                                    @FPGADevice.Resources.MemoryTotalKbits?.ToString("N0") Kbits
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.ToggleOn" Class="me-1 me-md-2" />
                                    <strong class="small">Flip-Flops</strong>
                                </div>
                                <div class="text-muted small text-truncate">
                                    @FPGADevice.Resources.RegistersFlipFlops?.ToString("N0") FF
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.Calculator" Class="me-1 me-md-2" />
                                    <strong class="small">DSP Slices</strong>
                                </div>
                                <div class="text-muted small text-truncate">
                                    @FPGADevice.Resources.DspSlices @FPGADevice.Resources.DspSliceType
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Clocking Info -->
                    @if(FPGADevice.Clocking != null)
                    {
                        <div class="col-6 col-md-4">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.Clock" Class="me-1 me-md-2" />
                                    <strong class="small">Max Clock</strong>
                                </div>
                                <div class="text-muted small">
                                    @FPGADevice.Clocking.MaxPllOutputMhz MHz
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.Diagram3" Class="me-1 me-md-2" />
                                    <strong class="small">Clock Res.</strong>
                                </div>
                                <div class="text-muted small">
                                    @FPGADevice.Clocking.PllCount PLL / @FPGADevice.Clocking.DcmMmcmCount DCM
                                </div>
                            </div>
                        </div>
                    }

                    <!-- I/O Info -->
                    @if(FPGADevice.IO != null)
                    {
                        <div class="col-6 col-md-4">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.Plugin" Class="me-1 me-md-2" />
                                    <strong class="small">I/O Pins</strong>
                                </div>
                                <div class="text-muted small">
                                    @FPGADevice.IO.MaxUserIO (@FPGADevice.IO.IoBanksCount banks)
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Power Info -->
                    @if(FPGADevice.Power != null)
                    {
                        <div class="col-6 col-md-12">
                            <div class="border rounded p-2">
                                <div class="d-flex align-items-center mb-1">
                                    <Icon Name="IconName.Lightning" Class="me-1 me-md-2" />
                                    <strong class="small">Core Voltage</strong>
                                </div>
                                <div class="text-muted small">
                                    @FPGADevice.Power.CoreVoltageVccintV V (VCCINT)
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <Alert Color="AlertColor.Warning">
                    <Icon Name="IconName.ExclamationTriangle" Class="me-2" />
                    No FPGA selected. Please select an FPGA to view its specifications.
                </Alert>
            }
        </CardBody>
    </Card>

    <!-- Resource Usage Analysis -->
    @if(FPGADevice != null && HasEntities)
    {
        <Card Class="mb-3">
            <CardHeader Class="py-2 py-md-3">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                    <div>
                        <Icon Name="IconName.Speedometer" Class="me-2" />
                        <strong>Resource Utilization</strong>
                    </div>
                    @if(ResourcesExceeded)
                    {
                        <Badge Color="BadgeColor.Danger" Pill="true">
                            <Icon Name="IconName.ExclamationTriangleFill" Class="me-1" />
                            Exceeded
                        </Badge>
                    }
                    else if(ResourcesNearLimit)
                    {
                        <Badge Color="BadgeColor.Warning" Pill="true">
                            <Icon Name="IconName.ExclamationTriangle" Class="me-1" />
                            Near Limit
                        </Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Success" Pill="true">
                            <Icon Name="IconName.CheckCircle" Class="me-1" />
                            OK
                        </Badge>
                    }
                </div>
            </CardHeader>
            <CardBody Class="p-2 p-md-3">
                @if(ResourcesExceeded)
                {
                    <Alert Color="AlertColor.Danger" Class="mb-3 small">
                        <Icon Name="IconName.ExclamationTriangleFill" Class="me-2" />
                        <strong>Cannot start!</strong> Design exceeds FPGA resources.
                    </Alert>
                }
                else if(ResourcesNearLimit)
                {
                    <Alert Color="AlertColor.Warning" Class="mb-3 small">
                        <Icon Name="IconName.ExclamationTriangle" Class="me-2" />
                        <strong>Warning:</strong> Near FPGA limits.
                    </Alert>
                }

                <div class="row g-2">
                    <!-- Flip-Flops Progress -->
                    @if(FPGADevice.Resources?.RegistersFlipFlops != null && FPGADevice.Resources.RegistersFlipFlops > 0)
                    {
                        <ResourceProgressBar Title="Flip-Flops"
                                             Icon="IconName.ToggleOn"
                                             Used="FlipFlopsUsed"
                                             Available="FPGADevice.Resources.RegistersFlipFlops.Value" />
                    }

                    <!-- LUTs Progress -->
                    @if(FPGADevice.Resources?.LogicUnits != null && FPGADevice.Resources.LogicUnits > 0)
                    {
                        <ResourceProgressBar Title="@(FPGADevice.Resources.LogicUnitsType ?? "LUTs")"
                                             Icon="IconName.Grid"
                                             Used="LUTsUsed"
                                             Available="FPGADevice.Resources.LogicUnits.Value" />
                    }

                    <!-- DSP Slices Progress -->
                    @if(FPGADevice.Resources?.DspSlices != null && FPGADevice.Resources.DspSlices > 0)
                    {
                        <ResourceProgressBar Title="DSP Slices"
                                             Icon="IconName.Calculator"
                                             Used="DSPSlicesUsed"
                                             Available="FPGADevice.Resources.DspSlices.Value" />
                    }

                    <!-- BRAM Blocks Progress -->
                    @if(FPGADevice.Resources?.MemoryBlocks != null && FPGADevice.Resources.MemoryBlocks > 0)
                    {
                        <ResourceProgressBar Title="BRAM"
                                             Icon="IconName.Memory"
                                             Used="BRAMBlocksUsed"
                                             Available="FPGADevice.Resources.MemoryBlocks.Value"
                                             FormatString="F1" />
                    }

                    <!-- I/O Pins Progress -->
                    @if(FPGADevice.IO?.MaxUserIO != null && FPGADevice.IO.MaxUserIO > 0)
                    {
                        <ResourceProgressBar Title="I/O Pins"
                                             Icon="IconName.Plugin"
                                             Used="IOPinsUsed"
                                             Available="FPGADevice.IO.MaxUserIO.Value" />
                    }
                </div>
            </CardBody>
        </Card>
    }
</div>

@code {
    [Parameter] public FPGA? FPGADevice { get; set; }
    [Parameter] public string SelectedFPGAPath { get; set; } = string.Empty;
    [Parameter] public List<string> AvailableFPGAs { get; set; } = new();
    [Parameter] public bool ResourcesExceeded { get; set; }
    [Parameter] public bool ResourcesNearLimit { get; set; }
    [Parameter] public int FlipFlopsUsed { get; set; }
    [Parameter] public int LUTsUsed { get; set; }
    [Parameter] public int DSPSlicesUsed { get; set; }
    [Parameter] public double BRAMBlocksUsed { get; set; }
    [Parameter] public int IOPinsUsed { get; set; }
    [Parameter] public bool HasEntities { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnFPGASelected { get; set; }
    [Parameter] public EventCallback OnApplyFPGA { get; set; }
    [Parameter] public EventCallback<string> OnQuickChangeFPGA { get; set; }
}
