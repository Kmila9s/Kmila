@*
    ResourceProgressBar — slim progress bar for FPGA resource utilization.

    Uses our own track markup (a simple div + inner fill) instead of BB's
    <Progress>/<ProgressBar> so we can drive everything through tokens and match
    the rest of the design. Color tier:

      0–59 %   → success  (green)
      60–79 %  → info     (accent blue)
      80–99 %  → warning  (amber)
      100 %+   → danger   (red)

    Layout:
      ┌────────────────────────────────────────────────────────┐
      │  [icon] Flip-Flops            120 / 1,000   (12.0%)    │
      │  ██░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░  │
      └────────────────────────────────────────────────────────┘
*@

@if (Available > 0)
{
    <div class="resource-bar" role="group" aria-label="@Title">
        <div class="resource-bar__head">
            <span class="resource-bar__title">
                <Icon Name="@Icon" />
                <strong>@Title</strong>
            </span>
            <span class="resource-bar__counts">
                <span class="resource-bar__used resource-bar__used--@Tier">@Used.ToString(FormatString)</span>
                <span class="resource-bar__sep">/</span>
                <span class="resource-bar__available">@Available.ToString("N0")</span>
                <span class="resource-bar__percent">(@Percent.ToString("F1")%)</span>
            </span>
        </div>
        <div class="resource-bar__track"
             role="progressbar"
             aria-valuenow="@Percent.ToString("F1")"
             aria-valuemin="0"
             aria-valuemax="100">
            <span class="resource-bar__fill resource-bar__fill--@Tier"
                  style="width: @Percent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%;"></span>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IconName Icon { get; set; }
    [Parameter] public double Used { get; set; }
    [Parameter] public double Available { get; set; }
    [Parameter] public string FormatString { get; set; } = "N0";

    private double Percent => Available > 0 ? Math.Min((Used / Available) * 100, 100) : 0;

    /// <summary>
    /// Color tier driven purely by percentage. The CSS class applies the
    /// corresponding token color to both the numeric `used` text and the fill.
    /// </summary>
    private string Tier => Percent switch
    {
        >= 100 => "danger",
        >= 80  => "warning",
        >= 60  => "info",
        _      => "success"
    };
}
