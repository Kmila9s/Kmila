@page "/editor/{ProjectId}"
@inject Microsoft.Extensions.Logging.ILogger<Kmila.Shared.Pages.Editor> Logger
@using Kmila.Shared.Services
@implements IDisposable
@inject SimulationParameters Sim
@inject BuildLog Log
@inject EditorDockState DockState
@inject Kmila.Shared.Services.RecentProjectsTracker Recent
@inject Kmila.Shared.Services.SimulationSnapshotStore Snapshots
@inject Kmila.Shared.Services.EditorSessionStore Sessions
@inject Kmila.Shared.Services.ReplayState Replay
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
<PageTitle>@string.Format(Traductor.T("EDITOR_PAGE_TITLE"), _project?.Name ?? string.Empty)</PageTitle>
@*
    The outer `<section class="editor-page">` wraps the route unconditionally
    so the `.content:has(.editor-page)` CSS rule (in app.css) can activate
    immediately on navigation, not only after the async project load finishes.
    Without this, the workbench would briefly inherit the 1440px content cap
    until the project record hydrated — visible as a layout jump.
*@
<section class="editor-page">
@if (_projectId != -1 && _project != null)
{

        @* ---------- Workbench: editor + action rail ---------- *@
        <div class="editor-workbench">

            @* Phase B+ (follow-up): editor-card tab strip. Splits the
               workbench between the source-code view and a Step Replay
               view so the debug surface lives next to the editor rather
               than crammed into the bottom dock. Tabs are always present
               (Replay reads as "disabled" until a sim has run / is
               running, but the tab strip itself is constant so the user
               always sees the choice). *@
            <div class="editor-workbench__view-tabs" role="tablist"
                 aria-label="@Traductor.T("EDITOR_VIEW_SWITCH")">
                <button type="button"
                        class="kmila-btn-tab @(_editorCardTab == EditorCardTab.Code ? "is-active" : "")"
                        role="tab" aria-selected="@(_editorCardTab == EditorCardTab.Code ? "true" : "false")"
                        @onclick="() => SwitchEditorCardTabAsync(EditorCardTab.Code)">
                    <Icon Name="IconName.Code" />
                    <span>@Traductor.T("EDITOR_VIEW_CODE")</span>
                </button>
                <button type="button"
                        class="kmila-btn-tab @(_editorCardTab == EditorCardTab.Blocks ? "is-active" : "")"
                        role="tab" aria-selected="@(_editorCardTab == EditorCardTab.Blocks ? "true" : "false")"
                        @onclick="() => SwitchEditorCardTabAsync(EditorCardTab.Blocks)">
                    <Icon Name="IconName.PuzzleFill" />
                    <span>@Traductor.T("EDITOR_VIEW_BLOCKS")</span>
                </button>
                <button type="button"
                        class="kmila-btn-tab @(_editorCardTab == EditorCardTab.Replay ? "is-active" : "")"
                        role="tab" aria-selected="@(_editorCardTab == EditorCardTab.Replay ? "true" : "false")"
                        disabled="@(!Replay.IsLiveActive && Replay.Current == null)"
                        @onclick="() => SwitchEditorCardTabAsync(EditorCardTab.Replay)">
                    <Icon Name="IconName.PlayCircle" />
                    <span>@Traductor.T("EDITOR_VIEW_REPLAY")</span>
                    @if (Replay.IsLiveActive)
                    {
                        <span class="editor-workbench__view-tab-badge @(Replay.IsLivePaused ? "editor-workbench__view-tab-badge--paused" : "editor-workbench__view-tab-badge--live")">
                            @(Replay.IsLivePaused ? "⏸" : "●")
                        </span>
                    }
                </button>
                @* Phase 2 (2026-06-26): the Visual canvas joins Code / Blocks /
                   Replay as a sibling tab. In MAUI native there's no address
                   bar, so /visual/{id} was unreachable; this is now the
                   primary entry point on both targets. The underlying
                   <VisualPanel> is the same component the /visual route
                   renders, just with EmbeddedMode=true so its header bar is
                   suppressed (the editor's breadcrumb + tab row stand in). *@
                <button type="button"
                        class="kmila-btn-tab @(_editorCardTab == EditorCardTab.Visual ? "is-active" : "")"
                        role="tab" aria-selected="@(_editorCardTab == EditorCardTab.Visual ? "true" : "false")"
                        @onclick="() => SwitchEditorCardTabAsync(EditorCardTab.Visual)">
                    <Icon Name="IconName.Cpu" />
                    <span>@Traductor.T("EDITOR_VIEW_VISUAL")</span>
                </button>
            </div>

            @* Code view — existing workbench header + pane(s). Hidden via
               CSS (not unmounted) when the Replay tab is active so Monaco
               keeps its breakpoint glyphs / cursor / scroll across
               tab switches. *@
            <div class="editor-workbench__view editor-workbench__view--code"
                 style="@(_editorCardTab == EditorCardTab.Code ? "" : "display:none")">

            @* File info bar on top of the editor — reflects the FOCUSED
               pane's active tab via the compatibility shims. The Split
               toggle lives at the right end of the status block; only
               visible on wide-enough viewports (CSS-driven). *@
            <header class="editor-workbench__header">
                <div class="editor-file-info">
                    @if (_hasUnsavedChanges)
                    {
                        <span class="editor-unsaved" title="@Traductor.T("EDITOR_UNSAVED")" aria-label="@Traductor.T("EDITOR_UNSAVED")"></span>
                    }
                    <Icon Name="@GetFileIcon()" Class="editor-file-icon" />
                    <span class="editor-file-name @(_openedFile is null ? "editor-file-name--empty" : "")"
                          title="@(_openedFile?.FileName ?? Traductor.T("EDITOR_NO_FILE"))">
                        @(_openedFile?.FileName ?? Traductor.T("EDITOR_NO_FILE"))
                    </span>
                    @if (_openedFile is not null)
                    {
                        <span class="editor-lang-chip">@_currentLanguage</span>
                    }
                </div>

                <div class="editor-status">
                    @* `dir="ltr"` keeps the "Ln 1 · Col 1" pair reading L→R
                       inside RTL languages — without it AR locale flips it to
                       "1 سطر · 1 عمود" with the digits visually preceding the
                       labels, which is confusing at a glance. *@
                    <span class="editor-position" dir="ltr">
                        @Traductor.T("EDITOR_LINE_ABBR") @_cursorLine · @Traductor.T("EDITOR_COL_ABBR") @_cursorColumn
                    </span>
                    <button type="button"
                            class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm editor-split-toggle"
                            @onclick="ToggleSplitAsync"
                            title="@Traductor.T(IsSplit ? "EDITOR_SPLIT_OFF" : "EDITOR_SPLIT_ON")"
                            aria-label="@Traductor.T(IsSplit ? "EDITOR_SPLIT_OFF" : "EDITOR_SPLIT_ON")"
                            aria-pressed="@IsSplit">
                        <Icon Name="@(IsSplit ? IconName.Square : IconName.LayoutSplit)" />
                    </button>
                    <span class="editor-shortcut" aria-hidden="true">
                        <kbd>Ctrl</kbd><kbd>S</kbd>
                    </span>
                </div>
            </header>

            @* Body: one or two side-by-side panes, each with its own tab
               strip + Monaco. Each pane's frame catches click events to
               update the focused-pane index — that's what decides where
               new files open and which pane the workbench header reads
               off. *@
            <div class="editor-workbench__body editor-workbench__body--panes @(IsSplit ? "is-split" : "")">
                @for (int p = 0; p < _panes.Count; p++)
                {
                    var paneIdx = p;
                    var pane = _panes[paneIdx];
                    var paneIsFocused = paneIdx == _focusedPaneIndex;
                    var paneIsMarkdown = pane.ActiveTab?.IsMarkdown ?? false;

                    @* @key keeps Blazor's diff anchored to the pane
                       identity rather than position. Without it, when
                       pane B is removed (unsplit), Blazor sometimes
                       keeps the second <section> stale and pane A
                       doesn't reclaim the space. *@
                    <section @key="paneIdx"
                             class="editor-pane @(paneIsFocused ? "is-focused" : "")"
                             @onclick="() => SetFocusedPane(paneIdx)">

                        <EditorTabStrip Tabs="pane.Tabs"
                                        ActiveIndex="pane.ActiveIndex"
                                        PaneIndex="paneIdx"
                                        OnTabSelect="@((int idx) => ActivateTabAsync(idx, paneIdx))"
                                        OnTabClose="@((int idx) => CloseTabAsync(idx, paneIdx))"
                                        OnTabMove="HandleTabMoveAsync" />

                        @if (paneIsMarkdown)
                        {
                            <div class="editor-split">
                                <div class="editor-split__pane">
                                    <div class="editor-split__header">
                                        <Icon Name="IconName.Eye" />
                                        <span>@Traductor.T("EDITOR_MD_PREVIEW")</span>
                                    </div>
                                    <div class="editor-markdown">
                                        @Kmila.Shared.Services.MarkdownRenderer.Render(pane.ActiveTab?.MarkdownPreview ?? string.Empty)
                                    </div>
                                </div>
                                <div class="editor-split__pane">
                                    <div class="editor-split__header">
                                        <Icon Name="IconName.Code" />
                                        <span>@Traductor.T("EDITOR_MD_SOURCE")</span>
                                    </div>
                                    <StandaloneCodeEditor @ref="pane.Monaco"
                                        CssClass="editor-monaco"
                                        ConstructionOptions="EditorConstructionOptions"
                                        OnDidInit="@(() => OnEditorInitAsync(paneIdx))"
                                        OnDidChangeCursorPosition="OnCursorPositionChanged"
                                        OnDidChangeModelContent="OnModelContentChanged"
                                        OnKeyDown="OnEditorKeyDown" />
                                </div>
                            </div>
                        }
                        else
                        {
                            <StandaloneCodeEditor @ref="pane.Monaco"
                                CssClass="editor-monaco"
                                ConstructionOptions="EditorConstructionOptions"
                                OnDidInit="@(() => OnEditorInitAsync(paneIdx))"
                                OnDidChangeCursorPosition="OnCursorPositionChanged"
                                OnDidChangeModelContent="OnModelContentChanged"
                                OnKeyDown="OnEditorKeyDown" />
                        }
                    </section>
                }
            </div>

            </div> @* /editor-workbench__view--code *@

            @* Blocks view — VHDL author surface (backlog #16). Always
               mounted so the kmila-blocks workspace state survives tab
               switches. Run / build while in this tab emits VHDL into the
               active Monaco buffer first, then falls through to the
               normal pipeline; see <see cref="SyncBlocksToCodeAsync"/>. *@
            <div class="editor-workbench__view editor-workbench__view--blocks"
                 style="@(_editorCardTab == EditorCardTab.Blocks ? "" : "display:none")">
                <BlockEditor @ref="_vhdlBlockEditor"
                             Toolbox="@VhdlBlockEmitter.ToolboxJson" />
            </div>

            @* Step Replay view — sibling tab of Code. Always mounted so its
               internal Monaco / decorations survive tab switches. *@
            <div class="editor-workbench__view editor-workbench__view--replay"
                 style="@(_editorCardTab == EditorCardTab.Replay ? "" : "display:none")">
                <StepReplayPanel />
            </div>

            @* Visual canvas view — Phase 2 4th sibling tab. Lazy-mounted on
               first visit (`_visualVisited` latches true) so the entity
               re-parse + .kviz load only fires when the user opens the
               canvas. After first visit, stays mounted (`display:none`)
               so the coordinator + canvas state survive tab switches. *@
            @if (_visualVisited)
            {
                <div class="editor-workbench__view editor-workbench__view--visual"
                     style="@(_editorCardTab == EditorCardTab.Visual ? "" : "display:none")">
                    <Kmila.Shared.Components.VisualRun.VisualPanel
                        ProjectId="@ProjectId"
                        EmbeddedMode="true" />
                </div>
            }

        </div>

        @* ---------- Run bar ---------- *@
        <RunBar OnBuildClicked="OnBuildRequested"
                OnRunClicked="OnRunRequested"
                OnPauseClicked="OnPauseSimulation"
                OnResumeClicked="OnContinueSimulation"
                OnStopClicked="OnStopSimulation"
                OnSaveClickedCallback="OnSaveFile"
                OnNewFileClickedCallback="ShowCreateFileModalAsync"
                OnFpgaChipClickedCallback="OpenFpgaPickerAsync" />

        @* ---------- Editor Dock: Entities · Ports · Waveforms · Runs · Files · Output ---------- *@
        <EditorDock EntitiesCount="@(Builder.Parser?.Entities.Count() ?? 0)"
                    FilesCount="@_projectFiles.Count"
                    RunsCount="@_runsCount"
                    WaveformsReady="@(_waveformData != null)"
                    OutputReady="@(Log.Entries.Count > 0)">

            <EntitiesContent>
                @if (Builder.Parser != null && Builder.Parser.Entities.Any())
                {
                    @foreach (var entity in Builder.Parser.Entities)
                    {
                        <EntityView Entity="entity" />
                    }
                }
            </EntitiesContent>

            <SchematicContent>
                @* Renders the first entity with an architecture; deeper
                   designs (multiple entities) are rare in TT1 and out of
                   scope for this view.

                   The ErrorBoundary is critical: SchematicViewer builds
                   inline SVG via MarkupString and indexes into several
                   layout lookups. Any render-time miss used to escalate
                   to the global #blazor-error-ui bar — on MAUI's
                   BlazorWebView that meant a stale schematic dropped the
                   whole shell into the "Reload window" state. Containing
                   the failure here keeps the rest of the dock usable. *@
                <ErrorBoundary>
                    <ChildContent>
                        <SchematicViewer Entity="@(Builder.Parser?.Entities.FirstOrDefault(e => e.Architecture != null))"
                                         Waveform="_waveformData" />
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="schematic-empty" role="alert">
                            <Icon Name="IconName.ExclamationTriangle" />
                            <p>@Traductor.T("SCHEMATIC_EMPTY")</p>
                            <pre style="white-space:pre-wrap;font-size:.8rem;opacity:.7;margin-top:.5rem;">@ex.GetType().Name: @ex.Message</pre>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </SchematicContent>

            <FlowContent>
                @* High-level control-flow view of the parsed design — one
                   Mermaid flowchart per architecture. Refreshed after every
                   build via _flowDiagram.RefreshAsync(). *@
                <FlowDiagramViewer @ref="_flowDiagram" />
            </FlowContent>

            <PortsContent>
                <PortsPanel OnBuildRequested="OnBuildRequested" />
            </PortsContent>

            <WaveformsContent>
                @if (_compareSnapshots != null && _compareSnapshots.Count >= 2)
                {
                    <WaveformViewer Snapshots="_compareSnapshots"
                                    OnClearCompare="ClearCompare"
                                    OnExportVcd="HandleVcdExport" />
                }
                else if (_waveformData != null && _waveformData.Signals.Count > 0)
                {
                    @if (_liveMergeSuspended && LiveRunOwnsThisProject)
                    {
                        <div class="waveform-saved-banner" role="status">
                            <Icon Name="IconName.InfoCircle" />
                            <span>@Traductor.T("EDITOR_VIEWING_SAVED_LIVE")</span>
                            <button type="button"
                                    class="kmila-btn kmila-btn--accent kmila-btn--sm"
                                    @onclick="ReturnToLiveRun">
                                <Icon Name="IconName.Broadcast" />
                                <span>@Traductor.T("EDITOR_RETURN_TO_LIVE")</span>
                            </button>
                        </div>
                    }
                    <WaveformViewer Data="_waveformData"
                                    IsLive="@(!_liveMergeSuspended && Replay.IsLiveActive)"
                                    OnExportVcd="HandleVcdExport" />
                }
                else if (Sim.State == SimState.Complete)
                {
                    @* Sim ran but produced no signals — most common cause: no
                       stimulus on any input port. Surface it explicitly instead
                       of falling through to the generic empty-waveforms state. *@
                    <div class="kmila-dock__empty">
                        <div class="kmila-dock__empty-icon"><Icon Name="IconName.ExclamationTriangleFill" /></div>
                        <p>@Traductor.T("EDITOR_WAVE_NO_DATA")</p>
                        <small class="text-muted">@Traductor.T("EDITOR_WAVE_NO_DATA_HINT")</small>
                    </div>
                }
            </WaveformsContent>

            <RunsContent>
                <RunsPanel ProjectId="@_projectId"
                           OnLoadSnapshot="LoadSnapshotAsync"
                           OnCompareSnapshots="OpenCompareAsync" />
            </RunsContent>

            @* Step Replay moved out of the bottom dock and into a sibling
               tab of the editor card (see editor-workbench__view-tabs
               above). Frees the dock for entities / schematic / waveforms
               / output / files etc., and puts the debug surface right
               next to the source it's stepping through. *@

            <FilesContent>
                <FilesCard
                    @ref="_filesCard"
                    OnProjectFileClicked="OnProjectFileOpened"
                    OnProjectFileRemoved="OnFileRemoved"
                    Project="_project" />
            </FilesContent>

            <OutputContent>
                <OutputPanel />
            </OutputContent>
        </EditorDock>

        @* ---------- Status bar (bottom of the editor page) ---------- *@
        <StatusBar HasUnsavedChanges="_hasUnsavedChanges"
                   FileName="@_openedFile?.FileName"
                   Line="_cursorLine"
                   Column="_cursorColumn"
                   Language="@_currentLanguage" />
}
</section>
@* Two refs — one for short forms (create-file) at Regular, one for long
   markdown previews at Large. Picking the right ref keeps each modal sized
   to its actual content density (audit follow-up 2026-06-15). *@
<Modal @ref="_multiUseModal" />
<Modal @ref="_multiUseLargeModal" Size="ModalSize.Large" />
<ConfirmDialog @ref="_closeTabDialog" />
@code {
    /// <summary>
    /// Gets or sets the project identifier.
    /// </summary>
    [Parameter]
    public string ProjectId { get; set; } = string.Empty;
    private int _projectId = -1;
    private Project _project = null!;
    private FilesCard _filesCard = new();
    private FlowDiagramViewer? _flowDiagram;
    private Modal _multiUseModal = new();
    private Modal _multiUseLargeModal = new();
    /// <summary>
    /// BlazorBootstrap ConfirmDialog used by <see cref="CloseTabAsync"/> when
    /// the tab has unsaved changes. Replaces a native <c>window.confirm</c>
    /// JS prompt so the close flow uses the same themed modal as the rest of
    /// the app (Projects delete, Runs delete, FilesCard delete).
    /// </summary>
    private ConfirmDialog _closeTabDialog = new();
    private List<ProjectFile> _projectFiles { get; set; } = new();

    /// <summary>
    /// Editor panes — at most 2 in Phase 2. <c>_panes[0]</c> is always
    /// present; <c>_panes[1]</c> exists only after the user clicks Split.
    /// All "current file" / "cursor" / "unsaved changes" reads still flow
    /// through the legacy field names (<c>_openedFile</c>,
    /// <c>_hasUnsavedChanges</c>, etc.) — those are now compatibility
    /// properties that delegate to the *focused* pane's active tab, so
    /// build / save / sim flows keep working without per-call pane
    /// parameters.
    /// </summary>
    private List<EditorPane> _panes = new() { new EditorPane() };

    /// <summary>Index of the currently focused pane. Drives "open file
    /// here" routing and the workbench header's cursor / dirty / name
    /// indicators.</summary>
    private int _focusedPaneIndex = 0;

    /// <summary>True while the editor is split into two panes. Toggling
    /// this happens through <see cref="ToggleSplitAsync"/>.</summary>
    private bool IsSplit => _panes.Count > 1;

    // _tabIdCounter was the monotonic counter we used to use for per-tab
    // Monaco model URIs, but it reset on every Editor mount and collided
    // with stale models still registered in Monaco's global table. We now
    // generate a fresh GUID per tab in CreateModelForTabAsync — see the
    // comment block there for the full reasoning.

    /// <summary>Debounces the per-project session-save calls so a flurry
    /// of tab mutations (e.g. a split that opens 5 tabs at once) writes
    /// localStorage just once 500 ms later instead of five times.</summary>
    private CancellationTokenSource? _sessionDebounce;
    private const int SessionSaveDebounceMs = 500;

    /// <summary>
    /// Flips true on the first interactive render. Until then JS interop
    /// (localStorage in particular) throws InvalidOperationException, so
    /// we gate every session-related call. The first interactive render
    /// also retries the session restore via <see cref="OnAfterRenderAsync"/>
    /// because the static-prerender pass couldn't run it.
    /// </summary>
    private bool _isInteractive;

    /// <summary>Focused pane shorthand. All the legacy single-pane
    /// references (<c>_pane.Monaco</c>, <c>_pane.Tabs</c>,
    /// <c>_pane.ActiveTab</c>, etc.) flow through here.</summary>
    private EditorPane _pane =>
        _focusedPaneIndex >= 0 && _focusedPaneIndex < _panes.Count
            ? _panes[_focusedPaneIndex]
            : _panes[0];

    private EditorPane GetPane(int idx) =>
        idx >= 0 && idx < _panes.Count ? _panes[idx] : _pane;

    // ─── Compatibility shims over _pane.ActiveTab ──────────────────────
    // Every reference to these names elsewhere in the file used to read /
    // write a flat field. They now route through the active tab, returning
    // safe defaults when no tab is open. Keeping the names lets the rest
    // of the page (handlers, markup, build/sim flow) stay unchanged.

    private ProjectFile? _openedFile => _pane.ActiveTab?.File;

    private string _originalContent
    {
        get => _pane.ActiveTab?.OriginalContent ?? string.Empty;
        set { if (_pane.ActiveTab != null) _pane.ActiveTab.OriginalContent = value; }
    }

    private bool _hasUnsavedChanges
    {
        get => _pane.ActiveTab?.HasUnsavedChanges ?? false;
        set { if (_pane.ActiveTab != null) _pane.ActiveTab.HasUnsavedChanges = value; }
    }

    private string _currentLanguage
    {
        get => _pane.ActiveTab?.Language ?? "vhdl";
        set { if (_pane.ActiveTab != null) _pane.ActiveTab.Language = value; }
    }

    private string _markdownPreview
    {
        get => _pane.ActiveTab?.MarkdownPreview ?? string.Empty;
        set { if (_pane.ActiveTab != null) _pane.ActiveTab.MarkdownPreview = value; }
    }

    private int _cursorLine
    {
        get => _pane.ActiveTab?.CursorLine ?? 1;
        set { if (_pane.ActiveTab != null) _pane.ActiveTab.CursorLine = value; }
    }

    private int _cursorColumn
    {
        get => _pane.ActiveTab?.CursorColumn ?? 1;
        set { if (_pane.ActiveTab != null) _pane.ActiveTab.CursorColumn = value; }
    }

    /// <summary>True after Monaco has emitted OnDidInit. Tab-open requests
    /// that arrive before this materialise their TextModels lazily once
    /// the editor is ready.</summary>
    private bool _editorInitialized
    {
        get => _pane.Initialized;
        set => _pane.Initialized = value;
    }

    // Waveform data from simulation
    private WaveformData? _waveformData;

    /// <summary>Snapshot count for the Runs tab badge.</summary>
    private int _runsCount;

    /// <summary>
    /// Two-or-more snapshots to overlay in compare mode. When non-null, the
    /// Waveforms tab renders them instead of <see cref="_waveformData"/>.
    /// Cleared via the "X" button on the compare banner.
    /// </summary>
    private List<Kmila.Shared.Models.SimulationSnapshot>? _compareSnapshots;

    /// <summary>
    /// Gets whether the active tab is showing a Markdown file.
    /// </summary>
    private bool IsMarkdownFile => _pane.ActiveTab?.IsMarkdown ?? false;
    /// <summary>
    /// Event subscriptions live here — they only need to happen once per
    /// component mount. Per-project loading is handled by
    /// <see cref="OnParametersSetAsync"/> so it re-runs when the user
    /// navigates between /editor/{a} and /editor/{b} (Blazor reuses the
    /// component when the route template matches).
    /// </summary>
    /// <summary>
    /// Snapshot of the Time/Scale pair used to build the current
    /// <see cref="_waveformData"/>. Updated in <see cref="OnSimulationDataReady"/>.
    /// When <see cref="OnSimParamsChanged"/> sees a divergence, the viewer's
    /// backing data is cleared so students don't read stale traces next to a
    /// different sim duration.
    /// </summary>
    private int _lastBuiltTime;
    private TimeScale _lastBuiltScale;

    /// <summary>
    /// Debounce gate for Markdown live-preview. Markdig re-parses the entire
    /// buffer on every call, which used to fire on every keystroke and pin
    /// the CPU on large notes. We delay the preview refresh by ~300 ms; each
    /// keystroke supersedes the previous pending refresh.
    /// </summary>
    private CancellationTokenSource? _markdownDebounce;
    private const int MarkdownDebounceMs = 300;

    protected override void OnInitialized()
    {
        // Read AppSettings.KEY_DEFAULT_DOCK_TAB synchronously so the dock
        // mounts on the user's preferred tab from the very first render —
        // avoids a tab-flip flash after OnParametersSetAsync's async DB read.
        // Best-effort: fire-and-forget the DB call (Hydrate runs on completion).
        _ = HydrateDefaultDockTabAsync();

        Builder.OnSimulationCompleted     += OnSimulationDataReady;
        Builder.OnSimulationProgressUpdate += OnSimulationProgressUpdate;
        Builder.OnSimulationEnded         += OnSimulationEnded;
        // OnProgressAdvanced is owned by SimulationCoordinator (singleton/
        // per-circuit) so progress keeps flowing into Sim even when the
        // Editor isn't mounted. Editor only needs to react to UI-relevant
        // events here.
        Builder.OnEngineReady             += OnEngineReadyForLiveReplay;
        Replay.OnBreakpointsChanged       += OnBreakpointsChangedRepaint;
        Replay.OnLiveChanged              += OnReplayLiveChangedForTabBadge;
        Sim.OnChange                      += OnSimParamsChanged;
        Snapshots.OnChange                += OnSnapshotsChanged;
    }

    /// <summary>
    /// Phase B (2026-05-19): handoff from <c>ProgramBuilder</c> when the
    /// engine is constructed for a new run. Attaches the engine to the
    /// scoped <see cref="ReplayState"/> so <c>StepReplayPanel</c> can
    /// surface the cooperative Pause / Resume / Step controls. The
    /// matching detach lives in <see cref="OnSimulationEnded"/>.
    ///
    /// Phase B+ (2026-05-19, "live frame consumption"): also reads the
    /// current Monaco source so live frames can carry highlight-line info.
    /// Fire-and-forget by design — the first few frames may arrive before
    /// the async source read finishes, but the engine emits hundreds of
    /// frames over a typical run so the warm-up gap is invisible.
    /// </summary>
    private void OnEngineReadyForLiveReplay(Interpreter.Services.DeltaCycleEngine engine)
    {
        // Attach SYNCHRONOUSLY with the saved file content so the engine's
        // OnFrameEmitted subscription is in place before the first delta
        // fires. The async Monaco.GetValue() path raced against the
        // simulator's tick loop — breakpoints sometimes missed early
        // transitions because the handler wasn't wired yet. The saved
        // file content has correct line numbers (it's what the parser
        // just ran on); even if the user has unsaved edits the line
        // mapping stays good for everything ABOVE the unsaved region.
        var source = _openedFile?.Content ?? string.Empty;
        Replay.AttachLive(engine, source);

        // A fresh run owns the waveform again — drop any leftover suspension
        // from inspecting a saved run during the previous run.
        _liveMergeSuspended = false;

        // Phase B+ (follow-up 2): auto-switch the editor card to the
        // Step Replay tab so the user sees the live pause/resume UI from
        // the moment Run starts. Only fires when at least one breakpoint
        // is set — otherwise the user probably just wants to watch the
        // waveform fill in, and we shouldn't yank them off the code view.
        if (Replay.Breakpoints.Count > 0)
        {
            InvokeAsync(() =>
            {
                _editorCardTab = EditorCardTab.Replay;
                StateHasChanged();
            });
        }
    }

    /// <summary>
    /// Re-entrancy guard for the live progress merge — the simulator's
    /// 200 ms timer can fire faster than the UI thread can render on long
    /// sims, so we drop overlapping fires. Idempotent watermarks make this
    /// safe.
    /// </summary>
    private int _liveMergeInflight;

    /// <summary>
    /// True while the user is inspecting a SAVED run (single snapshot or a
    /// compare) on the Waveforms tab even though a live simulation for this
    /// project is still in flight. While set, the live progress/completion
    /// merges leave <see cref="_waveformData"/> alone so the saved run the
    /// user opened isn't clobbered by incoming live frames. Cleared when the
    /// user returns to the live view, when a fresh run starts, or when the
    /// in-flight run completes (its result is then one click away in Runs).
    /// </summary>
    private bool _liveMergeSuspended;

    /// <summary>
    /// True when a live sim for the currently-open project is Running/Paused.
    /// Used to decide whether opening a saved run should suspend live merges
    /// and whether the "return to live run" affordance applies.
    /// </summary>
    private bool LiveRunOwnsThisProject
        => Sim.RunningProjectId == _projectId
           && (Sim.State == SimState.Running || Sim.State == SimState.Paused);

    /// <summary>
    /// Rebuild <see cref="_waveformData"/> from the live engine's current
    /// <c>SignalHistory</c> so a mid-run reattach (or "return to live") shows
    /// the run-so-far immediately instead of a blank panel until the next
    /// progress tick lands. No-op (returns false) when no engine is attached
    /// or it hasn't recorded any samples yet.
    /// </summary>
    private bool HydrateWaveformFromLiveEngine()
    {
        var engine = Replay.LiveEngine;
        if (engine == null) return false;
        var live = WaveformData.CreateEmpty(Builder.LastTickResNs);
        live.MergeFrom(engine.History);
        if (live.Signals.Count == 0) return false;
        _waveformData   = live;
        _lastBuiltTime  = Sim.Time;
        _lastBuiltScale = Sim.Scale;
        return true;
    }

    /// <summary>
    /// Builder progress tick — runs on a thread-pool thread. Marshals back
    /// to the Blazor sync context, lazy-creates the live WaveformData on
    /// first arrival, then appends only the transitions added since the
    /// last merge. Keeps the same instance reference so the WaveformViewer
    /// re-renders by virtue of StateHasChanged.
    /// </summary>
    private void OnSimulationProgressUpdate(Interpreter.Services.SignalHistory history)
    {
        // Don't clobber a saved run the user opened mid-flight — see
        // _liveMergeSuspended. The live run keeps recording into the engine's
        // own SignalHistory regardless; we just stop mirroring it here.
        if (_liveMergeSuspended) return;
        if (System.Threading.Interlocked.Exchange(ref _liveMergeInflight, 1) == 1) return;
        InvokeAsync(() =>
        {
            try
            {
                bool firstFrame = _waveformData == null;
                if (firstFrame)
                {
                    _waveformData = WaveformData.CreateEmpty(Builder.LastTickResNs);
                    _lastBuiltTime  = Sim.Time;
                    _lastBuiltScale = Sim.Scale;
                }
                bool appended = _waveformData!.MergeFrom(history);

                // First batch: jump the dock to the Waveforms tab so the
                // student watches it fill in. Skip if the user is in
                // compare mode — they're inspecting other runs.
                if (firstFrame && _compareSnapshots == null)
                    DockState.SetActive(EditorTab.Waveforms);

                // Only re-render when the merge actually advanced state,
                // OR on the very first frame (so the viewer shows up even
                // if no transitions arrived yet). Skips the render churn
                // that used to lock out Resume / Stop clicks during pause.
                if (firstFrame || appended)
                    StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "[Editor] Live waveform merge failed");
            }
            finally
            {
                System.Threading.Interlocked.Exchange(ref _liveMergeInflight, 0);
            }
        });
    }

    /// <summary>
    /// Refresh the Runs-tab badge count when a snapshot is added/removed for
    /// this project. Reactive so background captures (user navigated away mid
    /// sim and came back after completion) update the UI without polling.
    /// </summary>
    private async void OnSnapshotsChanged(int projectId)
    {
        if (projectId != _projectId) return;
        await RefreshRunsCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshRunsCountAsync()
    {
        if (_projectId <= 0) { _runsCount = 0; return; }
        // CountForProjectAsync issues a single SELECT COUNT(*) — used to be
        // ListForProjectAsync(...).Count, which materialised every row
        // including the multi-MB WaveformJson column just for the badge
        // number. That was responsible for a chunk of the post-run memory
        // spike when returning to /editor.
        _runsCount = await Snapshots.CountForProjectAsync(_projectId);
    }

    private async Task LoadSnapshotAsync(Kmila.Shared.Models.SimulationSnapshot snap)
    {
        // Row may be a metadata-only summary from the Runs panel (no
        // WaveformJson column). Re-fetch via GetByIdAsync so we have the
        // payload to deserialise into WaveformData.
        var full = string.IsNullOrEmpty(snap.WaveformJson)
            ? await Snapshots.GetByIdAsync(snap.Id)
            : snap;
        if (full == null || string.IsNullOrEmpty(full.WaveformJson))
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                Traductor.T("RUNS_LOAD_FAILED"), ToastType.Danger));
            return;
        }
        var wd = Kmila.Shared.Models.WaveformData.FromJson(full.WaveformJson);
        if (wd == null)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                Traductor.T("RUNS_LOAD_FAILED"), ToastType.Danger));
            return;
        }
        _waveformData = wd;
        _lastBuiltTime  = full.Time;
        _ = Enum.TryParse<TimeScale>(full.Scale, out var scale);
        _lastBuiltScale = scale;
        _compareSnapshots = null;
        // If a live sim for this project is still running, stop mirroring its
        // frames into _waveformData so the saved run the user just opened
        // isn't overwritten. The "return to live run" banner restores it.
        _liveMergeSuspended = LiveRunOwnsThisProject;
        DockState.SetActive(EditorTab.Waveforms);
        StateHasChanged();
    }

    private async Task OpenCompareAsync(List<Kmila.Shared.Models.SimulationSnapshot> picks)
    {
        // Compare picks coming from the Runs panel are metadata-only — they
        // know which rows the user selected but don't carry WaveformJson.
        // Fetch each full row before handing to the viewer so the compare
        // tracks have data to render. Done sequentially to keep SQLite
        // pressure modest; the picks count is bounded by the UI.
        var hydrated = new List<Kmila.Shared.Models.SimulationSnapshot>(picks.Count);
        foreach (var pick in picks)
        {
            if (!string.IsNullOrEmpty(pick.WaveformJson))
            {
                hydrated.Add(pick);
                continue;
            }
            var full = await Snapshots.GetByIdAsync(pick.Id);
            if (full != null && !string.IsNullOrEmpty(full.WaveformJson))
                hydrated.Add(full);
        }
        if (hydrated.Count < 2)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                Traductor.T("RUNS_LOAD_FAILED"), ToastType.Danger));
            return;
        }
        _compareSnapshots = hydrated;
        // Suspend live mirroring while comparing saved runs over a live sim,
        // same rationale as LoadSnapshotAsync.
        _liveMergeSuspended = LiveRunOwnsThisProject;
        DockState.SetActive(EditorTab.Waveforms);
        StateHasChanged();
    }

    private void ClearCompare()
    {
        _compareSnapshots = null;
        // If the live run is still going, snap back to it; otherwise just drop
        // the compare overlay and keep whatever single waveform was showing.
        if (_liveMergeSuspended && LiveRunOwnsThisProject)
        {
            _liveMergeSuspended = false;
            HydrateWaveformFromLiveEngine();
        }
        else
        {
            _liveMergeSuspended = false;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Return from a saved-run / compare view back to the still-running live
    /// simulation: drop the suspension and rehydrate the waveform from the
    /// engine's current history so it picks up live frames again.
    /// </summary>
    private void ReturnToLiveRun()
    {
        _liveMergeSuspended = false;
        _compareSnapshots = null;
        if (!HydrateWaveformFromLiveEngine())
            _waveformData = WaveformData.CreateEmpty(Builder.LastTickResNs);
        DockState.SetActive(EditorTab.Waveforms);
        StateHasChanged();
    }

    /// <summary>
    /// Fired whenever any field of <see cref="SimulationParameters"/> moves
    /// (time, scale, port moments, state, etc.). We only react when the user
    /// has edited <c>Time</c> or <c>Scale</c> after a completed run — that
    /// invalidates the waveform we're showing.
    /// </summary>
    private void OnSimParamsChanged()
    {
        if (_waveformData == null) return;
        if (Sim.Time != _lastBuiltTime || Sim.Scale != _lastBuiltScale)
        {
            _waveformData = null;
            InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Marks <c>&lt;html&gt;</c> with <c>data-route="editor"</c> on first render.
    /// MainLayout's URI-based class used to miss on the initial navigation in
    /// some WebView builds (the article kept its `.content` max-width until
    /// something — a Build click, a window resize — forced a re-layout). Going
    /// through a DOM attribute sidesteps Blazor render timing entirely: the
    /// attribute is set the moment Monaco mounts, cleared when we dispose.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-route", "editor");
        }
        catch
        {
            // JS not available (prerender) — fine, the Ctrl+S suppression script in App.razor will simply no-op.
        }

        // Now we're in the interactive circuit and JS interop is safe.
        // Open the gate so subsequent saves go through, then retry the
        // session restore that couldn't run during OnParametersSetAsync
        // (which fires before the circuit boots in the prerender pass).
        // If no session exists for this project the call is a fast
        // no-op and leaves the prerender's main-file tab untouched.
        _isInteractive = true;
        if (_projectId > 0 && _projectFiles.Count > 0)
        {
            try
            {
                bool restored = await TryRestoreSessionAsync();
                if (restored)
                {
                    _filesCard?.SetDefaultFile(_pane.ActiveTab?.File ?? FindMainFile(_projectFiles));
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "[Editor] Post-firstRender session restore failed");
            }
        }
    }

    /// <summary>
    /// Runs on first mount AND whenever the ProjectId route parameter changes.
    /// Short-circuits when the ID is unchanged (which happens on every language
    /// switch etc., since Blazor re-invokes SetParameters on any cascade).
    /// </summary>
    private async Task HydrateDefaultDockTabAsync()
    {
        try
        {
            var saved = await DbContext.GetSettingAsync(AppSettings.KEY_DEFAULT_DOCK_TAB);
            if (!string.IsNullOrWhiteSpace(saved) &&
                Enum.TryParse<EditorTab>(saved, ignoreCase: true, out var tab))
            {
                DockState.SetActive(tab);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* DB unavailable — fall back to default */ }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(ProjectId))
        {
            ToastService.Notify(Message(Traductor.T("EDITOR_PROJECT_NOT_SET_TITLE"), Traductor.T("EDITOR_PROJECT_NOT_SET_BODY"), ToastType.Danger));
            return;
        }
        if (!int.TryParse(ProjectId, out var newId)) return;
        if (newId != _projectId)
        {
            await LoadProjectAsync(newId);
        }

        // Deep-link support: ?tab=flow|schematic|waveforms|... pre-selects
        // the dock-tab. Runs AFTER LoadProjectAsync so the singleton state
        // we set isn't overridden by build/run handlers triggered during
        // project hydration. Useful for sharing focused views + driving
        // automated harnesses without simulating taps against the
        // `<button>` elements that this WebView's user-activation gating
        // rejects.
        try
        {
            EditorTab? requested = null;
            var query = new Uri(NavigationManager.Uri).Query;
            if (!string.IsNullOrEmpty(query))
            {
                foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
                {
                    var eq = pair.IndexOf('=');
                    var key  = eq >= 0 ? pair[..eq]   : pair;
                    var val  = eq >= 0 ? pair[(eq+1)..] : string.Empty;
                    if (string.Equals(Uri.UnescapeDataString(key), "tab", StringComparison.OrdinalIgnoreCase) &&
                        Enum.TryParse<EditorTab>(Uri.UnescapeDataString(val), ignoreCase: true, out var parsed))
                    {
                        requested = parsed;
                        break;
                    }
                }
            }

            if (requested is { } tab)
            {
                DockState.SetActive(tab);
            }
            else
            {
                var savedDefault = await DbContext.GetSettingAsync(AppSettings.KEY_DEFAULT_DOCK_TAB);
                if (!string.IsNullOrWhiteSpace(savedDefault) &&
                    Enum.TryParse<EditorTab>(savedDefault, ignoreCase: true, out var saved))
                {
                    DockState.SetActive(saved);
                }
            }
        }
        catch { /* malformed query or DB read — ignore */ }
    }

    /// <summary>
    /// Loads a project, its files, and the designated main file into Monaco.
    /// Also resets per-project transient state (sim status, waveform, log,
    /// port moments) so nothing from the previous project leaks over.
    /// </summary>
    private async Task LoadProjectAsync(int newProjectId)
    {
        _projectId = newProjectId;
        _project = await Projects.GetByAsync(_projectId);
        var allFiles = await ProjectFiles.GetProjectFilesAsync(_project);
        // Partition: user-visible .vhd / .md / etc. go into _projectFiles
        // (the existing pipeline); .bvhdl sidecars stash separately so
        // they never appear in the file picker but are reachable by
        // FindBvhdlSidecar for save/load.
        _projectFiles  = allFiles.Where(f => !IsBvhdlSidecar(f)).ToList();
        _sidecarFiles  = allFiles.Where(IsBvhdlSidecar).ToList();

        // Record the open for the sidebar MRU so the top-10 reflects actual usage.
        _ = Recent.TouchAsync(_projectId);

        // Re-attach path: if a simulation for THIS project is still in flight
        // (the user navigated away mid-run and came back), skip the wipe so
        // the live progress / state / port moments / log / replay survive.
        // The future OnSimulationProgressUpdate ticks repopulate _waveformData
        // from the next frame onward; OnSimulationCompleted (which fires with
        // the full SignalHistory) then fills in everything when the sim ends.
        bool reattach = Sim.RunningProjectId == newProjectId
                        && (Sim.State == SimState.Running || Sim.State == SimState.Paused);

        // Recover path: no live sim, but a run for THIS project finished
        // within the last few minutes (the user clicked away right when it
        // completed and is coming back to inspect the result). Repopulate
        // _waveformData from Sim.LastWaveform so the Waveform tab + run-bar
        // state look exactly as they did before they left, instead of resetting
        // to the Idle "no run yet" surface. See SimulationParameters
        // .LastRunRecoveryWindow for the timeout.
        bool recovered = false;
        if (!reattach && Sim.TryGetRecentRun(newProjectId, out var cachedWave) && cachedWave != null)
        {
            _waveformData = cachedWave;
            // Seed the staleness guards BEFORE the SetState/SetProgress calls
            // below fire Sim.OnChange. Without this, OnSimParamsChanged sees
            // _lastBuiltTime/_lastBuiltScale at their defaults (0 / US) and
            // wipes the just-recovered waveform because Sim.Time/Scale don't
            // match. The cached run was built against the current Sim.Time
            // and Sim.Scale (Sim is scoped per-circuit and Time/Scale only
            // mutate on user input), so they're the right values to record.
            _lastBuiltTime  = Sim.Time;
            _lastBuiltScale = Sim.Scale;
            Sim.SetState(SimState.Complete);
            Sim.SetProgress(100);
            recovered = true;
        }

        // Reattach: hydrate the waveform from the engine's current
        // SignalHistory immediately so the Waveforms tab shows the run-so-far
        // instead of a blank panel until the next progress tick. Dispose
        // nulled _waveformData when the user navigated away, so without this
        // the tab stays empty until OnSimulationProgressUpdate fires the next
        // frame (~200 ms, but arbitrarily long on sims with rare transitions).
        if (reattach)
        {
            _liveMergeSuspended = false;
            HydrateWaveformFromLiveEngine();
        }

        if (!reattach && !recovered)
        {
            // Wipe per-project runtime state
            Sim.SetState(SimState.Idle);
            Sim.SetProgress(0);
            Sim.ClearPortMoments();
            Log.Clear();
            _waveformData = null;
            _liveMergeSuspended = false;

            // Clear the step-replay state so the new project's Replay tab opens
            // on its empty hint instead of showing the previous project's run.
            // ReplayState is scoped per-circuit, so this only resets the slot we
            // share between tabs, not anyone else's.
            Replay.Set(null);
        }

        // Drop every tab from the previous project — never carry buffers
        // across project switches. CloseAllTabsAsync handles model disposal
        // and clears the editor surface when Monaco is initialised.
        await CloseAllTabsAsync();

        if (_projectFiles.Count > 0)
        {
            // First try to restore the saved session — open tabs +
            // active indices + split state from the user's last visit
            // to this project. Falls back to the project's main file
            // when there's no session or every saved tab references a
            // deleted file.
            bool restored = await TryRestoreSessionAsync();
            if (!restored)
            {
                var mainFile = FindMainFile(_projectFiles);
                await OpenFileInTabAsync(mainFile);
                _filesCard?.SetDefaultFile(mainFile);
            }
            else
            {
                _filesCard?.SetDefaultFile(_pane.ActiveTab?.File ?? FindMainFile(_projectFiles));
            }
            // Safety net: TryRestoreSessionAsync can return true with zero
            // restored tabs (every saved tab pointed at a since-deleted file),
            // and OpenFileInTabAsync can silently no-op if Monaco isn't yet
            // mounted. In both cases the editor lands on a confusing "No file
            // open" state despite the project having files. Force-open the
            // main file when nothing else opened — addresses the
            // "blank-editor-when-files-exist" defect surfaced during pipeline
            // testing.
            if (_pane.ActiveTab == null)
            {
                var mainFile = FindMainFile(_projectFiles);
                await OpenFileInTabAsync(mainFile);
            }
        }
        // Empty-project branch: pane already clear from CloseAllTabsAsync.

        await RefreshRunsCountAsync();

        // Consume any "apply this config once the project is loaded" request
        // stashed by the caller. Payload slot wins over name slot — it skips
        // the DB round-trip entirely so Unicode-name mismatches can't drop
        // the auto-apply silently.
        var payload = Sim.PendingConfigurationPayload;
        if (payload != null)
        {
            Sim.PendingConfigurationPayload = null;
            Sim.PendingConfigurationName = null;
            await ApplyConfigurationAsync(payload);
        }
        else
        {
            var pending = Sim.PendingConfigurationName;
            if (!string.IsNullOrEmpty(pending))
            {
                Sim.PendingConfigurationName = null;
                await ApplySavedConfigurationAsync(pending);
            }
        }

        StateHasChanged();
    }

    /// <summary>
    /// Applies an already-loaded <see cref="KmilaConfiguration"/> directly,
    /// skipping the save/load round-trip used by
    /// <see cref="ApplySavedConfigurationAsync"/>. Prefer this when the
    /// caller constructed the config object itself.
    /// </summary>
    private async Task ApplyConfigurationAsync(KmilaConfiguration config)
    {
        try
        {
            if (config.Time != null)
            {
                Sim.SetTime(config.Time.Value);
                if (Enum.TryParse<TimeScale>(config.Time.Scale, out var scale))
                    Sim.SetScale(scale);
            }
            Sim.ReplacePortMoments(config.PortMoments);

            if (config.FPGA != null && !string.IsNullOrEmpty(config.FPGA.Path))
            {
                try
                {
                    var fpga = await JSONFileReader.ReadFPGAJsonFileAsync(config.FPGA.Path);
                    if (fpga != null) SelectedFPGA.SetFPGA(fpga, config.FPGA.Path);
                }
                catch { /* non-fatal */ }
            }

            Sim.MarkLoaded(config.Name ?? Traductor.T("EDITOR_SAMPLE_CONFIG_FALLBACK"));
            Logger.LogInformation("[Editor] Applied pending payload — {Count} port moments",
                config.PortMoments?.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[Editor] Failed to apply pending config payload");
        }
    }

    /// <summary>
    /// Applies a named saved configuration to <see cref="Sim"/> (+ the FPGA
    /// selection if the config carries one). Mirrors the logic in
    /// <c>ConfigurationsPill.LoadAsync</c> so the first-open-sample flow
    /// behaves identically to a manual "Load" from the pill.
    /// </summary>
    private async Task ApplySavedConfigurationAsync(string name)
    {
        try
        {
            var config = await ConfigService.LoadConfigurationAsync(name);
            if (config == null)
            {
                // Surface the failure so it shows up in /logs and the user
                // understands why their sample didn't get its stimuli applied.
                Logger.LogWarning("[Editor] Pending config '{Name}' not found — port moments were NOT auto-applied. Use the Configurations pill to load it manually.",
                    name);
                Log.Warn(string.Format(Traductor.T("EDITOR_CONFIG_AUTOAPPLY_MISSING"), name));
                return;
            }

            if (config.Time != null)
            {
                Sim.SetTime(config.Time.Value);
                if (Enum.TryParse<TimeScale>(config.Time.Scale, out var scale))
                    Sim.SetScale(scale);
            }
            Sim.ReplacePortMoments(config.PortMoments);

            if (config.FPGA != null && !string.IsNullOrEmpty(config.FPGA.Path))
            {
                try
                {
                    var fpga = await JSONFileReader.ReadFPGAJsonFileAsync(config.FPGA.Path);
                    if (fpga != null) SelectedFPGA.SetFPGA(fpga, config.FPGA.Path);
                }
                catch { /* non-fatal */ }
            }

            Sim.MarkLoaded(name);
            Logger.LogInformation("[Editor] Applied config '{Name}' — {Count} port moments",
                name, config.PortMoments?.Count ?? 0);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[Editor] Failed to auto-apply pending config {Name}", name);
        }
    }

    /// <summary>
    /// Builder.OnSimulationEnded fires off the simulation thread. Marshal back
    /// to the UI thread, update <see cref="Sim.State"/>, append to the log,
    /// and auto-focus the Waveforms tab so the result is visible.
    /// </summary>
    private void OnSimulationEnded(bool ended)
    {
        InvokeAsync(() =>
        {
            // Sim.SetState(Complete) / SetProgress(100) / EndRun() are now
            // owned by SimulationCoordinator so they fire regardless of
            // whether the Editor is mounted. Editor only handles its own
            // UI side-effects here.
            Log.Success(ended
                ? Traductor.T("SIM_LOG_ENDED_OK")
                : Traductor.T("SIM_LOG_ENDED_STOPPED"));

            // Phase B+ (follow-up 2): bottom dock no longer has a Replay
            // tab; auto-focus Waveforms unconditionally. The editor card's
            // Step Replay tab stays on Replay for post-hoc scrubbing — the
            // user can flip back to Code from the workbench tab strip.
            DockState.SetActive(EditorTab.Waveforms);

            // Phase B: drop the live-engine reference now that the run is
            // over. The post-hoc replay doc (built by OnSimulationDataReady)
            // takes over as the Replay tab's content.
            Replay.DetachLive();

            StateHasChanged();
        });
    }

    /// <summary>
    /// Materialises Monaco TextModels for any tab that was opened
    /// before the corresponding pane's editor finished initialising —
    /// most commonly the project's main file, opened during
    /// <see cref="LoadProjectAsync"/> which runs in
    /// <c>OnParametersSetAsync</c> (i.e. before first render). After
    /// each model is created we point the pane's editor at the active
    /// tab's model so the user sees the right buffer the moment Monaco
    /// mounts.
    /// </summary>
    private async Task LoadPendingFileAsync(int paneIdx = -1)
    {
        if (paneIdx < 0 || paneIdx >= _panes.Count) paneIdx = _focusedPaneIndex;
        var pane = _panes[paneIdx];
        try
        {
            for (int i = 0; i < pane.Tabs.Count; i++)
            {
                var t = pane.Tabs[i];
                if (t.Model == null)
                    t.Model = await CreateModelForTabAsync(t);
            }
            if (pane.ActiveTab?.Model != null)
                await pane.Monaco.SetModel(pane.ActiveTab.Model);
        }
        catch (Exception ex)
        {
            Logger.LogError($"[Editor] Error materialising tab models: {ex.Message}");
        }
    }

    /// <summary>
    /// Finds the main file to open from a list of project files.
    /// Priority: main.vhd/vhdl > first .vhd/.vhdl file > first file
    /// </summary>
    /// <param name="files">The list of project files.</param>
    /// <returns>The main file to open.</returns>
    private ProjectFile FindMainFile(List<ProjectFile> files)
    {
        // First, look for a file explicitly named "main"
        var mainFile = files.FirstOrDefault(f =>
            System.IO.Path.GetFileNameWithoutExtension(f.FileName).Equals("main", StringComparison.OrdinalIgnoreCase) &&
            (f.FileName.EndsWith(".vhd", StringComparison.OrdinalIgnoreCase) ||
             f.FileName.EndsWith(".vhdl", StringComparison.OrdinalIgnoreCase)));

        if (mainFile != null) return mainFile;

        // Then, look for any VHDL file (they are the entry points)
        var vhdlFile = files.FirstOrDefault(f =>
            f.FileName.EndsWith(".vhd", StringComparison.OrdinalIgnoreCase) ||
            f.FileName.EndsWith(".vhdl", StringComparison.OrdinalIgnoreCase));

        if (vhdlFile != null) return vhdlFile;

        // Finally, return the first file
        return files.First();
    }
