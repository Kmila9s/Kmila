@page "/"
@implements IDisposable
<PageTitle>@Traductor.T("COMMON_WELCOME")</PageTitle>
<div class="container my-5">
    <div class="row">
        <div class="col-12 text-center">
            <h1 class="display-4">@Traductor.T("HOME_TITLE")</h1>
            <p class="lead">
                @Traductor.T("HOME_SUBTITLE")
            </p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-8 offset-md-2">
            <h2>@Traductor.T("HOME_OVERVIEW_TITLE")</h2>
            <p>
                @Traductor.T("HOME_OVERVIEW_P1")
            </p>
            <p>
                @Traductor.T("HOME_OVERVIEW_P2")
            </p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-8 offset-md-2">
            <h2>@Traductor.T("HOME_FEATURES_TITLE")</h2>
            <ul>
                <li><strong>@Traductor.T("HOME_FEATURE_VISUALIZATION")</strong> @Traductor.T("HOME_FEATURE_VISUALIZATION_DESC")</li>
                <li><strong>@Traductor.T("HOME_FEATURE_CROSSPLATFORM")</strong> @Traductor.T("HOME_FEATURE_CROSSPLATFORM_DESC")</li>
                <li><strong>@Traductor.T("HOME_FEATURE_OFFLINE")</strong> @Traductor.T("HOME_FEATURE_OFFLINE_DESC")</li>
                <li><strong>@Traductor.T("HOME_FEATURE_PRELAB")</strong> @Traductor.T("HOME_FEATURE_PRELAB_DESC")</li>
                <li><strong>@Traductor.T("HOME_FEATURE_ACCESSIBILITY")</strong> @Traductor.T("HOME_FEATURE_ACCESSIBILITY_DESC")</li>
                <li><strong>@Traductor.T("HOME_FEATURE_PROTOTYPING")</strong> @Traductor.T("HOME_FEATURE_PROTOTYPING_DESC")</li>
            </ul>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12 text-center">
            <a href="/projects" class="btn btn-primary btn-lg">@Traductor.T("HOME_GO_TO_PROJECTS")</a>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12 text-center">
            <p>
                @Traductor.T("HOME_GITHUB_TEXT")
                <a href="https://github.com/Kmila9s" target="_blank">@Traductor.T("HOME_GITHUB_LINK")</a>.
            </p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Traductor.OnLangChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Traductor.OnLangChanged -= OnLanguageChanged;
    }
}