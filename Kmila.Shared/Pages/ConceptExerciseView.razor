@page "/concepts/exercise/{ExerciseId}"
@using Kmila.Shared.Models
@using Kmila.Shared.Services
@using Kmila.Shared.Components
@inject ConceptCatalog Catalog
@inject ConceptProgressStore Progress
@inject BlockProgram BlockProgram
@implements IDisposable
<PageTitle>@(_title ?? Traductor.T("CONCEPTS_TITLE"))</PageTitle>

@*
    ConceptExercise — Scratch-style block exercise.

    The student composes a program in the kmila-blocks workspace (BlockEditor).
    On Run:

    1. Interpreter path (2026-11-15) — when the payload has a `world`
       (recipe · kitchen · logic · clocked · restaurant · signals), the
       serialized workspace goes to `kmilaExecSim.run` (wwwroot/js/kmila-exec-sim.js).
       ANY arrangement runs and returns an ExerciseSimResult: a timeline for the
       ExecutionPlayer, a localized verdict and 0–3 stars. A failed run reveals the
       next progressive hint (payload `hints`); best stars persist per device
       (`kmilaExecSim.stars`, localStorage — no DB schema change). Restaurant runs
       also post their schedule to the embedded exec-restaurant figure
       (`kmilaExecSim.showPlan`).
    2. Fallback — if the interpreter isn't loaded on this host, fingerprint the
       workspace (BlockProgram) and look up a pre-baked composition; on a miss,
       show the friendly "this combo isn't pre-baked yet" hint.

    While editing, `kmilaExecSim.code` keeps a live listing of the blocks (VHDL for
    logic/clocked/signals, a numbered program otherwise) in the code panel.

    The visible-line highlight pattern is the same one used by the lesson
    player (kmilaExecHighlightLines); the timeline drives the signal table and notes.
*@

<section class="lesson-page">
    <div class="lesson-page__chrome">
        <a href="/concepts" class="lesson-crumb">
            <Icon Name="IconName.ArrowLeft" />
            <span>@Traductor.T("CONCEPTS_ALL_CONCEPTS")</span>
        </a>

        @if (_exercise != null)
        {
            <div class="lesson-chip-row">
                <span class="lesson-chip lesson-chip--kind">
                    <Icon Name="IconName.PuzzleFill" />
                    @KindLabel(_exercise.Kind)
                </span>
                <span class="lesson-chip lesson-chip--time">
                    <Icon Name="IconName.ClockHistory" />
                    ~@_exercise.EstimatedMinutes @Traductor.T("CONCEPTS_MINUTES_SHORT")
                </span>
                @if (_completed)
                {
                    <span class="lesson-chip lesson-chip--done">
                        <Icon Name="IconName.CheckCircleFill" />
                        @Traductor.T("CONCEPTS_DONE")
                    </span>
                }
                @if (_bestStars > 0)
                {
                    <span class="lesson-chip kmila-exercise-stars-chip" title="@Traductor.T("CONCEPTS_EXERCISE_BEST")">
                        @for (var s = 1; s <= 3; s++)
                        {
                            <Icon Name="@(s <= _bestStars ? IconName.StarFill : IconName.Star)" />
                        }
                    </span>
                }
            </div>
        }
    </div>

    @if (_loading)
    {
        <div class="learn-empty">
            <Spinner Type="SpinnerType.Border" Color="SpinnerColor.Primary" />
        </div>
    }
    else if (_exercise == null || _payload == null)
    {
        <div class="learn-empty">
            <div class="learn-empty__icon"><Icon Name="IconName.PuzzleFill" /></div>
            <h2>@Traductor.T("CONCEPTS_EXERCISE_NOT_FOUND")</h2>
            <p>@Traductor.T("CONCEPTS_EXERCISE_NOT_FOUND_BODY")</p>
            <a class="kmila-btn kmila-btn--accent" href="/concepts">@Traductor.T("CONCEPTS_BACK_CATALOG")</a>
        </div>
    }
    else
    {
        <article class="lesson-body">
            <h1>@_title</h1>
            @if (!string.IsNullOrEmpty(_summary))
            {
                <p class="lesson-page__subtitle">@_summary</p>
            }
            @if (!string.IsNullOrEmpty(_brief))
            {
                <div class="lesson-markdown">
                    @MarkdownRenderer.Render(_brief)
                </div>
            }

            <div class="kmila-exercise-board">
                <BlockEditor @ref="_editor"
                             Toolbox="@_payload.Toolbox"
                             InitialStateJson="@(_payload.Starter.ValueKind == System.Text.Json.JsonValueKind.Object ? _payload.Starter.GetRawText() : null)"
                             OnChange="OnWorkspaceChanged" />
                @if (_payload.World == "restaurant")
                {
                    @* The restaurant figure replays the student's schedule (plan posted after Run). *@
                    <div class="lesson-figure kmila-exercise-figure">
                        <iframe src="/_content/Kmila.Shared/anatomia/exec-restaurant.html?modes=custom"
                                title="@_title" loading="lazy"></iframe>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_code))
                {
                    <div class="kmila-exercise-code">
                        <div class="kmila-exercise-code__title">
                            <Icon Name="IconName.CodeSlash" />
                            <span>@Traductor.T(_codeIsVhdl ? "CONCEPTS_EXERCISE_CODE_VHDL" : "CONCEPTS_EXERCISE_CODE_PROGRAM")</span>
                        </div>
                        <div class="lesson-markdown">
                            @MarkdownRenderer.Render("```" + (_codeIsVhdl ? "vhdl" : "text") + "\n" + _code + "\n```")
                        </div>
                    </div>
                }

                <div class="kmila-exercise-actions">
                    <button type="button" class="kmila-btn kmila-btn--ghost"
                            @onclick="ResetAsync"
                            disabled="@_running">
                        <Icon Name="IconName.ArrowCounterclockwise" />
                        <span>@Traductor.T("CONCEPTS_EXERCISE_RESET")</span>
                    </button>
                    <button type="button" data-tour="exercise-run" class="kmila-btn kmila-btn--accent"
                            @onclick="RunAsync"
                            disabled="@_running">
                        @if (_running)
                        {
                            <Spinner Type="SpinnerType.Border" Size="SpinnerSize.Small" />
                        }
                        else
                        {
                            <Icon Name="IconName.PlayFill" />
                        }
                        <span>@Traductor.T("CONCEPTS_EXERCISE_RUN")</span>
                    </button>
                </div>

                @if (_sim != null)
                {
                    <div class="kmila-exercise-match @(_sim.Ok ? "kmila-exercise-match--ok" : "kmila-exercise-match--miss")">
                        <Icon Name="@(_sim.Ok ? IconName.CheckCircleFill : IconName.XCircle)" />
                        <div>
                            <strong>@Traductor.T(_sim.Ok ? "CONCEPTS_EXERCISE_GOAL_MET" : "CONCEPTS_EXERCISE_GOAL_MISSED")</strong>
                            <span>@ConceptCatalog.Localize(_sim.Verdict, _lang, string.Empty)</span>
                        </div>
                        @if (_sim.Ok)
                        {
                            <span class="kmila-exercise-stars" aria-label="@_sim.Stars / 3">
                                @for (var s = 1; s <= 3; s++)
                                {
                                    <Icon Name="@(s <= _sim.Stars ? IconName.StarFill : IconName.Star)" />
                                }
                            </span>
                        }
                    </div>
                    @if (!_sim.Ok && CurrentHint is { } hint)
                    {
                        <div class="kmila-exercise-hint">
                            <Icon Name="IconName.Lightbulb" />
                            <div>
                                <strong>@Traductor.T("CONCEPTS_EXERCISE_HINT") @Math.Min(_fails, HintCount)/@HintCount</strong>
                                <span>@hint</span>
                            </div>
                        </div>
                    }
                    @if (_sim.Timeline != null)
                    {
                        <ExecutionPlayer Doc="_sim.Timeline" Lang="@_lang" />
                    }
                }
                else if (_matchedComposition != null)
                {
                    <div class="kmila-exercise-match kmila-exercise-match--ok">
                        <Icon Name="IconName.CheckCircleFill" />
                        <div>
                            <strong>@ConceptCatalog.Localize(_matchedComposition.Label, _lang, Traductor.T("CONCEPTS_EXERCISE_MATCHED"))</strong>
                            <span>@Traductor.T("CONCEPTS_EXERCISE_MATCH_HINT")</span>
                        </div>
                    </div>
                    <ExecutionPlayer Doc="_matchedComposition.Timeline" Lang="@_lang" />
                }
                else if (_attemptedRun && !string.IsNullOrEmpty(_lastFingerprint))
                {
                    <div class="kmila-exercise-match kmila-exercise-match--miss">
                        <Icon Name="IconName.QuestionDiamond" />
                        <div>
                            <strong>@Traductor.T("CONCEPTS_EXERCISE_NO_MATCH_TITLE")</strong>
                            <span>@Traductor.T("CONCEPTS_EXERCISE_NO_MATCH_BODY")</span>
                        </div>
                    </div>
                }
                else if (_attemptedRun)
                {
                    <div class="kmila-exercise-match kmila-exercise-match--miss">
                        <Icon Name="IconName.ExclamationTriangleFill" />
                        <div>
                            <strong>@Traductor.T("CONCEPTS_EXERCISE_EMPTY_TITLE")</strong>
                            <span>@Traductor.T("CONCEPTS_EXERCISE_EMPTY_BODY")</span>
                        </div>
                    </div>
                }
            </div>
        </article>

        <footer class="lesson-footer">
            <button type="button"
                    data-tour="exercise-complete-btn"
                    class="kmila-btn @(_completed ? "kmila-btn--ghost kmila-btn--primary" : "kmila-btn--success")"
                    @onclick="ToggleCompletedAsync">
                <Icon Name="@(_completed ? IconName.ArrowCounterclockwise : IconName.CheckCircleFill)" />
                <span>@Traductor.T(_completed ? "CONCEPTS_MARK_INCOMPLETE" : "CONCEPTS_MARK_COMPLETE")</span>
            </button>
        </footer>
    }
</section>

@code {
    [Parameter] public string ExerciseId { get; set; } = string.Empty;

    private ConceptModule? _module;
    private ConceptExercise? _exercise;
    private ExercisePayload? _payload;
    private BlockEditor? _editor;
    private string _lang = "en";
    private string? _title;
    private string? _summary;
    private string? _brief;
    private bool _loading = true;
    private bool _completed;
    private bool _running;
    private bool _attemptedRun;
    private string? _lastFingerprint;
    private ExerciseComposition? _matchedComposition;

    // ─── Interpreter (kmila-exec-sim.js) ────────────────────────────────
    private ExerciseSimResult? _sim;       // last interpreter run (null = none / fallback path)
    private int _fails;                    // unsuccessful runs this visit → reveals hints
    private int _bestStars;                // best stars on this device
    private string _code = string.Empty;   // live listing of the current blocks
    private bool _codeIsVhdl;
    private bool _codeDirty;               // re-colorize the code panel after render
    private bool _needCodeInit;            // build the listing once the editor holds the starter blocks

    private static readonly System.Text.Json.JsonSerializerOptions SimJson = new() { PropertyNameCaseInsensitive = true };

    private List<string>? HintList =>
        _payload == null || _payload.Hints.Count == 0 ? null
        : _payload.Hints.TryGetValue(_lang, out var h) && h.Count > 0 ? h
        : _payload.Hints.TryGetValue("en", out var en) ? en : null;
    private int HintCount => HintList?.Count ?? 0;
    private string? CurrentHint => _fails > 0 && HintCount > 0 ? HintList![Math.Min(_fails, HintCount) - 1] : null;

    private bool HasWorld => !string.IsNullOrEmpty(_payload?.World);

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLangChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needCodeInit && !_loading && _editor != null)
        {
            _needCodeInit = false;
            _ = InitCodeLaterAsync();
        }
        if (string.IsNullOrEmpty(_brief) && !_codeDirty) return;
        _codeDirty = false;
        // Pipe fenced code blocks in the brief (and the live code panel) through
        // Monaco's tokenizer so VHDL renders with the same colors as the Editor.
        try { await JS.InvokeVoidAsync("kmilaColorizeLessonCode", ".lesson-markdown"); }
        catch { /* monaco not loaded — fine */ }
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _lang = Traductor.Lang ?? "en";
        _matchedComposition = null;
        _attemptedRun = false;
        _lastFingerprint = null;

        var pair = await Catalog.GetExerciseAsync(ExerciseId);
        if (pair is null)
        {
            _module = null;
            _exercise = null;
            _payload = null;
            _loading = false;
            return;
        }

        _module = pair.Value.Module;
        _exercise = pair.Value.Exercise;
        _title = ConceptCatalog.Localize(_exercise.Titles, _lang, _exercise.Id);
        _summary = ConceptCatalog.Localize(_exercise.Summaries, _lang, string.Empty);

        _payload = await Catalog.GetExercisePayloadAsync(_exercise.Id);

        // Markdown brief is optional — lives next to the exercise JSON at
        // wwwroot/Concepts/exercises/{id}.md. We render whatever's there;
        // EN fallback is the catalog's standard policy.
        _brief = await Catalog.GetConceptBodyAsync("exercises", _exercise.Id, _lang);

        _completed = await Progress.IsCompletedAsync("exercises", _exercise.Id);

        _ = Progress.TouchLastOpenedAsync("exercises", _exercise.Id);
        _sim = null;
        _fails = 0;
        _code = string.Empty;
        _codeIsVhdl = _payload?.World is "logic" or "clocked" or "signals";
        _needCodeInit = true;
        try { _bestStars = HasWorld ? await JS.InvokeAsync<int>("kmilaExecSim.stars", _exercise.Id) : 0; }
        catch { _bestStars = 0; /* interpreter not loaded on this host yet */ }

        _loading = false;
    }

    /// <summary>
    /// The editor loads the starter blocks in its own first render, after ours — poll briefly until
    /// the workspace holds them so the code panel is there from the start.
    /// </summary>
    private async Task InitCodeLaterAsync()
    {
        for (var i = 0; i < 8 && string.IsNullOrEmpty(_code); i++)
        {
            await Task.Delay(250);
            await RefreshCodeAsync();
        }
        if (!string.IsNullOrEmpty(_code)) await InvokeAsync(StateHasChanged);
    }

    /// <summary>Refreshes the live code listing from the current blocks (interpreter worlds only).</summary>
    private async Task RefreshCodeAsync()
    {
        if (!HasWorld || _editor == null) return;
        try
        {
            var json = await _editor.SerializeAsync();
            var code = await JS.InvokeAsync<string?>("kmilaExecSim.code", _payload!.World, json, _lang) ?? string.Empty;
            if (code != _code) { _code = code; _codeDirty = true; }
        }
        catch { /* interpreter unavailable — no panel */ }
    }

    /// <summary>
    /// Runs the student's blocks in the exercise's interpreter world. Returns false when the
    /// interpreter isn't available (caller falls back to the pre-baked composition catalog).
    /// </summary>
    private async Task<bool> RunInterpreterAsync(string? workspaceJson)
    {
        string? raw;
        try
        {
            var goal = _payload!.Goal.ValueKind == System.Text.Json.JsonValueKind.Undefined ? "{}" : _payload.Goal.GetRawText();
            raw = await JS.InvokeAsync<string?>("kmilaExecSim.run", _payload.World, goal, workspaceJson ?? "{}", _lang);
        }
        catch { return false; }
        if (string.IsNullOrEmpty(raw)) return false;

        var sim = System.Text.Json.JsonSerializer.Deserialize<ExerciseSimResult>(raw, SimJson);
        if (sim == null) return false;
        _sim = sim;

        if (sim.Ok)
        {
            try { _bestStars = await JS.InvokeAsync<int>("kmilaExecSim.stars", _exercise!.Id, sim.Stars); } catch { }
            if (_exercise != null && !_completed)
            {
                await Progress.MarkCompletedAsync("exercises", _exercise.Id);
                _completed = true;
            }
        }
        else _fails++;

        // Restaurant world: replay the schedule in the figure.
        if (sim.Plan.ValueKind == System.Text.Json.JsonValueKind.Object)
        {
            try { await JS.InvokeVoidAsync("kmilaExecSim.showPlan", sim.Plan); } catch { }
        }
        return true;
    }

    /// <summary>
    /// Fired by BlockEditor whenever the workspace shape changes. We
    /// reset the match state so the student sees fresh feedback only
    /// after they explicitly click Run again.
    /// </summary>
    private async Task OnWorkspaceChanged()
    {
        _matchedComposition = null;
        _attemptedRun = false;
        _sim = null;
        await RefreshCodeAsync();
        StateHasChanged();
    }

    private async Task RunAsync()
    {
        if (_payload == null || _editor == null) return;
        _running = true;
        try
        {
            var json = await _editor.SerializeAsync();
            _lastFingerprint = BlockProgram.Fingerprint(json);
            _attemptedRun = true;
            _sim = null;

            // Interpreter first: any arrangement runs and explains itself.
            if (HasWorld && await RunInterpreterAsync(json))
            {
                await RefreshCodeAsync();
                return;
            }

            // Fallback: the pre-baked composition catalog (hosts without the interpreter).
            _matchedComposition = BlockProgram.FindMatch(_payload, _lastFingerprint);

            // Auto-mark completed the first time a match is found — same
            // contract as Learn's "open the sample once" rule.
            if (_matchedComposition != null && _exercise != null && !_completed)
            {
                await Progress.MarkCompletedAsync("exercises", _exercise.Id);
                _completed = true;
            }
        }
        finally
        {
            _running = false;
        }
    }

    private async Task ResetAsync()
    {
        if (_editor != null) await _editor.ClearAsync();
        _matchedComposition = null;
        _attemptedRun = false;
        _lastFingerprint = null;
        _sim = null;
        _code = string.Empty;
    }

    private async Task ToggleCompletedAsync()
    {
        if (_exercise == null) return;
        if (_completed)
            await Progress.MarkIncompleteAsync("exercises", _exercise.Id);
        else
            await Progress.MarkCompletedAsync("exercises", _exercise.Id);
        _completed = !_completed;
    }

    private void OnLangChanged()
    {
        InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private string KindLabel(ConceptExerciseKind k) => k switch
    {
        ConceptExerciseKind.Recipe  => Traductor.T("CONCEPTS_EXERCISE_KIND_RECIPE"),
        ConceptExerciseKind.Logic   => Traductor.T("CONCEPTS_EXERCISE_KIND_LOGIC"),
        ConceptExerciseKind.Clocked => Traductor.T("CONCEPTS_EXERCISE_KIND_CLOCKED"),
        ConceptExerciseKind.Scheduler => Traductor.T("CONCEPTS_EXERCISE_KIND_SCHEDULER"),
        ConceptExerciseKind.Signals   => Traductor.T("CONCEPTS_EXERCISE_KIND_SIGNALS"),
        _                           => k.ToString()
    };

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLangChanged;
    }
}
