    /// <summary>
    /// LCD rotating banner (FW-3 flagship). A 128-bit shift register holds
    /// the ASCII string "HELLO KMILA     " (16 chars, 8 bits each). Each
    /// STEP rising edge rotates the register left by one character so the
    /// banner scrolls across the top line of a 16×2 assisted LCD.
    /// </summary>
    private const string LCD_HELLO_VHD =
@"-- Kmila example: HD44780 LCD banner over the real 4-bit bus (raw wiring).
--
-- Pure VHDL. Instead of handing the LCD widget ready-made text, the design
-- speaks the actual HD44780 4-bit parallel protocol a real display needs:
--   • A command/data ROM holds the bytes to send: a Clear-Display command
--     (0x01) followed by the ASCII codes for ""HELLO KMILA"".
--   • A sequencer writes each byte as the HD44780 expects in 4-bit mode: the
--     HIGH nibble on DB7..DB4 latched by a rising edge on E, then the LOW
--     nibble latched by a second E pulse (exactly two E pulses per byte).
--   • RS selects command (0) vs data (1); RW is tied low (write only).
--
-- E-pulse width and the inter-step divider are sim-scaled so the whole banner
-- is written within a short run. Watch RS / E / DB in the Waveform viewer, or
-- open the Visual tab to see ""HELLO KMILA"" appear on the LCD.
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity lcd_banner is
    port(
        clk    : in  std_logic;
        reset  : in  std_logic;
        lcd_rs : out std_logic;                      -- 0 = command, 1 = data
        lcd_rw : out std_logic;                      -- tied low (write)
        lcd_e  : out std_logic;                      -- enable strobe
        lcd_db : out std_logic_vector(7 downto 4)    -- 4-bit data bus
    );
end lcd_banner;

architecture rtl of lcd_banner is
    constant STEP_CLKS : integer := 2;   -- clocks each micro-step is held (sim-scaled)

    -- Bytes to transmit (MSB-first binary, 8 bits each).
    type rom_t is array(0 to 11) of std_logic_vector(7 downto 0);
    constant DATA_ROM : rom_t := (
        0  => ""00000001"",   -- 0x01 Clear display (command)
        1  => ""01001000"",   -- 'H'
        2  => ""01000101"",   -- 'E'
        3  => ""01001100"",   -- 'L'
        4  => ""01001100"",   -- 'L'
        5  => ""01001111"",   -- 'O'
        6  => ""00100000"",   -- ' '
        7  => ""01001011"",   -- 'K'
        8  => ""01001101"",   -- 'M'
        9  => ""01001001"",   -- 'I'
        10 => ""01001100"",   -- 'L'
        11 => ""01000001""    -- 'A'
    );
    -- RS per entry: entry 0 is a command (0), the rest are data (1).
    constant RS_ROM : std_logic_vector(0 to 11) := ""011111111111"";

    signal byte_idx : integer range 0 to 12 := 0;  -- 12 = finished
    signal phase    : integer range 0 to 3 := 0;   -- micro-step within a byte
    signal div_cnt  : integer range 0 to STEP_CLKS := 0;
    signal rs_r     : std_logic := '0';
    signal e_r      : std_logic := '0';
    signal db_r     : std_logic_vector(7 downto 4) := ""0000"";
begin
    process(clk, reset)
        variable b : std_logic_vector(7 downto 0);
    begin
        if reset = '1' then
            byte_idx <= 0;
            phase    <= 0;
            div_cnt  <= 0;
            rs_r     <= '0';
            e_r      <= '0';
            db_r     <= ""0000"";
        elsif rising_edge(clk) then
            if byte_idx < 12 then
                if div_cnt < STEP_CLKS - 1 then
                    div_cnt <= div_cnt + 1;
                else
                    div_cnt <= 0;
                    b := DATA_ROM(byte_idx);
                    case phase is
                        when 0 =>                 -- setup HIGH nibble, E low
                            rs_r <= RS_ROM(byte_idx);
                            db_r <= b(7 downto 4);
                            e_r  <= '0';
                            phase <= 1;
                        when 1 =>                 -- E rising -> latch high nibble
                            e_r  <= '1';
                            phase <= 2;
                        when 2 =>                 -- setup LOW nibble, E low
                            e_r  <= '0';
                            db_r <= b(3 downto 0);
                            phase <= 3;
                        when others =>            -- E rising -> latch low nibble
                            e_r  <= '1';
                            phase <= 0;
                            byte_idx <= byte_idx + 1;
                    end case;
                end if;
            else
                e_r <= '0';   -- banner written; hold the bus idle
            end if;
        end if;
    end process;

    lcd_rs <= rs_r;
    lcd_rw <= '0';
    lcd_e  <= e_r;
    lcd_db <= db_r;
end rtl;
";

