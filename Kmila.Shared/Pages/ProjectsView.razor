    /// <summary>
    /// Creates a ready-to-run sample project and navigates straight to its editor.
    /// Name collisions are resolved by appending "(2)", "(3)", … so repeated clicks
    /// create distinct copies rather than failing silently.
    ///
    /// Backwards compat: the existing "Try a sample" button hits this method
    /// and gets the Demo Board (catalog id="demo"). The example-gallery modal
    /// invokes <see cref="CreateExampleAsync"/> directly with the user's pick.
    /// </summary>
    private async Task CreateSampleAsync()
    {
        await CreateExampleAsync(_examples[0]); // "demo"
    }

    private async Task PickExampleAsync(ExampleDef def)
    {
        _examplesModalOpen = false;
        StateHasChanged();
        await CreateExampleAsync(def);
    }

    /// <summary>
    /// Instantiates a project from a user-authored sample by re-importing its
    /// stored bundle, then navigates to its editor — the same "jump into the
    /// code" behaviour as the built-in examples.
    /// </summary>
    private async Task PickUserSampleAsync(UserSample sample)
    {
        _examplesModalOpen = false;
        StateHasChanged();
        try
        {
            var project = await UserSamples.CreateProjectFromSampleAsync(sample.Id, ResolveBasePath());
            if (project == null)
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    Traductor.T("PROJECTS_SAMPLE_ERROR"), ToastType.Danger));
                return;
            }
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("PROJECTS_SAMPLE_CREATED"), ToastType.Success));
            NavigationManager.NavigateTo($"/editor/{project.Id}");
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>Removes a user-authored sample from the gallery (does not touch
    /// any project already created from it).</summary>
    private async Task DeleteUserSampleAsync(UserSample sample)
    {
        var ok = await _removeProjectDialog.ShowAsync(
            Traductor.T("EXAMPLES_SAMPLE_DELETE_TITLE"),
            string.Format(Traductor.T("EXAMPLES_SAMPLE_DELETE_MSG"), sample.Title),
            new ConfirmDialogOptions
            {
                YesButtonColor = ButtonColor.Danger,
                YesButtonText = Traductor.T("COMMON_DELETE"),
                NoButtonColor = ButtonColor.Secondary,
                NoButtonText = Traductor.T("COMMON_CANCEL")
            });
        if (!ok) return;
        await UserSamples.DeleteAsync(sample.Id);
        _userSamples = await UserSamples.ListAsync();
        StateHasChanged();
    }

    /// <summary>Platform-appropriate data directory root (matches
    /// <see cref="CreateExampleAsync"/> and Settings bundle import).</summary>
    private static string ResolveBasePath()
    {
#if WINDOWS || MACCATALYST || ANDROID || IOS
        return FileSystem.AppDataDirectory;
#else
        return OperatingSystem.IsBrowser()
            ? "/kmila"
            : Path.Combine(
                System.Environment.GetFolderPath(System.Environment.SpecialFolder.ApplicationData),
                "KmilaData");
#endif
    }

    private async Task CreateExampleAsync(ExampleDef def)
    {
        try
        {
            // Platform-appropriate data directory (matches ProjectDetailsModal)
            string basePath;
#if WINDOWS || MACCATALYST || ANDROID || IOS
            basePath = FileSystem.AppDataDirectory;
#else
            basePath = OperatingSystem.IsBrowser()
                ? "/kmila"   // Blazor WASM: MEMFS root (see UserAssetStore)
                : Path.Combine(
                    System.Environment.GetFolderPath(System.Environment.SpecialFolder.ApplicationData),
                    "KmilaData");
#endif

            var baseName = Traductor.T(def.NameKey);
            var name = await FindAvailableNameAsync(baseName);
            var folder = name.Replace(" ", "").Replace("·", "").Replace("/", "_").Replace("-", "_");
            var projectPath = Path.Combine(basePath, "Projects", folder);

            var project = new Project
            {
                Name = name,
                Description = Traductor.T(def.DescKey),
                BasePath = projectPath
            };

            var created = await Projects.CreateAsync(project);
            if (!created)
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    $"{Traductor.T("PROJECTS_SAMPLE_ERROR")}: {Projects.LastError}", ToastType.Danger));
                return;
            }

            // Write the starter VHDL file via the ProjectFiles repository so
            // the disk + DB stay in lockstep with the rest of the app.
            // Ring 5: single-file examples use def.Vhd → def.MainFileName;
            // multi-file examples (capstone) leave def.Vhd empty and inject
            // every file through ExtraFiles.
            if (!string.IsNullOrEmpty(def.Vhd))
            {
                var file = new ProjectFile
                {
                    Project = project,
                    FileName = def.MainFileName,
                    Content = def.Vhd
                };
                await ProjectFiles.CreateAsync(file);
            }

            if (def.ExtraFiles != null)
            {
                foreach (var (fileName, content) in def.ExtraFiles.Invoke())
                {
                    var extra = new ProjectFile
                    {
                        Project = project,
                        FileName = fileName,
                        Content = content
                    };
                    await ProjectFiles.CreateAsync(extra);
                }
            }

            // Phase 3 (2026-06-26): every catalog example ships a pre-wired
            // .kviz sidecar so the Visual tab is immediately functional.
            // Sidecar file name mirrors the top-level design's stem so the
            // VisualPanel's KvizExt convention (`<stem>.kviz`) resolves it.
            var kvizName = System.IO.Path.GetFileNameWithoutExtension(def.MainFileName) + ".kviz";
            var kvizFile = new ProjectFile
            {
                Project = project,
                FileName = kvizName,
                Content = def.Kviz
            };
            await ProjectFiles.CreateAsync(kvizFile);

            // Only the Demo Board has a curated bounded-sim configuration
            // (port moments matching its 5-input shape). For Counter Clock
            // and Traffic Light the user can drive the canvas directly from
            // the Visual tab; bounded sim still works against any per-design
            // configuration the user adds later.
            if (def.Id == "demo")
            {
                await SaveSampleConfigurationAsync();
                Sim.PendingConfigurationName = Traductor.T("PROJECTS_SAMPLE_CONFIG_NAME");
            }

            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("PROJECTS_SAMPLE_CREATED"), ToastType.Success));

            // Jump into the new project's editor — the user wants to see the code.
            NavigationManager.NavigateTo($"/editor/{project.Id}");
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>
    /// Persists a ready-to-run simulation configuration keyed to the sample
    /// project's ports. Saving idempotently — if the name already exists
    /// (user clicked "Try a sample" before), we just overwrite, which is
    /// what <see cref="ConfigurationService.SaveConfigurationAsync"/> does
    /// under the hood anyway.
    ///
    /// Shape (matches the Demo Board sample design — 5 inputs):
    ///   • Time          : 30 US (long enough for the counter to wrap and
    ///                     the stepper to rotate several full revolutions)
    ///   • FPGA          : whatever the user currently has selected (may be null)
    ///   • Port moments  :
    ///       – clk    → clock signal marker
    ///       – reset  → '1' @ 0 ns, '0' @ 50 ns (one clean reset pulse)
    ///       – run    → '0' @ 0 ns, '1' @ 100 ns (start counting once
    ///                  reset releases), '0' @ 12000 ns, '1' @ 18000 ns
    ///                  (a 6 µs pause window mid-run so the user can
    ///                  watch every output freeze and then resume)
    ///       – dir    → '1' @ 0 ns (clockwise stepper direction)
    ///       – nudge  → '0' @ 0 ns, '1' @ 22000 ns, '0' @ 23000 ns
    ///                  (a single 1 µs nudge pulse late in the run to show
    ///                  the btn_echo LED following the input)
    /// </summary>
    private async Task SaveSampleConfigurationAsync()
    {
        try
        {
            var portMoments = new List<PortMomentConfiguration>
            {
                new PortMomentConfiguration
                {
                    PortName = "clk",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0, TimeScale = "CLK", Value = "CLOCK" }
                    }
                },
                new PortMomentConfiguration
                {
                    PortName = "reset",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0,  TimeScale = "NS", Value = "1" },
                        new PortMomentValue { Time = 50, TimeScale = "NS", Value = "0" }
                    }
                },
                new PortMomentConfiguration
                {
                    PortName = "run",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0,     TimeScale = "NS", Value = "0" },
                        new PortMomentValue { Time = 100,   TimeScale = "NS", Value = "1" },
                        new PortMomentValue { Time = 12000, TimeScale = "NS", Value = "0" },
                        new PortMomentValue { Time = 18000, TimeScale = "NS", Value = "1" }
                    }
                },
                new PortMomentConfiguration
                {
                    PortName = "dir",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0, TimeScale = "NS", Value = "1" }
                    }
                },
                new PortMomentConfiguration
                {
                    PortName = "nudge",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0,     TimeScale = "NS", Value = "0" },
                        new PortMomentValue { Time = 22000, TimeScale = "NS", Value = "1" },
                        new PortMomentValue { Time = 23000, TimeScale = "NS", Value = "0" }
                    }
                }
            };

            var cfg = ConfigurationService.CreateConfiguration(
                name: Traductor.T("PROJECTS_SAMPLE_CONFIG_NAME"),
                description: Traductor.T("PROJECTS_SAMPLE_CONFIG_DESCRIPTION"),
                fpga: SelectedFPGA?.FPGA,
                fpgaPath: SelectedFPGA?.Path ?? string.Empty,
                timeValue: 30,
                timeScale: "US",
                portMoments: portMoments);

            await ConfigService.SaveConfigurationAsync(cfg);
        }
        catch
        {
            // Non-fatal: the project + VHDL file are already created; the user
            // can still configure manually. Stay silent to avoid confusing the
            // main success toast with a secondary warning.
        }
    }

    /// <summary>
    /// Suffixes " (N)" onto the name until it doesn't collide with an existing
    /// project name in the DB. Case-insensitive comparison matches what the
    /// repository enforces.
    /// </summary>
    private async Task<string> FindAvailableNameAsync(string baseName)
    {
        var existing = (await Projects.GetListAsync() ?? new())
            .Select(p => p.Name.ToLowerInvariant()).ToHashSet();
        if (!existing.Contains(baseName.ToLowerInvariant())) return baseName;
        for (var i = 2; i < 1000; i++)
        {
            var candidate = $"{baseName} ({i})";
            if (!existing.Contains(candidate.ToLowerInvariant())) return candidate;
        }
        return $"{baseName} ({DateTime.Now:yyyyMMdd_HHmmss})";
    }

    private async Task RemoveProjectAsync(Project project)
    {
        var options = new ConfirmDialogOptions
        {
            YesButtonColor = ButtonColor.Danger,
            NoButtonColor = ButtonColor.Secondary,
            AutoFocusYesButton = false,
            YesButtonText = Traductor.T("PROJECTS_REMOVE"),
            NoButtonText = Traductor.T("COMMON_GO_BACK")
        };
        var ok = await _removeProjectDialog.ShowAsync(
            title: $"{Traductor.T("PROJECTS_REMOVING")}: {project.Name}",
            message1: string.Format(Traductor.T("PROJECTS_REMOVE_MSG1"), project.BasePath),
            message2: Traductor.T("PROJECTS_REMOVE_MSG2"),
            confirmDialogOptions: options
        );

        if (ok)
        {
            var result = await Projects.RemoveAsync(project);
            ToastService.Notify(Message(
                result ? Traductor.T("PROJECTS_REMOVED") : Traductor.T("COMMON_ERROR"),
                result ? Traductor.T("PROJECTS_REMOVED_SUCCESS") : $"{Traductor.T("PROJECTS_REMOVED_ERROR")}: {Projects.LastError}",
                result ? ToastType.Success : ToastType.Warning
            ));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("PROJECTS_NOT_REMOVED"), Traductor.T("PROJECTS_NOT_REMOVED_MSG")));
        }
        _projects = await Projects.GetListAsync() ?? new();
        StateHasChanged();
    }

    private async Task CreateProjectAsync()
    {
        // v1 templates flow: the gallery modal owns project-creation now.
        // The legacy ProjectDetailsModal still exists for the "Edit project"
        // path, but the primary create-flow goes through TemplateGalleryModal
        // so users land on a multi-file scaffold instead of a single empty
        // main.vhd. The gallery's first card ("Empty scaffold") is the
        // closest analog to the old behaviour.
        var parameters = new Dictionary<string, object>
        {
            { "OnProjectCreated", EventCallback.Factory.Create<Project>(this, OnTemplateProjectCreatedAsync) }
        };
        await _newProjectModal.ShowAsync<TemplateGalleryModal>(Traductor.T("TEMPLATE_GALLERY_TITLE"), parameters: parameters);
    }

    /// <summary>
    /// Invoked by TemplateGalleryModal after a successful create. Refreshes
    /// the projects grid, hides the modal, and navigates to the new project's
    /// editor so the user sees the freshly-scaffolded files immediately.
    /// </summary>
    private async Task OnTemplateProjectCreatedAsync(Project project)
    {
        _projects = await Projects.GetListAsync() ?? new();
        await _newProjectModal.HideAsync();
        NavigationManager.NavigateTo($"/editor/{project.Id}");
    }
}
