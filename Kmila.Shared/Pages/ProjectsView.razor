                 440 when note_sel = ""101"" else   -- A4
                 494 when note_sel = ""110"" else   -- B4
                 523;                               -- C5

    freq_hz <= std_logic_vector(to_unsigned(note_freq, 16));
    gate    <= enable;
end rtl;
