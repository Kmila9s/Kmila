    /// <summary>
    /// Counter Clock example — 2-digit decimal counter wrapping 00→99 with
    /// an overflow pulse. Shows two 7-seg widgets in decoded-decimal mode +
    /// an overflow LED. Demonstrates BCD-style decoding + finite-state
    /// rollover.
    /// </summary>
    private const string COUNTER_CLOCK_VHD =
@"-- Kmila example: 2-digit decimal counter (00 -> 99 -> 00 + overflow pulse).
--
-- Pure VHDL, raw 7-segment wiring (no assisted decoding). The design drives
-- the real segment lines a..g of two common-anode displays itself, exactly
-- like a counter you would synthesise onto an FPGA. Three building blocks:
--   1. A BCD counter: `units` 0-9, carrying into `tens` 0-9, with an overflow
--      pulse on the 99 -> 00 rollover. Advances one step per `tick`.
--   2. Two 7-segment decoders: each turns a 0-9 digit into the 7 segment
--      bits. Common anode => a segment lights when its bit is '0'.
--   3. Output wiring: the decoded patterns leave on `units_seg` / `tens_seg`.
--
-- Try a breakpoint on the `t_q <= t_q + 1` line to watch the carry in
-- step-replay, or open the Visual tab and hold TICK to see the digits run.
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity counter_clock is
  port (
    clk       : in  STD_LOGIC;
    reset     : in  STD_LOGIC;
    tick      : in  STD_LOGIC;
    -- Raw segment buses: bit 6 = a, bit 5 = b, ... bit 0 = g (common anode).
    units_seg : out STD_LOGIC_VECTOR(6 downto 0);
    tens_seg  : out STD_LOGIC_VECTOR(6 downto 0);
    overflow  : out STD_LOGIC
  );
end entity counter_clock;

architecture behavioral of counter_clock is
  signal u_q  : unsigned(3 downto 0) := (others => '0');  -- units digit (0-9)
  signal t_q  : unsigned(3 downto 0) := (others => '0');  -- tens  digit (0-9)
  signal ov_q : STD_LOGIC := '0';
begin
  -- The BCD counter. One increment per `tick`; overflow pulses for a single
  -- clock when the display rolls 99 -> 00.
  process(clk, reset)
  begin
    if reset = '1' then
      u_q  <= (others => '0');
      t_q  <= (others => '0');
      ov_q <= '0';
    elsif rising_edge(clk) then
      ov_q <= '0';
      if tick = '1' then
        if u_q = 9 then
          u_q <= (others => '0');
          if t_q = 9 then
            t_q  <= (others => '0');
            ov_q <= '1';
          else
            t_q <= t_q + 1;
          end if;
        else
          u_q <= u_q + 1;
        end if;
      end if;
    end if;
  end process;

  -- Units 7-segment decoder. Common anode: a segment lights when its bit is
  -- '0'. Bit order a b c d e f g (bit 6 = a ... bit 0 = g).
  process(u_q)
  begin
    case to_integer(u_q) is
      when 0 => units_seg <= ""0000001"";
      when 1 => units_seg <= ""1001111"";
      when 2 => units_seg <= ""0010010"";
      when 3 => units_seg <= ""0000110"";
      when 4 => units_seg <= ""1001100"";
      when 5 => units_seg <= ""0100100"";
      when 6 => units_seg <= ""0100000"";
      when 7 => units_seg <= ""0001111"";
      when 8 => units_seg <= ""0000000"";
      when 9 => units_seg <= ""0000100"";
      when others => units_seg <= ""1111111"";
    end case;
  end process;

  -- Tens 7-segment decoder (identical table, separate display).
  process(t_q)
  begin
    case to_integer(t_q) is
      when 0 => tens_seg <= ""0000001"";
      when 1 => tens_seg <= ""1001111"";
      when 2 => tens_seg <= ""0010010"";
      when 3 => tens_seg <= ""0000110"";
      when 4 => tens_seg <= ""1001100"";
      when 5 => tens_seg <= ""0100100"";
      when 6 => tens_seg <= ""0100000"";
      when 7 => tens_seg <= ""0001111"";
      when 8 => tens_seg <= ""0000000"";
      when 9 => tens_seg <= ""0000100"";
      when others => tens_seg <= ""1111111"";
    end case;
  end process;

  overflow <= ov_q;
end architecture behavioral;
";

