@page "/projects"
@page "/projects/{Option}"
@implements IDisposable
@inject Kmila.Shared.Services.SimulationParameters Sim
@inject Kmila.Shared.Services.ProgramBuilder Builder

<PageTitle>@Traductor.T("NAV_PROJECTS")</PageTitle>

<section class="projects-page">

    @* Header: eyebrow, title, count, search, primary CTA *@
    <header class="projects-header">
        <div class="projects-header__titles">
            <span class="home-section__eyebrow">@Traductor.T("NAV_PROJECT_OPTIONS")</span>
            <h1 class="projects-header__title">
                @Traductor.T("NAV_PROJECTS")
                @if (!_loading && _projects.Count > 0)
                {
                    <span class="projects-header__count">@_projects.Count</span>
                }
            </h1>
        </div>

        <div class="projects-header__tools">
            <label class="projects-search">
                <Icon Name="IconName.Search" />
                <input type="search"
                       class="form-control"
                       placeholder="@Traductor.T("PROJECTS_SEARCH_PLACEHOLDER")"
                       aria-label="@Traductor.T("PROJECTS_SEARCH_PLACEHOLDER")"
                       @bind="_filter"
                       @bind:event="oninput" />
                @if (!string.IsNullOrEmpty(_filter))
                {
                    <button type="button" class="projects-search__clear"
                            @onclick="() => _filter = string.Empty"
                            aria-label="@Traductor.T("COMMON_CLEAR")">
                        <Icon Name="IconName.X" />
                    </button>
                }
            </label>

            <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary projects-sample"
                    @onclick="CreateSampleAsync"
                    title="@Traductor.T("PROJECTS_SAMPLE_HINT")">
                <Icon Name="IconName.LightningChargeFill" />
                <span>@Traductor.T("PROJECTS_CREATE_SAMPLE")</span>
            </button>

            <button type="button" class="kmila-btn kmila-btn--accent projects-cta" @onclick="CreateProjectAsync">
                <Icon Name="IconName.PlusLg" />
                <span>@Traductor.T("PROJECTS_CREATE_NEW")</span>
            </button>
        </div>
    </header>

    @* Body: loading / empty / no-match / grid *@
    @if (_loading)
    {
        <div class="projects-grid">
            @for (var i = 0; i < 6; i++)
            {
                <div class="project-card project-card--skeleton">
                    <div class="skeleton skeleton--avatar"></div>
                    <div class="skeleton skeleton--title"></div>
                    <div class="skeleton skeleton--line"></div>
                    <div class="skeleton skeleton--line skeleton--short"></div>
                </div>
            }
        </div>
    }
    else if (_projects.Count == 0)
    {
        <div class="projects-empty">
            <div class="projects-empty__icon"><Icon Name="IconName.Folder2" /></div>
            <h2>@Traductor.T("PROJECTS_EMPTY_TITLE")</h2>
            <p>@Traductor.T("PROJECTS_EMPTY_BODY")</p>
            <div class="projects-empty__actions">
                <button type="button" class="kmila-btn kmila-btn--accent kmila-btn--lg" @onclick="CreateProjectAsync">
                    <Icon Name="IconName.PlusLg" />
                    <span>@Traductor.T("PROJECTS_CREATE_NEW")</span>
                </button>
                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary btn-lg" @onclick="CreateSampleAsync">
                    <Icon Name="IconName.LightningChargeFill" />
                    <span>@Traductor.T("PROJECTS_CREATE_SAMPLE")</span>
                </button>
            </div>
        </div>
    }
    else if (!Filtered.Any())
    {
        <div class="projects-empty projects-empty--compact">
            <div class="projects-empty__icon"><Icon Name="IconName.Search" /></div>
            <h2>@Traductor.T("PROJECTS_NO_MATCH_TITLE")</h2>
            <p>@string.Format(Traductor.T("PROJECTS_NO_MATCH_BODY"), _filter)</p>
            <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--accent" @onclick="() => _filter = string.Empty">
                <Icon Name="IconName.ArrowCounterclockwise" />
                <span>@Traductor.T("COMMON_CLEAR")</span>
            </button>
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var project in Filtered)
            {
                var isRunning = Sim.RunningProjectId == project.Id;
                var isPaused  = isRunning && Sim.State == SimState.Paused;
                var pct       = (int)Math.Round(Sim.Progress);
                <article class="project-card @(isRunning ? "project-card--running" : "")">
                    <a href="@($"/editor/{project.Id}")" class="project-card__link" aria-label="@project.Name">
                        <div class="project-card__avatar">
                            <Icon Name="IconName.FileEarmarkCode" />
                        </div>
                        <div class="project-card__body">
                            <h3 class="project-card__name">
                                @project.Name
                                @if (isRunning)
                                {
                                    <span class="project-card__running-badge" title="@(isPaused ? Traductor.T("SIDEBAR_PROJECT_PAUSED") : Traductor.T("SIDEBAR_PROJECT_RUNNING"))">
                                        <span class="project-card__running-dot" aria-hidden="true"></span>
                                        @(isPaused ? Traductor.T("RUN_STATE_PAUSED") : Traductor.T("RUN_STATE_RUNNING")) · @pct%
                                    </span>
                                }
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(project.Description))
                            {
                                <p class="project-card__description">@project.Description</p>
                            }
                            else
                            {
                                <p class="project-card__description project-card__description--muted">
                                    @Traductor.T("PROJECTS_NO_DESCRIPTION")
                                </p>
                            }
                            @if (isRunning)
                            {
                                <div class="project-card__progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                    <div class="project-card__progress-fill" style="width: @pct%;"></div>
                                </div>
                            }
                        </div>
                        <div class="project-card__meta">
                            <span class="project-card__date" title="@project.CreationTime.ToString("F")">
                                <Icon Name="IconName.Clock" />
                                @FormatDate(project.CreationTime)
                            </span>
                        </div>
                    </a>

                    <div class="project-card__actions" aria-label="@Traductor.T("PROJECTS_OPTIONS")">
                        @if (isRunning)
                        {
                            @if (isPaused)
                            {
                                <button type="button"
                                        class="project-card__action project-card__action--accent"
                                        title="@Traductor.T("SIM_RESUME")"
                                        @onclick="OnResumeSimulation"
                                        @onclick:preventDefault
                                        @onclick:stopPropagation>
                                    <Icon Name="IconName.PlayFill" />
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="project-card__action"
                                        title="@Traductor.T("SIM_PAUSE")"
                                        @onclick="OnPauseSimulation"
                                        @onclick:preventDefault
                                        @onclick:stopPropagation>
                                    <Icon Name="IconName.PauseFill" />
                                </button>
                            }
                            <button type="button"
                                    class="project-card__action project-card__action--danger"
                                    title="@Traductor.T("SIM_STOP")"
                                    @onclick="OnStopSimulation"
                                    @onclick:preventDefault
                                    @onclick:stopPropagation>
                                <Icon Name="IconName.StopFill" />
                            </button>
                        }
                        else
                        {
                            <a href="@($"/editor/{project.Id}")"
                               class="project-card__action"
                               title="@Traductor.T("PROJECTS_OPEN")">
                                <Icon Name="IconName.BoxArrowUpRight" />
                            </a>
                            <button type="button"
                                    class="project-card__action project-card__action--danger"
                                    title="@Traductor.T("PROJECTS_REMOVE")"
                                    @onclick="() => RemoveProjectAsync(project)"
                                    @onclick:preventDefault
                                    @onclick:stopPropagation>
                                <Icon Name="IconName.Trash" />
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>

<Modal Size="ModalSize.Large" IsScrollable=true @ref="_newProjectModal" />
<ConfirmDialog @ref="_removeProjectDialog" />

@code {
    [Parameter] public string? Option { get; set; }

    private Modal _newProjectModal = new();
    private ConfirmDialog _removeProjectDialog = new();
    private List<Project> _projects = new();
    private string _filter = string.Empty;
    private bool _loading = true;

    private IEnumerable<Project> Filtered =>
        string.IsNullOrWhiteSpace(_filter)
            ? _projects
            : _projects.Where(p =>
                (p.Name?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Description?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Re-render whenever the global simulation state changes so the running
    /// project's card picks up progress / pause / stop transitions even while
    /// the user lingers on /projects with a long sim in the background.
    /// </summary>
    private void OnSimChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
        Sim.OnChange -= OnSimChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Sim.OnChange += OnSimChanged;
        try
        {
            _projects = await Projects.GetListAsync() ?? new();
        }
        catch
        {
            _projects = new();
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Pauses the active simulation directly from a project card. Mirrors
    /// the sidebar / Run-bar handler so the user can park a long sim without
    /// jumping into the editor.
    /// </summary>
    private void OnPauseSimulation()
    {
        if (Sim.State != SimState.Running) return;
        Builder.PauseTimer();
        Sim.SetState(SimState.Paused);
    }

    /// <summary>Resumes a paused simulation from a project card.</summary>
    private void OnResumeSimulation()
    {
        if (Sim.State != SimState.Paused) return;
        Builder.ContinueTimer();
        Sim.SetState(SimState.Running);
    }

    /// <summary>
    /// Stops the active simulation from a project card. EndRun is called
    /// defensively in case the Editor isn't currently mounted (and therefore
    /// can't react to the engine's OnSimulationEnded event); when Editor
    /// is mounted, its handler will re-run the same cleanup as a no-op.
    /// </summary>
    private void OnStopSimulation()
    {
        if (Sim.State != SimState.Running && Sim.State != SimState.Paused) return;
        Builder.StopTimer();
        Sim.SetState(SimState.Complete);
        Sim.SetProgress(0);
        Sim.EndRun();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(Option))
        {
            if (string.Equals(Option, "create", StringComparison.OrdinalIgnoreCase))
            {
                await CreateProjectAsync();
            }
        }
    }

    /// <summary>
    /// Renders a compact, human-friendly date ("Today", "Yesterday", "3d ago",
    /// otherwise localized short date). Tooltip shows the full timestamp.
    /// </summary>
    private string FormatDate(DateTime dt)
    {
        var now = DateTime.Now;
        var span = now - dt;
        if (span.TotalDays < 1 && dt.Date == now.Date) return Traductor.T("DATE_TODAY");
        if (dt.Date == now.Date.AddDays(-1)) return Traductor.T("DATE_YESTERDAY");
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}{Traductor.T("DATE_DAYS_SHORT")}";
        return dt.ToString("yyyy-MM-dd");
    }

    /// <summary>
    /// The VHDL content shipped with the sample project. Kept as a constant
    /// (not a translated resource) since VHDL itself is English-keyworded and
    /// students benefit from seeing canonical source code in the language they
    /// encounter everywhere else.
    /// </summary>
    private const string SAMPLE_MAIN_VHD =
@"-- Kmila sample project: a 7-stage ripple counter (""Visible Wave"").
-- Click ▶ Run and watch the Waveforms tab fill in live.
--
-- What you should see:
--   • bit0 toggles every clock cycle (densest trace)
--   • each higher bit toggles half as often as the one below it
--   • bit6 only toggles ~12 times across the whole run — easy to read
--   • from 5 µs to 10 µs `enable` goes low and every output freezes,
--     then resumes — clear proof the waveform is rendering live
--   • heart mirrors bit3 so you have a slower rhythm to track

library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity sim_lab is
  port (
    clk    : in  STD_LOGIC;
    reset  : in  STD_LOGIC;
    enable : in  STD_LOGIC;
    bit0   : out STD_LOGIC;
    bit1   : out STD_LOGIC;
    bit2   : out STD_LOGIC;
    bit3   : out STD_LOGIC;
    bit4   : out STD_LOGIC;
    bit5   : out STD_LOGIC;
    bit6   : out STD_LOGIC;
    heart  : out STD_LOGIC
  );
end entity sim_lab;

architecture behavioral of sim_lab is
  signal q0, q1, q2, q3, q4, q5, q6 : STD_LOGIC := '0';
  signal h_reg : STD_LOGIC := '0';
begin
  process(clk, reset)
  begin
    if reset = '1' then
      q0 <= '0'; q1 <= '0'; q2 <= '0'; q3 <= '0';
      q4 <= '0'; q5 <= '0'; q6 <= '0';
      h_reg <= '0';
    elsif rising_edge(clk) then
      if enable = '1' then
        q0 <= not q0;
        if q0 = '1' then
          q1 <= not q1;
          if q1 = '1' then
            q2 <= not q2;
            if q2 = '1' then
              q3 <= not q3;
              if q3 = '1' then
                q4 <= not q4;
                if q4 = '1' then
                  q5 <= not q5;
                  if q5 = '1' then
                    q6 <= not q6;
                  end if;
                end if;
              end if;
            end if;
          end if;
        end if;
        h_reg <= q3;
      end if;
    end if;
  end process;

  bit0  <= q0;
  bit1  <= q1;
  bit2  <= q2;
  bit3  <= q3;
  bit4  <= q4;
  bit5  <= q5;
  bit6  <= q6;
  heart <= h_reg;
end architecture behavioral;
";

    /// <summary>
    /// Creates a ready-to-run sample project and navigates straight to its editor.
    /// Name collisions are resolved by appending "(2)", "(3)", … so repeated clicks
    /// create distinct copies rather than failing silently.
    /// </summary>
    private async Task CreateSampleAsync()
    {
        try
        {
            // Platform-appropriate data directory (matches ProjectDetailsModal)
            string basePath;
#if WINDOWS || MACCATALYST || ANDROID || IOS
            basePath = FileSystem.AppDataDirectory;
#else
            basePath = Path.Combine(
                System.Environment.GetFolderPath(System.Environment.SpecialFolder.ApplicationData),
                "KmilaData");
#endif

            var baseName = Traductor.T("PROJECTS_SAMPLE_NAME");
            var name = await FindAvailableNameAsync(baseName);
            var folder = name.Replace(" ", "").Replace("·", "").Replace("/", "_").Replace("-", "_");
            var projectPath = Path.Combine(basePath, "Projects", folder);

            var project = new Project
            {
                Name = name,
                Description = Traductor.T("PROJECTS_SAMPLE_DESCRIPTION"),
                BasePath = projectPath
            };

            var created = await Projects.CreateAsync(project);
            if (!created)
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    $"{Traductor.T("PROJECTS_SAMPLE_ERROR")}: {Projects.LastError}", ToastType.Danger));
                return;
            }

            // Write the starter VHDL file via the ProjectFiles repository so
            // the disk + DB stay in lockstep with the rest of the app.
            var file = new ProjectFile
            {
                Project = project,
                FileName = "main.vhd",
                Content = SAMPLE_MAIN_VHD
            };
            await ProjectFiles.CreateAsync(file);

            // Save a companion simulation configuration and ask the Editor to
            // auto-apply it as soon as the project finishes loading. We don't
            // bind configs to projects in the DB (they're global), but the
            // one-shot pending slot on SimulationParameters lets us hand off
            // without stale-stimulus-across-projects side effects.
            await SaveSampleConfigurationAsync();
            Sim.PendingConfigurationName = Traductor.T("PROJECTS_SAMPLE_CONFIG_NAME");

            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("PROJECTS_SAMPLE_CREATED"), ToastType.Success));

            // Jump into the new project's editor — the user wants to see the code.
            NavigationManager.NavigateTo($"/editor/{project.Id}");
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>
    /// Persists a ready-to-run simulation configuration keyed to the sample
    /// project's ports. Saving idempotently — if the name already exists
    /// (user clicked "Try a sample" before), we just overwrite, which is
    /// what <see cref="ConfigurationService.SaveConfigurationAsync"/> does
    /// under the hood anyway.
    ///
    /// Shape (matches the Visible Wave sample design):
    ///   • Time          : 30 US (1500 cycles at 50 MHz — long enough for
    ///                     the live-update timer to fire several times so
    ///                     the waveform is seen growing on-screen)
    ///   • FPGA          : whatever the user currently has selected (may be null)
    ///   • Port moments  :
    ///       – clk    → clock signal marker
    ///       – reset  → '1' @ 0 ns, '0' @ 50 ns (one clean reset pulse)
    ///       – enable → '0' @ 0 ns, '1' @ 100 ns (start counting once
    ///                  reset releases), '0' @ 5000 ns, '1' @ 10000 ns
    ///                  (a 5 µs pause window mid-run so the user can
    ///                  watch every output freeze and then resume)
    /// </summary>
    private async Task SaveSampleConfigurationAsync()
    {
        try
        {
            var portMoments = new List<PortMomentConfiguration>
            {
                new PortMomentConfiguration
                {
                    PortName = "clk",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0, TimeScale = "CLK", Value = "CLOCK" }
                    }
                },
                new PortMomentConfiguration
                {
                    PortName = "reset",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0,  TimeScale = "NS", Value = "1" },
                        new PortMomentValue { Time = 50, TimeScale = "NS", Value = "0" }
                    }
                },
                new PortMomentConfiguration
                {
                    PortName = "enable",
                    Values = new List<PortMomentValue>
                    {
                        new PortMomentValue { Time = 0,     TimeScale = "NS", Value = "0" },
                        new PortMomentValue { Time = 100,   TimeScale = "NS", Value = "1" },
                        new PortMomentValue { Time = 5000,  TimeScale = "NS", Value = "0" },
                        new PortMomentValue { Time = 10000, TimeScale = "NS", Value = "1" }
                    }
                }
            };

            var cfg = ConfigService.CreateConfiguration(
                name: Traductor.T("PROJECTS_SAMPLE_CONFIG_NAME"),
                description: Traductor.T("PROJECTS_SAMPLE_CONFIG_DESCRIPTION"),
                fpga: SelectedFPGA?.FPGA,
                fpgaPath: SelectedFPGA?.Path ?? string.Empty,
                timeValue: 30,
                timeScale: "US",
                portMoments: portMoments);

            await ConfigService.SaveConfigurationAsync(cfg);
        }
        catch
        {
            // Non-fatal: the project + VHDL file are already created; the user
            // can still configure manually. Stay silent to avoid confusing the
            // main success toast with a secondary warning.
        }
    }

    /// <summary>
    /// Suffixes " (N)" onto the name until it doesn't collide with an existing
    /// project name in the DB. Case-insensitive comparison matches what the
    /// repository enforces.
    /// </summary>
    private async Task<string> FindAvailableNameAsync(string baseName)
    {
        var existing = (await Projects.GetListAsync() ?? new())
            .Select(p => p.Name.ToLowerInvariant()).ToHashSet();
        if (!existing.Contains(baseName.ToLowerInvariant())) return baseName;
        for (var i = 2; i < 1000; i++)
        {
            var candidate = $"{baseName} ({i})";
            if (!existing.Contains(candidate.ToLowerInvariant())) return candidate;
        }
        return $"{baseName} ({DateTime.Now:yyyyMMdd_HHmmss})";
    }

    private async Task RemoveProjectAsync(Project project)
    {
        var options = new ConfirmDialogOptions
        {
            YesButtonColor = ButtonColor.Danger,
            NoButtonColor = ButtonColor.Secondary,
            AutoFocusYesButton = false,
            YesButtonText = Traductor.T("PROJECTS_REMOVE"),
            NoButtonText = Traductor.T("COMMON_GO_BACK")
        };
        var ok = await _removeProjectDialog.ShowAsync(
            title: $"{Traductor.T("PROJECTS_REMOVING")}: {project.Name}",
            message1: string.Format(Traductor.T("PROJECTS_REMOVE_MSG1"), project.BasePath),
            message2: Traductor.T("PROJECTS_REMOVE_MSG2"),
            confirmDialogOptions: options
        );

        if (ok)
        {
            var result = await Projects.RemoveAsync(project);
            ToastService.Notify(Message(
                result ? Traductor.T("PROJECTS_REMOVED") : Traductor.T("COMMON_ERROR"),
                result ? Traductor.T("PROJECTS_REMOVED_SUCCESS") : $"{Traductor.T("PROJECTS_REMOVED_ERROR")}: {Projects.LastError}",
                result ? ToastType.Success : ToastType.Warning
            ));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("PROJECTS_NOT_REMOVED"), Traductor.T("PROJECTS_NOT_REMOVED_MSG")));
        }
        _projects = await Projects.GetListAsync() ?? new();
        StateHasChanged();
    }

    private async Task CreateProjectAsync()
    {
        var parameters = new Dictionary<string, object>
        {
            { "OnProjectCreated", EventCallback.Factory.Create<bool>(this, OnProjectCreatedAsync) }
        };
        await _newProjectModal.ShowAsync<ProjectDetailsModal>(Traductor.T("PROJECTS_NEW"), parameters: parameters);
    }

    private async Task OnProjectCreatedAsync(bool status)
    {
        _projects = await Projects.GetListAsync() ?? new();
        await _newProjectModal.HideAsync();
        await InvokeAsync(StateHasChanged);
    }
}
