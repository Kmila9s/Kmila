    /// <summary>
    /// Buzzer scale (FW-5 flagship) — 3-bit note selector picks a note from
    /// the C-major octave (C4..C5). A separate ENABLE switch gates the
    /// tone. Uses `when-else` for the note table to keep the sample
    /// portable across the interpreter's supported concurrent-assignment
    /// syntax subset (see `[[project_visual_runtime_mode]]` — with-select
    /// alt-lists have historical gaps).
    /// </summary>
    private const string BUZZER_SCALE_VHD =
@"-- Kmila example: buzzer scale generator (raw PWM signal).
--
-- Pure VHDL, raw buzzer wiring: the design generates the square wave itself on
-- a single `signal` pin, exactly as you would drive a piezo buzzer from one
-- FPGA pin. A 3-bit NOTE selector picks one of the C-major octave notes; the
-- ENABLE switch gates the tone.
--
-- How it works: each note maps to a HALF-PERIOD count (in clock ticks). A
-- counter counts up to that half-period and then toggles `signal`, producing a
-- square wave whose period is 2x the half-period. A lower count = faster
-- toggling = higher pitch. The counts here are sim-scaled (small integers) so
-- the different notes are visibly distinct in the waveform within a short run;
-- on a real 50 MHz board you would instead use half_period = 50_000_000 /
-- (2 * note_hz).
--
-- NOTE: in raw mode the Visual buzzer widget shows the pulsing signal but does
-- not synthesise audio (that is an assisted-mode feature). Watch `signal` in
-- the Waveform viewer to see each note's frequency.
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity scale_generator is
    port(
        clk      : in  std_logic;
        reset    : in  std_logic;
        note_sel : in  std_logic_vector(2 downto 0);
        enable   : in  std_logic;
        signal_o : out std_logic   -- single PWM pin to the buzzer
    );
end scale_generator;

architecture rtl of scale_generator is
    -- Sim-scaled half-period per note (ticks). Smaller = higher pitch. The
    -- ratios roughly track the real C-major frequencies C4..C5 noted alongside.
    signal half_period : integer range 1 to 63;
    signal counter     : integer range 0 to 63 := 0;
    signal sig_reg     : std_logic := '0';
begin
    half_period <= 20 when note_sel = ""000"" else   -- C4 (262 Hz)
                   18 when note_sel = ""001"" else   -- D4 (294 Hz)
                   16 when note_sel = ""010"" else   -- E4 (330 Hz)
                   15 when note_sel = ""011"" else   -- F4 (349 Hz)
                   13 when note_sel = ""100"" else   -- G4 (392 Hz)
                   12 when note_sel = ""101"" else   -- A4 (440 Hz)
                   11 when note_sel = ""110"" else   -- B4 (494 Hz)
                   10;                               -- C5 (523 Hz)

    -- Square-wave generator. ENABLE off holds the pin low (silent); otherwise
    -- the counter toggles `signal` every half_period ticks.
    process(clk, reset)
    begin
        if reset = '1' then
            counter <= 0;
            sig_reg <= '0';
        elsif rising_edge(clk) then
            if enable = '0' then
                counter <= 0;
                sig_reg <= '0';
            elsif counter >= half_period - 1 then
                counter <= 0;
                sig_reg <= not sig_reg;
            else
                counter <= counter + 1;
            end if;
        end if;
    end process;

    signal_o <= sig_reg;
end rtl;
";

