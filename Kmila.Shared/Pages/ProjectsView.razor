@page "/projects"
@page "/projects/{Option}"
@implements IDisposable
<PageTitle>@Traductor.T("NAV_PROJECTS")</PageTitle>
<div class="d-grid gap-2 my-3">
    <Button
        TooltipTitle="@Traductor.T("PROJECTS_CREATE_NEW")"
        Color="ButtonColor.Success"
        Outline=true
        @onclick=CreateProjectAsync
    >
        @Traductor.T("PROJECTS_CREATE_NEW")
        <Icon Name="IconName.FolderPlus"/>
    </Button>
</div>
<Grid TItem="Project"
      Data=@_projects
      AllowFiltering="true"
      AllowPaging="true"
      AllowSorting="true"
      Class="table table-hover table-bordered table-striped my-3"
      PageSize="35"
      Responsive="true">

    <GridColumns>
        <GridColumn TItem="Project" HeaderText="@Traductor.T("PROJECTS_NAME")" PropertyName="Name" SortKeySelector="item => item.Name">
            @context.Name
        </GridColumn>
        <GridColumn TItem="Project" HeaderText="@Traductor.T("PROJECTS_DESCRIPTION")" PropertyName="Description" SortKeySelector="item => item.Description">
            @context.Description
        </GridColumn>
        <GridColumn TItem="Project" HeaderText="@Traductor.T("PROJECTS_CREATED")" PropertyName="CreationTime" SortKeySelector="item => item.CreationTime">
            @context.CreationTime
        </GridColumn>
        <GridColumn TItem="Project" HeaderText="@Traductor.T("PROJECTS_OPTIONS")" Sortable=false Filterable=false>
            <div class="btn-group">
                <Button
                    Outline=true
                    Color="ButtonColor.Info"
                    TooltipTitle="@Traductor.T("PROJECTS_OPEN")"
                    Type="ButtonType.Link"
                    @onclick='() => NavigationManager.NavigateTo($"/editor/{context.Id}")'
                >
                    <Icon Name="IconName.Folder2Open"/>
                </Button>
                <Button
                    Outline=true
                    Color="ButtonColor.Warning"
                    TooltipTitle="@Traductor.T("PROJECTS_EDIT")"
                    Type="ButtonType.Button"
                >
                    <Icon Name="IconName.PencilSquare"/>
                </Button>
                <Button
                    Outline=true
                    Color="ButtonColor.Danger"
                    TooltipTitle="@Traductor.T("PROJECTS_REMOVE")"
                    Type="ButtonType.Button"
                    @onclick="async () => await RemoveProjectAsync(context)"
                >
                    <Icon Name="IconName.Trash"/>
                </Button>
            </div>
        </GridColumn>
    </GridColumns>

</Grid>
<Modal Size="ModalSize.Large" IsScrollable=true @ref="_newProjectModal"/>
<ConfirmDialog @ref="_removeProjectDialog" />

@code{
    /// <summary>
    /// Gets or sets the option for the view.
    /// </summary>
    [Parameter]
    public string? Option { get; set; } = null!;
    private Modal _newProjectModal = new();
    private ConfirmDialog _removeProjectDialog = new();
    private List<Project> _projects = new();

    protected override void OnInitialized()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
    }

    /// <summary>
    /// Method invoked when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync(){
        _projects = await Projects.GetListAsync();

    }
    /// <summary>
    /// Method invoked after the component has rendered.
    /// </summary>
    /// <param name="firstRender">A boolean value indicating if it is the first render.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender){
        if(firstRender){
            if(!String.IsNullOrEmpty(Option)){
                switch(Option.ToLowerInvariant()){
                    case "create":
                        await CreateProjectAsync();
                    break;
                }
            }
        }
    }
    /// <summary>
    /// Removes a project asynchronously.
    /// </summary>
    /// <param name="project">The project to remove.</param>
    private async Task RemoveProjectAsync(Project project){
        ConfirmDialogOptions options = new(){
            YesButtonColor = ButtonColor.Danger,
            NoButtonColor = ButtonColor.Success,
            AutoFocusYesButton = false,
            YesButtonText = Traductor.T("PROJECTS_REMOVE"),
            NoButtonText = Traductor.T("COMMON_GO_BACK")
        };
        var confirmation = await _removeProjectDialog.ShowAsync(
            title: $"{Traductor.T("PROJECTS_REMOVING")}: {project.Name}",
            message1: $"{Traductor.T("PROJECTS_REMOVE_MSG1")} {project.BasePath}",
            message2: Traductor.T("PROJECTS_REMOVE_MSG2"),
            confirmDialogOptions: options
        );
        if(confirmation){
            var result = await Projects.RemoveAsync(project);
            ToastService.Notify(Message(
                result ? Traductor.T("PROJECTS_REMOVED") : Traductor.T("COMMON_ERROR"),
                result ? Traductor.T("PROJECTS_REMOVED_SUCCESS") : $"{Traductor.T("PROJECTS_REMOVED_ERROR")}: {Projects.LastError}",
                result ? ToastType.Success : ToastType.Warning
            ));
        }else{
            ToastService.Notify(Message(Traductor.T("PROJECTS_NOT_REMOVED"), Traductor.T("PROJECTS_NOT_REMOVED_MSG")));
        }
        _projects = await Projects.GetListAsync();
    }
    /// <summary>
    /// Creates a new project asynchronously.
    /// </summary>
    private async Task CreateProjectAsync(){
        Dictionary<string, object> parameters = new(){
            {"OnProjectCreated", EventCallback.Factory.Create<bool>(this, OnProjectCreatedAsync)}
        };
        await _newProjectModal.ShowAsync<ProjectDetailsModal>(Traductor.T("PROJECTS_NEW"), parameters: parameters);
    }
    /// <summary>
    /// Handles the project created event.
    /// </summary>
    /// <param name="status">The status of the project creation.</param>
    private async Task OnProjectCreatedAsync(bool status){
        _projects = await Projects.GetListAsync();
        await _newProjectModal.HideAsync();
        await InvokeAsync(StateHasChanged);
    }
}