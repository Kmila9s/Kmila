    /// <summary>
    /// DIP adder (FW-2 flagship) — two DIP-switch banks feed a 4-bit adder,
    /// the 5-bit sum drops onto an LED array + carry LED. Shows the
    /// multi-switch widget in vector mode driving std_logic_vector inputs
    /// without any bit-slice binding — the port width is the DIP count.
    /// </summary>
    private const string DIP_ADDER_VHD =
@"-- Kmila example: 4-bit DIP adder (two switch banks -> 5-bit sum).
--
-- Pure combinational VHDL, raw per-switch wiring. Each DIP switch drives one
-- real input bit (a[0..3] / b[0..3] in the .kviz), just like wiring eight
-- toggle switches to FPGA pins. There is no clock: the sum follows the inputs
-- immediately.
--
-- How the add works: `a` and `b` are 4-bit buses. They are read as unsigned,
-- resized to 5 bits so the result has room for the carry-out, then added. The
-- 5-bit `sum` therefore holds 0..30, where bit 4 is the carry of a 4-bit add.
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity dip_adder is
    port(
        a   : in  std_logic_vector(3 downto 0);  -- DIP bank A (switches a0..a3)
        b   : in  std_logic_vector(3 downto 0);  -- DIP bank B (switches b0..b3)
        sum : out std_logic_vector(4 downto 0)   -- a + b, bit 4 = carry-out
    );
end dip_adder;

architecture rtl of dip_adder is
begin
    -- resize(...,5) widens each operand to 5 bits so the add can't overflow;
    -- the extra top bit becomes the carry-out.
    sum <= std_logic_vector(resize(unsigned(a), 5) + resize(unsigned(b), 5));
end rtl;
";

