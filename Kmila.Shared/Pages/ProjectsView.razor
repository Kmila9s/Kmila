    /// <summary>
    /// Catalog of pre-built example projects. The default sample ("demo")
    /// is what the "Try a sample" button creates with one click; the rest
    /// surface through the example-gallery modal. Stable IDs so future
    /// share-links can point at a specific example without a name drift.
    /// </summary>
    // Ring 5 (2026-07-14): `MainFileName` lets multi-file examples land
    // their top-level entity on a non-`main.vhd` name (e.g. `calc_top.vhd`).
    // `ExtraFiles` is a lazy loader for additional VHDL files created after
    // the main file — used by the capstone example whose 15-file corpus
    // ships as embedded resources rather than inline consts.
    private sealed record ExampleDef(
        string Id,
        string NameKey,
        string DescKey,
        string Vhd,
        string Kviz,
        string MainFileName = "main.vhd",
        Func<IEnumerable<(string FileName, string Content)>>? ExtraFiles = null);

    private static readonly List<ExampleDef> _examples = new()
    {
        new ExampleDef("demo",       "EXAMPLE_DEMO_NAME",       "EXAMPLE_DEMO_DESC",       SAMPLE_MAIN_VHD,     SAMPLE_MAIN_KVIZ),
        new ExampleDef("counter",    "EXAMPLE_COUNTER_NAME",    "EXAMPLE_COUNTER_DESC",    COUNTER_CLOCK_VHD,   COUNTER_CLOCK_KVIZ),
        new ExampleDef("traffic",    "EXAMPLE_TRAFFIC_NAME",    "EXAMPLE_TRAFFIC_DESC",    TRAFFIC_LIGHT_VHD,   TRAFFIC_LIGHT_KVIZ),
        new ExampleDef("shift",      "EXAMPLE_SHIFT_NAME",      "EXAMPLE_SHIFT_DESC",      SHIFT_REGISTER_VHD,  SHIFT_REGISTER_KVIZ),
        new ExampleDef("dip-adder",  "EXAMPLE_DIP_ADDER_NAME",  "EXAMPLE_DIP_ADDER_DESC",  DIP_ADDER_VHD,       DIP_ADDER_KVIZ),
        new ExampleDef("matrix-plus","EXAMPLE_MATRIX_NAME",     "EXAMPLE_MATRIX_DESC",     MATRIX_PLUS_VHD,     MATRIX_PLUS_KVIZ),
        new ExampleDef("rgb-rainbow","EXAMPLE_RGB_NAME",        "EXAMPLE_RGB_DESC",        RGB_RAINBOW_VHD,     RGB_RAINBOW_KVIZ),
        new ExampleDef("buzzer-scale","EXAMPLE_BUZZER_NAME",    "EXAMPLE_BUZZER_DESC",     BUZZER_SCALE_VHD,    BUZZER_SCALE_KVIZ),
        new ExampleDef("keypad-display","EXAMPLE_KEYPAD_NAME",  "EXAMPLE_KEYPAD_DESC",     KEYPAD_DISPLAY_VHD,  KEYPAD_DISPLAY_KVIZ),
        new ExampleDef("lcd-hello",   "EXAMPLE_LCD_NAME",       "EXAMPLE_LCD_DESC",        LCD_HELLO_VHD,       LCD_HELLO_KVIZ),
        new ExampleDef(
            "capstone-calc",
            "EXAMPLE_CAPSTONE_NAME",
            "EXAMPLE_CAPSTONE_DESC",
            "", // main file content injected via ExtraFiles loader below (calc_top.vhd is first entry)
            CAPSTONE_CALC_KVIZ,
            MainFileName: CAPSTONE_CALC_MAIN,
            ExtraFiles: LoadCapstoneCalcFiles),
    };

