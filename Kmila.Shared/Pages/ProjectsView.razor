        48 => ""00000000"",
        49 => ""01000001"",
        50 => ""01111111"",
        51 => ""01000001"",
        52 => ""00000000"",
        53 => ""00000000"",
        54 => ""01111111"",
        55 => ""01000000"",
        56 => ""01000000"",
        57 => ""01000000"",
        58 => ""01000000"",
        59 => ""00000000"",
        60 => ""01111110"",
        61 => ""00001001"",
        62 => ""00001001"",
        63 => ""00001001"",
        64 => ""01111110"",
        65 => ""00000000"",
        66 => ""00000000"",
        67 => ""00000000"",
        68 => ""00000000"",
        69 => ""00000000"",
        70 => ""00000000"",
        71 => ""00000000"",
        72 => ""00000000"",
        73 => ""00000000""
    );

    signal scan   : integer range 0 to 7 := 0;              -- physical column being lit
    signal offset : integer range 0 to 66 := 0;    -- left edge of visible window
    signal idx    : integer range 0 to 73 := 0;    -- ROM index = offset + scan
    signal div    : integer range 0 to SCROLL_CLKS := 0;
    signal col_r  : std_logic_vector(7 downto 0) := ""00000001"";
    signal row_r  : std_logic_vector(7 downto 0) := ""00000000"";
begin
    process(clk, reset)
    begin
        if reset = '1' then
            scan   <= 0;
            offset <= 0;
            idx    <= 0;
            div    <= 0;
            col_r  <= ""00000001"";
            row_r  <= ""00000000"";
        elsif rising_edge(clk) then
            -- Drive the current column's pixels and advance the one-hot select.
            row_r <= MSG(idx);
            col_r <= col_r(6 downto 0) & col_r(7);  -- rotate one-hot left
            -- Advance the scan column; recompute the ROM index.
            if scan = 7 then
                scan <= 0;
                idx  <= offset;          -- back to column 0 of the window
            else
                scan <= scan + 1;
                idx  <= idx + 1;
            end if;
            -- Scroll the window one column every SCROLL_CLKS clocks.
            if div < SCROLL_CLKS - 1 then
                div <= div + 1;
            else
                div <= 0;
                if offset = 66 then offset <= 0; else offset <= offset + 1; end if;
            end if;
        end if;
    end process;

    col <= col_r;
    row <= row_r;
end rtl;
";

