    /// <summary>
    /// Keypad → 7-segment latch (FW-4 flagship). Assisted 4×4 keypad
    /// drives a hex 7-segment display. The design latches the current
    /// key value while `pressed` is high; releasing all keys freezes
    /// the last digit on the display.
    /// </summary>
    private const string KEYPAD_DISPLAY_VHD =
@"-- Kmila example: 4x4 matrix keypad scanner -> hex 7-segment (raw wiring).
--
-- Pure VHDL. Instead of an assisted 'key + pressed' widget, the design does the
-- real work a keypad needs on an FPGA:
--   1. Row driver: drives the four row lines `rows` one-hot LOW, one row at a
--      time, stepping on an internal scan tick.
--   2. Column sense: reads the four `cols` lines (active LOW). A grounded column
--      while a given row is low means the key at that (row, col) is pressed.
--   3. Debounce: a key must be seen stable for DEBOUNCE_TICKS scan cycles before
--      it registers, and an idle window must elapse before the same key can
--      register again (so a held key doesn't repeat).
--   4. Decode + display: the pressed position maps to its key value (0-9, A-D,
--      and F/E as placeholders for * / #), shown on a raw a..g 7-segment.
--
-- Physical layout (row-major positions 0..15):
--   Row 0: 1 2 3 A    Row 1: 4 5 6 B    Row 2: 7 8 9 C    Row 3: * 0 # D
--
-- Scan tick + debounce counts are sim-scaled so a press registers within a
-- short run. On a real board the scan tick would be ~1 kHz.
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity keypad_display is
    port(
        clk      : in  std_logic;
        reset    : in  std_logic;
        cols     : in  std_logic_vector(3 downto 0);   -- active-low column read-back
        rows     : out std_logic_vector(3 downto 0);   -- one-hot low row drive
        segments : out std_logic_vector(6 downto 0)    -- raw a..g, common anode
    );
end keypad_display;

architecture rtl of keypad_display is
    constant SCAN_DIV       : integer := 3;   -- clocks between scan ticks (sim-scaled)
    constant DEBOUNCE_TICKS : integer := 3;   -- stable sightings before a key registers
    constant IDLE_RELEASE   : integer := 12;  -- idle ticks before the same key repeats

    -- Position -> displayed hex nibble (matches the physical layout above).
    -- * -> F and # -> E are placeholders (no hex digit of their own).
    type lut_t is array(0 to 15) of std_logic_vector(3 downto 0);
    constant KEY_LUT : lut_t := (
        0  => ""0001"", 1  => ""0010"", 2  => ""0011"", 3  => ""1010"",  -- 1 2 3 A
        4  => ""0100"", 5  => ""0101"", 6  => ""0110"", 7  => ""1011"",  -- 4 5 6 B
        8  => ""0111"", 9  => ""1000"", 10 => ""1001"", 11 => ""1100"",  -- 7 8 9 C
        12 => ""1111"", 13 => ""0000"", 14 => ""1110"", 15 => ""1101""   -- * 0 # D
    );

    signal div_cnt   : integer range 0 to SCAN_DIV := 0;
    signal scan_tick : std_logic := '0';

    signal row_idx    : integer range 0 to 3 := 0;
    signal rows_int   : std_logic_vector(3 downto 0) := ""1111"";
    signal last_pos   : integer range 0 to 16 := 16;   -- 16 = no key
    signal stable_cnt : integer range 0 to 15 := 0;
    signal idle_cnt   : integer range 0 to 31 := 0;
    signal prev_code  : integer range 0 to 16 := 16;
    signal code_r     : std_logic_vector(3 downto 0) := ""0000"";
begin
    -- Row driver: active row is driven low, the rest high.
    process(row_idx)
    begin
        rows_int <= ""1111"";
        rows_int(row_idx) <= '0';
    end process;
    rows <= rows_int;

    -- Scan-tick divider.
    process(clk, reset)
    begin
        if reset = '1' then
            div_cnt   <= 0;
            scan_tick <= '0';
        elsif rising_edge(clk) then
            if div_cnt >= SCAN_DIV - 1 then
                div_cnt   <= 0;
                scan_tick <= '1';
            else
                div_cnt   <= div_cnt + 1;
                scan_tick <= '0';
            end if;
        end if;
    end process;

    -- Scan + debounce. Only one column low (one key on the active row) counts.
    process(clk, reset)
        variable one_low : integer range 0 to 4;
        variable col_idx : integer range 0 to 3;
        variable sensed  : integer range 0 to 16;
    begin
        if reset = '1' then
            row_idx    <= 0;
            last_pos   <= 16;
            stable_cnt <= 0;
            idle_cnt   <= 0;
            prev_code  <= 16;
            code_r     <= ""0000"";
        elsif rising_edge(clk) then
            if scan_tick = '1' then
                one_low := 0;
                col_idx := 0;
                for i in 0 to 3 loop
                    if cols(i) = '0' then
                        one_low := one_low + 1;
                        col_idx := i;
                    end if;
                end loop;

                if one_low = 1 then
                    sensed := row_idx * 4 + col_idx;
                else
                    sensed := 16;
                end if;

                if sensed /= 16 then
                    idle_cnt <= 0;
                    if sensed = last_pos then
                        if stable_cnt < DEBOUNCE_TICKS then
                            stable_cnt <= stable_cnt + 1;
                        end if;
                        if stable_cnt = DEBOUNCE_TICKS - 1 then
                            if sensed /= prev_code then
                                code_r    <= KEY_LUT(sensed);
                                prev_code <= sensed;
                            end if;
                        end if;
                    else
                        stable_cnt <= 0;
                        last_pos   <= sensed;
                    end if;
                else
                    if idle_cnt < IDLE_RELEASE then
                        idle_cnt <= idle_cnt + 1;
                    else
                        prev_code  <= 16;
                        last_pos   <= 16;
                        stable_cnt <= 0;
                    end if;
                end if;

                if row_idx = 3 then
                    row_idx <= 0;
                else
                    row_idx <= row_idx + 1;
                end if;
            end if;
        end if;
    end process;

    -- Raw hex 7-segment decoder for the latched key code (common anode).
    process(code_r)
    begin
        case to_integer(unsigned(code_r)) is
            when 0  => segments <= ""0000001"";
            when 1  => segments <= ""1001111"";
            when 2  => segments <= ""0010010"";
            when 3  => segments <= ""0000110"";
            when 4  => segments <= ""1001100"";
            when 5  => segments <= ""0100100"";
            when 6  => segments <= ""0100000"";
            when 7  => segments <= ""0001111"";
            when 8  => segments <= ""0000000"";
            when 9  => segments <= ""0000100"";
            when 10 => segments <= ""0001000"";  -- A
            when 11 => segments <= ""1100000"";  -- b
            when 12 => segments <= ""0110001"";  -- C
            when 13 => segments <= ""1000010"";  -- d
            when 14 => segments <= ""0110000"";  -- E
            when others => segments <= ""0111000"";  -- F
        end case;
    end process;
end rtl;
";

