    { ""id"": ""sw-step"",   ""type"": ""switch"", ""position"": { ""x"": 220, ""y"": 60 }, ""config"": { ""label"": ""STEP"", ""defaultState"": ""1"" }, ""bindings"": { ""out"": ""step_en"" } },
    { ""id"": ""lcd-1"",     ""type"": ""lcd-hd44780"", ""position"": { ""x"": 60,  ""y"": 200 }, ""config"": { ""mode"": ""text"", ""rows"": 2, ""cols"": 16 }, ""bindings"": { ""line0"": ""line0"" } }
