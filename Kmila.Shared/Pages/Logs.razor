@*
    Logs page — live viewer of every ILogger event routed through
    InMemoryLoggerProvider. Mirrors the console without needing a terminal,
    which is especially useful on mobile where there's no console to watch.

    Controls:
      • Search (substring match, case-insensitive, over message + category)
      • Level filter — All | Info | Warning | Error
      • Auto-scroll toggle — jumps to newest on each new entry
      • Pause — stops updating the UI (log capture still runs in the background)
      • Clear — wipes the in-memory buffer

    Rendering: the list is capped at 500 displayed rows out of a 2000-entry
    buffer. Beyond that the DOM gets heavy and blasts re-render time.
*@
@page "/logs"
@implements IDisposable
@inject AppLogStore Store
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.Extensions.Logging
@using Kmila.Shared.Services

<PageTitle>@Traductor.T("NAV_LOGS")</PageTitle>

<section class="logs-page">

    <header class="logs-page__header">
        <div class="logs-page__titles">
            <span class="home-section__eyebrow">@Traductor.T("LOGS_EYEBROW")</span>
            <h1 class="logs-page__title">
                @Traductor.T("NAV_LOGS")
                <span class="logs-page__count">@_filtered.Count / @_snapshot.Count</span>
            </h1>
            <small class="logs-page__untranslated-note">
                @Traductor.T("LOGS_UNTRANSLATED_NOTE")
            </small>
        </div>

        @* slot/page-header-tools v2 — filter shelf (search + level select integrated
           into one tall bordered container) + separate actions cluster on the right.
           Stops the search input from feeling pinched against 32 px buttons. *@
        <div class="logs-page__tools kmila-slot-header-tools">
            <div class="kmila-slot-header-tools__filter">
                <label class="projects-search logs-page__search">
                    <Icon Name="IconName.Search" />
                    <input type="search"
                           class="form-control"
                           placeholder="@Traductor.T("LOGS_SEARCH_PLACEHOLDER")"
                           aria-label="@Traductor.T("LOGS_SEARCH_PLACEHOLDER")"
                           @bind="_filter"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(_filter))
                    {
                        <KmilaTooltip TextKey="LOGS_CLEAR_FILTER_TIP">
                            <button type="button" class="projects-search__clear"
                                    @onclick="() => _filter = string.Empty">
                                <Icon Name="IconName.X" />
                            </button>
                        </KmilaTooltip>
                    }
                </label>

                <span class="kmila-slot-header-tools__filter-divider" aria-hidden="true"></span>

                <select class="form-select form-select-sm logs-page__level"
                        value="@_levelFilter"
                        @onchange="OnLevelChanged"
                        aria-label="@Traductor.T("LOGS_LEVEL_FILTER")">
                    <option value="all">@Traductor.T("LOGS_LEVEL_ALL")</option>
                    <option value="info">@Traductor.T("LOGS_LEVEL_INFO")+</option>
                    <option value="warning">@Traductor.T("LOGS_LEVEL_WARN")+</option>
                    <option value="error">@Traductor.T("LOGS_LEVEL_ERROR")+</option>
                </select>
            </div>

            <div class="kmila-slot-header-tools__actions">
                <KmilaTooltip TextKey="LOGS_AUTOSCROLL">
                    <button type="button"
                            class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm logs-page__toggle @(_autoScroll ? "is-active" : "")"
                            @onclick="() => _autoScroll = !_autoScroll"
                            aria-label="@Traductor.T("LOGS_AUTOSCROLL")">
                        <Icon Name="IconName.ArrowDownSquare" />
                    </button>
                </KmilaTooltip>

                <KmilaTooltip TextKey="@(_paused ? "LOGS_RESUME" : "LOGS_PAUSE")">
                    <button type="button"
                            class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm logs-page__toggle @(_paused ? "is-active" : "")"
                            @onclick="() => _paused = !_paused"
                            aria-label="@Traductor.T(_paused ? "LOGS_RESUME" : "LOGS_PAUSE")">
                        <Icon Name="@(_paused ? IconName.PlayFill : IconName.PauseFill)" />
                    </button>
                </KmilaTooltip>

                <KmilaTooltip TextKey="LOGS_EXPORT">
                    <button type="button"
                            class="kmila-btn-icon kmila-btn-icon--ghost kmila-btn-icon--primary kmila-btn-icon--sm"
                            @onclick="ExportLogsAsync"
                            disabled="@(_snapshot.Count == 0)"
                            aria-label="@Traductor.T("LOGS_EXPORT")">
                        <Icon Name="IconName.Download" />
                    </button>
                </KmilaTooltip>

                <KmilaTooltip TextKey="LOGS_CLEAR">
                    <button type="button"
                            class="kmila-btn-icon kmila-btn-icon--ghost kmila-btn-icon--danger kmila-btn-icon--sm"
                            @onclick="Store.Clear"
                            aria-label="@Traductor.T("LOGS_CLEAR")">
                        <Icon Name="IconName.Trash" />
                    </button>
                </KmilaTooltip>
            </div>
        </div>
    </header>

    @if (_filtered.Count == 0)
    {
        <div class="logs-page__empty">
            <div class="projects-empty__icon"><Icon Name="IconName.TerminalFill" /></div>
            @if (_snapshot.Count == 0)
            {
                <h2>@Traductor.T("LOGS_EMPTY_TITLE")</h2>
                <p>@Traductor.T("LOGS_EMPTY_BODY")</p>
            }
            else
            {
                <h2>@Traductor.T("LOGS_NO_MATCH_TITLE")</h2>
                <p>@Traductor.T("LOGS_NO_MATCH_BODY")</p>
            }
        </div>
    }
    else
    {
        <ol class="logs-page__list" role="log" aria-live="polite" aria-relevant="additions">
            @foreach (var e in _filtered.TakeLast(500))
            {
                var variant = LevelVariant(e.Level);
                <li class="output-row output-row--@variant">
                    <span class="output-row__time">@e.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="output-row__icon"><Icon Name="@LevelIcon(e.Level)" /></span>
                    <span class="logs-row__body">
                        <span class="logs-row__category">@ShortenCategory(e.Category)</span>
                        <span class="output-row__msg">@ShortenMessage(e.Message)</span>
                        @if (!string.IsNullOrEmpty(e.Exception))
                        {
                            <pre class="logs-row__exception">@e.Exception</pre>
                        }
                    </span>
                    @* Per-entry Report button — only on Error / Critical rows.
                       Opens a pre-filled GitHub issue with the log context.
                       Students stop having to manually copy-paste the
                       stacktrace when something breaks. *@
                    @if (e.Level >= Microsoft.Extensions.Logging.LogLevel.Error)
                    {
                        <KmilaTooltip TextKey="LOGS_REPORT_THIS">
                            <button type="button"
                                    class="logs-row__report kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                                    aria-label="@Traductor.T("LOGS_REPORT_THIS")"
                                    @onclick="() => ReportEntryAsync(e)">
                                <Icon Name="IconName.FlagFill" />
                                <span>@Traductor.T("LOGS_REPORT_SHORT")</span>
                            </button>
                        </KmilaTooltip>
                    }
                </li>
            }
        </ol>
    }
</section>

@code {
    private IReadOnlyList<AppLogEntry> _snapshot = Array.Empty<AppLogEntry>();
    private List<AppLogEntry> _filtered = new();
    private string _filter = "";
    private string _levelFilter = "all";
    private bool _autoScroll = true;
    private bool _paused;

    protected override void OnInitialized()
    {
        Store.OnChange += OnStoreChanged;
        Traductor.StaticOnLangChanged += OnLangChanged;
        RebuildSnapshot();
    }

    private void OnStoreChanged()
    {
        if (_paused) return;
        InvokeAsync(() =>
        {
            RebuildSnapshot();
            StateHasChanged();
        });
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private void RebuildSnapshot()
    {
        _snapshot = Store.Snapshot();
        _filtered = _snapshot.Where(Matches).ToList();
    }

    /// <summary>Filters by message/category substring + minimum level.</summary>
    private bool Matches(AppLogEntry e)
    {
        if (_levelFilter switch
            {
                "info"    => e.Level < Microsoft.Extensions.Logging.LogLevel.Information,
                "warning" => e.Level < Microsoft.Extensions.Logging.LogLevel.Warning,
                "error"   => e.Level < Microsoft.Extensions.Logging.LogLevel.Error,
                _         => false
            })
            return false;

        if (string.IsNullOrEmpty(_filter)) return true;
        return e.Message.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || e.Category.Contains(_filter, StringComparison.OrdinalIgnoreCase);
    }

    private void OnLevelChanged(ChangeEventArgs e)
    {
        _levelFilter = e.Value?.ToString() ?? "all";
        RebuildSnapshot();
    }

    // -----

    /// <summary>Friendly short name for a fully-qualified logger category.</summary>
    private static string ShortenCategory(string cat)
    {
        var lastDot = cat.LastIndexOf('.');
        return lastDot >= 0 && lastDot < cat.Length - 1 ? cat[(lastDot + 1)..] : cat;
    }

    /// <summary>
    /// Trim host-machine absolute paths inside log messages to a project-
    /// relative tail. Internal logs frequently embed paths like
    /// /Users/&lt;name&gt;/Documents/Kmila-9s/App/Kmila/Kmila.Shared/wwwroot/...
    /// which leak the dev's home directory in screenshots and look noisy on
    /// mobile. We replace anything ending in "Kmila.Shared/..." or
    /// "Kmila.Web/..." with the shortened tail prefixed by "…/".
    /// </summary>
    private static string ShortenMessage(string msg)
    {
        if (string.IsNullOrEmpty(msg)) return msg;
        // Cheap, allocation-free fast path for the common case.
        if (!msg.Contains('/')) return msg;
        return System.Text.RegularExpressions.Regex.Replace(
            msg,
            @"(?:[A-Za-z]:)?(?:/[^\s:]*?)?/(Kmila\.(?:Shared|Web|MAUI|Tests)|App/Kmila|Documentacion)/",
            "…/$1/");
    }

    private static string LevelVariant(Microsoft.Extensions.Logging.LogLevel lvl) => lvl switch
    {
        Microsoft.Extensions.Logging.LogLevel.Trace       => "info",
        Microsoft.Extensions.Logging.LogLevel.Debug       => "info",
        Microsoft.Extensions.Logging.LogLevel.Information => "info",
        Microsoft.Extensions.Logging.LogLevel.Warning     => "warning",
        Microsoft.Extensions.Logging.LogLevel.Error       => "danger",
        Microsoft.Extensions.Logging.LogLevel.Critical    => "danger",
        _                    => "info"
    };

    private static IconName LevelIcon(Microsoft.Extensions.Logging.LogLevel lvl) => lvl switch
    {
        Microsoft.Extensions.Logging.LogLevel.Warning  => IconName.ExclamationTriangleFill,
        Microsoft.Extensions.Logging.LogLevel.Error    => IconName.XCircleFill,
        Microsoft.Extensions.Logging.LogLevel.Critical => IconName.XCircleFill,
        _                 => IconName.InfoCircleFill
    };

    /// <summary>
    /// Builds a GitHub issue URL prefilled from a specific log entry and
    /// opens it in a new tab. Title carries the shortened message so the
    /// issue list is scannable; body carries the full entry (category,
    /// level, timestamp, message, exception) plus the standard env block
    /// from <see cref="FeedbackHelper.BuildDiagnostics"/>.
    /// </summary>
    private async Task ReportEntryAsync(AppLogEntry entry)
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Level: {entry.Level}");
            sb.AppendLine($"Category: {entry.Category}");
            sb.AppendLine($"Timestamp: {entry.Timestamp:O}");
            sb.AppendLine($"Message: {entry.Message}");
            if (!string.IsNullOrEmpty(entry.Exception))
            {
                sb.AppendLine();
                sb.AppendLine("Exception:");
                sb.AppendLine(entry.Exception);
            }

            var body  = FeedbackHelper.BuildDiagnostics(Traductor.Lang ?? "en",
                                                        logContext: sb.ToString());
            var title = $"[{entry.Level}] {entry.Message}";
            var url   = FeedbackHelper.BuildIssueUrl(title, body);
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch
        {
            // Ghost-failing a log-report button is better than a toast —
            // if the browser blocked the popup the user will try again.
        }
    }

    private async Task ExportLogsAsync()
    {
        if (_snapshot.Count == 0) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# Kmila app log — exported {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
        foreach (var e in _snapshot)
        {
            sb.Append(e.Timestamp.ToString("HH:mm:ss.fff"))
              .Append(" [").Append(e.Level.ToString().ToUpperInvariant()).Append("] ")
              .Append(ShortenCategory(e.Category)).Append(" — ")
              .AppendLine(e.Message);
            if (!string.IsNullOrEmpty(e.Exception))
                sb.AppendLine(e.Exception);
        }
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var result = await Export.SaveTextAsync(ExportCategory.Logs,
            $"kmila-app-{stamp}.log", "text/plain", sb.ToString());
        if (result.Saved)
        {
            var msg = result.Path != null ? $"Saved: {result.Path}" : Traductor.T("OUTPUT_LOG_DOWNLOADED");
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), msg, ToastType.Success));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                result.Error ?? Traductor.T("COMMON_EXPORT_FAILED"), ToastType.Danger));
        }
    }

    public void Dispose()
    {
        Store.OnChange -= OnStoreChanged;
        Traductor.StaticOnLangChanged -= OnLangChanged;
    }
}
