    /// <summary>Persists the auto-report toggle. Phase A only saves
    /// the preference; the actual hook into the error-logging
    /// pipeline lands in a follow-up so we can review the throttle /
    /// dedup design separately.</summary>
    private async Task OnAutoReportToggledAsync(ChangeEventArgs e)
    {
        _autoReportEnabled = e.Value is bool b && b;
        await DbContext.SetSettingAsync(AutoReportSettingKey, _autoReportEnabled ? "true" : "false");
    }

    /// <summary>Toggles the private-repo (`repo`) scope opt-in for version
    /// control. Takes effect on the next sign-in — if already signed in, tell
    /// the user to sign out and back in for it to apply.</summary>
    private async Task OnPrivateScopeToggledAsync(ChangeEventArgs e)
    {
        _privateScopeEnabled = e.Value is bool b && b;
        await GitHubAuth.SetPrivateScopeAsync(_privateScopeEnabled);
        if (GitHubAuth.IsLoggedIn)
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("SETTINGS_VC_PRIVATE_REAUTH"), ToastType.Warning));
    }

    /// <summary>One-shot manual report. Posts the same diagnostics the
    /// Tier 1 / Tier 2 buttons surface, but goes through the GitHub
    /// API as the logged-in user so the issue is properly attributed.</summary>
    private async Task SubmitManualReportAsync()
    {
        if (_submitting || !GitHubAuth.IsLoggedIn) return;
        _submitting = true;
        _lastReportUrl = null;
        StateHasChanged();
        try
        {
            var lang = await DbContext.GetSettingAsync(AppSettings.KEY_LANGUAGE) ?? "en";
            var diag = FeedbackHelper.BuildDiagnostics(lang);
            var url = await GitHubAuth.SubmitIssueAsync(
                title: "[Kmila] Manual report",
                body:  diag,
                labels: new[] { "user-report" });
            if (url != null)
            {
                _lastReportUrl = url;
                ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                    Traductor.T("SETTINGS_ACCOUNT_REPORT_SENT"), ToastType.Success));
            }
            else
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    Traductor.T("SETTINGS_ACCOUNT_REPORT_FAILED"), ToastType.Danger));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

