@*
    Settings page — currently a placeholder with tokenized section cards so
    future preferences (autosave, default FPGA, accent override, keyboard
    shortcuts, etc.) have a natural home. Everything lives under /settings and
    is reachable from the sidebar's "System" section.

    Each card here is a slot. Wire behavior into the individual cards as
    features land; the shell + navigation are already in place.
*@
@page "/settings"
@using Kmila.Shared.Services
@using Kmila.Shared.Repositories
@using Kmila.Shared.Models
@inject UserAssetStore UserAssets
@inject LessonProgressStore LearnProgress
@inject ProjectBundleService Bundles
@inject Projects ProjectsRepo
@inject GitHubAuth GitHubAuth
@inject LibraryCompiler.Services.LibraryCompiler LibCompiler
@inject Kmila.Shared.Services.ReplayState Replay
@implements IDisposable

<PageTitle>@Traductor.T("NAV_SETTINGS")</PageTitle>

<section class="settings-page">
    <header class="settings-page__header">
        <span class="home-section__eyebrow">@Traductor.T("SETTINGS_EYEBROW")</span>
        <h1>@Traductor.T("NAV_SETTINGS")</h1>
        <p class="settings-page__intro">@Traductor.T("SETTINGS_INTRO")</p>
    </header>

    <div class="settings-page__grid">

        @* --- Appearance --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--accent">
                    <Icon Name="IconName.PaletteFill" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_APPEARANCE_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_APPEARANCE_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-row">
                    <div class="settings-row__label">
                        <strong>@Traductor.T("SETTINGS_THEME")</strong>
                        <small>@Traductor.T("SETTINGS_THEME_HINT")</small>
                    </div>
                    <div class="settings-row__control">
                        <KmilaThemeSwitcher />
                    </div>
                </div>
                <div class="settings-row">
                    <div class="settings-row__label">
                        <strong>@Traductor.T("SETTINGS_LANGUAGE")</strong>
                        <small>@Traductor.T("SETTINGS_LANGUAGE_HINT")</small>
                    </div>
                    <div class="settings-row__control">
                        <LanguageChanger />
                    </div>
                </div>
                <div class="settings-row">
                    <div class="settings-row__label">
                        <strong>@Traductor.T("SETTINGS_TEXT_SIZE_TITLE")</strong>
                        <small>@Traductor.T("SETTINGS_TEXT_SIZE_HINT")</small>
                    </div>
                    <div class="settings-row__control">
                        <KmilaTextSizeSwitcher />
                    </div>
                </div>
            </div>
        </article>

        @* --- Editor --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--info">
                    <Icon Name="IconName.CodeSquare" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_EDITOR_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_EDITOR_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <p class="settings-card__placeholder">@Traductor.T("SETTINGS_COMING_SOON")</p>
            </div>
        </article>

        @* --- Simulation --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--success">
                    <Icon Name="IconName.CpuFill" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_SIMULATION_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_SIMULATION_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-row">
                    <div class="settings-row__label">
                        <strong>@Traductor.T("SETTINGS_TICK_RES_TITLE")</strong>
                        <small>@Traductor.T("SETTINGS_TICK_RES_HINT")</small>
                    </div>
                    <div class="settings-row__control">
                        <select class="form-select form-select-sm"
                                value="@_tickMode.ToToken()"
                                @onchange="OnTickModeChanged">
                            <option value="default">@Traductor.T("SETTINGS_TICK_RES_DEFAULT")</option>
                            <option value="high">@Traductor.T("SETTINGS_TICK_RES_HIGH")</option>
                            <option value="adaptive">@Traductor.T("SETTINGS_TICK_RES_ADAPTIVE")</option>
                        </select>
                    </div>
                </div>
                <p class="settings-card__hint">@Traductor.T(_tickMode switch {
                    TickResolutionMode.HighPrecision => "SETTINGS_TICK_RES_HIGH_DESC",
                    TickResolutionMode.Adaptive      => "SETTINGS_TICK_RES_ADAPTIVE_DESC",
                    _                                 => "SETTINGS_TICK_RES_DEFAULT_DESC"
                })</p>

                <div class="settings-row">
                    <div class="settings-row__label">
                        <strong>@Traductor.T("SETTINGS_LIVE_REPLAY_TITLE")</strong>
                        <small>@Traductor.T("SETTINGS_LIVE_REPLAY_HINT")</small>
                    </div>
                    <div class="settings-row__control">
                        <label class="form-check form-switch mb-0">
                            <input type="checkbox"
                                   class="form-check-input"
                                   role="switch"
                                   checked="@_liveReplayDuringRun"
                                   @onchange="OnLiveReplayChanged" />
                        </label>
                    </div>
                </div>
                @if (_liveReplayDuringRun)
                {
                    <p class="settings-card__hint settings-card__hint--warn">
                        <Icon Name="IconName.ExclamationTriangleFill" />
                        <span>@Traductor.T("SETTINGS_LIVE_REPLAY_WARN")</span>
                    </p>
                }
            </div>
        </article>

        @* --- Library compilation --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--info">
                    <Icon Name="IconName.Layers" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_LIB_BUILD_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_LIB_BUILD_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-row">
                    <div class="settings-row__label">
                        <strong>@Traductor.T("SETTINGS_LIB_BUILD_MODE_TITLE")</strong>
                        <small>@Traductor.T("SETTINGS_LIB_BUILD_MODE_HINT")</small>
                    </div>
                    <div class="settings-row__control">
                        <select class="form-select form-select-sm"
                                value="@_libBuildMode.ToToken()"
                                @onchange="OnLibBuildModeChanged">
                            <option value="ondemand">@Traductor.T("SETTINGS_LIB_BUILD_ONDEMAND")</option>
                            <option value="process">@Traductor.T("SETTINGS_LIB_BUILD_PROCESS")</option>
                            <option value="persistent">@Traductor.T("SETTINGS_LIB_BUILD_PERSISTENT")</option>
                        </select>
                    </div>
                </div>
                <p class="settings-card__hint">@Traductor.T(_libBuildMode switch {
                    LibraryCompiler.Services.LibraryBuildMode.OnDemand      => "SETTINGS_LIB_BUILD_ONDEMAND_DESC",
                    LibraryCompiler.Services.LibraryBuildMode.ProcessCached => "SETTINGS_LIB_BUILD_PROCESS_DESC",
                    _                                                       => "SETTINGS_LIB_BUILD_PERSISTENT_DESC"
                })</p>

                <div class="settings-card__actions">
                    <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary"
                            @onclick="ClearLibraryCache">
                        <Icon Name="IconName.Trash" />
                        <span>@Traductor.T("SETTINGS_LIB_CACHE_CLEAR")</span>
                    </button>
                </div>
            </div>
        </article>

        @* --- User FPGAs --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--success">
                    <Icon Name="IconName.CpuFill" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_USER_FPGAS_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_USER_FPGAS_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-card__actions">
                    <button type="button" class="kmila-btn kmila-btn--primary"
                            @onclick="DownloadFpgaTemplate">
                        <Icon Name="IconName.Download" />
                        <span>@Traductor.T("SETTINGS_DOWNLOAD_TEMPLATE")</span>
                    </button>
                    <label class="kmila-btn kmila-btn--accent settings-import-btn">
                        <Icon Name="IconName.FileEarmarkPlus" />
                        <span>@Traductor.T("SETTINGS_IMPORT_FPGA")</span>
                        <InputFile OnChange="OnFpgaImportAsync" accept=".json" class="d-none" />
                    </label>
                </div>

                @if (_userFpgas.Count == 0)
                {
                    <p class="settings-card__placeholder">@Traductor.T("SETTINGS_NO_USER_FPGA")</p>
                }
                else
                {
                    <ul class="settings-list">
                        @foreach (var path in _userFpgas)
                        {
                            var name = System.IO.Path.GetFileName(path);
                            <li class="settings-list__item">
                                <div class="settings-list__info">
                                    <Icon Name="IconName.FileEarmarkCode" />
                                    <span class="settings-list__name">@name</span>
                                </div>
                                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                                        @onclick="() => DeleteFpga(name)"
                                        aria-label="@Traductor.T("COMMON_DELETE")"
                                        title="@Traductor.T("COMMON_DELETE")">
                                    <Icon Name="IconName.Trash" />
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>
        </article>

        @* --- User languages --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--info">
                    <Icon Name="IconName.Translate" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_USER_LANGS_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_USER_LANGS_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-card__actions">
                    <button type="button" class="kmila-btn kmila-btn--primary"
                            @onclick="DownloadLanguageTemplate">
                        <Icon Name="IconName.Download" />
                        <span>@Traductor.T("SETTINGS_DOWNLOAD_TEMPLATE")</span>
                    </button>
                    <label class="kmila-btn kmila-btn--accent settings-import-btn">
                        <Icon Name="IconName.FileEarmarkPlus" />
                        <span>@Traductor.T("SETTINGS_IMPORT_LANG")</span>
                        <InputFile OnChange="OnLangImportAsync" accept=".json" class="d-none" />
                    </label>
                </div>

                @if (_userLangs.Count == 0)
                {
                    <p class="settings-card__placeholder">@Traductor.T("SETTINGS_NO_USER_LANG")</p>
                }
                else
                {
                    <ul class="settings-list">
                        @foreach (var path in _userLangs)
                        {
                            var name = System.IO.Path.GetFileName(path);
                            var display = UserAssetStore.ReadLanguageDisplayName(path);
                            <li class="settings-list__item">
                                <div class="settings-list__info">
                                    <Icon Name="IconName.Translate" />
                                    <span class="settings-list__name">@display</span>
                                    <span class="settings-list__code">@name</span>
                                </div>
                                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                                        @onclick="() => DeleteLang(name)"
                                        aria-label="@Traductor.T("COMMON_DELETE")"
                                        title="@Traductor.T("COMMON_DELETE")">
                                    <Icon Name="IconName.Trash" />
                                </button>
                            </li>
                        }
                    </ul>
                }

                <p class="settings-card__note">
                    <Icon Name="IconName.InfoCircle" />
                    <span>@Traductor.T("SETTINGS_USER_LANGS_NOTE")</span>
                </p>
            </div>
        </article>

        @* --- User VHDL libraries --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--accent">
                    <Icon Name="IconName.Stack" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_USER_LIBS_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_USER_LIBS_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-card__actions">
                    <label class="kmila-btn kmila-btn--accent settings-import-btn">
                        <Icon Name="IconName.FileEarmarkPlus" />
                        <span>@Traductor.T("SETTINGS_IMPORT_LIB")</span>
                        <InputFile OnChange="OnLibraryImportAsync" accept=".vhd,.vhdl" class="d-none" />
                    </label>
                </div>

                @if (_userLibs.Count == 0)
                {
                    <p class="settings-card__placeholder">@Traductor.T("SETTINGS_NO_USER_LIB")</p>
                }
                else
                {
                    <ul class="settings-list">
                        @foreach (var path in _userLibs)
                        {
                            var name     = System.IO.Path.GetFileName(path);
                            var packages = UserAssetStore.ListPackagesInFile(path);
                            <li class="settings-list__item">
                                <div class="settings-list__info">
                                    <Icon Name="IconName.FileEarmarkCode" />
                                    <span class="settings-list__name">@name</span>
                                    @if (packages.Count > 0)
                                    {
                                        <span class="settings-list__code">
                                            @string.Join(", ", packages)
                                        </span>
                                    }
                                </div>
                                <div class="d-flex gap-1">
                                    <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                                            @onclick="() => ViewLibrary(path)"
                                            aria-label="@Traductor.T("SETTINGS_LIB_VIEW")"
                                            title="@Traductor.T("SETTINGS_LIB_VIEW")">
                                        <Icon Name="IconName.Eye" />
                                    </button>
                                    <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--primary kmila-btn--sm"
                                            @onclick="() => DeleteLibrary(name)"
                                            aria-label="@Traductor.T("COMMON_DELETE")"
                                            title="@Traductor.T("COMMON_DELETE")">
                                        <Icon Name="IconName.Trash" />
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }

                <p class="settings-card__note">
                    <Icon Name="IconName.InfoCircle" />
                    <span>@Traductor.T("SETTINGS_USER_LIBS_NOTE")</span>
                </p>
            </div>
        </article>

        @* --- Project bundle export / import --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--accent">
                    <Icon Name="IconName.BoxArrowUpRight" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_BUNDLE_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_BUNDLE_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-card__actions">
                    <select class="form-select settings-card__select" @bind="_exportProjectId">
                        <option value="0">@Traductor.T("SETTINGS_BUNDLE_PICK")</option>
                        @foreach (var p in _projects)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                    <button type="button" class="kmila-btn kmila-btn--primary"
                            disabled="@(_exportProjectId <= 0)"
                            @onclick="ExportBundleAsync">
                        <Icon Name="IconName.Download" />
                        <span>@Traductor.T("SETTINGS_BUNDLE_EXPORT")</span>
                    </button>
                    <label class="kmila-btn kmila-btn--accent settings-import-btn">
                        <Icon Name="IconName.FileEarmarkPlus" />
                        <span>@Traductor.T("SETTINGS_BUNDLE_IMPORT")</span>
                        <InputFile OnChange="OnBundleImportAsync" accept=".kmila,.json" class="d-none" />
                    </label>
                </div>
            </div>
        </article>

        @* --- Learn progress --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--accent">
                    <Icon Name="IconName.MortarboardFill" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_LEARN_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_LEARN_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-row">
                    <div class="settings-row__label">
                        <strong>@Traductor.T("SETTINGS_LEARN_COMPLETED")</strong>
                        <small>@string.Format(Traductor.T("SETTINGS_LEARN_COMPLETED_N"), _learnCompleted)</small>
                    </div>
                    <div class="settings-row__control">
                        <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--danger kmila-btn--sm"
                                @onclick="ResetLearnProgressAsync"
                                disabled="@(_learnCompleted == 0)">
                            <Icon Name="IconName.ArrowCounterclockwise" />
                            <span>@Traductor.T("SETTINGS_LEARN_RESET")</span>
                        </button>
                    </div>
                </div>
            </div>
        </article>

        @* --- Diagnostics --- *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--warning">
                    <Icon Name="IconName.TerminalFill" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_DIAGNOSTICS_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_DIAGNOSTICS_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <a href="/logs" class="kmila-btn kmila-btn--primary">
                    <Icon Name="IconName.JournalText" />
                    <span>@Traductor.T("SETTINGS_OPEN_LOGS")</span>
                </a>
            </div>
        </article>

        @* --- Account (GitHub login, optional) ---
            Login is OPTIONAL. The card surfaces sign-in / sign-out, the
            auto-error-report preference, and the privacy declaration in
            one place. Tier 1+2 fallbacks below stay available either
            way; only "submit in-app" + auto-reports require auth. *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--accent">
                    <Icon Name="IconName.PersonCircle" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_ACCOUNT_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_ACCOUNT_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                @if (GitHubAuth.IsLoggedIn && GitHubAuth.Account != null)
                {
                    @* Flat row mirroring .settings-list__item — same
                       visual weight as the FPGA / Languages list rows
                       elsewhere in this page. No card-within-card. *@
                    <ul class="settings-list">
                        <li class="settings-list__item">
                            <div class="settings-list__info">
                                @if (!string.IsNullOrEmpty(GitHubAuth.Account.AvatarUrl))
                                {
                                    <img src="@GitHubAuth.Account.AvatarUrl" alt=""
                                         class="settings-account__avatar"
                                         width="32" height="32" />
                                }
                                else
                                {
                                    <Icon Name="IconName.PersonCircle" />
                                }
                                <span class="settings-list__name">@(GitHubAuth.Account.Name ?? GitHubAuth.Account.Login)</span>
                                <span class="settings-list__code">@GitHubAuth.Account.Login</span>
                            </div>
                            <button type="button" class="kmila-btn-icon kmila-btn-icon--ghost kmila-btn-icon--primary kmila-btn-icon--sm"
                                    @onclick="SignOutAsync"
                                    aria-label="@Traductor.T("TOPBAR_SIGN_OUT")"
                                    title="@Traductor.T("TOPBAR_SIGN_OUT")">
                                <Icon Name="IconName.BoxArrowRight" />
                            </button>
                        </li>
                    </ul>

                    <div class="settings-row">
                        <div class="settings-row__label">
                            <strong>@Traductor.T("SETTINGS_AUTO_REPORT_TITLE")</strong>
                            <small>@Traductor.T("SETTINGS_AUTO_REPORT_HINT")</small>
                        </div>
                        <div class="settings-row__control">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox"
                                       id="auto-report"
                                       checked="@_autoReportEnabled"
                                       @onchange="OnAutoReportToggledAsync" />
                            </div>
                        </div>
                    </div>

                    <div class="settings-card__actions">
                        <button type="button"
                                class="kmila-btn kmila-btn--accent"
                                @onclick="SubmitManualReportAsync"
                                disabled="@_submitting">
                            <Icon Name="IconName.Send" />
                            <span>@Traductor.T("SETTINGS_ACCOUNT_SEND_REPORT")</span>
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_lastReportUrl))
                    {
                        <p class="settings-card__note">
                            <Icon Name="IconName.CheckCircle" />
                            <span>
                                @Traductor.T("SETTINGS_ACCOUNT_REPORT_SENT")
                                <a href="@_lastReportUrl" target="_blank" rel="noopener noreferrer">@_lastReportUrl</a>
                            </span>
                        </p>
                    }
                }
                else
                {
                    @* Logged-out state. When OAuth Client ID isn't yet
                       configured, show a 3-step setup form so the
                       deployer can paste the ID without recompiling. *@
                    @if (!GitHubAuth.IsConfigured)
                    {
                        <p class="settings-card__hint">
                            <strong>@Traductor.T("SETTINGS_ACCOUNT_SETUP_TITLE")</strong>
                        </p>
                        <ol class="settings-account__setup-steps">
                            <li>
                                @Traductor.T("SETTINGS_ACCOUNT_SETUP_STEP1_TEXT")
                                <a href="https://github.com/settings/developers" target="_blank" rel="noopener noreferrer">
                                    github.com/settings/developers
                                    <Icon Name="IconName.BoxArrowUpRight" />
                                </a>
                            </li>
                            <li>@Traductor.T("SETTINGS_ACCOUNT_SETUP_STEP2")</li>
                            <li>@Traductor.T("SETTINGS_ACCOUNT_SETUP_STEP3")</li>
                        </ol>

                        <div class="settings-row">
                            <div class="settings-row__label">
                                <label for="kmila-client-id"><strong>@Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_LABEL")</strong></label>
                                <small>@Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_HINT")</small>
                            </div>
                            <div class="settings-row__control">
                                <input id="kmila-client-id" type="text"
                                       class="form-control"
                                       placeholder="Iv1.xxxxxxxxxxxxxxxx"
                                       @bind="_clientIdInput" />
                            </div>
                        </div>

                        <div class="settings-card__actions">
                            <button type="button" class="kmila-btn kmila-btn--accent"
                                    @onclick="SaveClientIdAsync"
                                    disabled="@string.IsNullOrWhiteSpace(_clientIdInput)">
                                <Icon Name="IconName.Save" />
                                <span>@Traductor.T("COMMON_SAVE")</span>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="settings-card__actions">
                            <button type="button" class="kmila-btn kmila-btn--accent"
                                    @onclick="OpenLoginAsync">
                                <Icon Name="IconName.Github" />
                                <span>@Traductor.T("TOPBAR_SIGN_IN_GITHUB")</span>
                            </button>
                        </div>
                        <p class="settings-card__hint">@Traductor.T("SETTINGS_ACCOUNT_LOGIN_OPTIONAL")</p>

                        @* Optional: change OAuth Client ID. Wrapped in
                           a <details> using the codebase's standard
                           rotated-chevron pattern (see .kmila-fpga-picker)
                           so the disclosure feels native to the app. *@
                        <details class="settings-card__details">
                            <summary>
                                <Icon Name="IconName.Tools" />
                                <span>@Traductor.T("SETTINGS_ACCOUNT_CHANGE_CLIENT_ID")</span>
                                <Icon Name="IconName.ChevronDown" Class="settings-card__details-chevron" />
                            </summary>
                            <div class="settings-row">
                                <div class="settings-row__label">
                                    <label for="kmila-client-id-change"><strong>@Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_LABEL")</strong></label>
                                    <small>@Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_HINT")</small>
                                </div>
                                <div class="settings-row__control">
                                    <input id="kmila-client-id-change" type="text"
                                           class="form-control"
                                           placeholder="@GitHubAuth.CurrentClientId"
                                           @bind="_clientIdInput" />
                                </div>
                            </div>
                            <div class="settings-card__actions">
                                <button type="button" class="kmila-btn kmila-btn--accent"
                                        @onclick="SaveClientIdAsync"
                                        disabled="@string.IsNullOrWhiteSpace(_clientIdInput)">
                                    <Icon Name="IconName.Save" />
                                    <span>@Traductor.T("COMMON_SAVE")</span>
                                </button>
                                <button type="button" class="kmila-btn kmila-btn--ghost kmila-btn--danger"
                                        @onclick="ClearClientIdAsync">
                                    <Icon Name="IconName.Trash" />
                                    <span>@Traductor.T("COMMON_CLEAR")</span>
                                </button>
                            </div>
                        </details>
                    }
                }

                @* Privacy notice — always visible. Reuses the canonical
                   .settings-card__note treatment so it reads as a
                   sibling of every other note in the page (e.g. the
                   user-languages note in the same section). *@
                <p class="settings-card__note">
                    <Icon Name="IconName.ShieldLock" />
                    <span>@Traductor.T("SETTINGS_ACCOUNT_PRIVACY")</span>
                </p>
            </div>
        </article>

        @* --- Feedback / Issue reporting ---
            Tier 1: copy diagnostics to clipboard (offline, no auth).
            Tier 2: open a pre-filled GitHub issue URL (new tab, no auth).
            Tier 3 (Device Flow in-app submission) ships in the Account
            card above — it requires an OAuth Client ID configured in
            GitHubAuthConfig. *@
        <article class="settings-card">
            <header class="settings-card__head">
                <span class="settings-card__icon settings-card__icon--accent">
                    <Icon Name="IconName.Github" />
                </span>
                <div class="settings-card__head-text">
                    <h2>@Traductor.T("SETTINGS_FEEDBACK_TITLE")</h2>
                    <p class="settings-card__sub">@Traductor.T("SETTINGS_FEEDBACK_SUB")</p>
                </div>
            </header>
            <div class="settings-card__body">
                <div class="settings-card__actions">
                    <button type="button"
                            class="kmila-btn kmila-btn--primary"
                            @onclick="CopyDiagnosticsAsync">
                        <Icon Name="IconName.Clipboard2CheckFill" />
                        <span>@Traductor.T("SETTINGS_FEEDBACK_COPY")</span>
                    </button>
                    <button type="button"
                            class="kmila-btn kmila-btn--accent"
                            @onclick="OpenIssueUrlAsync">
                        <Icon Name="IconName.BoxArrowUpRight" />
                        <span>@Traductor.T("SETTINGS_FEEDBACK_OPEN_ISSUE")</span>
                    </button>
                </div>
                <p class="settings-card__hint">@Traductor.T("SETTINGS_FEEDBACK_HINT")</p>
            </div>
        </article>
    </div>
</section>

<ConfirmDialog @ref="_confirmDialog" />
<Modal @ref="_accountLoginModal" Title="@Traductor.T("TOPBAR_SIGN_IN_GITHUB")" />

@* Library source viewer — opened from the "View" button on each
   imported library row. Plain <pre> rendering keeps the VHDL source
   readable without dragging in a Monaco instance for what's
   effectively a one-off browse. *@
<Modal @ref="_libraryViewModal" Title="@_libraryViewName" Size="ModalSize.Large">
    <BodyTemplate>
        <pre class="library-source-view"
             style="max-height:60vh; overflow:auto; white-space:pre; font-family:var(--bs-font-monospace);">@_libraryViewSource</pre>
    </BodyTemplate>
</Modal>

@code {
    private List<string> _userFpgas = new();
    private List<string> _userLangs = new();
    private List<string> _userLibs  = new();
    private int _learnCompleted;
    private ConfirmDialog _confirmDialog = default!;

    /// <summary>
    /// Current simulation tick-resolution mode. Loaded from AppSettings on
    /// init, written back on change. Default mode is assumed when the
    /// setting is missing or unreadable so Run never blocks on this.
    /// </summary>
    private TickResolutionMode _tickMode = TickResolutionMode.Default;

    /// <summary>
    /// Current LibraryCompiler build-policy mode. Loaded from AppSettings,
    /// written back on change, and applied directly to the singleton
    /// LibraryCompiler so the next Build picks it up without restart.
    /// </summary>
    private LibraryCompiler.Services.LibraryBuildMode _libBuildMode =
        LibraryCompiler.Services.LibraryBuildMode.Persistent;

    /// <summary>
    /// Current opt-in for live frame-by-frame replay accumulation. Default
    /// off — see <see cref="ReplayState.LiveReplayDuringRun"/> for the
    /// memory rationale (per-frame snapshot growth dominates GB-scale leaks
    /// on long sims).
    /// </summary>
    private bool _liveReplayDuringRun;

    /// <summary>Projects available to export — loaded alongside user assets.</summary>
    private List<Kmila.Shared.Models.Project> _projects = new();
    private int _exportProjectId;

    // ─── Account / GitHub login state ────────────────────────────
    private const string AutoReportSettingKey = "KMILA_AUTO_REPORT_ENABLED";
    private bool _autoReportEnabled;
    private bool _submitting;
    private string? _lastReportUrl;
    private Modal _accountLoginModal = new();
    private string _clientIdInput = string.Empty;

    // Library source viewer state (View button on each imported library row).
    private Modal _libraryViewModal = default!;
    private string _libraryViewName   = string.Empty;
    private string _libraryViewSource = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Traductor.StaticOnLangChanged += OnLang;
        UserAssets.OnChange += OnLang;
        LearnProgress.OnChange += OnLang;
        RefreshLists();
        _learnCompleted = await LearnProgress.TotalCompletedAsync();
        _projects = (await ProjectsRepo.GetListAsync()) ?? new();

        // Hydrate the tick-mode dropdown from the persisted setting. Unknown
        // or missing values resolve to Default — safer than surfacing the
        // load failure on the Settings page.
        var raw = await DbContext.GetSettingAsync(AppSettings.KEY_TICK_RESOLUTION_MODE);
        _tickMode = TickResolutionModeExtensions.ParseToken(raw);

        // Same for the library-build mode. The startup hook in Program.cs
        // already applied this to the singleton LibraryCompiler — we just
        // mirror it here so the dropdown shows the right value.
        var libRaw = await DbContext.GetSettingAsync(AppSettings.KEY_LIBRARY_BUILD_MODE);
        _libBuildMode = LibraryBuildModeExtensions.ParseToken(libRaw);

        // Live-replay-during-run toggle. The actual setter lives on
        // ReplayState (mutated below in OnLiveReplayChanged); MainLayout
        // also reads this key on app boot so the gate is in place before
        // the first run. Reading from Replay here keeps the UI honest if
        // the user toggled it from another route in the same session.
        _liveReplayDuringRun = Replay.LiveReplayDuringRun;

        // Account state — restore the cached account from the saved
        // token (no-op if logged out), then subscribe to the auth
        // service so sign-in / sign-out from elsewhere (TopBar pill)
        // re-renders this card too.
        GitHubAuth.OnChange += OnLang;
        _ = GitHubAuth.RestoreAsync();
        var autoRaw = await DbContext.GetSettingAsync(AutoReportSettingKey);
        _autoReportEnabled = string.Equals(autoRaw, "true", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// Persist the new mode immediately so the next Run picks it up — no
    /// Save/Apply button. Writes the token form (not the int) to keep the
    /// AppSettings value human-readable and version-stable.
    /// </summary>
    private async Task OnTickModeChanged(ChangeEventArgs e)
    {
        _tickMode = TickResolutionModeExtensions.ParseToken(e.Value?.ToString());
        await DbContext.SetSettingAsync(AppSettings.KEY_TICK_RESOLUTION_MODE, _tickMode.ToToken());
        StateHasChanged();
    }

    /// <summary>
    /// Persists the new library-build mode AND applies it directly to the
    /// singleton LibraryCompiler. The next build sees the new policy
    /// without an app restart; already-cached artifacts stay valid.
    /// </summary>
    /// <summary>
    /// Persists the live-replay toggle and applies it to the scoped
    /// <see cref="ReplayState"/> immediately so the next Run honours it.
    /// Already-running sims keep their existing setting until they end —
    /// the gate is read at <c>AttachLive</c> time.
    /// </summary>
    private async Task OnLiveReplayChanged(ChangeEventArgs e)
    {
        _liveReplayDuringRun = e.Value is bool b ? b : false;
        Replay.LiveReplayDuringRun = _liveReplayDuringRun;
        await DbContext.SetSettingAsync(
            AppSettings.KEY_LIVE_REPLAY_DURING_RUN,
            _liveReplayDuringRun ? "true" : "false");
        StateHasChanged();
    }

    private async Task OnLibBuildModeChanged(ChangeEventArgs e)
    {
        _libBuildMode = LibraryBuildModeExtensions.ParseToken(e.Value?.ToString());
        await DbContext.SetSettingAsync(AppSettings.KEY_LIBRARY_BUILD_MODE, _libBuildMode.ToToken());
        try
        {
            LibCompiler.Orchestrator.Policy = LibraryBuildModeExtensions.ToPolicy(_libBuildMode);
        }
        catch (Exception ex)
        {
            // Apply errors are extremely unlikely (the property is just a
            // setter on a singleton) but log so /logs picks it up.
            Console.WriteLine($"[Settings] Failed to apply library build mode: {ex.Message}");
        }
        StateHasChanged();
    }

    private void OnLang() => InvokeAsync(async () =>
    {
        RefreshLists();
        _learnCompleted = await LearnProgress.TotalCompletedAsync();
        StateHasChanged();
    });

    private void RefreshLists()
    {
        _userFpgas = UserAssets.ListUserFpgaPaths();
        _userLangs = UserAssets.ListUserLanguagePaths();
        _userLibs  = UserAssets.ListUserLibraryPaths();
    }

    /// <summary>
    /// Exports the FPGA starter template. Web downloads via the JS helper;
    /// MAUI writes to Documents/Kmila/Settings/.
    /// </summary>
    private async Task DownloadFpgaTemplate()
    {
        var result = await Export.SaveTextAsync(ExportCategory.Settings,
            "fpga-template.json", "application/json",
            UserAssetStore.BuildFpgaTemplate());
        NotifyExport(result);
    }

    private async Task DownloadLanguageTemplate()
    {
        var result = await Export.SaveTextAsync(ExportCategory.Languages,
            "language-template.json", "application/json",
            UserAssetStore.BuildLanguageTemplate());
        NotifyExport(result);
    }

    private void NotifyExport(FileExportResult result)
    {
        if (result.Saved)
        {
            var msg = result.Path != null ? $"Saved: {result.Path}" : Traductor.T("SETTINGS_TEMPLATE_DOWNLOADED");
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), msg, ToastType.Success));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                result.Error ?? Traductor.T("COMMON_ERROR"), ToastType.Danger));
        }
    }

    private async Task OnFpgaImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        // 2 MB cap — FPGA device JSONs are tiny (~2-3 KB), anything larger is
        // almost certainly wrong and we don't want to buffer unbounded.
        using var src = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
        var saved = await UserAssets.ImportFpgaAsync(src, file.Name);
        ToastService.Notify(saved != null
            ? Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("SETTINGS_FPGA_IMPORTED"), ToastType.Success)
            : Message(Traductor.T("COMMON_ERROR"), Traductor.T("SETTINGS_IMPORT_FAILED"), ToastType.Danger));
    }

    private async Task OnLangImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        // 512 KB cap — dictionary files are a few hundred keys; very rarely
        // more than 50 KB even when fully translated.
        using var src = file.OpenReadStream(maxAllowedSize: 512 * 1024);
        var saved = await UserAssets.ImportLanguageAsync(src, file.Name);
        if (saved != null)
        {
            // Register the new language into the picker so the user doesn't
            // have to restart to see it.
            var code = System.IO.Path.GetFileNameWithoutExtension(saved);
            var display = UserAssetStore.ReadLanguageDisplayName(saved);
            Traductor.AddUserLanguage(display, code);
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("SETTINGS_LANG_IMPORTED"), ToastType.Success));
        }
        else
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), Traductor.T("SETTINGS_IMPORT_FAILED"), ToastType.Danger));
        }
    }

    private void DeleteFpga(string name)
    {
        if (UserAssets.DeleteFpga(name))
        {
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("SETTINGS_FPGA_REMOVED"), ToastType.Info));
        }
    }

    private void DeleteLang(string name)
    {
        if (UserAssets.DeleteLanguage(name))
        {
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("SETTINGS_LANG_REMOVED"), ToastType.Info));
        }
    }

    /// <summary>
    /// Imports a user-supplied <c>.vhd</c> / <c>.vhdl</c> library pack. The
    /// file lives under <see cref="UserAssetStore.UserLibrariesDir"/>; the
    /// LibraryCompiler discovers it through
    /// <see cref="UserAssetStore.ListUserLibrarySources"/> on the next build.
    /// </summary>
    private async Task OnLibraryImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        // 4 MB cap — VHDL packages are usually well under 100 KB even when
        // extensively documented; anything bigger probably isn't a library.
        using var src = file.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024);
        var saved = await UserAssets.ImportLibraryAsync(src, file.Name);
        // Resolver re-sync happens automatically via the
        // UserAssetStore.OnChange subscription wired up in Program.cs /
        // MauiProgram.cs — Import / Delete fire OnChange, which calls
        // SyncResolver, so the next build sees the new state without an
        // app restart.
        ToastService.Notify(saved != null
            ? Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("SETTINGS_LIB_IMPORTED"), ToastType.Success)
            : Message(Traductor.T("COMMON_ERROR"), Traductor.T("SETTINGS_IMPORT_FAILED"), ToastType.Danger));
    }

    private void DeleteLibrary(string name)
    {
        if (UserAssets.DeleteLibrary(name))
        {
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"), Traductor.T("SETTINGS_LIB_REMOVED"), ToastType.Info));
        }
    }

    /// <summary>
    /// Opens a modal with the raw .vhd contents so the user can inspect
    /// what's actually in their imported library without leaving the app.
    /// Reads on demand (no caching) — these files are tiny.
    /// </summary>
    private async Task ViewLibrary(string absolutePath)
    {
        try
        {
            _libraryViewName   = System.IO.Path.GetFileName(absolutePath);
            _libraryViewSource = System.IO.File.Exists(absolutePath)
                ? await System.IO.File.ReadAllTextAsync(absolutePath)
                : string.Empty;
        }
        catch (Exception ex)
        {
            _libraryViewSource = $"-- Failed to read file: {ex.Message}";
        }
        await _libraryViewModal.ShowAsync();
    }

    /// <summary>
    /// Wipes the library cache directory AND the orchestrator's in-memory
    /// snapshot so the next build is a guaranteed cold rebuild. Useful
    /// when the user suspects a corrupted artifact or just wants to
    /// reclaim disk space.
    /// </summary>
    private void ClearLibraryCache()
    {
        try
        {
            int removed = UserAssets.ClearLibraryCache();
            LibCompiler.Orchestrator.Reset();
            ToastService.Notify(Message(
                Traductor.T("COMMON_MESSAGE"),
                string.Format(Traductor.T("SETTINGS_LIB_CACHE_CLEARED"), removed),
                ToastType.Info));
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>
    /// Asks for confirmation, then wipes every <c>learn.done.*</c> entry plus
    /// the last-opened pointer. The UI re-renders via the <see cref="LessonProgressStore.OnChange"/>
    /// subscription above, so the completed counter flips to 0 immediately.
    /// </summary>
    private async Task ResetLearnProgressAsync()
    {
        var options = new ConfirmDialogOptions
        {
            YesButtonColor = ButtonColor.Danger,
            YesButtonText = Traductor.T("SETTINGS_LEARN_RESET"),
            NoButtonColor = ButtonColor.Secondary,
            NoButtonText  = Traductor.T("COMMON_CANCEL")
        };
        var ok = await _confirmDialog.ShowAsync(
            title:   Traductor.T("SETTINGS_LEARN_RESET_TITLE"),
            message1: Traductor.T("SETTINGS_LEARN_RESET_MSG"),
            confirmDialogOptions: options);
        if (!ok) return;

        await LearnProgress.ResetAllAsync();
        ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
            Traductor.T("SETTINGS_LEARN_RESET_DONE"), ToastType.Info));
    }

    private async Task ExportBundleAsync()
    {
        var proj = _projects.FirstOrDefault(p => p.Id == _exportProjectId);
        if (proj == null) return;
        try
        {
            var json = await Bundles.ExportAsync(proj);
            var safeName = proj.Name.Replace(' ', '_');
            var result = await Export.SaveTextAsync(ExportCategory.Projects,
                $"{safeName}.kmila", "application/json", json);
            NotifyExport(result);
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    private async Task OnBundleImportAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            // Same logic the Projects page uses for picking a base path.
            var basePath =
#if WINDOWS || MACCATALYST || ANDROID || IOS
                Microsoft.Maui.Storage.FileSystem.AppDataDirectory;
#else
                Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ApplicationData), "KmilaData");
#endif

            var project = await Bundles.ImportAsync(json, basePath);
            ToastService.Notify(project != null
                ? Message(Traductor.T("COMMON_MESSAGE"),
                    string.Format(Traductor.T("SETTINGS_BUNDLE_IMPORTED"), project.Name), ToastType.Success)
                : Message(Traductor.T("COMMON_ERROR"),
                    Traductor.T("SETTINGS_BUNDLE_IMPORT_FAILED"), ToastType.Danger));

            _projects = (await ProjectsRepo.GetListAsync()) ?? new();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>Tier 1: copy diagnostics to clipboard. Offline, no auth.</summary>
    private async Task CopyDiagnosticsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText",
                FeedbackHelper.BuildDiagnostics(Traductor.Lang ?? "en"));
            ToastService.Notify(Message(Traductor.T("COMMON_OK"),
                Traductor.T("SETTINGS_FEEDBACK_COPIED"), ToastType.Success));
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>Tier 2: open GitHub's new-issue URL with the diagnostics prefilled.</summary>
    private async Task OpenIssueUrlAsync()
    {
        try
        {
            var body = FeedbackHelper.BuildDiagnostics(Traductor.Lang ?? "en");
            var url  = FeedbackHelper.BuildIssueUrl("[Report] ", body);
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    // ─── Account handlers ────────────────────────────────────────

    /// <summary>Opens the device-flow modal for sign-in. Routed to
    /// the Editor's existing multi-use modal pattern through the
    /// hosting layout's slot — we use the layout-level slot so the
    /// modal stays visible if the user navigates away mid-flow.</summary>
    private async Task OpenLoginAsync()
    {
        var parameters = new Dictionary<string, object>
        {
            { "OnSuccess", EventCallback.Factory.Create(this, () => _accountLoginModal.HideAsync()) },
            { "OnCancel",  EventCallback.Factory.Create(this, () => _accountLoginModal.HideAsync()) }
        };
        await _accountLoginModal.ShowAsync<GitHubLoginModal>(
            Traductor.T("TOPBAR_SIGN_IN_GITHUB"), null, parameters);
    }

    private async Task SignOutAsync()
    {
        await GitHubAuth.SignOutAsync();
        _lastReportUrl = null;
    }

    /// <summary>Persists the user-entered Client ID into the settings
    /// table. The auth service picks it up immediately so the next
    /// sign-in attempt uses it.</summary>
    private async Task SaveClientIdAsync()
    {
        if (string.IsNullOrWhiteSpace(_clientIdInput)) return;
        try
        {
            await GitHubAuth.SetClientIdAsync(_clientIdInput);
            _clientIdInput = string.Empty;
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_SAVED"), ToastType.Success));
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    private async Task ClearClientIdAsync()
    {
        try
        {
            await GitHubAuth.SetClientIdAsync(null);
            _clientIdInput = string.Empty;
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_CLEARED"), ToastType.Info));
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    /// <summary>Persists the auto-report toggle. Phase A only saves
    /// the preference; the actual hook into the error-logging
    /// pipeline lands in a follow-up so we can review the throttle /
    /// dedup design separately.</summary>
    private async Task OnAutoReportToggledAsync(ChangeEventArgs e)
    {
        _autoReportEnabled = e.Value is bool b && b;
        await DbContext.SetSettingAsync(AutoReportSettingKey, _autoReportEnabled ? "true" : "false");
    }

    /// <summary>One-shot manual report. Posts the same diagnostics the
    /// Tier 1 / Tier 2 buttons surface, but goes through the GitHub
    /// API as the logged-in user so the issue is properly attributed.</summary>
    private async Task SubmitManualReportAsync()
    {
        if (_submitting || !GitHubAuth.IsLoggedIn) return;
        _submitting = true;
        _lastReportUrl = null;
        StateHasChanged();
        try
        {
            var lang = await DbContext.GetSettingAsync(AppSettings.KEY_LANGUAGE) ?? "en";
            var diag = FeedbackHelper.BuildDiagnostics(lang);
            var url = await GitHubAuth.SubmitIssueAsync(
                title: "[Kmila] Manual report",
                body:  diag,
                labels: new[] { "user-report" });
            if (url != null)
            {
                _lastReportUrl = url;
                ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                    Traductor.T("SETTINGS_ACCOUNT_REPORT_SENT"), ToastType.Success));
            }
            else
            {
                ToastService.Notify(Message(Traductor.T("COMMON_ERROR"),
                    Traductor.T("SETTINGS_ACCOUNT_REPORT_FAILED"), ToastType.Danger));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLang;
        UserAssets.OnChange -= OnLang;
        LearnProgress.OnChange -= OnLang;
        GitHubAuth.OnChange -= OnLang;
    }
}
