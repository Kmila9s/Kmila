    /// <summary>Opens the device-flow modal for sign-in. Routed to
    /// the Editor's existing multi-use modal pattern through the
    /// hosting layout's slot — we use the layout-level slot so the
    /// modal stays visible if the user navigates away mid-flow.</summary>
    private async Task OpenLoginAsync()
    {
        var parameters = new Dictionary<string, object>
        {
            { "OnSuccess", EventCallback.Factory.Create(this, () => _accountLoginModal.HideAsync()) },
            { "OnCancel",  EventCallback.Factory.Create(this, () => _accountLoginModal.HideAsync()) }
        };
        await _accountLoginModal.ShowAsync<GitHubLoginModal>(
            Traductor.T("TOPBAR_SIGN_IN_GITHUB"), null, parameters);
    }

    private async Task SignOutAsync()
    {
        await GitHubAuth.SignOutAsync();
        _lastReportUrl = null;
    }

    /// <summary>Persists the user-entered Client ID into the settings
    /// table. The auth service picks it up immediately so the next
    /// sign-in attempt uses it.</summary>
    private async Task SaveClientIdAsync()
    {
        if (string.IsNullOrWhiteSpace(_clientIdInput)) return;
        try
        {
            await GitHubAuth.SetClientIdAsync(_clientIdInput);
            _clientIdInput = string.Empty;
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_SAVED"), ToastType.Success));
        }
        catch (Exception ex)
        {
            ToastService.Notify(Message(Traductor.T("COMMON_ERROR"), ex.Message, ToastType.Danger));
        }
    }

    private async Task ClearClientIdAsync()
    {
        try
        {
            await GitHubAuth.SetClientIdAsync(null);
            _clientIdInput = string.Empty;
            ToastService.Notify(Message(Traductor.T("COMMON_MESSAGE"),
                Traductor.T("SETTINGS_ACCOUNT_CLIENT_ID_CLEARED"), ToastType.Info));
