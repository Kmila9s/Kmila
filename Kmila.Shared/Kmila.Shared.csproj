<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net9.0-android</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1587;CS1591;CS1570;CS1573;CS1574;CS1998;CS8602;CS8604;CS8625;CS8892;CS0219;CS0618;CS4014;NETSDK1206</NoWarn>
    <!-- Required for Android target -->
    <UseMaui Condition="'$(TargetFramework)' == 'net9.0-android'">true</UseMaui>
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net9.0-android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Copy Devices folder to output directory -->
  <ItemGroup>
    <Content Update="wwwroot\Devices\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Common packages for all targets -->
  <ItemGroup>
    <PackageReference Include="Blazor.Bootstrap" Version="3.4.0" />
    <PackageReference Include="BlazorMonaco" Version="3.3.0" />
    <!-- Markdig: full GFM + advanced extensions (tables, fenced code, task
         lists, autolinks, etc.). BlazorBootstrap's built-in <Markdown>
         component uses a regex parser that doesn't handle tables or ASCII art
         reliably; Markdig is the .NET standard and renders everything
         correctly. See LessonView.razor for the rendering path. -->
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <ProjectReference Include="../../../Debugger/Debugger.csproj" />
    <ProjectReference Include="../../../Interpreter/Interpreter.csproj" />
  </ItemGroup>

  <!-- Web-specific settings (net9.0 only) -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <DefineConstants>$(DefineConstants);ASPNETCORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.5" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- MAUI-specific packages (net9.0-android) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

</Project>