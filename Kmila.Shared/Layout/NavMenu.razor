@*
    NavMenu — Kmila custom sidebar

    Fully hand-rolled; no BlazorBootstrap Sidebar2 dependency so we have total
    control over markup, icons, active state, collapse behavior, and mobile drawer.

    Three display modes coordinated via SidebarState service:
      • Expanded (default, desktop)    — 260px, icons + labels, section headers visible
      • Rail/collapsed (desktop)        — 72px,  icons only, labels appear as tooltips
      • Drawer (mobile)                 — off-canvas slide-in, backdrop + esc/overlay close

    Active-route detection uses NavigationManager.LocationChanged so highlighting
    updates immediately when the user clicks a link, without waiting for a full render.
*@
@implements IDisposable
@inject SidebarState SidebarState
@inject Microsoft.Extensions.Logging.ILogger<NavMenu> Logger
@inject Kmila.Shared.Services.RecentProjectsTracker Recent
@inject Kmila.Shared.Services.LessonProgressStore LearnProgress
@inject Kmila.Shared.Services.LessonCatalog LessonCatalog
@inject Kmila.Shared.Services.ConceptProgressStore ConceptProgress
@inject Kmila.Shared.Services.ConceptCatalog ConceptCatalog
@inject Kmila.Shared.Services.SimulationParameters Sim
@inject Kmila.Shared.Services.ProgramBuilder Builder
@inject Kmila.Shared.Services.Practice.PracticeCatalog PracticeCatalog
@inject Kmila.Shared.Services.Practice.PracticeAttemptStore PracticeAttempts

<aside class="kmila-sidebar @_rootClass" aria-label="@Traductor.T("A11Y_MAIN_NAV")">
    @* Top row: logo + wordmark + version chip *@
    <a href="/" class="kmila-sidebar__brand" @onclick="OnNavClicked">
        <img src="_content/Kmila.Shared/img/Logo.png" alt="Kmila" class="kmila-sidebar__logo" />
        <span class="kmila-sidebar__wordmark">
            <span class="kmila-sidebar__name">Kmila</span>
            <span class="kmila-sidebar__version">@Traductor.T("APP_VERSION")</span>
        </span>
    </a>

    @* Scrollable nav body *@
    <nav class="kmila-sidebar__nav" role="navigation">

        @* Project group: only contains project-scoped routes (browse + create). *@
        <div class="kmila-sidebar__section" aria-label="@Traductor.T("NAV_SECTION_PROJECT")">
            <span class="kmila-sidebar__section-label">
                <span>@Traductor.T("NAV_SECTION_PROJECT")</span>
            </span>

            <a href="/projects"
               class="kmila-nav-item @ActiveClass("/projects", exact: true)"
               @onclick="OnNavClicked"
               data-tooltip="@Traductor.T("NAV_PROJECTS")">
                <span class="kmila-nav-item__indicator"></span>
                <Icon Name="IconName.Collection" Class="kmila-nav-item__icon" />
                <span class="kmila-nav-item__label">@Traductor.T("NAV_PROJECTS")</span>
            </a>

            <a href="/projects/create"
               class="kmila-nav-item @ActiveClass("/projects/create", exact: true)"
               @onclick="OnNavClicked"
               data-tooltip="@Traductor.T("NAV_CREATE_PROJECT")">
                <span class="kmila-nav-item__indicator"></span>
                <Icon Name="IconName.PlusCircleFill" Class="kmila-nav-item__icon" />
                <span class="kmila-nav-item__label">@Traductor.T("NAV_CREATE_PROJECT")</span>
            </a>
        </div>

        @* Learning group: top-level pedagogy surfaces. Split from the Project
           section because Learn/Practice/Concepts are not project-scoped. *@
        <div class="kmila-sidebar__section" aria-label="@Traductor.T("NAV_SECTION_LEARNING")">
            <span class="kmila-sidebar__section-label">
                <span>@Traductor.T("NAV_SECTION_LEARNING")</span>
            </span>

            <a href="/learn"
               class="kmila-nav-item @ActiveClass("/learn", exact: false)"
               @onclick="OnNavClicked"
               data-tooltip="@Traductor.T("NAV_LEARN")">
                <span class="kmila-nav-item__indicator"></span>
                <Icon Name="IconName.MortarboardFill" Class="kmila-nav-item__icon" />
                <span class="kmila-nav-item__label">@Traductor.T("NAV_LEARN")</span>
                @if (_learnTotal > 0)
                {
                    @* `dir="ltr"` keeps the "done / total" pair in numeric reading order
                       inside RTL contexts (Arabic) — without it, Latin digits and the
                       slash get bidi-reordered to "31 / 0". *@
                    <span class="kmila-nav-item__badge" dir="ltr"
                          title="@string.Format(Traductor.T("LEARN_YOUR_PROGRESS_FMT"), _learnDone, _learnTotal)">
                        @_learnDone / @_learnTotal
                    </span>
                }
            </a>

            <a href="/practice"
               class="kmila-nav-item @ActiveClass("/practice", exact: false)"
               @onclick="OnNavClicked"
               data-tooltip="@Traductor.T("NAV_PRACTICE")">
                <span class="kmila-nav-item__indicator"></span>
                <Icon Name="IconName.PuzzleFill" Class="kmila-nav-item__icon" />
                <span class="kmila-nav-item__label">@Traductor.T("NAV_PRACTICE")</span>
                @if (_practiceTotal > 0)
                {
                    <span class="kmila-nav-item__badge" dir="ltr"
                          title="@string.Format(Traductor.T("PRACTICE_NAV_BADGE_FMT"), _practiceSolved, _practiceTotal)">
                        @_practiceSolved / @_practiceTotal
                    </span>
                }
            </a>

            <a href="/concepts"
               class="kmila-nav-item @ActiveClass("/concepts", exact: false)"
               @onclick="OnNavClicked"
               data-tooltip="@Traductor.T("NAV_CONCEPTS")">
                <span class="kmila-nav-item__indicator"></span>
                <Icon Name="IconName.Diagram3" Class="kmila-nav-item__icon" />
                <span class="kmila-nav-item__label">@Traductor.T("NAV_CONCEPTS")</span>
                @if (_conceptTotal > 0)
                {
                    <span class="kmila-nav-item__badge" dir="ltr"
                          title="@string.Format(Traductor.T("CONCEPTS_NAV_BADGE_FMT"), _conceptDone, _conceptTotal)">
                        @_conceptDone / @_conceptTotal
                    </span>
                }
            </a>
        </div>

        @if (_visibleProjects.Count > 0)
        {
            <div class="kmila-sidebar__section" aria-label="@Traductor.T("NAV_PROJECTS_RECENT")">
                <span class="kmila-sidebar__section-label">
                    <span>@Traductor.T("NAV_PROJECTS_RECENT")</span>
                    <span class="kmila-sidebar__count">@_visibleProjects.Count@(_projects.Count > RecentProjectsTracker.SidebarLimit ? $"/{_projects.Count}" : "")</span>
                </span>

                <div class="kmila-sidebar__project-list">
                    @foreach (var project in _visibleProjects)
                    {
                        var href = $"/editor/{project.Id}";
                        var isRunning = Sim.RunningProjectId == project.Id;
                        var isPaused  = isRunning && Sim.State == SimState.Paused;
                        var pct       = (int)Math.Round(Sim.Progress);
                        <div class="kmila-nav-item kmila-nav-item--project @ActiveClass(href, exact: true) @(isRunning ? "kmila-nav-item--running" : "")"
                             data-tooltip="@(isRunning ? $"{project.Name} — {(isPaused ? Traductor.T("SIDEBAR_PROJECT_PAUSED") : Traductor.T("SIDEBAR_PROJECT_RUNNING"))} {pct}%" : project.Name)">
                            <a href="@href" class="kmila-nav-item__main"
                               @onclick="OnNavClicked"
                               aria-label="@string.Format(Traductor.T("NAV_OPEN_PROJECT"), project.Name)">
                                <span class="kmila-nav-item__indicator"></span>
                                <Icon Name="IconName.FileEarmarkCode" Class="kmila-nav-item__icon" />
                                <span class="kmila-nav-item__label">@project.Name</span>
                                @if (isRunning)
                                {
                                    <span class="kmila-nav-item__progress-text">@pct%</span>
                                    <span class="kmila-nav-item__pulse" title="@Traductor.T("SIDEBAR_PROJECT_RUNNING")" aria-hidden="true"></span>
                                }
                            </a>
                            @if (isRunning)
                            {
                                <span class="kmila-nav-item__actions">
                                    @if (isPaused)
                                    {
                                        <button type="button" class="kmila-nav-item__action"
                                                @onclick="OnResumeSimulation"
                                                @onclick:stopPropagation="true"
                                                aria-label="@Traductor.T("SIM_RESUME")"
                                                title="@Traductor.T("SIM_RESUME")">
                                            <Icon Name="IconName.PlayFill" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="kmila-nav-item__action"
                                                @onclick="OnPauseSimulation"
                                                @onclick:stopPropagation="true"
                                                aria-label="@Traductor.T("SIM_PAUSE")"
                                                title="@Traductor.T("SIM_PAUSE")">
                                            <Icon Name="IconName.PauseFill" />
                                        </button>
                                    }
                                    <button type="button" class="kmila-nav-item__action kmila-nav-item__action--danger"
                                            @onclick="OnStopSimulation"
                                            @onclick:stopPropagation="true"
                                            aria-label="@Traductor.T("SIM_STOP")"
                                            title="@Traductor.T("SIM_STOP")">
                                        <Icon Name="IconName.StopFill" />
                                    </button>
                                </span>
                                <div class="kmila-nav-item__progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                    <div class="kmila-nav-item__progress-fill" style="width: @pct%;"></div>
                                </div>
                            }
                            else
                            {
                                <span class="kmila-nav-item__actions">
                                    <button type="button" class="kmila-nav-item__action"
                                            @onclick="() => RemoveProjectAsync(project)"
                                            @onclick:stopPropagation="true"
                                            aria-label="@string.Format(Traductor.T("NAV_REMOVE_PROJECT"), project.Name)"
                                            title="@string.Format(Traductor.T("NAV_REMOVE_PROJECT"), project.Name)">
                                        <Icon Name="IconName.Trash" />
                                    </button>
                                </span>
                            }
                        </div>
                    }
                </div>

                @if (_projects.Count > RecentProjectsTracker.SidebarLimit)
                {
                    <a href="/projects" class="kmila-sidebar__view-all"
                       @onclick="OnNavClicked"
                       data-tooltip="@Traductor.T("NAV_VIEW_ALL_PROJECTS")">
                        <Icon Name="IconName.Collection" />
                        <span>@string.Format(Traductor.T("NAV_VIEW_ALL_PROJECTS_N"), _projects.Count)</span>
                    </a>
                }
            </div>
        }

        @* System section — app-level tools, always visible *@
        <div class="kmila-sidebar__section" aria-label="@Traductor.T("NAV_SYSTEM")">
            <span class="kmila-sidebar__section-label">
                <span>@Traductor.T("NAV_SYSTEM")</span>
            </span>
            <a href="/settings"
               class="kmila-nav-item @ActiveClass("/settings", exact: true)"
               @onclick="OnNavClicked"
               data-tooltip="@Traductor.T("NAV_SETTINGS")">
                <span class="kmila-nav-item__indicator"></span>
                <Icon Name="IconName.GearFill" Class="kmila-nav-item__icon" />
                <span class="kmila-nav-item__label">@Traductor.T("NAV_SETTINGS")</span>
            </a>
            <a href="/logs"
               class="kmila-nav-item @ActiveClass("/logs", exact: true)"
               @onclick="OnNavClicked"
               data-tooltip="@Traductor.T("NAV_LOGS")">
                <span class="kmila-nav-item__indicator"></span>
                <Icon Name="IconName.JournalText" Class="kmila-nav-item__icon" />
                <span class="kmila-nav-item__label">@Traductor.T("NAV_LOGS")</span>
            </a>
        </div>
    </nav>

    @* Footer: collapse toggle (desktop only) *@
    <div class="kmila-sidebar__footer">
        <button type="button"
                class="kmila-sidebar__collapse-btn"
                @onclick="ToggleCollapsed"
                aria-label="@(SidebarState.IsCollapsed ? Traductor.T("SIDEBAR_EXPAND") : Traductor.T("SIDEBAR_COLLAPSE"))"
                title="@(SidebarState.IsCollapsed ? Traductor.T("SIDEBAR_EXPAND") : Traductor.T("SIDEBAR_COLLAPSE"))">
            <Icon Name="@(SidebarState.IsCollapsed ? IconName.ChevronDoubleRight : IconName.ChevronDoubleLeft)" />
            <span class="kmila-nav-item__label">@Traductor.T("SIDEBAR_COLLAPSE")</span>
        </button>
    </div>
</aside>

@* Mobile backdrop — shown only when drawer is open on narrow viewports *@
@if (SidebarState.IsMobileOpen)
{
    <div class="kmila-sidebar__backdrop" @onclick="SidebarState.CloseMobile" aria-hidden="true"></div>
}

@* Destructive-action confirmation. The sidebar's trash icon is small + close to
   the project label, so an accidental tap was destroying work without any
   undo. Mirrors the ConfirmDialog flow on the Projects card grid so the UX
   is consistent across delete surfaces. *@
<ConfirmDialog @ref="_removeProjectDialog" />

@code {
    /// <summary>Full project list from the DB.</summary>
    private List<Project> _projects = new();

    /// <summary>
    /// Sorted + capped list actually rendered in the sidebar. MRU first (per
    /// RecentProjectsTracker), falling back to creation time for projects the
    /// user hasn't opened yet. Capped to <see cref="RecentProjectsTracker.SidebarLimit"/>
    /// so the sidebar stays reasonable once students have dozens of projects.
    /// </summary>
    private List<Project> _visibleProjects = new();

    private int _learnDone;
    private int _learnTotal;

    private int _practiceSolved;
    private int _practiceTotal;

    private int _conceptDone;
    private int _conceptTotal;

    private string _currentPath = "/";

    private string _rootClass =>
        (SidebarState.IsCollapsed ? "kmila-sidebar--collapsed " : "") +
        (SidebarState.IsMobileOpen ? "kmila-sidebar--open " : "");

    protected override async Task OnInitializedAsync()
    {
        Traductor.StaticOnLangChanged += OnLanguageChanged;
        SidebarState.OnChange += OnSidebarStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        Projects.OnListChanged += OnProjectListChanged;
        Recent.OnChange += OnRecentChanged;
        LearnProgress.OnChange += OnLearnProgressChanged;
        ConceptProgress.OnChange += OnConceptProgressChanged;
        Sim.OnChange += OnSimChanged;
        PracticeAttempts.OnChange += OnPracticeChanged;

        _currentPath = new Uri(NavigationManager.Uri).AbsolutePath;
        await LoadProjectsAsync();
        await LoadLearnProgressAsync();
        await LoadConceptProgressAsync();
        await LoadPracticeProgressAsync();
    }

    /// <summary>
    /// Hydrates the Concepts done/total badge. Falls back to (0, 0) so a
    /// missing manifest never breaks the nav.
    /// </summary>
    private async Task LoadConceptProgressAsync()
    {
        try
        {
            var manifest = await ConceptCatalog.GetManifestAsync();
            _conceptTotal = manifest.Modules.Sum(m => m.Lessons.Count);
            _conceptDone = await ConceptProgress.TotalCompletedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[NavMenu] Failed to load concept progress");
            _conceptTotal = 0;
            _conceptDone = 0;
        }
    }

    private async void OnConceptProgressChanged()
    {
        await LoadConceptProgressAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadLearnProgressAsync()
    {
        try
        {
            var manifest = await LessonCatalog.GetManifestAsync();
            _learnTotal = manifest.Modules.Sum(m => m.Lessons.Count);
            _learnDone  = await LearnProgress.TotalCompletedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[NavMenu] Failed to load learn progress");
            _learnTotal = 0;
            _learnDone = 0;
        }
    }

    private async void OnLearnProgressChanged()
    {
        await LoadLearnProgressAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Hydrates <see cref="_practiceSolved"/> / <see cref="_practiceTotal"/>.
    /// Falls back to (0, 0) on any failure so the nav doesn't break if the
    /// catalog manifest is missing or the DB is locked at boot.
    /// </summary>
    private async Task LoadPracticeProgressAsync()
    {
        try
        {
            var meta = await PracticeCatalog.ListAsync();
            _practiceTotal  = meta.Count;
            _practiceSolved = await PracticeAttempts.TotalSolvedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[NavMenu] Failed to load practice progress");
            _practiceTotal = 0;
            _practiceSolved = 0;
        }
    }

    private async void OnPracticeChanged(string _)
    {
        await LoadPracticeProgressAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Refresh when the global <see cref="SimulationParameters.RunningProjectId"/>
    /// flips on/off so the "project is running" pulse animates even when the
    /// user has navigated away from the Editor.
    /// </summary>
    private void OnSimChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Pauses the active simulation from the sidebar. Mirrors the Run-bar's
    /// pause handler (<c>Editor.OnPauseSimulation</c>): the singleton
    /// <see cref="ProgramBuilder"/> drives the underlying timer, and
    /// <see cref="SimulationParameters.SetState"/> flips the state machine so
    /// every subscribed surface (Run bar, sidebar, project card) re-renders.
    /// </summary>
    private void OnPauseSimulation()
    {
        if (Sim.State != SimState.Running) return;
        Builder.PauseTimer();
        Sim.SetState(SimState.Paused);
    }

    /// <summary>Resumes a paused simulation from the sidebar.</summary>
    private void OnResumeSimulation()
    {
        if (Sim.State != SimState.Paused) return;
        Builder.ContinueTimer();
        Sim.SetState(SimState.Running);
    }

    /// <summary>
    /// Stops the active simulation from the sidebar. Mirrors
    /// <c>Editor.OnStopSimulation</c>: stops the timer, transitions to
    /// Complete, zeros progress, and clears the RunningProjectId so the
    /// row drops back to its idle layout.
    /// </summary>
    private void OnStopSimulation()
    {
        if (Sim.State != SimState.Running && Sim.State != SimState.Paused) return;
        Builder.StopTimer();
        Sim.SetState(SimState.Complete);
        Sim.SetProgress(0);
        Sim.EndRun();
    }

    private async void OnProjectListChanged()
    {
        await LoadProjectsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnRecentChanged()
    {
        await RebuildVisibleAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProjectsAsync()
    {
        try
        {
            _projects = await Projects.GetListAsync() ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[NavMenu] Failed to load projects");
            _projects = new();
        }
        await RebuildVisibleAsync();
    }

    /// <summary>
    /// Re-derives <see cref="_visibleProjects"/> from the full project list +
    /// the MRU tracker. Intersects MRU ids with the current list (so deleted
    /// projects drop out automatically) and then pads with never-opened ones
    /// sorted by creation time descending so new projects are instantly
    /// visible even before their first open.
    /// </summary>
    private async Task RebuildVisibleAsync()
    {
        var mru = await Recent.GetOrderedAsync();
        var byId = _projects.ToDictionary(p => p.Id);

        var ordered = new List<Project>();
        foreach (var id in mru)
        {
            if (byId.TryGetValue(id, out var p))
            {
                ordered.Add(p);
                byId.Remove(id);
            }
        }
        // Pad with never-opened projects (newest first).
        ordered.AddRange(byId.Values.OrderByDescending(p => p.CreationTime));
        _visibleProjects = ordered.Take(RecentProjectsTracker.SidebarLimit).ToList();
    }

    private ConfirmDialog _removeProjectDialog = new();

    /// <summary>
    /// Sidebar row delete. Originally skipped confirmation because the trash
    /// icon required an intentional tap — but in practice mis-taps were
    /// destroying student work with no undo path. Now mirrors the Projects
    /// page confirm flow so users get a "Yes / Go back" gate.
    /// </summary>
    private async Task RemoveProjectAsync(Project project)
    {
        try
        {
            var options = new ConfirmDialogOptions
            {
                YesButtonColor = ButtonColor.Danger,
                NoButtonColor = ButtonColor.Secondary,
                AutoFocusYesButton = false,
                YesButtonText = Traductor.T("PROJECTS_REMOVE"),
                NoButtonText = Traductor.T("COMMON_GO_BACK")
            };
            var confirmed = await _removeProjectDialog.ShowAsync(
                title: $"{Traductor.T("PROJECTS_REMOVING")}: {project.Name}",
                message1: string.Format(Traductor.T("PROJECTS_REMOVE_MSG1"), project.BasePath),
                message2: Traductor.T("PROJECTS_REMOVE_MSG2"),
                confirmDialogOptions: options
            );
            if (!confirmed) return;

            var ok = await Projects.RemoveAsync(project);
            if (ok)
            {
                await Recent.ForgetAsync(project.Id);
                // If the user was on this project's editor, bounce to /projects.
                if (_currentPath.EndsWith($"/editor/{project.Id}", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/projects");
                }
            }
            else
            {
                Logger.LogWarning("[NavMenu] Project remove failed: {Err}", Projects.LastError);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[NavMenu] Remove project {Id} threw", project.Id);
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = new Uri(e.Location).AbsolutePath;
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnSidebarStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Close the mobile drawer after any nav click. On desktop this is a no-op.
    /// </summary>
    private void OnNavClicked()
    {
        SidebarState.CloseMobile();
    }

    private void ToggleCollapsed() => SidebarState.ToggleCollapsed();

    /// <summary>
    /// Returns the active CSS class when the current route matches <paramref name="href"/>.
    /// </summary>
    private string ActiveClass(string href, bool exact)
    {
        if (string.Equals(_currentPath, href, StringComparison.OrdinalIgnoreCase))
            return "is-active";
        if (!exact && _currentPath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase))
            return "is-active";
        return "";
    }

    public void Dispose()
    {
        Traductor.StaticOnLangChanged -= OnLanguageChanged;
        SidebarState.OnChange -= OnSidebarStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        Projects.OnListChanged -= OnProjectListChanged;
        Recent.OnChange -= OnRecentChanged;
        LearnProgress.OnChange -= OnLearnProgressChanged;
        ConceptProgress.OnChange -= OnConceptProgressChanged;
        Sim.OnChange -= OnSimChanged;
        PracticeAttempts.OnChange -= OnPracticeChanged;
    }
}
